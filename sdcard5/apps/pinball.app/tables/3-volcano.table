[rule]
when       = lanes top
do         = multiplier
message    = Bonus x up!
message.fr = Bonus x augmenté !

[rule]
when       = ramp lava
count      = 10
once       = 1
do         = extraball
message    = Extra ball!
message.fr = Bille supplémentaire !

[rule]
when       = bank magma
do         = ballsave 10
message    = Ball save 10 s
message.fr = Bille sauvée 10 s

