# ---- the rules -------------------------------------------------------------------------------------------
[rule]
when       = lanes top
do         = multiplier; score 1000
message    = Bonus x up!
message.fr = Bonus x augmenté !

[rule]
when       = bank solar
do         = bonus 5000
message    = Solar array: 5,000 bonus
message.fr = Panneaux : 5 000 de bonus

[rule]
when       = ramp orbit
count      = 3
once       = 1
do         = extraball
message    = Extra ball!
message.fr = Bille supplémentaire !

[rule]
when       = saucer dock
count      = 2
do         = multiball 2
message    = MULTIBALL!
message.fr = MULTIBALL !

