# Turtle Quest -- a pack of levels (user/Apps/turtle/world.h says the format)
[pack]
title = 5. Spirals and fractals
title.fr = 5. Spirales et fractales

[level]
id = polygon-sub
title = Any polygon
title.fr = Tout polygone
concept = params
words = FORWARD BACK LEFT RIGHT PENUP PENDOWN COLOR
draw = 1
text = Teach the turtle one word for every polygon: SUB Polygon (sides, size). Then draw the pentagon and the octagon.
text.fr = Un seul mot pour tous les polygones : SUB Polygone (cotes, taille). Puis dessine le pentagone et l'octogone.
hint = Polygon 5, 3; then PENUP, move 8 squares to the right, PENDOWN, and Polygon 8, 2.
hint.fr = Polygone 5, 3 ; puis LEVERCRAYON, déplace-toi de 8 cases vers la droite, BAISSERCRAYON, et Polygone 8, 2.
par = 11 15
map =
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ...^....................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
solution =
| SUB Polygon (sides, size)
|   REPEAT sides
|     FORWARD size
|     RIGHT 360 / sides
|   END REPEAT
| END SUB
| Polygon 5, 3
| PENUP
| RIGHT
| FORWARD 8
| LEFT
| PENDOWN
| Polygon 8, 2

[level]
id = polygon-row
title = Three to eight
title.fr = De trois à huit
concept = params
words = FORWARD BACK LEFT RIGHT PENUP PENDOWN COLOR
draw = 1
text = A triangle, a square, a pentagon... up to an octagon, all from the same corner, sides of 2. A FOR loop gives the sides.
text.fr = Du triangle à l'octogone, tous depuis le même coin, de côté 2. Une boucle POUR donne le nombre de côtés.
hint = Your SUB Polygon, then FOR s = 3 TO 8: Polygon s, 2: NEXT.
hint.fr = Ton SUB Polygone, puis POUR s = 3 JUSQUE 8 : Polygone s, 2 : SUITE.
par = 6 9
map =
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........^...............
| ........................
| ........................
| ........................
solution =
| SUB Polygon (sides, size)
|   REPEAT sides
|     FORWARD size
|     RIGHT 360 / sides
|   END REPEAT
| END SUB
| FOR s = 3 TO 8
|   Polygon s, 2
| NEXT

[level]
id = rainbow-spiral
title = Rainbow snail
title.fr = Arc-en-ciel
concept = color
words = FORWARD BACK LEFT RIGHT PENUP PENDOWN COLOR
draw = color
text = A square spiral of 16 legs, each one square longer, in the rainbow's colours: the colour comes from the counter.
text.fr = Une spirale carrée de 16 côtés, chacun une case plus long, aux couleurs de l'arc-en-ciel : la couleur vient du compteur.
hint = FOR i = 1 TO 16: COLOR i MOD 6 + 1, FORWARD i, RIGHT.
hint.fr = POUR i = 1 JUSQUE 16 : COULEUR i MOD 6 + 1, AVANCER i, DROITE.
par = 4 7
map =
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ...........^............
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
solution =
| FOR i = 1 TO 16
|   COLOR i MOD 6 + 1
|   FORWARD i
|   RIGHT
| NEXT

[level]
id = hex-spiral
title = Hexagon spiral
title.fr = Spirale à six pans
concept = variable
words = FORWARD BACK LEFT RIGHT PENUP PENDOWN COLOR
draw = 1
text = A spiral that turns by 60 degrees: 18 legs, the first half a square long, each one half a square longer.
text.fr = Une spirale qui tourne de 60 degrés : 18 côtés, le premier d'une demi-case, chacun une demi-case plus long.
hint = n = 0.5, then REPEAT 18: FORWARD n, RIGHT 60, n = n + 0.5.
hint.fr = n = 0.5, puis REPETER 18 : AVANCER n, DROITE 60, n = n + 0.5.
par = 5 8
map =
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ...........^............
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
solution =
| n = 0.5
| REPEAT 18
|   FORWARD n
|   RIGHT 60
|   n = n + 0.5
| END REPEAT

[level]
id = color-flower
title = Two-colour flower
title.fr = Fleur bicolore
concept = color
words = FORWARD BACK LEFT RIGHT PENUP PENDOWN COLOR
draw = color
text = Six hexagons of side 2.5 around one point, each turned by 60 degrees: blue, red, blue, red...
text.fr = Six hexagones de côté 2,5 autour d'un point, chacun tourné de 60 degrés : bleu, rouge, bleu, rouge...
hint = FOR i = 1 TO 6: blue or red from i MOD 2, a hexagon (REPEAT 6: FORWARD 2.5, RIGHT 60), then RIGHT 60.
hint.fr = POUR i = 1 JUSQUE 6 : bleu ou rouge selon i MOD 2, un hexagone (REPETER 6 : AVANCER 2.5, DROITE 60), puis DROITE 60.
par = 6 9
map =
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ...........^............
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
solution =
| FOR i = 1 TO 6
|   IF i MOD 2 = 0 THEN COLOR 4 ELSE COLOR 1
|   REPEAT 6
|     FORWARD 2.5
|     RIGHT 60
|   END REPEAT
|   RIGHT 60
| NEXT

[level]
id = halves
title = Half of half
title.fr = Moitié de moitié
concept = function
words = FORWARD BACK LEFT RIGHT PENUP PENDOWN COLOR
draw = 1
text = Each side is half the one before: 8, 4, 2, 1, a half. Write FUNCTION Half (x) and let it compute them.
text.fr = Chaque côté est la moitié du précédent : 8, 4, 2, 1, une demie. Écris FONCTION Moitie (x) et laisse-la les calculer.
hint = n = 8, then REPEAT 5: FORWARD n, RIGHT, n = Half (n).
hint.fr = n = 8, puis REPETER 5 : AVANCER n, DROITE, n = Moitie (n).
par = 7 10
map =
| ........................
| ........................
| ...>....................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
solution =
| FUNCTION Half (x)
|   Half = x / 2
| END FUNCTION
| n = 8
| REPEAT 5
|   FORWARD n
|   RIGHT
|   n = Half (n)
| END REPEAT

[level]
id = snail-rec
title = Snail in a snail
title.fr = Escargot gigogne
concept = recursion
words = FORWARD BACK LEFT RIGHT PENUP PENDOWN COLOR
draw = 1
text = A snail is a side, then a smaller snail. Draw it with a SUB that calls itself: sides 13, 12, 11... down to 1.
text.fr = Un escargot, c'est un côté, puis un plus petit escargot : un SUB qui s'appelle. Côtés 13, 12, 11... jusqu'à 1.
hint = SUB Snail (size): IF size < 1 THEN EXIT SUB, FORWARD size, RIGHT, Snail size - 1. Then Snail 13.
hint.fr = SUB Escargot (taille) : SI taille < 1 ALORS SORTIR SUB, AVANCER taille, DROITE, Escargot taille - 1. Puis Escargot 13.
par = 6 9
map =
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ...^....................
| ........................
| ........................
solution =
| SUB Snail (size)
|   IF size < 1 THEN EXIT SUB
|   FORWARD size
|   RIGHT
|   Snail size - 1
| END SUB
| Snail 13

[level]
id = tree
title = A tree
title.fr = Un arbre
concept = recursion
words = FORWARD BACK LEFT RIGHT PENUP PENDOWN COLOR
draw = 1
text = A trunk, then two smaller trees on it, turned by 30 degrees each way. Four levels of branches.
text.fr = Un tronc, puis deux arbres plus petits dessus, tournés de 30 degrés de chaque côté. Quatre étages de branches.
hint = SUB Tree (size, depth): stop at depth 0; else FORWARD size, LEFT 30, Tree size * 0.6, depth - 1, RIGHT 60, the same again, LEFT 30, BACK size. Then Tree 6, 4.
hint.fr = SUB Arbre (taille, etage) : arrête-toi à l'étage 0 ; sinon AVANCER taille, GAUCHE 30, Arbre taille * 0.6, etage - 1, DROITE 60, pareil, GAUCHE 30, RECULER taille. Puis Arbre 6, 4.
par = 10 14
map =
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ...........^............
solution =
| SUB Tree (size, depth)
|   IF depth = 0 THEN EXIT SUB
|   FORWARD size
|   LEFT 30
|   Tree size * 0.6, depth - 1
|   RIGHT 60
|   Tree size * 0.6, depth - 1
|   LEFT 30
|   BACK size
| END SUB
| Tree 6, 4

[level]
id = koch
title = The Koch curve
title.fr = La courbe de Koch
concept = recursion
words = FORWARD BACK LEFT RIGHT PENUP PENDOWN COLOR
draw = 1
text = A line whose middle third becomes two sides of a triangle -- and the same again on each piece, three times.
text.fr = Un trait dont le tiers du milieu devient deux côtés d'un triangle -- et pareil sur chaque morceau, trois fois.
hint = SUB Koch (size, depth): at depth 0, FORWARD size; else four Koch size / 3, depth - 1, with LEFT 60, RIGHT 120, LEFT 60 between them. Then Koch 18, 3.
hint.fr = SUB Koch (taille, etage) : à l'étage 0, AVANCER taille ; sinon quatre Koch taille / 3, etage - 1, avec GAUCHE 60, DROITE 120, GAUCHE 60 entre eux. Puis Koch 18, 3.
par = 12 16
map =
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ..>.....................
| ........................
| ........................
| ........................
| ........................
| ........................
solution =
| SUB Koch (size, depth)
|   IF depth = 0 THEN
|     FORWARD size
|     EXIT SUB
|   END IF
|   Koch size / 3, depth - 1
|   LEFT 60
|   Koch size / 3, depth - 1
|   RIGHT 120
|   Koch size / 3, depth - 1
|   LEFT 60
|   Koch size / 3, depth - 1
| END SUB
| Koch 18, 3

[level]
id = snowflake
title = The snowflake
title.fr = Le flocon de neige
concept = recursion
words = FORWARD BACK LEFT RIGHT PENUP PENDOWN COLOR
draw = 1
text = Three Koch curves, turned by 120 degrees, close into a snowflake.
text.fr = Trois courbes de Koch, tournées de 120 degrés, se referment en flocon.
hint = Your SUB Koch, then REPEAT 3: Koch 12, 2, RIGHT 120.
hint.fr = Ton SUB Koch, puis REPETER 3 : Koch 12, 2, DROITE 120.
par = 14 18
map =
| ........................
| ........................
| ........................
| ........................
| ........................
| .....>..................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
solution =
| SUB Koch (size, depth)
|   IF depth = 0 THEN
|     FORWARD size
|     EXIT SUB
|   END IF
|   Koch size / 3, depth - 1
|   LEFT 60
|   Koch size / 3, depth - 1
|   RIGHT 120
|   Koch size / 3, depth - 1
|   LEFT 60
|   Koch size / 3, depth - 1
| END SUB
| REPEAT 3
|   Koch 12, 2
|   RIGHT 120
| END REPEAT

[level]
id = sierpinski
title = Sierpinski
title.fr = Sierpinski
concept = recursion
words = FORWARD BACK LEFT RIGHT PENUP PENDOWN COLOR
draw = color
text = Three half-size triangles in a triangle, and the same in each of them. Each small triangle has its own colour.
text.fr = Trois triangles deux fois plus petits dans un triangle, et pareil dans chacun. Chaque petit triangle a sa couleur.
hint = SUB Tri (size, depth, c): at depth 0, a triangle in COLOR c MOD 6 + 1; else three Tri size / 2, depth - 1, with c, c + 1, c + 2 -- the pen up to move. Then Tri 16, 3, 0.
hint.fr = SUB Tri (taille, etage, c) : à l'étage 0, un triangle en COULEUR c MOD 6 + 1 ; sinon trois Tri taille / 2, etage - 1, avec c, c + 1, c + 2 -- le crayon levé pour bouger. Puis Tri 16, 3, 0.
par = 24 28
map =
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ........................
| ...>....................
| ........................
solution =
| SUB Tri (size, depth, c)
|   IF depth = 0 THEN
|     COLOR c MOD 6 + 1
|     REPEAT 3
|       FORWARD size
|       LEFT 120
|     END REPEAT
|     EXIT SUB
|   END IF
|   Tri size / 2, depth - 1, c
|   PENUP
|   FORWARD size / 2
|   PENDOWN
|   Tri size / 2, depth - 1, c + 1
|   PENUP
|   LEFT 120
|   FORWARD size / 2
|   RIGHT 120
|   PENDOWN
|   Tri size / 2, depth - 1, c + 2
|   PENUP
|   RIGHT 120
|   FORWARD size / 2
|   LEFT 120
|   PENDOWN
| END SUB
| Tri 16, 3, 0
