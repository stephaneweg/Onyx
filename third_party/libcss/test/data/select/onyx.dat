#reset
#tree screen
| div
|  class=outer
|  ul
|   class=nav
|   li*
|    class=item
#ua
div, ul, li { display: block; }
#user
:is(ul, ol) li { margin-left: 1px; }
:where(.nav) .item { margin-top: 2px; }
.item:not(.disabled, .hidden) { margin-right: 3px; }
li:not(.outer li) { margin-bottom: 4px; }
:is(.outer > ul) > li.item { padding-left: 5px; }
:is(::before, .item) { padding-top: 6px; }
li:is() { padding-bottom: 7px; }
.item:focus-visible { padding-right: 8px; }
li:where(.item) { z-index: 1; }
li { z-index: 2; }
:is(#nope, li) { line-height: 3; }
li.item { line-height: 2; }
