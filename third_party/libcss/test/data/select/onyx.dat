#reset
#tree screen
| div*
#ua
div { display: block; }
#user
@supports (display: grid) and (not (display: nonsense)) { div { color: #010203; } }
@supports (display: nonsense) { div { background-color: #111111; } }
@layer base { div { margin-left: 3px; } }
@layer a, b;
@media screen { @supports (gap: 1px) { div { margin-top: 4px; } } }
@media print { @layer x { div { margin-bottom: 9px; } } }
@container sidebar (min-width: 0px) { div { padding-left: 5px; } }
@supports selector(:has(a)) { div { padding-top: 6px; } }
@supports (--x: 1) { div { padding-right: 7px; } }
div { z-index: 2; }
