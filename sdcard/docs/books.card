# Onyx Cardfile -- a form and its records (open it with Cardfile)
[form]
version = 1
title = My Books
description = The books on my shelves, read or waiting

[field]
column = title
label = Title
type = text

[field]
column = author
label = Author
type = text

[field]
column = genre
label = Genre
type = choice
choice = Novel
choice = Science fiction
choice = Crime
choice = History
choice = Science
choice = Comics

[field]
column = read
label = Read
type = yesno

[field]
column = cover
label = Cover
type = colour

[field]
column = year
label = Published
type = integer

[field]
column = pages
label = Pages
type = integer

[field]
column = price
label = Price
type = decimal
decimals = 2

[field]
column = bought
label = Bought on
type = date

[field]
column = notes
label = Notes
type = multiline

[records]
