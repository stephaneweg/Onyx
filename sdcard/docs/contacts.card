# Onyx Cardfile -- a form and its records (open it with Cardfile)
[form]
version = 1
title = Contacts
description = Family, friends and work
sort = name

[field]
column = name
label = Name
type = text

[field]
column = group
label = Group
type = choice
choice = Family
choice = Friends
choice = Work
choice = Neighbours

[field]
column = phone
label = Phone
type = text

[field]
column = email
label = E-mail
type = text

[field]
column = birthday
label = Birthday
type = date

[field]
column = card
label = Christmas card
type = yesno

[field]
column = address
label = Address
type = multiline

