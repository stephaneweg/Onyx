\pard\plain\s0\ql\sa120\sl276\slmult1\qj {\f0\fs24 Writer lays its pages out itself and draws every letter with }{\f0\fs24\b FreeType}{\f0\fs24 , from the TrueType fonts of the card, at any zoom: }{\f1\fs24 Liberation Sans}{\f0\fs24 , }{\f3\fs24 Gelasio}{\f0\fs24 , }{\f4\fs24 Selawik}{\f0\fs24  or }{\f2\fs22 DejaVu Sans Mono}{\f0\fs24 , in every size. The paragraphs are justified, centred or aligned; the page is A4 with its margins, numbered at its foot.}\par
\pard\plain\s0\ql\li720\fi-360\sa120\sl276\slmult1{\listtext\f0\fs24 \'b7\tab}{\*\pn\pnlvlblt\pnf0{\pntxtb\'b7}}{\f0\fs24 Characters: }{\f0\fs24\b bold}{\f0\fs24 , }{\f0\fs24\i italic}{\f0\fs24 , }{\f0\fs24\ul underlined}{\f0\fs24 , }{\f0\fs24\strike struck through}{\f0\fs24 , superscript (E = mc}{\f0\fs24\super 2}{\f0\fs24 ) and subscript (H}{\f0\fs24\sub 2}{\f0\fs24 O).}\par
