# Onyx NetSurf options -- NetSurf "Choices" format: one "key:value" per line.
# Read at startup from SD:/res/Choices. Edit on the card; no rebuild needed, and
# re-staging keeps your edits (the build only creates this file if it is missing).

# --- Images -----------------------------------------------------------------
# 1 = load and display images (PNG / JPEG / GIF / BMP / WebP).
# 0 = do NOT fetch images; show their alt text instead. This is much faster on
#     heavy pages (it skips dozens of blocking fetches) -- a good "text mode".
foreground_images:1
background_images:1

# --- JavaScript (QuickJS, ES2023) ---------------------------------------------
# 1 = run page JavaScript; 0 disables it (faster on heavy pages, but menus and forms
#     that need scripts stop working).
enable_javascript:1
# The seconds a script (a page's script, an event handler, a promise job) may run before it
# is stopped; 0 = never. Unset = 60 (the Pi is ~5x slower than a PC: css3test.com's and
# browserscore.dev's test runs take several seconds there).
# script_timeout:60

# --- GPU compositing ---------------------------------------------------------
# 1 (default) = the page is kept in a band taller than the window, its layers (opacity,
#     transforms) apart; the GPU assembles them into the window (the processor when the GPU
#     fails its self-test at start): a scroll repaints nothing, animated transforms and
#     fades are composites. 0 = painted into the window as before. The kernel log says which.
gpu_compositing:1

# --- Fetch / memory ---------------------------------------------------------
# memory_cache_size feeds BOTH the source cache and the decoded-image cache
# (the latter = size/4). Too small => images get evicted then re-fetched AND
# re-decoded on every redraw (page stuck "fetching/processing"). RAM is ample
# here, so keep it generous: 64 MB => 16 MB image cache.
# Downloads at once (each in a thread; a site's connections are kept: keep-alive).
max_fetchers:8
max_fetchers_per_host:6

# --- Identity ---------------------------------------------------------------
# The User-Agent sent (and navigator.userAgent); unset = Chrome on Android: the big sites
# (Google, Facebook, Yahoo) then send their light mobile pages. Their full desktop pages:
# user_agent:Mozilla/5.0 (X11; Linux aarch64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/142.0.0.0 Safari/537.36
# The languages asked for; unset = French, then English.
# accept_language:fr-FR,fr;q=0.9,en;q=0.8
memory_cache_size:67108864
