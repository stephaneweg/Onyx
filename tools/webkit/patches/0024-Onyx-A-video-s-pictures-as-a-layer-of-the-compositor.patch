+
+// What a layer shows that WebCore does not paint: a video's pictures. Its owner (the media player)
+// gives each picture as it comes due; the layer it is the contents of (GraphicsLayer::
+// setContentsToPlatformLayer: this object is the port's PlatformLayer) has the compositor draw it
+// in its contents rectangle, from a texture of its own -- no tile is painted again for a picture.
+class GraphicsLayerOnyxContents {
+    WTF_MAKE_NONCOPYABLE(GraphicsLayerOnyxContents);
+public:
+    GraphicsLayerOnyxContents() = default;
+    WEBCORE_EXPORT ~GraphicsLayerOnyxContents();
+
+    // The picture to show: 0xFFRRGGBB words (opaque), stride in pixels. The pixels stay the caller's:
+    // valid until the next setPicture or forgetPixels (the compositor copies them at its next frame).
+    WEBCORE_EXPORT void setPicture(const uint32_t* pixels, const IntSize&, int stride);
+    // The pixels are about to go: what was last drawn stays on the screen.
+    void forgetPixels() { m_pixels = nullptr; }
+
+    // A layer shows it (false: the owner paints its pictures itself).
+    bool isAttached() const { return !!m_layer; }
+
+    const uint32_t* pixels() const { return m_pixels; }
+    const IntSize& size() const LIFETIME_BOUND { return m_size; }
+    int stride() const { return m_stride; }
+    // Changes with each picture.
+    unsigned generation() const { return m_generation; }
+
+    // (PlatformLayer is void* on this port: the object's address stands for it.)
+    PlatformLayer* platformLayer() { return reinterpret_cast<PlatformLayer*>(this); }
+    static GraphicsLayerOnyxContents* fromPlatformLayer(PlatformLayer* layer) { return reinterpret_cast<GraphicsLayerOnyxContents*>(layer); }
+
+private:
+    friend class GraphicsLayerOnyx;
+
+    GraphicsLayerOnyx* m_layer { nullptr };
+    const uint32_t* m_pixels { nullptr };
+    IntSize m_size;
+    int m_stride { 0 };
+    unsigned m_generation { 0 };
 };
 
