+
+void LayerTreeHost::destroyContentsTexture(ContentsTexture& contents)
+{
+    if (!contents.texture)
+        return;
+    m_texturePixels -= std::min(m_texturePixels, static_cast<uint64_t>(contents.size.width()) * contents.size.height());
+    gpc_tex_destroy(m_compositor, contents.texture);
+    contents.texture = nullptr;
+    if (m_textureCount)
+        --m_textureCount;
+    ++m_paintGeneration;
+}
+
+// A layer with a video: its picture, when it is another one than the texture holds, is copied into
+// the texture (made again when the pictures' size changed), and the rectangle it is drawn in is
+// this frame's damage -- nothing of the page is painted for a picture.
+void LayerTreeHost::prepareContents(GraphicsLayerOnyx& layer, const WalkState& state)
+{
+    auto* source = layer.contents();
+    if (!source)
+        return;
+
+    auto& contents = m_contentsTextures.ensure(&layer, [] {
+        return ContentsTexture { };
+    }).iterator->value;
+    contents.lastFrame = m_frameNumber;
+
+    auto* pixels = source->pixels();
+    if (!pixels || source->size().isEmpty() || (contents.texture && contents.generation == source->generation()))
+        return;
+
+    auto& size = source->size();
+    if (contents.texture && contents.size != size)
+        destroyContentsTexture(contents);
+
+    auto startTime = MonotonicTime::now();
+    if (!contents.texture) {
+        if (!hasRoomForTileTexture(size))
+            return;
+        contents.texture = gpc_tex_create(m_compositor, size.width(), size.height(), pixels, source->stride());
+        if (!contents.texture)
+            return;
+        ++m_textureCount;
+        m_texturePixels += static_cast<uint64_t>(size.width()) * size.height();
+        contents.size = size;
+    } else {
+        int result = gpc_tex_update(m_compositor, contents.texture, 0, 0, size.width(), size.height(), pixels, source->stride());
+        if (result == GPC_LOST) {
+            m_texturesWereLost = true;
+            return;
+        }
+        if (result != GPC_OK)
+            return;
+    }
+    m_uploadTime += MonotonicTime::now() - startTime;
+    contents.generation = source->generation();
+    ++m_paintGeneration;
+    ++m_picturesUploaded;
+
+    auto targetRect = enclosingIntRect(state.toTarget.mapRect(layer.contentsRect()));
+    targetRect.intersect(state.clip);
+    m_frameDamage.unite(targetRect);
+}
