+// The player's pixels are about to be its own again (it is freed, or flushed by a seek): what must
+// outlive them is copied first.
+void MediaPlayerPrivateOnyx::forgetPicturePixels()
+{
+    ensureImage();
+    m_picturePixels = nullptr;
+#if USE(GRAPHICS_LAYER_ONYX)
+    m_contents.forgetPixels();
+#endif
+}
