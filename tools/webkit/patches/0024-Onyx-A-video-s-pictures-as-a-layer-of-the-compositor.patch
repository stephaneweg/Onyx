+void GraphicsLayerOnyx::setContentsToPlatformLayer(PlatformLayer* platformLayer, ContentsLayerPurpose)
+{
+    // (Without a compositor nothing draws it: its owner goes on painting its pictures.)
+    auto* contents = m_host ? GraphicsLayerOnyxContents::fromPlatformLayer(platformLayer) : nullptr;
+    if (contents == m_contents)
+        return;
+    if (m_contents)
+        m_contents->m_layer = nullptr;
+    m_contents = contents;
+    if (m_contents) {
+        // (It was another layer's: a video element whose renderer was made again.)
