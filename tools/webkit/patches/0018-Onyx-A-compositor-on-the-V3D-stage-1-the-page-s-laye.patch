+GraphicsLayerOnyx::GraphicsLayerOnyx(Type type, GraphicsLayerClient& client, GraphicsLayerOnyxHost* host)
+    : GraphicsLayer(type, client)
+    , m_host(host)
+{
+    if (m_host)
+        m_host->layerCreated(*this);
+}
