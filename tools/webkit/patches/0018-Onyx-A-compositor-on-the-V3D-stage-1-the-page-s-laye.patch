+
+IntRect GraphicsLayerOnyx::rectForTile(int x, int y) const
+{
+    auto layerSize = expandedIntSize(m_size);
+    int x1 = x * tileSize;
+    int y1 = y * tileSize;
+    int x2 = std::min(x1 + tileSize, layerSize.width());
+    int y2 = std::min(y1 + tileSize, layerSize.height());
+    if (x2 <= x1 || y2 <= y1)
+        return { };
+    return { x1, y1, x2 - x1, y2 - y1 };
+}
+
+void GraphicsLayerOnyx::setSize(const FloatSize& size)
+{
+    if (size == m_size)
+        return;
+    GraphicsLayer::setSize(size);
+
+    // The tiles whose rectangle is still the same keep their pixels (a page that grows keeps all but
+    // its last row); the others are made again.
+    m_tiles.removeIf([&](auto& entry) {
+        auto& tile = entry.value;
+        if (rectForTile(tile.rect.x() / tileSize, tile.rect.y() / tileSize) == tile.rect)
+            return false;
+        destroyTile(tile);
+        return true;
+    });
+    noteLayerPropertyChanged();
+}
+
+bool GraphicsLayerOnyx::shouldRepaintOnSizeChange() const
+{
+    // A tiled layer (as GraphicsLayerCA's): the tiles in place keep their pixels, what changed in
+    // them is invalidated by the render tree, the new ones are painted whole (setSize).
+    if (m_host)
+        return false;
+    return GraphicsLayer::shouldRepaintOnSizeChange();
+}
