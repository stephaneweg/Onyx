+class GraphicsLayerOnyx;
+
+// The compositor a GraphicsLayerOnyx belongs to (WebKit's LayerTreeHost on Onyx): it keeps the
+// tiles' pixels as textures (user/gpucomp: the V3D, or the CPU) and assembles them. A layer made
+// without one (no factory: accelerated compositing off) keeps the tree and its properties and
+// draws nothing, as before there was a compositor.
+class GraphicsLayerOnyxHost {
+public:
+    using Texture = void*;
+
+    virtual ~GraphicsLayerOnyxHost() = default;
+
+    virtual void layerCreated(GraphicsLayerOnyx&) = 0;
+    virtual void layerDestroyed(GraphicsLayerOnyx&) = 0;
+
+    // Pixels: 0xAARRGGBB words, premultiplied (Skia's kBGRA_8888); stride in pixels.
+    // A null texture: none can be made now (the texture budget); the tile stays dirty.
+    virtual Texture createTileTexture(const IntSize&, const uint32_t* pixels, int stride) = 0;
+    // The rectangle is in the texture's coordinates. False: the pixels did not get there.
+    virtual bool updateTileTexture(Texture, const IntRect&, const uint32_t* pixels, int stride) = 0;
+    virtual void destroyTileTexture(Texture) = 0;
+};
+
+class GraphicsLayerOnyx final : public GraphicsLayer {
+public:
+    static constexpr int tileSize = 512;
+
+    struct Tile {
+        IntRect rect; // In the layer's coordinates, clipped to the layer.
+        IntRect dirtyRect;
+        GraphicsLayerOnyxHost::Texture texture { nullptr };
+    };
+
+    struct TileUpdate {
+        unsigned tilesPainted { 0 };
+        Seconds paintTime;
+        // What was painted again of tiles already shown, in the layer's coordinates.
+        Vector<IntRect, 8> repaintedRects;
+        // Tiles outside the visible rectangle that the budget left for a later frame.
+        bool hasPendingTiles { false };
+    };
+
+    WEBCORE_EXPORT static Ref<GraphicsLayerOnyx> create(Type, GraphicsLayerClient&, GraphicsLayerOnyxHost*);
+    WEBCORE_EXPORT ~GraphicsLayerOnyx();
+
+    // The host goes away before the layer: nothing is drawn any more (its textures went with it).
+    WEBCORE_EXPORT void detachFromHost();
+
+    // The tile grid follows the visible rectangle (the layer's coordinates): its coverage is that
+    // rectangle grown by its height above and twice below, clamped to the layer. The visible tiles
+    // that are new or dirty are painted and given to the host; those only covered, while
+    // offscreenBudget lasts (it is counted down). The tiles that left the coverage are dropped.
+    WEBCORE_EXPORT void updateTiles(const IntRect& visibleRect, unsigned& offscreenBudget, TileUpdate&);
