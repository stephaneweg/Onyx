+// The kernel gives a program 512 textures (kapi v70); a few are left for the colours.
+static constexpr unsigned maximumTileTextures = 480;
+// The tiles around the visible ones are painted a few a frame: what is seen comes first.
+static constexpr unsigned offscreenTilesPerFrame = 4;
+static constexpr Seconds frameInterval { 16_ms };
+// A frame the UI process never answered (a hidden window...) does not stop the next for ever.
+static constexpr Seconds didRefreshTimeout { 500_ms };
+static constexpr Seconds statisticsInterval { 2_s };
+static constexpr size_t maximumColorTextures = 32;
+
+// One line, one write, on the standard error: the kernel's log (kmsg) for an Onyx program.
+static void logLine(const char* format, ...) WTF_ATTRIBUTE_PRINTF(1, 2);
+static void logLine(const char* format, ...)
+{
+    char message[400];
+    char line[440];
+    va_list arguments;
+    va_start(arguments, format);
+    vsnprintf(message, sizeof(message), format, arguments);
+    va_end(arguments);
+    int length = snprintf(line, sizeof(line), "web: gpu: %s\n", message);
+    if (length > static_cast<int>(sizeof(line)) - 1)
+        length = sizeof(line) - 1;
+    if (length > 0)
+        (void)!write(STDERR_FILENO, line, length);
+}
+
+static void* allocateForCompositor(unsigned long bytes)
+{
+    return malloc(bytes);
+}
+
+static void freeForCompositor(void* memory)
+{
+    free(memory);
+}
+
+// For comparisons on the machine: SD:/etc/web-gpu-cpu has gpucomp's CPU path composite,
+// SD:/etc/web-gpu-copy has the frame composited into a buffer of gpucomp's and copied into the
+// surface (the environment variables ONYX_WEB_GPU_CPU / ONYX_WEB_GPU_COPY say the same).
+static bool testSwitch(const char* variable, const char* file)
+{
+    if (const char* value = getenv(variable); value && *value && *value != '0')
+        return true;
+    return !access(file, F_OK);
+}
+
+LayerTreeHost::LayerTreeHost(WebPage& webPage, FrameCallback&& frameCallback)
+    : m_webPage(webPage)
+    , m_frameCallback(WTF::move(frameCallback))
+    , m_renderTimer(*this, &LayerTreeHost::renderTimerFired)
+{
+    m_layerTreeContext.contextID = reinterpret_cast<uint64_t>(this);
+
+    gpc_config configuration = { allocateForCompositor, freeForCompositor, 0 };
+    if (testSwitch("ONYX_WEB_GPU_CPU", "SD:/etc/web-gpu-cpu"))
+        configuration.flags |= GPC_F_CPU;
+    m_compositor = gpc_create(&configuration);
+    m_compositesIntoSurface = !testSwitch("ONYX_WEB_GPU_COPY", "SD:/etc/web-gpu-copy");
+    m_logsLayerTree = testSwitch("ONYX_WEB_GPU_DEBUG", "SD:/etc/web-gpu-debug");
+
+    auto& size = m_webPage.size();
+    if (m_compositor)
+        logLine("compositing on (%d x %d), backend %s: %s", size.width(), size.height(), gpc_backend(m_compositor) == GPC_BACKEND_GPU ? "GPU" : "CPU", gpc_info(m_compositor));
+    else
+        logLine("compositing on (%d x %d), but no compositor (gpc_create failed): nothing will be shown", size.width(), size.height());
+
+    m_rootLayer = GraphicsLayerOnyx::create(GraphicsLayer::Type::Normal, *this, this);
+#ifndef NDEBUG
+    m_rootLayer->setName(MAKE_STATIC_STRING_IMPL("LayerTreeHost root layer"));
+#endif
+    m_rootLayer->setSize(size);
+
+    m_statisticsStartTime = MonotonicTime::now();
+}
+
+LayerTreeHost::~LayerTreeHost()
+{
+    m_renderTimer.stop();
+
+    // The layers may live longer than this (the render tree's): they draw nothing from now on.
+    for (auto* layer : copyToVector(m_layers))
+        layer->detachFromHost();
+    m_layers.clear();
+    m_rootLayer = nullptr;
+
+    if (m_compositor) {
+        if (m_copyTarget)
+            gpc_target_free(m_compositor, m_copyTarget);
+        gpc_destroy(m_compositor); // (its textures too)
+    }
+    logLine("compositing off (%u frames composited in all)", m_totalFramesComposited);
+}
+
+void LayerTreeHost::setLayerTreeStateIsFrozen(bool isFrozen)
+{
+    if (m_layerTreeStateIsFrozen == isFrozen)
+        return;
+    m_layerTreeStateIsFrozen = isFrozen;
+    if (!isFrozen)
+        scheduleRenderingUpdate();
+}
+
+void LayerTreeHost::scheduleRenderingUpdate()
+{
+    if (m_isSuspended || m_layerTreeStateIsFrozen)
+        return;
+
+    auto now = MonotonicTime::now();
+    if (m_isWaitingForDidRefresh) {
+        if (now - m_lastFrameTime < didRefreshTimeout) {
+            m_scheduledWhileWaitingForDidRefresh = true;
+            return;
+        }
+        m_isWaitingForDidRefresh = false;
+    }
+
+    if (m_renderTimer.isActive())
+        return;
+
+    // One composite at most for a refresh of the display.
+    auto sinceLastFrame = now - m_lastFrameTime;
+    m_renderTimer.startOneShot(sinceLastFrame < frameInterval ? frameInterval - sinceLastFrame : 0_s);
+}
+
+void LayerTreeHost::displayDidRefresh()
+{
+    m_isWaitingForDidRefresh = false;
+    if (!std::exchange(m_scheduledWhileWaitingForDidRefresh, false))
+        return;
+    scheduleRenderingUpdate();
+}
+
+void LayerTreeHost::setRootCompositingLayer(GraphicsLayer* graphicsLayer)
+{
+    if (m_rootCompositingLayer == graphicsLayer)
+        return;
+
+    m_rootCompositingLayer = graphicsLayer;
+    m_rootLayer->removeAllChildren();
+    if (m_rootCompositingLayer)
+        m_rootLayer->addChild(Ref { *m_rootCompositingLayer });
+    if (m_overlayCompositingLayer)
+        m_rootLayer->addChild(Ref { *m_overlayCompositingLayer });
+    logLine(graphicsLayer ? "the page's root layer is attached" : "the page's root layer is detached");
+    m_needsFullFrame = true;
+    scheduleRenderingUpdate();
+}
+
+void LayerTreeHost::setViewOverlayRootLayer(GraphicsLayer* graphicsLayer)
+{
+    if (m_overlayCompositingLayer == graphicsLayer)
+        return;
+
+    m_overlayCompositingLayer = graphicsLayer;
+    m_rootLayer->removeAllChildren();
+    if (m_rootCompositingLayer)
+        m_rootLayer->addChild(Ref { *m_rootCompositingLayer });
+    if (m_overlayCompositingLayer)
+        m_rootLayer->addChild(Ref { *m_overlayCompositingLayer });
+    m_needsFullFrame = true;
+    scheduleRenderingUpdate();
+}
+
+void LayerTreeHost::updateRenderingWithForcedRepaint()
+{
+    m_needsFullFrame = true;
+    m_renderTimer.stop();
+    renderFrame();
+}
+
+void LayerTreeHost::updateRenderingWithForcedRepaintAsync(CompletionHandler<void()>&& completionHandler)
+{
+    updateRenderingWithForcedRepaint();
+    completionHandler();
+}
+
+void LayerTreeHost::sizeDidChange()
+{
+    m_rootLayer->setSize(m_webPage.size());
+    m_needsFullFrame = true;
+    scheduleRenderingUpdate();
+}
+
+void LayerTreeHost::pauseRendering()
+{
+    m_isSuspended = true;
+    m_renderTimer.stop();
+}
+
+void LayerTreeHost::resumeRendering()
+{
+    m_isSuspended = false;
+    m_needsFullFrame = true;
+    scheduleRenderingUpdate();
+}
+
+void LayerTreeHost::backgroundColorDidChange()
+{
+    m_needsFullFrame = true;
+    scheduleRenderingUpdate();
+}
+
+void LayerTreeHost::setSurface(uint32_t surfaceID)
+{
+    int width = 0;
+    int height = 0;
+    auto* pixels = onyx_surface_map(surfaceID, &width, &height);
+    if (!pixels) {
+        logLine("surface %u cannot be mapped: nothing will be shown", surfaceID);
+        return;
+    }
+
+    if (m_copyTarget && IntSize { width, height } != m_surfaceSize) {
+        gpc_target_free(m_compositor, m_copyTarget);
+        m_copyTarget = nullptr;
+    }
+    if (surfaceID != m_surfaceID)
+        logLine("target: surface %u (%d x %d)", surfaceID, width, height);
+    m_surfaceID = surfaceID;
+    m_surfacePixels = pixels;
+    m_surfaceSize = { width, height };
+    m_targetPathLogged = false;
+
+    // (A frame the UI process had of another surface is not waited for.)
+    m_isWaitingForDidRefresh = false;
+    m_needsFullFrame = true;
+    scheduleRenderingUpdate();
+}
