+GraphicsLayerOnyx::~GraphicsLayerOnyx()
+{
+    dropTiles();
+    if (m_host)
+        m_host->layerDestroyed(*this);
+    willBeDestroyed();
+}
+
+void GraphicsLayerOnyx::detachFromHost()
+{
+    m_host = nullptr;
+    m_tiles.clear();
+}
+
+void GraphicsLayerOnyx::noteLayerPropertyChanged(ScheduleFlush scheduleFlush)
+{
+    if (!m_host || beingDestroyed())
+        return;
+    // (A change that asks for no flush is seen by the host's next walk anyway.)
+    if (scheduleFlush == ScheduleFlush::No)
+        return;
+    // (Nor one made during a flush: the walk comes right after it.)
+    if (m_hasUncommittedChanges || client().isFlushingLayers())
+        return;
+    m_hasUncommittedChanges = true;
+    client().notifyFlushRequired(this);
+}
+
+void GraphicsLayerOnyx::setNeedsDisplay()
+{
+    setNeedsDisplayInRect({ { }, m_size }, ShouldClipToLayer::Clip);
+}
+
+void GraphicsLayerOnyx::setNeedsDisplayInRect(const FloatRect& rect, ShouldClipToLayer)
+{
+    if (!m_host || !drawsContent())
+        return;
+
+    auto dirtyRect = enclosingIntRect(rect);
+    for (auto& tile : m_tiles.values())
+        tile.dirtyRect.unite(intersection(dirtyRect, tile.rect));
+    noteLayerPropertyChanged();
+    addRepaintRect(rect);
+}
