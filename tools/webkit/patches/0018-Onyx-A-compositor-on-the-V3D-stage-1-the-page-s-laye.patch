+Ref<GraphicsLayer> LayerTreeHost::createGraphicsLayer(GraphicsLayerType type, GraphicsLayerClient& client)
+{
+    return GraphicsLayerOnyx::create(type, client, this);
+}
+
+void LayerTreeHost::layerCreated(GraphicsLayerOnyx& layer)
+{
+    m_layers.add(&layer);
+}
+
+void LayerTreeHost::layerDestroyed(GraphicsLayerOnyx& layer)
+{
+    m_layers.remove(&layer);
+}
+
+GraphicsLayerOnyxHost::Texture LayerTreeHost::createTileTexture(const IntSize& size, const uint32_t* pixels, int stride)
+{
+    if (!m_compositor)
+        return nullptr;
+    if (m_textureCount >= maximumTileTextures) {
+        if (!m_textureBudgetLogged) {
+            m_textureBudgetLogged = true;
+            logLine("the texture budget is reached (%u tiles): the tiles past it are not drawn", m_textureCount);
+        }
+        return nullptr;
+    }
+
+    auto startTime = MonotonicTime::now();
+    auto* texture = gpc_tex_create(m_compositor, size.width(), size.height(), pixels, stride);
+    m_uploadTime += MonotonicTime::now() - startTime;
+    if (texture)
+        ++m_textureCount;
+    return texture;
+}
+
+bool LayerTreeHost::updateTileTexture(Texture texture, const IntRect& rect, const uint32_t* pixels, int stride)
+{
+    if (!m_compositor)
+        return false;
+
+    auto startTime = MonotonicTime::now();
+    int result = gpc_tex_update(m_compositor, static_cast<gpc_tex*>(texture), rect.x(), rect.y(), rect.width(), rect.height(), pixels, stride);
+    m_uploadTime += MonotonicTime::now() - startTime;
+    if (result == GPC_LOST)
+        m_texturesWereLost = true;
+    return result == GPC_OK;
+}
+
+void LayerTreeHost::destroyTileTexture(Texture texture)
+{
+    if (!m_compositor || !texture)
+        return;
+    gpc_tex_destroy(m_compositor, static_cast<gpc_tex*>(texture));
+    if (m_textureCount)
+        --m_textureCount;
+}
+
+gpc_tex* LayerTreeHost::textureForColor(uint32_t premultipliedARGB)
+{
+    for (auto& entry : m_colorTextures) {
+        if (entry.first == premultipliedARGB)
+            return entry.second;
+    }
+    auto* texture = gpc_tex_create(m_compositor, 1, 1, &premultipliedARGB, 1);
+    if (texture)
+        m_colorTextures.append({ premultipliedARGB, texture });
+    return texture;
+}
+
+void LayerTreeHost::appendQuad(gpc_tex* texture, const TransformationMatrix& layerToTarget, const FloatRect& rect, const WalkState& state, float opacity, bool opaque)
+{
+    int textureWidth = 0;
+    int textureHeight = 0;
+    gpc_tex_size(texture, &textureWidth, &textureHeight);
+    if (textureWidth <= 0 || textureHeight <= 0 || rect.isEmpty())
+        return;
+
+    // gpucomp's layer space is the texture's rectangle: texels -> the layer's rectangle -> the target.
+    // (Of a transform that is not affine, its 2D affine part.)
+    auto transform = layerToTarget.toAffineTransform();
+    transform.translate(rect.x(), rect.y());
+    bool isScaled = rect.width() != textureWidth || rect.height() != textureHeight;
+    if (isScaled)
+        transform.scale(rect.width() / textureWidth, rect.height() / textureHeight);
+
+    auto targetRect = enclosingIntRect(transform.mapRect(FloatRect { 0, 0, static_cast<float>(textureWidth), static_cast<float>(textureHeight) }));
+    if (!targetRect.intersects(state.clip))
+        return;
+
+    unsigned alpha = clampTo<unsigned>(lroundf(opacity * 255), 0, 255);
+    if (!alpha)
+        return;
+
+    gpc_layer layer;
+    memset(&layer, 0, sizeof(layer));
+    gpc_layer_init(&layer, texture);
+    layer.m = { static_cast<float>(transform.a()), static_cast<float>(transform.b()), static_cast<float>(transform.c()), static_cast<float>(transform.d()), static_cast<float>(transform.e()), static_cast<float>(transform.f()) };
+    bool isTranslation = transform.a() == 1 && !transform.b() && !transform.c() && transform.d() == 1;
+    if (isTranslation) {
+        // A scrolled page: whole pixels, the texels as they are.
+        layer.m.e = roundf(layer.m.e);
+        layer.m.f = roundf(layer.m.f);
+    }
+    if (isTranslation || isScaled)
+        layer.flags |= GPC_L_NEAREST;
+    if (opaque && alpha == 255)
+        layer.flags |= GPC_L_OPAQUE;
+    layer.opacity = alpha;
+    if (!state.clip.contains(targetRect)) {
+        layer.clip[0] = state.clip.x();
+        layer.clip[1] = state.clip.y();
+        layer.clip[2] = state.clip.width();
+        layer.clip[3] = state.clip.height();
+    }
+    m_frameLayers.append(layer);
+}
+
+void LayerTreeHost::appendColorQuad(const Color& color, const TransformationMatrix& layerToTarget, const FloatRect& rect, const WalkState& state, float opacity)
+{
+    if (!color.isVisible() || rect.isEmpty())
+        return;
+
+    auto components = color.toColorTypeLossy<SRGBA<uint8_t>>().resolved();
+    unsigned alpha = components.alpha;
+    auto premultiply = [alpha](unsigned component) {
+        return (component * alpha + 127) / 255;
+    };
+    uint32_t pixel = (alpha << 24) | (premultiply(components.red) << 16) | (premultiply(components.green) << 8) | premultiply(components.blue);
+    if (auto* texture = textureForColor(pixel))
+        appendQuad(texture, layerToTarget, rect, state, opacity, alpha == 255);
+}
+
+void LayerTreeHost::walkLayer(GraphicsLayerOnyx& layer, const WalkState& parentState)
+{
+    if (m_logsLayers) {
+        logLine("layer %p: at %.0f,%.0f %.0f x %.0f, bounds origin %.0f,%.0f, opacity %.2f%s%s%s%s, %u children, %u tiles", &layer, layer.position().x(), layer.position().y(), layer.size().width(), layer.size().height(),
+            layer.boundsOrigin().x(), layer.boundsOrigin().y(), layer.opacity(), layer.drawsContent() ? ", draws content" : "", layer.contentsAreVisible() ? "" : ", contents hidden",
+            layer.masksToBounds() ? ", masks to bounds" : "", layer.hasNonIdentityTransform() ? ", transform" : "", static_cast<unsigned>(layer.children().size()), static_cast<unsigned>(layer.tiles().size()));
+    }
+
+    float opacity = parentState.opacity * clampTo<float>(layer.opacity(), 0, 1);
+    if (opacity <= 0)
+        return;
+
+    // The layer's own space -> the target: its place in its parent, its transform about its anchor.
+    auto& size = layer.size();
+    FloatPoint3D anchor = layer.anchorPoint();
+    anchor.scale(size.width(), size.height(), 1);
+
+    WalkState state { parentState.toTarget, parentState.clip, opacity };
+    state.toTarget.translate(layer.position().x(), layer.position().y());
+    if (layer.hasNonIdentityTransform()) {
+        state.toTarget.translate3d(anchor.x(), anchor.y(), anchor.z());
+        state.toTarget.multiply(layer.transform());
+        state.toTarget.translate3d(-anchor.x(), -anchor.y(), -anchor.z());
+    }
+
+    FloatRect bounds { { }, size };
+    if (layer.masksToBounds()) {
+        // (The clip is a rectangle of the target: of a rotated layer, its bounding box.)
+        state.clip.intersect(enclosingIntRect(state.toTarget.mapRect(bounds)));
+        if (state.clip.isEmpty())
+            return;
+    }
+
+    bool drawsSelf = layer.contentsAreVisible() && (layer.backfaceVisibility() || !state.toTarget.isBackFaceVisible());
+    if (drawsSelf) {
+        appendColorQuad(layer.backgroundColor(), state.toTarget, bounds, state, opacity);
+
+        // What is seen of the layer, in its own coordinates: its tiles follow it (a layer that draws
+        // no content keeps none).
+        auto affine = state.toTarget.toAffineTransform();
+        IntRect visibleRect = enclosingIntRect(bounds);
+        if (auto inverse = affine.inverse())
+            visibleRect.intersect(enclosingIntRect(inverse->mapRect(FloatRect { state.clip })));
+
+        GraphicsLayerOnyx::TileUpdate update;
+        layer.updateTiles(visibleRect, m_offscreenTileBudget, update);
+        m_tilesPainted += update.tilesPainted;
+        m_paintTime += update.paintTime;
+        m_hasPendingTiles |= update.hasPendingTiles;
+        if (m_logsLayerTree && update.tilesPainted) {
+            logLine("layer %p (%.0f x %.0f): %u tiles painted, %u of them again (visible %d,%d %d x %d)", &layer, size.width(), size.height(), update.tilesPainted, static_cast<unsigned>(update.repaintedRects.size()),
+                visibleRect.x(), visibleRect.y(), visibleRect.width(), visibleRect.height());
+        }
+        for (auto& rect : update.repaintedRects)
+            m_frameDamage.unite(intersection(enclosingIntRect(affine.mapRect(FloatRect { rect })), state.clip));
+
+        for (auto& tile : layer.tiles().values()) {
+            if (tile.texture)
+                appendQuad(static_cast<gpc_tex*>(tile.texture), state.toTarget, tile.rect, state, opacity, layer.contentsOpaque());
+        }
+
+        appendColorQuad(layer.solidColor(), state.toTarget, layer.contentsRect(), state, opacity);
+    } else
+        layer.dropTiles();
+
+    // Its children's space: the children transform about the same anchor, the bounds origin (what a
+    // scroll container is scrolled by).
+    if (layer.hasNonIdentityChildrenTransform()) {
+        state.toTarget.translate3d(anchor.x(), anchor.y(), anchor.z());
+        state.toTarget.multiply(layer.childrenTransform());
+        state.toTarget.translate3d(-anchor.x(), -anchor.y(), -anchor.z());
+    }
+    state.toTarget.translate(-layer.boundsOrigin().x(), -layer.boundsOrigin().y());
+
+    // (Every layer of the tree is a GraphicsLayerOnyx: GraphicsLayer::create makes nothing else.)
+    for (auto& child : layer.children())
+        walkLayer(static_cast<GraphicsLayerOnyx&>(child.get()), state);
+}
+
+static bool layersAreEqual(const Vector<gpc_layer>& a, const Vector<gpc_layer>& b)
+{
+    if (a.size() != b.size())
+        return false;
+    for (size_t i = 0; i < a.size(); ++i) {
+        auto& first = a[i];
+        auto& second = b[i];
+        if (first.tex != second.tex || first.opacity != second.opacity || first.flags != second.flags || first.blend != second.blend
+            || first.src_x != second.src_x || first.src_y != second.src_y || first.src_w != second.src_w || first.src_h != second.src_h
+            || first.m.a != second.m.a || first.m.b != second.m.b || first.m.c != second.m.c || first.m.d != second.m.d || first.m.e != second.m.e || first.m.f != second.m.f
+            || first.clip[0] != second.clip[0] || first.clip[1] != second.clip[1] || first.clip[2] != second.clip[2] || first.clip[3] != second.clip[3])
+            return false;
+    }
+    return true;
+}
+
+void LayerTreeHost::texturesWereLost()
+{
+    // The GPU stopped: gpucomp goes on with the CPU, the textures that were on the GPU are empty
+    // until given again, whole.
+    logLine("the GPU's textures were lost (now %s): every tile is painted again", m_compositor ? gpc_info(m_compositor) : "-");
+    m_texturesWereLost = false;
+    for (auto* layer : m_layers)
+        layer->invalidateTiles();
+    for (auto& entry : m_colorTextures)
+        gpc_tex_destroy(m_compositor, entry.second);
+    m_colorTextures.clear();
+    m_previousFrameLayers.clear();
+    m_targetPathLogged = false;
+    m_needsFullFrame = true;
+}
+
+bool LayerTreeHost::compositeFrame(const IntRect& damage)
+{
+    unsigned* pixels = m_surfacePixels;
+    int stride = m_surfaceSize.width();
+    if (!m_compositesIntoSurface) {
+        if (!m_copyTarget)
+            m_copyTarget = gpc_target_alloc(m_compositor, m_surfaceSize.width(), m_surfaceSize.height(), &m_copyTargetStride);
+        if (!m_copyTarget) {
+            logLine("no buffer to composite into (%d x %d)", m_surfaceSize.width(), m_surfaceSize.height());
+            return false;
+        }
+        pixels = m_copyTarget;
+        stride = m_copyTargetStride;
+    }
+
+    // The damaged rectangle only: a target of that rectangle, the layers moved by its corner.
+    gpc_target target = { pixels + static_cast<size_t>(damage.y()) * stride + damage.x(), damage.width(), damage.height(), stride, 0 };
+    const gpc_layer* layers = m_frameLayers.span().data();
+    Vector<gpc_layer> movedLayers;
+    if (damage.x() || damage.y()) {
+        movedLayers = m_frameLayers;
+        for (auto& layer : movedLayers) {
+            layer.m.e -= damage.x();
+            layer.m.f -= damage.y();
+            if (layer.clip[2] > 0) {
+                layer.clip[0] -= damage.x();
+                layer.clip[1] -= damage.y();
+            }
+        }
+        layers = movedLayers.span().data();
+    }
+
+    unsigned clearColor = 0xFFFFFF;
+    if (auto& backgroundColor = m_webPage.backgroundColor(); backgroundColor && backgroundColor->isVisible()) {
+        auto components = backgroundColor->toColorTypeLossy<SRGBA<uint8_t>>().resolved();
+        clearColor = (components.red << 16) | (components.green << 8) | components.blue;
+    }
+
+    auto startTime = MonotonicTime::now();
+    int result = gpc_composite(m_compositor, &target, layers, m_frameLayers.size(), clearColor, GPC_C_CLEAR);
+    m_compositeTime += MonotonicTime::now() - startTime;
+
+    if (result < 0) {
+        if (m_compositesIntoSurface) {
+            logLine("compositing into the surface failed (%d): through a buffer of gpucomp's from now on", result);
+            m_compositesIntoSurface = false;
+            m_targetPathLogged = false;
+            return compositeFrame(damage);
+        }
+        logLine("compositing failed (%d)", result);
+        return false;
+    }
+    if (result == GPC_LOST) {
+        m_texturesWereLost = true;
+        return false;
+    }
+
+    if (!m_compositesIntoSurface) {
+        for (int y = damage.y(); y < damage.maxY(); ++y)
+            memcpy(m_surfacePixels + static_cast<size_t>(y) * m_surfaceSize.width() + damage.x(), m_copyTarget + static_cast<size_t>(y) * m_copyTargetStride + damage.x(), damage.width() * sizeof(unsigned));
+    }
+
+    if (!m_targetPathLogged) {
+        m_targetPathLogged = true;
+        gpc_stats statistics;
+        gpc_get_stats(m_compositor, &statistics);
+        logLine("target path: %s; the first frame: %u layers, %u GPU calls, %u layers by the CPU, %u us", m_compositesIntoSurface ? "straight into the surface" : "a gpucomp buffer copied into the surface",
+            static_cast<unsigned>(m_frameLayers.size()), statistics.last_gpu_calls, statistics.last_cpu_layers, statistics.last_us);
+    }
+    return true;
+}
+
+void LayerTreeHost::renderTimerFired()
+{
+    renderFrame();
+}
+
+void LayerTreeHost::renderFrame()
+{
+    if (m_isSuspended || m_layerTreeStateIsFrozen)
+        return;
+
+    m_lastFrameTime = MonotonicTime::now();
+
+    Ref webPage = m_webPage;
+    webPage->updateRendering();
+    // (The frames' layers are flushed there: Page::finalizeRenderingUpdate.)
+    webPage->finalizeRenderingUpdate({ });
+    webPage->flushPendingEditorStateUpdate();
+
+    m_rootLayer->flushCompositingStateForThisLayerOnly();
+    if (m_overlayCompositingLayer)
+        m_overlayCompositingLayer->flushCompositingState(FloatRect { { }, m_rootLayer->size() });
+
+    IntRect viewRect { { }, webPage->size() };
+    viewRect.intersect(IntRect { { }, m_surfaceSize });
+    if (!m_compositor || !m_surfacePixels || viewRect.isEmpty()) {
+        webPage->didUpdateRendering();
+        return;
+    }
+
+    if (m_colorTextures.size() > maximumColorTextures) {
+        for (auto& entry : m_colorTextures)
+            gpc_tex_destroy(m_compositor, entry.second);
+        m_colorTextures.clear();
+        m_previousFrameLayers.clear();
+    }
+
+    m_frameLayers.shrink(0);
+    m_frameDamage = { };
+    m_hasPendingTiles = false;
+    m_offscreenTileBudget = offscreenTilesPerFrame;
+    // (SD:/etc/web-gpu-debug: the layer tree in the log, for the first walks and whenever the number
+    // of layers drawn changed.)
+    m_logsLayers = m_logsLayerTree && (m_loggedLayerCount != m_previousFrameLayers.size() || m_loggedWalks < 5);
+    if (m_logsLayers) {
+        ++m_loggedWalks;
+        m_loggedLayerCount = m_previousFrameLayers.size();
+        logLine("the layer tree (view %d x %d, %u layers drawn last):", viewRect.width(), viewRect.height(), static_cast<unsigned>(m_loggedLayerCount));
+    }
+    walkLayer(*m_rootLayer, WalkState { { }, viewRect, 1 });
+    m_logsLayers = false;
+
+    if (m_texturesWereLost) {
+        texturesWereLost();
+        webPage->didUpdateRendering();
+        scheduleRenderingUpdate();
+        return;
+    }
+
+    if (m_needsFullFrame || !layersAreEqual(m_frameLayers, m_previousFrameLayers))
+        m_frameDamage = viewRect;
+    m_frameDamage.intersect(viewRect);
+
+    if (!m_frameDamage.isEmpty()) {
+        if (compositeFrame(m_frameDamage)) {
+            m_needsFullFrame = false;
+            m_previousFrameLayers = m_frameLayers;
+            ++m_framesComposited;
+            ++m_totalFramesComposited;
+            m_isWaitingForDidRefresh = true;
+            m_scheduledWhileWaitingForDidRefresh = false;
+            m_frameCallback(viewRect.size(), m_frameDamage);
+        } else if (m_texturesWereLost) {
+            texturesWereLost();
+            scheduleRenderingUpdate();
+        }
+    }
+
+    webPage->didUpdateRendering();
+
+    // The tiles around the visible ones that are still to paint: in the next frames.
+    if (m_hasPendingTiles)
+        scheduleRenderingUpdate();
+
+    logStatisticsIfNeeded();
+}
+
+void LayerTreeHost::logStatisticsIfNeeded()
+{
+    auto now = MonotonicTime::now();
+    auto elapsed = now - m_statisticsStartTime;
+    if (elapsed < statisticsInterval)
+        return;
+
+    if (m_framesComposited || m_tilesPainted) {
+        gpc_stats statistics;
+        gpc_get_stats(m_compositor, &statistics);
+        logLine("%.1f s: %u frames, %u tiles painted, paint %.0f ms, upload %.0f ms, composite %.0f ms; %u textures, %u layers (last frame: %u GPU calls, %u layers by the CPU)",
+            elapsed.seconds(), m_framesComposited, m_tilesPainted, m_paintTime.milliseconds(), m_uploadTime.milliseconds(), m_compositeTime.milliseconds(),
+            m_textureCount + static_cast<unsigned>(m_colorTextures.size()), static_cast<unsigned>(m_frameLayers.size()), statistics.last_gpu_calls, statistics.last_cpu_layers);
+    }
+    m_statisticsStartTime = now;
+    m_framesComposited = 0;
+    m_tilesPainted = 0;
+    m_paintTime = { };
+    m_uploadTime = { };
+    m_compositeTime = { };
+}
