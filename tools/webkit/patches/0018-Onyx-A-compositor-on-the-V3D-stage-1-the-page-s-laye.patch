+void GraphicsLayerOnyx::flushCompositingState(const FloatRect& visibleRect)
+{
+    // The host reads the layers' properties where they are when it walks the tree (the same thread):
+    // a flush only says that it has seen them. Every layer of a tree is a GraphicsLayerOnyx
+    // (GraphicsLayer::create makes nothing else).
+    flushCompositingStateForThisLayerOnly();
+    if (auto* mask = maskLayer())
+        mask->flushCompositingState(visibleRect);
+    for (auto& child : children())
+        child->flushCompositingState(visibleRect);
+}
+
+void GraphicsLayerOnyx::flushCompositingStateForThisLayerOnly()
+{
+    m_hasUncommittedChanges = false;
+}
+
+void GraphicsLayerOnyx::destroyTile(Tile& tile)
+{
+    if (tile.texture && m_host)
+        m_host->destroyTileTexture(tile.texture);
+    tile.texture = nullptr;
+}
+
+void GraphicsLayerOnyx::dropTiles()
+{
+    for (auto& tile : m_tiles.values())
+        destroyTile(tile);
+    m_tiles.clear();
+}
+
+void GraphicsLayerOnyx::invalidateTiles()
+{
+    for (auto& tile : m_tiles.values())
+        tile.dirtyRect = tile.rect;
+}
+
+bool GraphicsLayerOnyx::paintTile(Tile& tile, TileUpdate& update)
+{
+    // One scratch buffer for every tile of every layer (the main thread): the pixels live in the
+    // host's textures, not here.
+    static NeverDestroyed<Vector<uint32_t>> scratch;
+
+    bool isNew = !tile.texture;
+    auto dirtyRect = isNew ? tile.rect : intersection(tile.dirtyRect, tile.rect);
+    if (dirtyRect.isEmpty()) {
+        tile.dirtyRect = { };
+        return true;
+    }
+
+    size_t pixelCount = static_cast<size_t>(dirtyRect.width()) * dirtyRect.height();
+    auto& pixels = scratch.get();
+    if (pixels.size() < pixelCount)
+        pixels.grow(pixelCount);
+    zeroSpan(pixels.mutableSpan().first(pixelCount));
+
+    auto startTime = MonotonicTime::now();
+    {
+        // 0xAARRGGBB words, premultiplied: gpucomp's texels.
+        auto info = SkImageInfo::Make(dirtyRect.width(), dirtyRect.height(), kBGRA_8888_SkColorType, kPremul_SkAlphaType, SkColorSpace::MakeSRGB());
+        SkSurfaceProps properties = FontRenderOptions::singleton().createSurfaceProps();
+        auto surface = SkSurfaces::WrapPixels(info, pixels.mutableSpan().data(), info.minRowBytes(), &properties);
+        if (!surface || !surface->getCanvas())
+            return false;
+        GraphicsContextSkia context(*surface->getCanvas(), RenderingMode::Unaccelerated, RenderingPurpose::LayerBacking);
+        context.translate(-dirtyRect.x(), -dirtyRect.y());
+        paintGraphicsLayerContents(context, dirtyRect);
+    }
+    update.paintTime += MonotonicTime::now() - startTime;
+    update.tilesPainted++;
+
+    if (isNew) {
+        tile.texture = m_host->createTileTexture(tile.rect.size(), pixels.span().data(), dirtyRect.width());
+        if (!tile.texture)
+            return false;
+    } else {
+        IntRect rectInTile { dirtyRect.location() - toIntSize(tile.rect.location()), dirtyRect.size() };
+        if (!m_host->updateTileTexture(tile.texture, rectInTile, pixels.span().data(), dirtyRect.width()))
+            return false;
+        update.repaintedRects.append(dirtyRect);
+    }
+    tile.dirtyRect = { };
+    return true;
+}
+
+void GraphicsLayerOnyx::updateTiles(const IntRect& passedVisibleRect, unsigned& offscreenBudget, TileUpdate& update)
+{
+    if (!m_host)
+        return;
+
+    IntRect layerRect { { }, expandedIntSize(m_size) };
+    auto visibleRect = intersection(passedVisibleRect, layerRect);
+    if (!drawsContent() || !contentsAreVisible() || visibleRect.isEmpty()) {
+        // (A layer out of sight keeps nothing: its tiles are painted when it comes back.)
+        dropTiles();
+        return;
+    }
+
+    // One viewport above, two below: where a page is scrolled next.
+    auto coverageRect = visibleRect;
+    coverageRect.setY(visibleRect.y() - visibleRect.height());
+    coverageRect.setHeight(visibleRect.height() * 4);
+    coverageRect.intersect(layerRect);
+
+    auto tileRange = [](const IntRect& rect) {
+        int x = rect.x() / tileSize;
+        int y = rect.y() / tileSize;
+        int maxX = (rect.maxX() + tileSize - 1) / tileSize;
+        int maxY = (rect.maxY() + tileSize - 1) / tileSize;
+        return IntRect { x, y, maxX - x, maxY - y };
+    };
+    auto covered = tileRange(coverageRect);
+
+    m_tiles.removeIf([&](auto& entry) {
+        auto& tile = entry.value;
+        if (covered.contains(IntPoint { tile.rect.x() / tileSize, tile.rect.y() / tileSize }))
+            return false;
+        destroyTile(tile);
+        return true;
+    });
+
+    for (int y = covered.y(); y < covered.maxY(); ++y) {
+        for (int x = covered.x(); x < covered.maxX(); ++x) {
+            auto rect = rectForTile(x, y);
+            if (rect.isEmpty())
+                continue;
+            auto& tile = m_tiles.ensure(tileKey(x, y), [&] {
+                return Tile { rect, rect, nullptr };
+            }).iterator->value;
+            if (tile.texture && tile.dirtyRect.isEmpty())
+                continue;
+            if (!tile.rect.intersects(visibleRect)) {
+                if (!offscreenBudget) {
+                    update.hasPendingTiles = true;
+                    continue;
+                }
+                --offscreenBudget;
+            }
+            paintTile(tile, update);
+        }
+    }
+}
+
