+// The kernel's shared surfaces (kapi surface_create / surface_map, Onyx's docs/02): pixel buffers,
+// physically contiguous, that several processes map -- where the web process's compositor leaves a
+// page's picture and the UI process reads it. The kernel's calls are reached through the Onyx
+// sources' kapi.h, which is not a header for these files: the program WebKit is linked into brings
+// these few functions (tools/webkit/onyxsurface.c of the Onyx sources), as it brings gpucomp.
+extern "C" {
+
+// The screen's size now (a surface is never larger).
+void onyx_screen_size(int* width, int* height);
+// A surface owned by this process -> its id (> 0), 0 none. The kernel frees it once the owner has
+// destroyed it (or ended) and the processes that mapped it have ended.
+int onyx_surface_create(int width, int height);
+// Its pixels in this process (0x00RRGGBB words, a row is its width) and its size -> null: no such
+// surface. Mapped once a process, however often it is asked.
+unsigned* onyx_surface_map(int surfaceID, int* width, int* height);
+void onyx_surface_destroy(int surfaceID);
+
+}
