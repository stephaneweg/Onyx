+    void setSize(const FloatSize&) final;
+    void setBoundsOrigin(const FloatPoint&) final;
+    void syncBoundsOrigin(const FloatPoint&) final;
+    void setTransform(const TransformationMatrix&) final;
+    void setChildrenTransform(const TransformationMatrix&) final;
+    void setPreserves3D(bool) final;
+    void setMasksToBounds(bool) final;
+    void setDrawsContent(bool) final;
+    void setContentsVisible(bool) final;
+    void setContentsOpaque(bool) final;
+    void setBackfaceVisibility(bool) final;
+    void setBackgroundColor(const Color&) final;
+    void setOpacity(float) final;
+    bool setFilters(const FilterOperations&) final;
+    bool setBackdropFilters(const FilterOperations&) final;
+    void setContentsRect(const FloatRect&) final;
+    void setContentsToSolidColor(const Color&) final;
+    bool canDirectlyCompositeNativeImage() const final { return !m_host; }
+
+    void flushCompositingState(const FloatRect&) final;
+    void flushCompositingStateForThisLayerOnly() final;
+
+private:
+    GraphicsLayerOnyx(Type, GraphicsLayerClient&, GraphicsLayerOnyxHost*);
+
+    bool shouldRepaintOnSizeChange() const final;
+
+    enum class ScheduleFlush : bool { No, Yes };
+    void noteLayerPropertyChanged(ScheduleFlush = ScheduleFlush::Yes);
+
+    static uint64_t tileKey(int x, int y) { return (static_cast<uint64_t>(x + 1) << 32) | static_cast<uint32_t>(y + 1); }
+    IntRect rectForTile(int x, int y) const;
+    bool paintTile(Tile&, TileUpdate&);
+    void destroyTile(Tile&);
+
+    GraphicsLayerOnyxHost* m_host { nullptr };
+    HashMap<uint64_t, Tile> m_tiles;
+    Color m_solidColor;
+    bool m_hasUncommittedChanges { false };
+};
