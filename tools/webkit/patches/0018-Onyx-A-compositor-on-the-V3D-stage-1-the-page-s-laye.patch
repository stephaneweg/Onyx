+
+#include "config.h"
+#include "DrawingAreaProxyCoordinatedGraphics.h"
+
+#if USE(GRAPHICS_LAYER_ONYX)
+
+#include "DrawingAreaMessages.h"
+#include "MessageSenderInlines.h"
+#include "OnyxSurface.h"
+#include "WebPageProxy.h"
+#include <WebCore/Region.h>
+#include <skia/core/SkCanvas.h>
+#include <skia/core/SkPixmap.h>
+#include <stdio.h>
+#include <unistd.h>
+#include <wtf/NeverDestroyed.h>
+#include <wtf/Vector.h>
+
+// The UI process's side of Onyx's compositor (the web process's: LayerTreeHostOnyx). The page's
+// picture is in a kernel surface, shared memory that the web process's compositor (the GPU)
+// writes: this process makes the surface -- the screen's size, so that a view is resized without
+// another -- gives its id to the web process when that enters accelerated compositing mode, hears
+// of each frame (OnyxCompositedFrame: the view's size in the surface, what changed), has the view
+// painted and copies the rectangles asked for from the surface in paint(). The web process
+// composites its next frame once this one was painted (DisplayDidRefresh).
+//
+// The kernel keeps a surface's memory while its owner lives and a place in the address space for
+// each mapping, never given back: the surfaces are made once and reused by the drawing areas that
+// follow one another in this process (a page gets a new one with each web process).
+
+namespace WebKit {
+using namespace WebCore;
+
+struct OnyxSurface {
+    int surfaceID { 0 };
+    unsigned* pixels { nullptr };
+    IntSize size;
+};
+
+static Vector<OnyxSurface>& freeOnyxSurfaces()
+{
+    static NeverDestroyed<Vector<OnyxSurface>> surfaces;
+    return surfaces;
+}
+
+// A view the page never painted is given up after this long (the web process goes on).
+static constexpr Seconds frameShownTimeout { 100_ms };
+
+static void logLine(const char* message, int surfaceID, const IntSize& size)
+{
+    // One line, one write, on the standard error: the kernel's log (kmsg) for an Onyx program.
+    char line[160];
+    int length = snprintf(line, sizeof(line), "web: gpu: %s %d (%d x %d)\n", message, surfaceID, size.width(), size.height());
+    if (length > static_cast<int>(sizeof(line)) - 1)
+        length = sizeof(line) - 1;
+    if (length > 0)
+        (void)!write(STDERR_FILENO, line, length);
+}
+
+void DrawingAreaProxyCoordinatedGraphics::sendOnyxCompositingSurface(bool onlyIfReplaced)
+{
+    IntRect viewRect { { }, size() };
+    int screenWidth = 0;
+    int screenHeight = 0;
+    onyx_screen_size(&screenWidth, &screenHeight);
+
+    // A surface is as large as the screen at most (the kernel's rule): a view larger than its surface
+    // gets another only if the screen grew (its resolution changed); else what fits is shown.
+    bool needsSurface = !m_onyxSurfacePixels
+        || (!IntRect({ }, m_onyxSurfaceSize).contains(viewRect) && (screenWidth > m_onyxSurfaceSize.width() || screenHeight > m_onyxSurfaceSize.height()));
+    if (!needsSurface && onlyIfReplaced)
+        return;
+
+    if (needsSurface) {
+        releaseOnyxCompositingSurface();
+
+        auto& freeSurfaces = freeOnyxSurfaces();
+        for (size_t i = 0; i < freeSurfaces.size(); ++i) {
+            if (freeSurfaces[i].size.width() < screenWidth || freeSurfaces[i].size.height() < screenHeight)
+                continue;
+            m_onyxSurfaceID = freeSurfaces[i].surfaceID;
+            m_onyxSurfacePixels = freeSurfaces[i].pixels;
+            m_onyxSurfaceSize = freeSurfaces[i].size;
+            freeSurfaces.removeAt(i);
+            break;
+        }
+
+        if (!m_onyxSurfacePixels) {
+            int surfaceID = onyx_surface_create(std::max(screenWidth, viewRect.width()), std::max(screenHeight, viewRect.height()));
+            int width = 0;
+            int height = 0;
+            auto* pixels = surfaceID ? onyx_surface_map(surfaceID, &width, &height) : nullptr;
+            if (!pixels) {
+                logLine("the UI process has no surface for the page: nothing will be shown; id", surfaceID, viewRect.size());
+                if (surfaceID)
+                    onyx_surface_destroy(surfaceID);
+                return;
+            }
+            m_onyxSurfaceID = surfaceID;
+            m_onyxSurfacePixels = pixels;
+            m_onyxSurfaceSize = { width, height };
+            logLine("the UI process made surface", surfaceID, m_onyxSurfaceSize);
+        }
+        m_onyxFrameSize = { };
+    }
+
+    send(Messages::DrawingArea::SetOnyxCompositingSurface(m_onyxSurfaceID));
+}
+
+void DrawingAreaProxyCoordinatedGraphics::releaseOnyxCompositingSurface()
+{
+    m_onyxFrameShownTimer.stop();
+    m_onyxFrameIsPending = false;
+    if (m_onyxSurfacePixels)
+        freeOnyxSurfaces().append({ m_onyxSurfaceID, m_onyxSurfacePixels, m_onyxSurfaceSize });
+    m_onyxSurfaceID = 0;
+    m_onyxSurfacePixels = nullptr;
+    m_onyxSurfaceSize = { };
+    m_onyxFrameSize = { };
+}
+
+void DrawingAreaProxyCoordinatedGraphics::onyxCompositedFrame(const IntSize& frameSize, const IntRect& damage)
+{
+    if (!m_onyxSurfacePixels || !isInAcceleratedCompositingMode()) {
+        send(Messages::DrawingArea::DisplayDidRefresh(MonotonicTime::now()));
+        return;
+    }
+
+    bool sizeChanged = frameSize != m_onyxFrameSize;
+    m_onyxFrameSize = frameSize.shrunkTo(m_onyxSurfaceSize);
+
+    m_onyxFrameIsPending = true;
+    m_onyxFrameShownTimer.startOneShot(frameShownTimeout);
+
+    if (RefPtr page = this->page())
+        page->setViewNeedsDisplay(sizeChanged ? IntRect { { }, page->viewSize() } : damage);
+}
+
+void DrawingAreaProxyCoordinatedGraphics::onyxFrameWasShown()
+{
+    m_onyxFrameShownTimer.stop();
+    if (!std::exchange(m_onyxFrameIsPending, false))
+        return;
+    send(Messages::DrawingArea::DisplayDidRefresh(MonotonicTime::now()));
+}
+
+void DrawingAreaProxyCoordinatedGraphics::paintOnyxCompositedFrame(PlatformPaintContextPtr canvas, const IntRect& rect, Region& unpaintedRegion)
+{
+    SkPixmap pixmap;
+    if (m_onyxSurfacePixels && !m_onyxFrameSize.isEmpty() && canvas && canvas->peekPixels(&pixmap) && pixmap.info().bytesPerPixel() == 4) {
+        // The surface's pixels are 0x00RRGGBB (what the GPU leaves there); the embedder's are
+        // 0xAARRGGBB, opaque.
+        auto paintRect = intersection(rect, IntRect { { }, m_onyxFrameSize });
+        paintRect.intersect(IntRect { 0, 0, pixmap.width(), pixmap.height() });
+        for (int y = paintRect.y(); y < paintRect.maxY(); ++y) {
+            const unsigned* source = m_onyxSurfacePixels + static_cast<size_t>(y) * m_onyxSurfaceSize.width() + paintRect.x();
+            uint32_t* destination = pixmap.writable_addr32(paintRect.x(), y);
+            for (int x = 0; x < paintRect.width(); ++x)
+                destination[x] = source[x] | 0xFF000000u;
+        }
+        if (!paintRect.isEmpty())
+            unpaintedRegion.subtract(paintRect);
+    }
+
+    onyxFrameWasShown();
+}
+
+} // namespace WebKit
