+                menuItems.append(menuItem);
+            }
+            m_client.showPopupMenu(WebKit::toAPI(&view), menuItems.span().data(), static_cast<int>(menuItems.size()), selectedIndex, WebKit::toAPI(rect), m_client.base.clientInfo);
