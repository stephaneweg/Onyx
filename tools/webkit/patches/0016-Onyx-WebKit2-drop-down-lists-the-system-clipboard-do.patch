+
+void WKSetClipboardCallbacksOnyx(WKClipboardWriteTextOnyx write, WKClipboardReadTextOnyx read, WKClipboardSerialOnyx serial)
+{
+    // WebCore::PlatformPasteboard lives in this (the UI) process: the web processes reach it through
+    // WebPasteboardProxy (UIProcess/libwpe/WebPasteboardProxyLibWPE.cpp).
+    WebCore::setOnyxSystemClipboard(write, read, serial);
+}
+
+// The Referer a link followed from the page would carry, by the default policy
+// (strict-origin-when-cross-origin): the page's address on the same origin, its origin elsewhere, none
+// from https to http.
+static String referrerForDownload(const URL& pageURL, const URL& url)
+{
+    if (!pageURL.isValid() || !pageURL.protocolIsInHTTPFamily())
+        return { };
+    if (pageURL.protocolIs("https"_s) && !url.protocolIs("https"_s))
+        return { };
+    if (protocolHostAndPortAreEqual(pageURL, url)) {
+        auto referrer = pageURL;
+        referrer.removeCredentials();
+        referrer.removeFragmentIdentifier();
+        return referrer.string();
+    }
+    return makeString(pageURL.protocolHostAndPort(), '/');
+}
+
+void WKPageDownloadURLOnyx(WKPageRef pageRef, WKURLRef urlRef, const void* context, WKPageDownloadStartedOnyx started)
+{
+    Ref page = *WebKit::toImpl(pageRef);
+    URL url { WebKit::toImpl(urlRef)->string() };
+
+    WebCore::ResourceRequest request { URL { url } };
+    auto referrer = referrerForDownload(URL { page->currentURL() }, url);
+    if (!referrer.isEmpty())
+        request.setHTTPReferrer(referrer);
+    // The web process gives a page's loads their User-Agent; this one starts in the network process.
+    if (!page->userAgent().isEmpty())
+        request.setHTTPUserAgent(page->userAgent());
+
+    // The cookies come with the page's session (its website data store) in the network process.
+    page->downloadRequest(WTF::move(request), [context, started] (WebKit::DownloadProxy* download) {
+        if (started)
+            started(WebKit::toAPI(download), context);
+    });
+}
