+        bool showPopupMenu(WebKit::OnyxWebView& view, const Vector<WebKit::WebPopupItem>& items, int32_t selectedIndex, const WebCore::IntRect& rect) final
+        {
+            if (!m_client.showPopupMenu)
+                return false;
+
+            // The texts live until the call returns.
+            Vector<UTF8CString> texts;
+            texts.reserveInitialCapacity(items.size());
+            Vector<WKPopupMenuItemOnyx> menuItems;
+            menuItems.reserveInitialCapacity(items.size());
+            for (auto& item : items) {
+                bool isSeparator = item.m_type == WebKit::WebPopupItem::Type::Separator;
+                // (A CString's characters stay where they are when the vector grows: it holds a buffer.)
