-// The clipboard of the Onyx port, for now a clipboard of its own: what a page copies is kept in this
-// process (the UI process: the web processes reach it through WebPasteboardProxy) and can be pasted into
-// any page of the same browser, as text or as HTML. It is not Onyx's system clipboard yet: nothing copied
-// here reaches another program, and nothing copied elsewhere can be pasted here.
+// The clipboard of the Onyx port: what a page copies is kept in this process (the UI process: the web
+// processes reach it through WebPasteboardProxy) and can be pasted into any page of the same browser, as
+// text or as HTML.
 //
-// The system clipboard is the kernel's (kapi clipboard_set / clipboard_get, CLIP_TEXT: user/kapi.h of the
-// Onyx tree), and a program built on libonyxposix has no access to it: kapi.h is not in the POSIX
-// sysroot, and libonyxposix exports no clipboard function. What the binding needs: two functions in
-// libonyxposix, declared in a header of the sysroot, over those two kernel calls -- "set the clipboard's
-// plain text (UTF-8, a length)" and "get it (a buffer, its size, the clipboard's serial number)". With
-// them, write() below also gives the plain text to the system clipboard, and readString() / getTypes()
-// compare the system's serial with the one of our last write: when it differs another program has
-// copied something, which then replaces what is kept here (the HTML with it).
+// Onyx's system clipboard is the kernel's (kapi clipboard_set / clipboard_get), which only the embedder
+// reaches: it gives three functions with setOnyxSystemClipboard (WKSetClipboardCallbacksOnyx in WebKit's
+// C API). With them, a write that has plain text also gives that text to the system clipboard, and every
+// read first compares the system's serial with the one seen after our last write: when it differs,
+// another program has copied something, whose text then replaces what is kept here (the HTML with it).
 
 namespace WebCore {
 
@@ -57,10 +55,20 @@ struct OnyxClipboardEntry {
     String string;
 };
 
+struct OnyxSystemClipboard {
+    void (*write)(const char*, size_t) { nullptr };
+    size_t (*read)(char*, size_t) { nullptr };
+    unsigned (*serial)() { nullptr };
+};
+
 struct OnyxClipboardStore {
     Lock lock;
     Vector<OnyxClipboardEntry> items WTF_GUARDED_BY_LOCK(lock);
     int64_t changeCount WTF_GUARDED_BY_LOCK(lock) { 0 };
+    OnyxSystemClipboard system WTF_GUARDED_BY_LOCK(lock);
+    // The system's serial when its text was last the same as ours (after our write, or after reading it);
+    // none: the system's text has not been read yet.
+    std::optional<unsigned> systemSerial WTF_GUARDED_BY_LOCK(lock);
 };
 
 OnyxClipboardStore& onyxClipboardStore()
@@ -72,16 +80,88 @@ OnyxClipboardStore& onyxClipboardStore()
 constexpr auto onyxPlainTextType = "text/plain;charset=utf-8"_s;
 constexpr auto onyxHTMLTextType = "text/html"_s;
 
+bool isPlainTextType(const String& type)
+{
+    return type.startsWith("text/plain"_s);
+}
+
 // "text/plain" and "text/plain;charset=utf-8" name the same thing.
 bool isSameClipboardType(const String& a, const String& b)
 {
     if (a == b)
         return true;
-    return a.startsWith("text/plain"_s) && b.startsWith("text/plain"_s);
+    return isPlainTextType(a) && isPlainTextType(b);
+}
+
+String readSystemText(const OnyxSystemClipboard& system)
+{
+    // read() gives the text's full length, and copies what fits.
+    Vector<char> buffer(4096);
+    for (unsigned attempt = 0; attempt < 4; ++attempt) {
+        size_t length = system.read(buffer.mutableSpan().data(), buffer.size());
+        if (length < buffer.size()) {
+            auto bytes = buffer.span().first(length);
+            // (A text ends at its first NUL, if the embedder copies one.)
+            size_t end = bytes.size();
+            for (size_t i = 0; i < bytes.size(); ++i) {
+                if (!bytes[i]) {
+                    end = i;
+                    break;
+                }
+            }
+            // (Not UTF-8: read as Latin-1, rather than nothing.)
+            return String::fromUTF8WithLatin1Fallback(bytes.first(end));
+        }
+        // Too small (the text may have grown in between: try again).
+        buffer.grow(length + 1);
+    }
+    return String();
+}
+
+// Another program has copied since our last look: its text replaces ours.
+void synchronizeWithSystemClipboard(OnyxClipboardStore& clipboard) WTF_REQUIRES_LOCK(clipboard.lock)
+{
+    auto& system = clipboard.system;
+    if (!system.read || !system.serial)
+        return;
+
+    unsigned serial = system.serial();
+    if (clipboard.systemSerial && *clipboard.systemSerial == serial)
+        return;
+
+    auto text = readSystemText(system);
+    clipboard.systemSerial = serial;
+    clipboard.items.clear();
+    if (!text.isEmpty())
+        clipboard.items.append(OnyxClipboardEntry { onyxPlainTextType, WTF::move(text) });
+    clipboard.changeCount++;
+}
+
+// Our write gives its plain text to the system clipboard too. A write with no plain text (null) leaves
+// the system's text as it is, but what is kept here is now the newest: the system's present serial is
+// noted, so that its older text does not replace ours.
+void writeToSystemClipboard(OnyxClipboardStore& clipboard, const String& text) WTF_REQUIRES_LOCK(clipboard.lock)
+{
+    auto& system = clipboard.system;
+    if (system.write && !text.isNull()) {
+        auto utf8 = text.utf8();
+        auto characters = byteCast<char>(utf8.span());
+        system.write(characters.data(), characters.size());
+    }
+    if (system.serial)
+        clipboard.systemSerial = system.serial();
 }
 
 } // namespace
 
+void setOnyxSystemClipboard(void (*write)(const char* utf8, size_t length), size_t (*read)(char* buffer, size_t capacity), unsigned (*serial)(void))
+{
+    auto& clipboard = onyxClipboardStore();
+    Locker locker { clipboard.lock };
+    clipboard.system = { write, read, serial };
+    clipboard.systemSerial = std::nullopt;
+}
+
 PlatformPasteboard::PlatformPasteboard(const String&)
     : m_pasteboard(nullptr)
 {
@@ -101,6 +181,7 @@ int64_t PlatformPasteboard::changeCount() const
 {
     auto& clipboard = onyxClipboardStore();
     Locker locker { clipboard.lock };
+    synchronizeWithSystemClipboard(clipboard);
     return clipboard.changeCount;
 }
 
@@ -108,6 +189,7 @@ void PlatformPasteboard::getTypes(Vector<String>& types) const
 {
     auto& clipboard = onyxClipboardStore();
     Locker locker { clipboard.lock };
+    synchronizeWithSystemClipboard(clipboard);
     for (auto& item : clipboard.items)
         types.append(item.type);
 }
@@ -116,6 +198,7 @@ String PlatformPasteboard::readString(size_t, const String& type) const
 {
     auto& clipboard = onyxClipboardStore();
     Locker locker { clipboard.lock };
+    synchronizeWithSystemClipboard(clipboard);
     for (auto& item : clipboard.items) {
         if (isSameClipboardType(item.type, type))
             return item.string;
@@ -133,6 +216,7 @@ void PlatformPasteboard::write(const PasteboardWebContent& content)
     if (!content.markup.isNull())
         clipboard.items.append(OnyxClipboardEntry { onyxHTMLTextType, content.markup });
     clipboard.changeCount++;
+    writeToSystemClipboard(clipboard, content.text);
 }
 
 void PlatformPasteboard::write(const String& type, const String& string)
@@ -142,6 +226,7 @@ void PlatformPasteboard::write(const String& type, const String& string)
     clipboard.items.clear();
     clipboard.items.append(OnyxClipboardEntry { type, string });
     clipboard.changeCount++;
+    writeToSystemClipboard(clipboard, isPlainTextType(type) ? string : String());
 }
 
 Vector<String> PlatformPasteboard::typesSafeForDOMToReadAndWrite(const String&) const
