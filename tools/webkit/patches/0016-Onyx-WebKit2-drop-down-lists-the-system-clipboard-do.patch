+/* Onyx's system clipboard, which only the embedder reaches (its kernel calls). write: the plain text
+   copied in a page (UTF-8, a length, no NUL needed). read: copies up to capacity bytes of the system's
+   text into buffer and returns the text's full length (called again with a bigger buffer when it did not
+   fit). serial: a number that changes whenever any program copies. Called once, in the UI process, before
+   any page; the functions are then called on the UI thread. NULL functions: the clipboard stays inside
+   the browser. */
+typedef void (*WKClipboardWriteTextOnyx)(const char* utf8, size_t length);
+typedef size_t (*WKClipboardReadTextOnyx)(char* buffer, size_t capacity); /* -> the text's full length */
+typedef unsigned (*WKClipboardSerialOnyx)(void);
+WK_EXPORT void WKSetClipboardCallbacksOnyx(WKClipboardWriteTextOnyx write, WKClipboardReadTextOnyx read, WKClipboardSerialOnyx serial);
+
+typedef void (*WKPageDownloadStartedOnyx)(WKDownloadRef download, const void* context);
+/* Starts downloading url as the page would (its cookies, its referrer); started is called with the
+   download (the embedder then sets its WKDownloadClient: destination, progress, end), or with NULL when
+   the download could not start. */
+WK_EXPORT void WKPageDownloadURLOnyx(WKPageRef page, WKURLRef url, const void* context, WKPageDownloadStartedOnyx started);
+
 #ifdef __cplusplus
 }
 #endif
