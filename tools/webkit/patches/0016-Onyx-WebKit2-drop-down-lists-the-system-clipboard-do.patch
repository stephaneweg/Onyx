+#include "config.h"
+#include "WebPopupMenuProxyOnyx.h"
+
+#include "OnyxWebView.h"
+#include "WebPopupItem.h"
+#include <WebCore/IntRect.h>
+
+namespace WebKit {
+
+WebPopupMenuProxyOnyx::WebPopupMenuProxyOnyx(OnyxWebView& view, WebPopupMenuProxy::Client& client)
+    : WebPopupMenuProxy(client)
+    , m_view(&view)
+{
+}
+
+WebPopupMenuProxyOnyx::~WebPopupMenuProxyOnyx() = default;
+
+void WebPopupMenuProxyOnyx::showPopupMenu(const WebCore::IntRect& rect, WebCore::TextDirection, double, const Vector<WebPopupItem>& items, const PlatformPopupMenuData&, int32_t selectedIndex)
+{
+    // The rectangle is in the main frame view's coordinates, which are the view's on Onyx (the view
+    // itself never scrolls: the page does, inside it). The page scale factor is not applied, as GTK.
+    m_itemCount = items.size();
+    m_isShown = true;
+    if (!m_view || !m_view->showPopupMenu(*this, items, selectedIndex, rect)) {
+        // No embedder menu: WebCore must not stay with a list it thinks is open.
+        didSelectItem(-1);
+    }
+}
+
+void WebPopupMenuProxyOnyx::didSelectItem(int32_t index)
+{
+    if (!m_isShown)
+        return;
+    m_isShown = false;
+
+    if (index < 0 || static_cast<size_t>(index) >= m_itemCount)
+        index = -1;
+
+    Ref protectedThis { *this };
+    if (CheckedPtr client = this->client()) {
+        if (index >= 0)
+            client->setTextFromItemForPopupMenu(this, index);
+        // -1: the list closes with no change (WebPopupMenu::didChangeSelectedIndex).
+        client->valueChangedForPopupMenu(this, index);
+    }
+}
+
+void WebPopupMenuProxyOnyx::hidePopupMenu()
+{
+    // The page closes the list itself (or opens another): the embedder's menu goes, and an answer
+    // that arrives after this is ignored.
+    if (!m_isShown)
+        return;
+    m_isShown = false;
+    if (m_view)
+        m_view->hidePopupMenu(*this);
+}
+
+void WebPopupMenuProxyOnyx::cancelTracking()
+{
+    hidePopupMenu();
+}
+
+} // namespace WebKit
