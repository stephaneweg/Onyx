+#pragma once
+
+#include "WebPopupMenuProxy.h"
+
+namespace WebKit {
+
+class OnyxWebView;
+
+// The list of a <select>: Onyx's view draws no menu itself. The items go to the embedder (the view
+// client's showPopupMenu), which shows its own menu and answers later, from its loop, with
+// WKViewSelectPopupMenuItem (OnyxWebView::selectPopupMenuItem -> didSelectItem).
+class WebPopupMenuProxyOnyx final : public WebPopupMenuProxy {
+public:
+    static Ref<WebPopupMenuProxyOnyx> create(OnyxWebView& view, WebPopupMenuProxy::Client& client)
+    {
+        return adoptRef(*new WebPopupMenuProxyOnyx(view, client));
+    }
+    ~WebPopupMenuProxyOnyx();
+
+    void showPopupMenu(const WebCore::IntRect&, WebCore::TextDirection, double pageScaleFactor, const Vector<WebPopupItem>&, const PlatformPopupMenuData&, int32_t selectedIndex) final;
+    void hidePopupMenu() final;
+    void cancelTracking() final;
+
+    // The embedder's answer: an item's index, or -1 (cancelled).
+    void didSelectItem(int32_t index);
+    // The view is going away (the page may outlive it).
+    void detachView() { m_view = nullptr; }
+
+private:
+    WebPopupMenuProxyOnyx(OnyxWebView&, WebPopupMenuProxy::Client&);
+
+    OnyxWebView* m_view;
+    size_t m_itemCount { 0 };
+    bool m_isShown { false };
+};
+
+} // namespace WebKit
