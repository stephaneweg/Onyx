--- a/Source/WebCore/platform/onyx/PlatformPasteboardOnyx.cpp
+++ b/Source/WebCore/platform/onyx/PlatformPasteboardOnyx.cpp
@@ -29,24 +29,22 @@
 #if PLATFORM(ONYX)
 
