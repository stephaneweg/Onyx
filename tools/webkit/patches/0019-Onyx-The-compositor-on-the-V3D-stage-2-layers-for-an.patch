+unsigned onyxCompositingTriggers()
+{
+    static unsigned triggers;
+    static std::once_flag once;
+    std::call_once(once, [] {
+        // (No trigger at all would switch compositing off -- RenderLayerCompositor::
+        // cacheAcceleratedCompositingFlags --: the plugins' is given, there are no plugins.)
+        triggers = ChromeClient::PluginTrigger;
+        if (testSwitch("ONYX_WEB_GPU_STAGE1", "SD:/etc/web-gpu-stage1"))
+            return;
+        triggers |= ChromeClient::AnimationTrigger | ChromeClient::AnimatedOpacityTrigger;
+        if (testSwitch("ONYX_WEB_GPU_3D", "SD:/etc/web-gpu-3d"))
+            triggers |= ChromeClient::ThreeDTransformTrigger;
+    });
+    return triggers;
