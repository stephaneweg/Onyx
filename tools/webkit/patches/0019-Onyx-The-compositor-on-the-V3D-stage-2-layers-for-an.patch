+void GraphicsLayerOnyx::addDirtyRect(IntRect rect)
+{
+    // A paint has a cost of its own (the render tree walked) besides its pixels': rectangles that
+    // touch or nearly are painted as one, far ones each for itself, eight at most.
+    static constexpr uint64_t acceptableWaste = 64 * 64;
+    static constexpr size_t maximumRects = 8;
+
+    auto area = [](const IntRect& r) {
+        return static_cast<uint64_t>(r.width()) * r.height();
+    };
+    auto waste = [&](const IntRect& a, const IntRect& b) {
+        auto united = area(unionRect(a, b));
+        auto separate = area(a) + area(b);
+        return united > separate ? united - separate : 0;
+    };
+
+    for (bool merged = true; merged;) {
+        merged = false;
+        for (size_t i = 0; i < m_dirtyRects.size(); ++i) {
+            if (m_dirtyRects[i].contains(rect))
+                return;
+            if (waste(m_dirtyRects[i], rect) <= acceptableWaste) {
+                rect.unite(m_dirtyRects[i]);
+                m_dirtyRects.removeAt(i);
+                merged = true;
+                break;
+            }
+        }
+    }
+    m_dirtyRects.append(rect);
+
+    while (m_dirtyRects.size() > maximumRects) {
+        size_t bestFirst = 0;
+        size_t bestSecond = 1;
+        uint64_t bestWaste = std::numeric_limits<uint64_t>::max();
+        for (size_t i = 0; i < m_dirtyRects.size(); ++i) {
+            for (size_t j = i + 1; j < m_dirtyRects.size(); ++j) {
+                auto pairWaste = waste(m_dirtyRects[i], m_dirtyRects[j]);
+                if (pairWaste < bestWaste) {
+                    bestWaste = pairWaste;
+                    bestFirst = i;
+                    bestSecond = j;
+                }
+            }
+        }
+        m_dirtyRects[bestFirst].unite(m_dirtyRects[bestSecond]);
+        m_dirtyRects.removeAt(bestSecond);
+    }
+}
