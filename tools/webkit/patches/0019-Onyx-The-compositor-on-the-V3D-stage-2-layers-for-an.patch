         return;
 
     m_layoutViewportOrigin = origin;
+#if USE(GRAPHICS_LAYER_ONYX)
+    // Onyx's compositor scrolls on the main thread: each step of a scroll moves the layout viewport.
+    // A fixed element that is a layer of its own is only moved by that (its size depends on the
+    // viewport's size, which has not changed): a movement-only layout, after which a composited
+    // layer is not painted again (RenderLayer::shouldRepaintAfterLayout) -- a full layout would
+    // repaint the whole layer at every step. A sticky element that is a layer needs no layout at all:
+    // its offset is computed when its layer's position is (RenderLayer::updateLayerPosition), from
+    // the layout viewport -- a layout would lay out its containing block again and repaint the
+    // lines beside it, at every step. Its layer's position is asked for again, now that the layout
+    // viewport has moved: by the layout that is due (a fixed element's), else at once.
+    if (layoutTriggering == TriggerLayoutOrNot::Yes && hasViewportConstrainedObjects()) {
+        bool hasStickyLayerToMove = false;
+        for (CheckedRef renderer : *m_viewportConstrainedObjects) {
+            if (renderer->isStickilyPositioned() && renderer->isComposited() && !renderer->needsLayout()) {
+                downcast<RenderBoxModelObject>(renderer).layer()->setSelfAndDescendantsNeedPositionUpdate();
+                hasStickyLayerToMove = true;
+            } else if (renderer->isFixedPositioned() && renderer->isComposited() && !renderer->needsLayout())
+                renderer->setNeedsOutOfFlowMovementLayout(nullptr);
+            else
+                renderer->setNeedsLayout();
+            if (renderer->hasLayer())
+                downcast<RenderBoxModelObject>(renderer).layer()->setNeedsCompositingGeometryUpdate();
+        }
+        if (hasStickyLayerToMove && !needsLayout() && layoutContext().layoutPhase() == LocalFrameViewLayoutContext::LayoutPhase::OutsideLayout) {
+            updateLayerPositionsAfterScrolling();
+            updateCompositingLayersAfterScrolling();
+        }
+    } else
+#endif
     if (layoutTriggering == TriggerLayoutOrNot::Yes)
         setViewportConstrainedObjectsNeedLayout();
     
