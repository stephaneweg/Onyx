+// ---- animations
+
+bool GraphicsLayerOnyx::addAnimation(const GraphicsLayerKeyframeValueList& valueList, const GraphicsLayerAnimation* animation, const String& animationName, double timeOffset)
+{
+    if (!m_host || !m_host->acceleratesAnimations())
+        return false;
+
+    // What TextureMapperAnimation samples as WebCore would; the rest stays on the main thread.
+    if (!animation || !animation->timingFunction() || !animation->duration() || *animation->duration() <= 0 || valueList.size() < 2 || animation->playbackRate() != 1)
+        return false;
+    // (Before its start an animation that does not fill backwards shows the layer's own value.)
+    if (timeOffset < 0 && !animation->fillsBackwards())
+        return false;
+
+    switch (valueList.property()) {
+    case AnimatedProperty::Opacity:
+    case AnimatedProperty::Translate:
+    case AnimatedProperty::Rotate:
+    case AnimatedProperty::Scale:
+    case AnimatedProperty::Transform:
+        break;
+    default:
+        return false;
+    }
+
+    if (!m_animations)
+        m_animations = makeUniqueWithoutFastMallocCheck<TextureMapperAnimations>();
+    m_animations->add(TextureMapperAnimation(animationName, valueList, *animation, MonotonicTime::now() - Seconds(timeOffset), 0_s, TextureMapperAnimation::State::Playing));
+    m_host->layerAnimationsChanged();
+    return true;
+}
+
+void GraphicsLayerOnyx::pauseAnimation(const String& animationName, double timeOffset)
+{
+    if (!m_animations)
+        return;
+    m_animations->pause(animationName, Seconds(timeOffset));
+    if (m_host)
+        m_host->layerAnimationsChanged();
+}
+
+void GraphicsLayerOnyx::removeAnimation(const String& animationName, std::optional<AnimatedProperty> property)
+{
+    if (!m_animations)
+        return;
+    if (property)
+        m_animations->remove(animationName, *property);
+    else
+        m_animations->remove(animationName);
+    if (m_animations->isEmpty())
+        m_animations = nullptr;
+    if (m_host)
+        m_host->layerAnimationsChanged();
+}
+
+bool GraphicsLayerOnyx::updateAnimations(MonotonicTime time)
+{
+    m_currentOpacity = opacity();
+    m_currentTransform = transform();
+    if (!m_animations || m_animations->isEmpty())
+        return false;
+
+    // The transform is translate, rotate, scale and transform, in that order: the ones that are not
+    // animated come from the style.
+    if (m_animations->hasActiveAnimationsOfType(AnimatedProperty::Translate) || m_animations->hasActiveAnimationsOfType(AnimatedProperty::Rotate)
+        || m_animations->hasActiveAnimationsOfType(AnimatedProperty::Scale) || m_animations->hasActiveAnimationsOfType(AnimatedProperty::Transform)) {
+        m_animations->setTranslate(client().transformMatrixForProperty(AnimatedProperty::Translate));
+        m_animations->setRotate(client().transformMatrixForProperty(AnimatedProperty::Rotate));
+        m_animations->setScale(client().transformMatrixForProperty(AnimatedProperty::Scale));
+        m_animations->setTransform(client().transformMatrixForProperty(AnimatedProperty::Transform));
+    }
+
+    TextureMapperAnimation::ApplicationResult result;
+    m_animations->apply(result, time);
+    if (result.opacity)
+        m_currentOpacity = *result.opacity;
+    if (result.transform)
+        m_currentTransform = *result.transform;
+    return result.hasRunningAnimations;
 }
 
