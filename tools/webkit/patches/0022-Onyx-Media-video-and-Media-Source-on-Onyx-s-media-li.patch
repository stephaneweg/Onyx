+MediaTime MediaPlayerPrivateOnyx::maxTimeSeekable() const
+{
+    return duration();
+}
+
+const PlatformTimeRanges& MediaPlayerPrivateOnyx::buffered() const
+{
+    m_buffered.clear();
+    if (m_av && m_fileSource >= 0) {
+        av_range ranges[32];
+        int count = av_store_buffered(store(), m_fileSource, ranges, 32);
+        for (int i = 0; i < count; i++)
+            m_buffered.add(fromUs(ranges[i].start), fromUs(ranges[i].end));
+    }
+    return m_buffered;
+}
+
+bool MediaPlayerPrivateOnyx::didLoadingProgress() const
+{
+    return std::exchange(m_loadingProgressed, false);
+}
