+void MediaPlayerPrivateOnyx::load(const URL&, const LoadOptions&, MediaSourcePrivateClient& client)
+{
+    if (!ensurePlayer()) {
+        fail(MediaPlayer::NetworkState::FormatError);
+        return;
+    }
+    setNetworkState(MediaPlayer::NetworkState::Loading);
+    if (RefPtr mediaSourcePrivate = downcast<MediaSourcePrivateOnyx>(client.mediaSourcePrivate())) {
+        mediaSourcePrivate->setPlayer(this);
+        m_mediaSourcePrivate = WTF::move(mediaSourcePrivate);
+        client.reOpen();
+    } else
+        m_mediaSourcePrivate = MediaSourcePrivateOnyx::create(*this, client);
+    schedulePoll();
