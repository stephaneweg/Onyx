+void MediaPlayerPrivateOnyx::getSupportedTypes(HashSet<String>& types)
+{
+    types = mimeTypes();
+}
+
+MediaPlayer::SupportsType MediaPlayerPrivateOnyx::supportsType(const MediaEngineSupportParameters& parameters)
+{
+    bool mediaSource = parameters.platformType == PlatformMediaDecodingType::MediaSource;
+#if !ENABLE(MEDIA_SOURCE)
+    if (mediaSource)
+        return MediaPlayer::SupportsType::IsNotSupported;
+#endif
+    if (parameters.platformType == PlatformMediaDecodingType::MediaStream)
+        return MediaPlayer::SupportsType::IsNotSupported;
+
+    // No type given (a file by its address alone): the container is read from its first bytes.
+    if (parameters.type.isEmpty())
+        return mediaSource ? MediaPlayer::SupportsType::IsNotSupported : MediaPlayer::SupportsType::MayBeSupported;
+
+    // The library's answer for the type with its codecs (profiles, sizes): 2 "probably", 1 "maybe".
+    int smooth = 0;
+    switch (av_type_supported(reinterpret_cast<const char*>(parameters.type.raw().utf8().data()), mediaSource, &smooth)) {
+    case 2:
+        return MediaPlayer::SupportsType::IsSupported;
+    case 1:
+        return MediaPlayer::SupportsType::MayBeSupported;
+    default:
+        return MediaPlayer::SupportsType::IsNotSupported;
+    }
+}
