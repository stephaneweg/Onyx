+// ---- loading: a file ----
+
+class MediaResourceClientOnyx final : public PlatformMediaResourceClient {
+public:
+    static Ref<MediaResourceClientOnyx> create(MediaPlayerPrivateOnyx& parent) { return adoptRef(*new MediaResourceClientOnyx(parent)); }
+    void detach() { m_parent = nullptr; }
+
+private:
+    explicit MediaResourceClientOnyx(MediaPlayerPrivateOnyx& parent)
+        : m_parent(parent)
+    {
+    }
+
+    void responseReceived(PlatformMediaResource&, const ResourceResponse& response, CompletionHandler<void(ShouldContinuePolicyCheck)>&& completionHandler) final
+    {
+        if (RefPtr parent = m_parent.get()) {
+            // "bytes 100-199/5000": the whole size is after the slash.
+            long long total = -1;
+            auto range = response.httpHeaderField(HTTPHeaderName::ContentRange);
+            if (auto slash = range.find('/'); slash != notFound) {
+                if (auto value = parseInteger<long long>(StringView(range).substring(slash + 1)))
+                    total = *value;
+            }
+            parent->resourceResponse(total >= 0 ? total : response.expectedContentLength(), response.httpStatusCode(), total >= 0);
+        }
+        completionHandler(ShouldContinuePolicyCheck::Yes);
+    }
+
+    void dataReceived(PlatformMediaResource&, const SharedBuffer& buffer) final
+    {
+        if (RefPtr parent = m_parent.get())
+            parent->resourceData(buffer.span());
+    }
+
+    void loadFailed(PlatformMediaResource&, const ResourceError&) final
+    {
+        if (RefPtr parent = m_parent.get())
+            parent->resourceFinished(true);
+    }
+
+    void loadFinished(PlatformMediaResource&, const NetworkLoadMetrics&) final
+    {
+        if (RefPtr parent = m_parent.get())
+            parent->resourceFinished(false);
+    }
+
+    WeakPtr<MediaPlayerPrivateOnyx> m_parent;
+};
+
+void MediaPlayerPrivateOnyx::load(const String& url)
+{
+    m_url = URL { url };
+    if (!ensurePlayer()) {
+        fail(MediaPlayer::NetworkState::FormatError);
+        return;
+    }
+    setNetworkState(MediaPlayer::NetworkState::Loading);
+    requestFrom(0);
+    schedulePoll();
+}
+
+void MediaPlayerPrivateOnyx::stopRequest()
+{
+    if (RefPtr resource = std::exchange(m_resource, nullptr)) {
+        if (RefPtr client = resource->client())
+            static_cast<MediaResourceClientOnyx&>(*client).detach();
+        resource->setClient(nullptr);
+        resource->shutdown();
+    }
+}
+
+void MediaPlayerPrivateOnyx::requestFrom(long long offset)
+{
+    stopRequest();
+    RefPtr player = m_player.get();
+    if (!player || m_loadFailed)
+        return;
+
+    ResourceRequest request { URL { m_url } };
+    m_requestIsRanged = offset > 0;
+    if (m_requestIsRanged)
+        request.setHTTPHeaderField(HTTPHeaderName::Range, makeString("bytes="_s, offset, '-'));
+    m_requestOffset = offset;
+    m_offset = offset;
+
+    m_resource = player->mediaResourceLoader()->requestResource(WTF::move(request), 0);
+    if (!m_resource) {
+        fail(MediaPlayer::NetworkState::NetworkError);
+        return;
+    }
+    m_resource->setClient(MediaResourceClientOnyx::create(*this));
+}
+
+void MediaPlayerPrivateOnyx::resourceResponse(long long expectedLength, int httpStatus, bool hasContentRange)
+{
+    if (httpStatus >= 400) {
+        fail(m_fileSource < 0 ? MediaPlayer::NetworkState::FormatError : MediaPlayer::NetworkState::NetworkError);
+        return;
+    }
+    if (m_requestIsRanged && httpStatus != 206 && !hasContentRange) {
+        // The server does not do ranges: the bytes come from the start again. Those before the
+        // offset asked for are fed again where they belong (the store takes them as a restart).
+        m_serverHasRanges = false;
+        m_offset = 0;
+        expectedLength = expectedLength >= 0 ? expectedLength : -1;
+    } else if (!hasContentRange && m_requestIsRanged && expectedLength >= 0)
+        expectedLength += m_requestOffset; // (a 206 without a Content-Range: the length is the rest's)
+
+    if (expectedLength > 0 && m_fileSize < 0) {
+        m_fileSize = expectedLength;
+        if (m_fileSource >= 0)
+            av_store_set_size(store(), m_fileSource, m_fileSize);
+    }
+}
+
+void MediaPlayerPrivateOnyx::resourceData(std::span<const uint8_t> data)
+{
+    if (!m_av || m_loadFailed || data.empty())
+        return;
+    m_loadingProgressed = true;
+
+    if (m_fileSource < 0) {
+        // The container, from the stream's first bytes.
+        m_head.append(data);
+        if (m_head.size() < probeBytes && (m_fileSize < 0 || static_cast<long long>(m_head.size()) < m_fileSize))
+            return;
+        ASCIILiteral mime;
+        switch (av_probe(m_head.span().data(), m_head.size())) {
+        case AV_FMT_MKV:
+            mime = "video/webm"_s;
+            break;
+        case AV_FMT_MP4:
+            mime = "video/mp4"_s;
+            break;
+        case AV_FMT_WAV:
+            mime = "audio/wav"_s;
+            break;
+        case AV_FMT_FLAC:
+            mime = "audio/flac"_s;
+            break;
+        case AV_FMT_MP3:
+            mime = "audio/mpeg"_s;
+            break;
+        default:
+            fail(MediaPlayer::NetworkState::FormatError);
+            return;
+        }
+        m_fileSource = av_store_add_source(store(), mime.characters(), fileQuota);
+        if (m_fileSource < 0) {
+            fail(MediaPlayer::NetworkState::FormatError);
+            return;
+        }
+        if (m_fileSize > 0)
+            av_store_set_size(store(), m_fileSource, m_fileSize);
+        auto head = std::exchange(m_head, { });
+        int result = av_store_feed(store(), m_fileSource, 0, head.span().data(), head.size());
+        m_offset = head.size();
+        if (result == AV_EUNSUP) {
+            fail(MediaPlayer::NetworkState::FormatError);
+            return;
+        }
+    } else {
+        int result = av_store_feed(store(), m_fileSource, m_offset, data.data(), data.size());
+        m_offset += data.size();
+        if (result == AV_EUNSUP) {
+            fail(MediaPlayer::NetworkState::FormatError);
+            return;
+        }
+    }
+
+    // The demuxer wants bytes from elsewhere (an MP4's index at its end, a seek).
+    auto want = av_store_want(store(), m_fileSource);
+    if (want >= 0 && want != m_offset && m_serverHasRanges && (m_fileSize < 0 || want < m_fileSize))
+        requestFrom(want);
+}
+
+void MediaPlayerPrivateOnyx::resourceFinished(bool failed)
+{
+    m_resource = nullptr;
+    if (m_loadFailed || !m_av)
+        return;
+    if (m_fileSource < 0) {
+        // A file shorter than the probe's bytes: known now, or never.
+        if (!m_head.isEmpty() && !failed) {
+            m_fileSize = m_head.size();
+            auto head = m_head;
+            resourceData(head.span());
+        }
+        if (m_fileSource < 0) {
+            fail(failed ? MediaPlayer::NetworkState::NetworkError : MediaPlayer::NetworkState::FormatError);
+            return;
+        }
+    }
+    if (failed) {
+        // What came is played; the rest is asked for again when the playback nears it (pumpFile).
+        if (!m_serverHasRanges)
+            fail(MediaPlayer::NetworkState::NetworkError);
+        return;
+    }
+    if (m_fileSize < 0)
+        m_fileSize = m_offset;
+    pumpFile();
+}
+
+// The file's requests, from the poll: one runs while the store holds less than fileAheadStop after
+// the playback position, from where the demuxer wants bytes; the end is told once it is reached.
+void MediaPlayerPrivateOnyx::pumpFile()
+{
+    if (m_fileSource < 0 || m_fedEnd || m_loadFailed)
+        return;
+    auto want = av_store_want(store(), m_fileSource);
+    if (want < 0)
+        return;
+
+    // How far the buffered media reaches after the playback position.
+    av_us now = toUs(currentTime()), ahead = 0;
+    av_range ranges[32];
+    int count = av_store_buffered(store(), m_fileSource, ranges, 32);
+    for (int i = 0; i < count; i++) {
+        if (ranges[i].start <= now + 200000 && ranges[i].end > now)
+            ahead = ranges[i].end - now;
+    }
+
+    if (m_resource) {
+        if (want != m_offset && m_serverHasRanges && (m_fileSize < 0 || want < m_fileSize))
+            requestFrom(want); // (a seek sent the demuxer elsewhere)
+        else if (ahead > fileAheadStop && m_serverHasRanges && m_fileSize > 0)
+            stopRequest();
+        return;
+    }
+    if (m_fileSize >= 0 && want >= m_fileSize) {
+        av_store_feed_end(store(), m_fileSource);
+        m_fedEnd = true;
+        setNetworkState(MediaPlayer::NetworkState::Loaded);
+        return;
+    }
+    if (ahead < fileAheadResume)
+        requestFrom(want);
+}
