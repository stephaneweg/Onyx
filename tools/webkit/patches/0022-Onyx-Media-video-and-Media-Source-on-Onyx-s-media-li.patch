+void MediaPlayerPrivateOnyx::registerMediaEngine(MediaEngineRegistrar registrar)
+{
+    registrar(makeUnique<MediaPlayerFactoryOnyx>());
+    static bool installed;
+    if (!std::exchange(installed, true))
+        PlatformMediaEngineConfigurationFactory::installFactory({ &createDecodingConfigurationOnyx, nullptr });
+}
