+Ref<MediaSourcePrivateOnyx> MediaSourcePrivateOnyx::create(MediaPlayerPrivateOnyx& parent, MediaSourcePrivateClient& client)
+{
+    Ref source = adoptRef(*new MediaSourcePrivateOnyx(parent, client));
+    client.setPrivateAndOpen(source.copyRef());
+    return source;
+}
