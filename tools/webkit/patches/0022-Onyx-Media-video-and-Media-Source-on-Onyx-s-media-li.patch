+// navigator.mediaCapabilities.decodingInfo(): what the library decodes, and whether it does so in
+// real time on the Pi at that size and rate (av_type_supported's "smooth": the players -- YouTube --
+// choose their stream with it). Never "power efficient": the decoders are software.
+static void createDecodingConfigurationOnyx(PlatformMediaDecodingConfiguration&& configuration, Function<void(PlatformMediaCapabilitiesDecodingInfo&&)>&& callback)
+{
+    bool mediaSource = configuration.type == PlatformMediaDecodingType::MediaSource;
+    PlatformMediaCapabilitiesDecodingInfo info;
+    info.supported = configuration.video || configuration.audio;
+    info.smooth = true;
+    if (configuration.video) {
+        auto& video = *configuration.video;
+        auto type = makeString(video.contentType, "; width="_s, video.width, "; height="_s, video.height, "; framerate="_s, static_cast<unsigned>(video.framerate + 0.5));
+        int smooth = 0;
+        if (!av_type_supported(reinterpret_cast<const char*>(type.utf8().data()), mediaSource, &smooth))
+            info.supported = false;
+        info.smooth = info.smooth && smooth;
+    }
+    if (configuration.audio) {
+        int smooth = 0;
+        if (!av_type_supported(reinterpret_cast<const char*>(configuration.audio->contentType.utf8().data()), mediaSource, &smooth))
+            info.supported = false;
+    }
+    info.smooth = info.smooth && info.supported;
+    info.powerEfficient = false;
+    info.configuration = WTF::move(configuration);
+    callback(WTF::move(info));
+}
