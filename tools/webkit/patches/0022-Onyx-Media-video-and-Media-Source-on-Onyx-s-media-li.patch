+Ref<MediaTimePromise> MediaPlayerPrivateOnyx::seekToTarget(const SeekTarget& target)
+{
+    m_seekPromise.emplace(PlatformMediaError::Cancelled);
+    m_seekTime = target.time;
+    m_seekSent = false;
+    m_ended = false;
+    if (!m_av) {
+        if (auto promise = std::exchange(m_seekPromise, std::nullopt))
+            promise->reject(PlatformMediaError::Cancelled);
+        return MediaTimePromise::createAndReject(PlatformMediaError::Cancelled);
+    }
+
+#if ENABLE(MEDIA_SOURCE)
+    if (RefPtr mediaSource = m_mediaSourcePrivate) {
+        // The Media Source says when the target is buffered (and which time it is, within the
+        // target's tolerance); its buffers then give the frames again from the random access
+        // point before it, and the player decodes up to it.
+        mediaSource->waitForTarget(target)->whenSettled(RunLoop::currentSingleton(), [weakThis = WeakPtr { *this }](auto&& result) {
+            RefPtr protectedThis = weakThis.get();
+            if (!protectedThis)
+                return;
+            if (!result) {
+                if (auto promise = std::exchange(protectedThis->m_seekPromise, std::nullopt))
+                    promise->reject(result.error());
+                protectedThis->m_seekTime.reset();
+                return;
+            }
+            auto seekTime = *result;
+            protectedThis->m_seekTime = seekTime;
+            RefPtr mediaSource = protectedThis->m_mediaSourcePrivate;
+            if (!mediaSource)
+                return;
+            mediaSource->reenqueueMediaForTime(seekTime)->whenSettled(RunLoop::currentSingleton(), [weakThis, seekTime](auto&& result) {
+                RefPtr protectedThis = weakThis.get();
+                if (!protectedThis || !result || !protectedThis->m_av)
+                    return;
+                av_player_seek(protectedThis->m_av, toUs(seekTime));
+                if (protectedThis->m_playing)
+                    av_player_play(protectedThis->m_av);
+                protectedThis->m_seekSent = true;
+            });
+        });
+        schedulePoll();
+        return *m_seekPromise;
+    }
+#endif
+
+    av_player_seek(m_av, toUs(target.time));
+    if (m_playing)
+        av_player_play(m_av);
+    m_seekSent = true;
+    schedulePoll();
+    return *m_seekPromise;
+}
+
+// The player's state and the picture due, from the timer.
+void MediaPlayerPrivateOnyx::poll()
+{
+    if (!m_av)
+        return;
+    Ref protectedThis { *this };
+    RefPtr player = m_player.get();
+    if (!player)
+        return;
+
+    av_player_status status;
+    av_video_out picture;
+    bool gotPicture = av_player_poll(m_av, &status, &picture);
+
+    m_time = fromUs(std::max<av_us>(status.time, 0)); // (the clock starts a sound queue's length before 0)
+    m_waiting = status.waiting;
+    m_decoded = status.decoded;
+    m_dropped = status.dropped;
+
+    if (status.error && !m_loadFailed) {
+        fail(status.error == AV_EUNSUP ? MediaPlayer::NetworkState::FormatError : MediaPlayer::NetworkState::DecodeError);
+        return;
+    }
+
+    bool hadVideo = m_hasVideo, hadAudio = m_hasAudio;
+    m_hasVideo = status.has_video;
+    m_hasAudio = status.has_audio;
+    if (hadVideo != m_hasVideo || hadAudio != m_hasAudio)
+        player->characteristicChanged();
+
+    // What plays, in the kernel log, every five seconds while pictures are decoded.
+    if (auto now = MonotonicTime::now(); now - m_lastLog > 5_s && status.decoded != m_loggedDecoded) {
+        mediaLog(makeString("at "_s, status.time / 100000 / 10.0, " s, "_s, status.width, 'x', status.height, ", "_s, status.decoded, " pictures decoded ("_s, status.dropped,
+            " dropped), "_s, static_cast<int>(status.decode_us / 1000), " ms a picture"_s, status.waiting ? ", waiting for data"_s : ""_s, status.sound ? ""_s : ", no sound output"_s,
+            ", "_s, onyx_cores_side_jobs_done ? onyx_cores_side_jobs_done() : 0, " on the app core"_s));
+        m_lastLog = now;
+        m_loggedDecoded = status.decoded;
+    }
+
+    IntSize size { status.width, status.height };
+    if (!size.isEmpty() && size != m_size) {
+        m_size = size;
+        player->sizeChanged();
+    }
+
+    if (gotPicture && picture.pixels && picture.width > 0 && picture.height > 0) {
+        // The player's pixels are its own until the next picture: copied into an image.
+        auto info = SkImageInfo::Make(picture.width, picture.height, kBGRA_8888_SkColorType, kOpaque_SkAlphaType, SkColorSpace::MakeSRGB());
+        SkPixmap pixmap(info, picture.pixels, picture.stride);
+        bool first = !m_image;
+        m_image = NativeImage::create(SkImages::RasterFromPixmapCopy(pixmap));
+        if (first)
+            player->firstVideoFrameAvailable();
+        player->repaint();
+    }
+
+#if ENABLE(MEDIA_SOURCE)
+    bool isMediaSource = !!m_mediaSourcePrivate;
+#else
+    bool isMediaSource = false;
+#endif
+    if (!isMediaSource) {
+        // A file: the duration is the container's, the ready state the player's.
+        auto duration = status.duration > 0 ? fromUs(status.duration) : MediaTime::zeroTime();
+        if (duration != m_duration) {
+            m_duration = duration;
+            player->durationChanged();
+        }
+        switch (status.ready) {
+        case AV_HAVE_METADATA:
+            setReadyState(MediaPlayer::ReadyState::HaveMetadata);
+            break;
+        case AV_HAVE_CURRENT_DATA:
+            setReadyState(MediaPlayer::ReadyState::HaveCurrentData);
+            break;
+        case AV_HAVE_FUTURE_DATA:
+            setReadyState(MediaPlayer::ReadyState::HaveFutureData);
+            break;
+        case AV_HAVE_ENOUGH_DATA:
+            setReadyState(MediaPlayer::ReadyState::HaveEnoughData);
+            break;
+        default:
+            break; // (nothing yet: the state stays what it was)
+        }
+        pumpFile();
+    }
+#if ENABLE(MEDIA_SOURCE)
+    else if (RefPtr mediaSource = m_mediaSourcePrivate)
+        mediaSource->provideMediaDataIfNeeded();
+#endif
+
+    // A seek is over when the player shows its first picture (or has its audio ready).
+    if (m_seekSent && !status.seeking) {
+        m_seekSent = false;
+        m_seekTime.reset();
+        if (auto promise = std::exchange(m_seekPromise, std::nullopt))
+            promise->resolve(m_time);
+    }
+
+    if (status.ended && !m_ended) {
+        m_ended = true;
+        player->timeChanged();
+    } else if (!status.ended) {
+        m_ended = false;
+        // The page still wants it playing (a loop's seek back to the start, after the end).
+        if (m_playing && status.paused && !status.seeking && !m_seekTime)
+            av_player_play(m_av);
+    }
+    schedulePoll();
+}
