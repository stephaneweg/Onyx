+
+bool SourceBufferPrivateOnyx::ensureQueue()
+{
+    if (m_queue >= 0)
+        return true;
+    if (auto* store = this->store())
+        m_queue = av_store_add_queue(store);
+    return m_queue >= 0;
+}
+
+SourceBufferPrivateOnyx::Track* SourceBufferPrivateOnyx::trackFor(TrackID id)
+{
+    for (auto& track : m_tracks) {
+        if (track.id == id)
+            return &track;
+    }
+    return nullptr;
+}
+
+// The demuxer's tracks, after a (new) initialization segment: told to WebCore, and defined in the
+// player's queue (a track already there keeps its place: its description is replaced).
+void SourceBufferPrivateOnyx::receivedInitializationSegment()
+{
+    SourceBufferPrivateClient::InitializationSegment segment;
+    auto duration = av_demux_duration(m_demux);
+    segment.duration = duration > 0 ? fromUs(duration) : MediaTime::invalidTime();
+
+    bool haveQueue = ensureQueue();
+    for (int i = 0; i < av_demux_ntracks(m_demux); i++) {
+        auto* info = av_demux_track(m_demux, i);
+        if (!info || (info->kind != AV_VIDEO && info->kind != AV_AUDIO))
+            continue;
+        TrackID id = info->number;
+        auto* track = trackFor(id);
+        if (!track) {
+            m_tracks.append(Track { id });
+            track = &m_tracks.last();
+        }
+        track->isVideo = info->kind == AV_VIDEO;
+        track->size = { info->dwidth > 0 ? info->dwidth : info->width, info->dheight > 0 ? info->dheight : info->height };
+        if (haveQueue)
+            track->queueIndex = av_store_queue_track(store(), m_queue, info);
+        mediaLog(makeString("a source buffer's "_s, track->isVideo ? "video"_s : "audio"_s, " track "_s, info->number, ": "_s, String::fromUTF8(info->codec_str[0] ? info->codec_str : info->codec_id),
+            ", "_s, info->width, 'x', info->height, ", "_s, static_cast<int>(info->fps + 0.5), " pictures a second, "_s, info->rate, " Hz x "_s, info->channels));
+        if (track->isVideo) {
+            if (RefPtr mediaSource = mediaSourcePrivate(); mediaSource && mediaSource->onyxPlayer())
+                mediaSource->onyxPlayer()->mediaSourceVideoSize(track->size);
+        }
+
+        if (track->isVideo) {
+            SourceBufferPrivateClient::InitializationSegment::VideoTrackInformation information;
+            information.track = VideoTrackPrivateOnyx::create(id);
+            information.description = MediaDescriptionOnyx::create(*info);
+            segment.videoTracks.append(WTF::move(information));
+        } else {
+            SourceBufferPrivateClient::InitializationSegment::AudioTrackInformation information;
+            information.track = AudioTrackPrivateOnyx::create(id);
+            information.description = MediaDescriptionOnyx::create(*info);
+            segment.audioTracks.append(WTF::move(information));
+        }
+    }
+    didReceiveInitializationSegment(WTF::move(segment));
+}
+
+Ref<MediaPromise> SourceBufferPrivateOnyx::appendInternal(Ref<SharedBuffer>&& data)
+{
+    if (!m_demux)
+        return MediaPromise::createAndReject(PlatformMediaError::ParsingError);
+    auto bytes = data->span();
+    int result = av_demux_append(m_demux, bytes.data(), bytes.size());
+    if (result != AV_OK)
+        return MediaPromise::createAndReject(PlatformMediaError::ParsingError);
+
+    for (;;) {
+        av_packet packet;
+        result = av_demux_read(m_demux, &packet);
+        if (av_demux_take_init(m_demux))
+            receivedInitializationSegment();
+        if (result == AV_AGAIN || result == AV_EOF)
+            break;
+        if (result != AV_OK)
+            return MediaPromise::createAndReject(PlatformMediaError::ParsingError);
+        auto* info = av_demux_track(m_demux, packet.track);
+        if (auto* track = info ? trackFor(info->number) : nullptr) {
+            if (packet.dur <= 0)
+                packet.dur = info->default_dur > 0 ? info->default_dur : (track->isVideo ? 33333 : 20000);
+            didReceiveSample(MediaSampleOnyx::create(packet, track->id, track->size));
+        }
+        av_pkt_free(&packet);
+    }
+    return MediaPromise::createAndResolve();
+}
+
+void SourceBufferPrivateOnyx::resetParserStateInternal()
+{
+    if (m_demux)
+        av_demux_reset(m_demux);
+}
+
+void SourceBufferPrivateOnyx::removedFromMediaSource()
+{
+    if (m_queue >= 0) {
+        if (auto* store = this->store())
+            av_store_remove_source(store, m_queue);
+        m_queue = -1;
+    }
+    SourceBufferPrivate::removedFromMediaSource();
+}
+
+bool SourceBufferPrivateOnyx::canSwitchToType(const ContentType& contentType)
+{
+    MediaEngineSupportParameters parameters {
+        .platformType = PlatformMediaDecodingType::MediaSource,
+        .type = contentType
+    };
+    if (MediaPlayerPrivateOnyx::supportsType(parameters) == MediaPlayer::SupportsType::IsNotSupported)
+        return false;
+    m_pendingFormat = av_format_of_mime(reinterpret_cast<const char*>(contentType.raw().utf8().data()));
+    return m_pendingFormat != AV_FMT_UNKNOWN;
+}
+
+void SourceBufferPrivateOnyx::startChangingType()
+{
+    SourceBufferPrivate::startChangingType();
+    // The next bytes are an initialization segment of the new type: a demuxer for it.
+    if (m_pendingFormat && m_pendingFormat != m_format) {
+        if (m_demux)
+            av_demux_free(m_demux);
+        m_format = m_pendingFormat;
+        m_demux = av_demux_new(m_format);
+    } else if (m_demux)
+        av_demux_reset(m_demux);
+    m_pendingFormat = 0;
+}
+
+void SourceBufferPrivateOnyx::flush(TrackID id)
+{
+    auto* track = trackFor(id);
+    if (track && track->queueIndex >= 0 && m_queue >= 0) {
+        if (auto* store = this->store())
+            av_store_queue_flush(store, m_queue, track->queueIndex);
+    }
+}
+
+void SourceBufferPrivateOnyx::enqueueSample(Ref<MediaSample>&& sample, TrackID id)
+{
+    auto* track = trackFor(id);
+    auto* store = this->store();
+    if (!track || track->queueIndex < 0 || m_queue < 0 || !store || sample->type() != MediaSample::Type::None)
+        return;
+    auto& onyxSample = static_cast<MediaSampleOnyx&>(sample.get());
+    auto bytes = onyxSample.data().span();
+    av_packet packet { };
+    packet.track = track->queueIndex;
+    packet.pts = toUs(sample->presentationTime());
+    packet.dts = toUs(sample->decodeTime());
+    packet.dur = toUs(sample->duration());
+    packet.key = sample->isSync();
+    packet.pos = -1;
+    packet.data = const_cast<uint8_t*>(bytes.data()); // (copied by the queue)
+    packet.size = bytes.size();
+    packet.discard_end = onyxSample.discardEnd();
+    av_store_queue_put(store, m_queue, track->queueIndex, &packet);
+}
+
+void SourceBufferPrivateOnyx::allSamplesInTrackEnqueued(TrackID id)
+{
+    auto* track = trackFor(id);
+    if (track && track->queueIndex >= 0 && m_queue >= 0) {
+        if (auto* store = this->store())
+            av_store_queue_end(store, m_queue, track->queueIndex, 1);
+    }
+}
+
+bool SourceBufferPrivateOnyx::isReadyForMoreSamples(TrackID id)
+{
+    auto* track = trackFor(id);
+    auto* store = this->store();
+    RefPtr mediaSource = mediaSourcePrivate();
+    if (!track || track->queueIndex < 0 || m_queue < 0 || !store || !mediaSource)
+        return false;
+    size_t bytes = 0;
+    auto ahead = av_store_queue_level(store, m_queue, track->queueIndex, toUs(mediaSource->currentTime()), &bytes);
+    return ahead < queueAhead && bytes < queueBytes;
+}
+
+void SourceBufferPrivateOnyx::notifyClientWhenReadyForMoreSamples(TrackID id)
+{
+    if (auto* track = trackFor(id))
+        track->wantsMore = true;
+}
+
+void SourceBufferPrivateOnyx::provideMediaDataIfNeeded()
+{
+    // (provideMediaData may call notifyClientWhenReadyForMoreSamples again: the ids first)
+    Vector<TrackID, 2> ready;
+    for (auto& track : m_tracks) {
+        if (track.wantsMore && isReadyForMoreSamples(track.id)) {
+            track.wantsMore = false;
+            ready.append(track.id);
+        }
+    }
+    for (auto id : ready)
+        provideMediaData(id);
+}
