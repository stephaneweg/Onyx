+class MediaSampleOnyx final : public MediaSample {
+public:
+    static Ref<MediaSampleOnyx> create(const av_packet& packet, TrackID trackID, const IntSize& size)
+    {
+        return adoptRef(*new MediaSampleOnyx(SharedBuffer::create(std::span<const uint8_t> { packet.data, packet.size }), fromUs(packet.pts),
+            fromUs(packet.dts != AV_NOTIME ? packet.dts : packet.pts), fromUs(packet.dur), packet.key, trackID, size, packet.discard_end));
+    }
+
+    const SharedBuffer& data() const { return m_data.get(); }
+    av_us discardEnd() const { return m_discardEnd; }
+
+private:
+    MediaSampleOnyx(Ref<SharedBuffer>&& data, const MediaTime& presentationTime, const MediaTime& decodeTime, const MediaTime& duration, bool isSync, TrackID trackID, const IntSize& size, av_us discardEnd)
+        : m_data(WTF::move(data))
+        , m_presentationTime(presentationTime)
+        , m_decodeTime(decodeTime)
+        , m_duration(duration)
+        , m_trackID(trackID)
+        , m_size(size)
+        , m_discardEnd(discardEnd)
+        , m_isSync(isSync)
+    {
+    }
+
+    Ref<MediaSampleOnyx> copy() const
+    {
+        Ref sample = adoptRef(*new MediaSampleOnyx(m_data.copyRef(), m_presentationTime, m_decodeTime, m_duration, m_isSync, m_trackID, m_size, m_discardEnd));
+        sample->m_isNonDisplaying = m_isNonDisplaying;
+        return sample;
+    }
+
+    MediaTime presentationTime() const final { return m_presentationTime; }
+    MediaTime decodeTime() const final { return m_decodeTime; }
+    MediaTime duration() const final { return m_duration; }
+    TrackID trackID() const final { return m_trackID; }
+    size_t sizeInBytes() const final { return m_data->size(); }
+    FloatSize presentationSize() const final { return m_size; }
+    void offsetTimestampsBy(const MediaTime& offset) final
+    {
+        m_presentationTime += offset;
+        m_decodeTime += offset;
+    }
+    void setTimestamps(const MediaTime& presentationTime, const MediaTime& decodeTime) final
+    {
+        m_presentationTime = presentationTime;
+        m_decodeTime = decodeTime;
+    }
+    Ref<MediaSample> createNonDisplayingCopy() const final
+    {
+        auto sample = copy();
+        sample->m_isNonDisplaying = true;
+        return sample;
+    }
+    Ref<MediaSample> createCopyWithAdjustedStartTime(const MediaTime& offset) const final
+    {
+        auto clamped = std::max(MediaTime::zeroTime(), std::min(offset, m_duration));
+        auto sample = copy();
+        sample->m_presentationTime = m_presentationTime + clamped;
+        sample->m_decodeTime = m_decodeTime + clamped;
+        sample->m_duration = m_duration - clamped;
+        return sample;
+    }
+    SampleFlags flags() const final
+    {
+        unsigned flags = None;
+        if (m_isSync)
+            flags |= IsSync;
+        if (m_isNonDisplaying)
+            flags |= IsNonDisplaying;
+        return SampleFlags(flags);
+    }
+    PlatformSample platformSample() const final { return PlatformSample { static_cast<const MockSampleBox*>(nullptr) }; }
+    Type type() const final { return Type::None; }
+
+    const Ref<SharedBuffer> m_data;
+    MediaTime m_presentationTime;
+    MediaTime m_decodeTime;
+    MediaTime m_duration;
+    TrackID m_trackID;
+    IntSize m_size;
+    av_us m_discardEnd { 0 };
+    bool m_isSync { false };
+    bool m_isNonDisplaying { false };
+};
