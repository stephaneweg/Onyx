+// ---- the video decoder on an app core ----
+//
+// Onyx's app cores (the Pi's cores the system leaves to programs: one, core 2, when the network has
+// core 3) run the compositor's raster jobs (WebKit/Shared/onyx/OnyxCores.h; the program's
+// onyxcores.c). The same workers take the player's "side job" before a raster job: a video packet
+// decoded and its picture converted, off the main thread's core -- where the page's scripts run.
+// Weak: a program linked without onyxcores.c (a test of WebCore alone) decodes on its own thread.
+extern "C" {
+int onyx_cores_start(int wanted) __attribute__((weak));
+void onyx_cores_stop(void) __attribute__((weak));
+int onyx_cores_offload(void (*job)(void*), void* argument) __attribute__((weak));
+unsigned onyx_cores_side_jobs_done(void) __attribute__((weak));
+}
+
+static unsigned s_playersWithCores;
+
+static void acquireDecoderCore()
+{
+    if (!onyx_cores_start || !onyx_cores_offload)
+        return;
+    if (!s_playersWithCores++) {
+        int cores = onyx_cores_start(1);
+        mediaLog(makeString("the video decoder has "_s, cores > 0 ? "an app core"_s : "no app core (it shares the page's)"_s));
+        av_set_offload(onyx_cores_offload);
+    }
+}
+
+static void releaseDecoderCore()
+{
+    if (!onyx_cores_stop || !s_playersWithCores)
+        return;
+    if (!--s_playersWithCores)
+        onyx_cores_stop();
+}
+
+// ---- the sound output: the system's has one owner -- one player at a time is heard, the others run
+// silent on the wall clock (av_player does that when the output's open says no) ----
+
+static const void* s_soundOwner;
+
+static int soundOpen(void* context, int* rate)
+{
+    if (s_soundOwner && s_soundOwner != context)
+        return 0;
+    auto* out = av_audio_kapi();
+    if (!out->open(out->ctx, rate))
+        return 0;
+    s_soundOwner = context;
+    return 1;
+}
+
+static unsigned soundWrite(void*, const int16_t* frames, unsigned count)
+{
+    auto* out = av_audio_kapi();
+    return out->write(out->ctx, frames, count);
+}
+
+static unsigned soundQueued(void*)
+{
+    auto* out = av_audio_kapi();
+    return out->queued(out->ctx);
+}
+
+static void soundClose(void* context)
+{
+    auto* out = av_audio_kapi();
+    out->close(out->ctx);
+    if (s_soundOwner == context)
+        s_soundOwner = nullptr;
+}
