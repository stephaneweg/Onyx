+
+MediaSourcePrivate::AddStatus MediaSourcePrivateOnyx::addSourceBuffer(const ContentType& contentType, const MediaSourceConfiguration&, RefPtr<SourceBufferPrivate>& outPrivate)
+{
+    MediaEngineSupportParameters parameters {
+        .platformType = PlatformMediaDecodingType::MediaSource,
+        .type = contentType
+    };
+    if (MediaPlayerPrivateOnyx::supportsType(parameters) == MediaPlayer::SupportsType::IsNotSupported)
+        return AddStatus::NotSupported;
+
+    {
+        Locker locker { m_lock };
+        m_sourceBuffers.append(SourceBufferPrivateOnyx::create(*this, contentType));
+        outPrivate = m_sourceBuffers.last();
+    }
+    outPrivate->setMediaSourceDuration(duration());
+    return AddStatus::Ok;
+}
+
+void MediaSourcePrivateOnyx::durationChanged(const MediaTime& duration)
+{
+    MediaSourcePrivate::durationChanged(duration);
+    if (RefPtr player = m_player.get())
+        player->mediaSourceDurationChanged(duration);
+}
+
+void MediaSourcePrivateOnyx::notifyActiveSourceBuffersChanged()
+{
