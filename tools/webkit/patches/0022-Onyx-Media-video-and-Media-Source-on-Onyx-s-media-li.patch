+{
+#if ENABLE(MEDIA_SOURCE)
+    if (m_mediaSourcePrivate)
+        return MediaPlayer::MovieLoadType::StoredStream;
+#endif
+    return MediaPlayer::MovieLoadType::Download;
+}
