+MediaPlayerPrivateOnyx::MediaPlayerPrivateOnyx(MediaPlayer& player)
+    : m_player(player)
+    , m_pollTimer(RunLoop::mainSingleton(), "MediaPlayerPrivateOnyx::PollTimer"_s, this, &MediaPlayerPrivateOnyx::poll)
+{
+}
+
+MediaPlayerPrivateOnyx::~MediaPlayerPrivateOnyx()
+{
+    m_pollTimer.stop();
+    stopRequest();
+#if ENABLE(MEDIA_SOURCE)
+    if (RefPtr mediaSource = std::exchange(m_mediaSourcePrivate, nullptr))
+        mediaSource->setPlayer(nullptr);
+#endif
+    if (m_av) {
+        av_player_free(m_av);
+        releaseDecoderCore();
+    }
+}
+
+bool MediaPlayerPrivateOnyx::ensurePlayer()
+{
+    if (m_av)
+        return true;
+    // The pictures: B, G, R, A bytes (Skia's N32 in Onyx's build). The sound: the system's output
+    // through the one-owner guard above; the context is this player.
+    static av_audio_out sound = { nullptr, soundOpen, soundWrite, soundQueued, soundClose };
+    auto* out = new av_audio_out(sound); // (lives as long as the process: the player's thread may still hold it while it ends)
+    out->ctx = this;
+    m_av = av_player_new(AV_PIX_BGRA, out);
+    if (!m_av)
+        return false;
+    acquireDecoderCore();
+    applyVolume();
+    av_player_set_rate(m_av, m_rate);
+    return true;
+}
+
+av_store* MediaPlayerPrivateOnyx::store() const
+{
+    return m_av ? av_player_store(m_av) : nullptr;
+}
+
+void MediaPlayerPrivateOnyx::schedulePoll()
+{
+    if (!m_av)
+        return;
+    // Often while pictures may be due (playing, a seek), seldom otherwise (the load's progress).
+    auto interval = (m_playing && !m_ended) || m_seekTime ? 12_ms : 60_ms;
+    if (!m_pollTimer.isActive() || m_pollTimer.secondsUntilFire() > interval)
+        m_pollTimer.startOneShot(interval);
+}
