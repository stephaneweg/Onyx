+
+struct av_player;
+struct av_store;
+
+namespace WebCore {
+
+class MediaSourcePrivateOnyx;
+class NativeImage;
+class PlatformMediaResource;
+
+// Onyx's media engine: <video> and <audio> played by Onyx's own media library (user/av of the Onyx
+// sources: av.h -- its demuxers, its decoders (libvpx, dav1d, opus, FLAC, MP3, PCM), its player with
+// the audio as the clock). One class for the two ways a page gives media:
+//
+//   - a file (src=...): its bytes are fetched through the page's loader (PlatformMediaResourceLoader,
+//     Range requests) and fed to the player's store where its demuxer asks for them, some thirty
+//     seconds ahead of the playback position;
+//   - Media Source Extensions: WebCore keeps the coded frames (SourceBufferPrivate, TrackBuffer);
+//     SourceBufferPrivateOnyx parses the appended bytes with the library's demuxers and puts the
+//     frames WebCore enqueues into a queue of the player's store (av_store_add_queue).
+//
+// The player's threads decode; this object polls it from a timer on the main thread: the state
+// (ready, time, duration, ended), and the picture due now -- 32-bit pixels, kept as an image and
+// painted by paint() (the software path; the page's compositor takes it in its tiles).
+class MediaPlayerPrivateOnyx final
+    : public MediaPlayerPrivateInterface
+    , public RefCounted<MediaPlayerPrivateOnyx>
+    , public CanMakeWeakPtr<MediaPlayerPrivateOnyx> {
+public:
+    void ref() const final { RefCounted::ref(); }
+    void deref() const final { RefCounted::deref(); }
+
+    explicit MediaPlayerPrivateOnyx(MediaPlayer&);
+    virtual ~MediaPlayerPrivateOnyx();
+
+    static void registerMediaEngine(MediaEngineRegistrar);
+    static void getSupportedTypes(HashSet<String>&);
+    static MediaPlayer::SupportsType supportsType(const MediaEngineSupportParameters&);
+
+    constexpr MediaPlayerType mediaPlayerType() const final { return MediaPlayerType::Onyx; }
+
+    // The Media Source's side (MediaSourcePrivateOnyx, SourceBufferPrivateOnyx).
+    av_store* store() const;
+    MediaTime playerTime() const { return m_time; }
+    void mediaSourceDurationChanged(const MediaTime&);
+    void mediaSourceVideoSize(const IntSize&); // an initialization segment's video track
+    void notifyActiveSourceBuffersChanged() final;
+
+    // The file's loader (its client is a class of the .cpp).
+    void resourceResponse(long long expectedLength, int httpStatus, bool hasContentRange);
+    void resourceData(std::span<const uint8_t>);
+    void resourceFinished(bool failed);
+
+private:
+    // MediaPlayerPrivateInterface
+    void load(const String& url) final;
+#if ENABLE(MEDIA_SOURCE)
+    void load(const URL&, const LoadOptions&, MediaSourcePrivateClient&) final;
+    void readyStateFromMediaSourceChanged() final;
+    void characteristicsFromMediaSourceChanged() final;
+    void seekableRangesFromMediaSourceChanged() final;
+    void mediaSourceHasRetrievedAllData() final;
+#endif
+#if ENABLE(MEDIA_STREAM)
+    void load(MediaStreamPrivate&) final { }
+#endif
+    void cancelLoad() final;
+    void play() final;
+    void pause() final;
+    bool paused() const final { return !m_playing; }
+    bool ended() const final { return m_ended; }
+    FloatSize naturalSize() const final;
+    bool hasVideo() const final;
+    bool hasAudio() const final;
+    void setPageIsVisible(bool) final { }
+    MediaTime duration() const final;
+    MediaTime currentTime() const final;
+    bool timeIsProgressing() const final;
+    Ref<MediaTimePromise> seekToTarget(const SeekTarget&) final;
+    void setRateDouble(double) final;
+    double rate() const final { return m_rate; }
+    void setVolumeDouble(double) final;
+    void setMuted(bool) final;
+    MediaPlayer::NetworkState networkState() const final { return m_networkState; }
+    MediaPlayer::ReadyState readyState() const final;
+    MediaTime maxTimeSeekable() const final;
+    const PlatformTimeRanges& buffered() const final;
+    unsigned long long totalBytes() const final { return m_fileSize > 0 ? m_fileSize : 0; }
+    bool didLoadingProgress() const final;
+    void paint(GraphicsContext&, const FloatRect&) final;
+    RefPtr<NativeImage> nativeImageForCurrentTime() final;
+    ColorSpace colorSpace() final;
+    bool hasAvailableVideoFrame() const final { return !!m_image; }
+    MediaPlayer::MovieLoadType movieLoadType() const final;
+    std::optional<VideoPlaybackQualityMetrics> videoPlaybackQualityMetrics() final;
+    String engineDescription() const final { return "Onyx"_s; }
+
+    bool ensurePlayer();
+    void poll();
+    void schedulePoll();
+    void setNetworkState(MediaPlayer::NetworkState);
+    void setReadyState(MediaPlayer::ReadyState);
+    void applyVolume();
+    void fail(MediaPlayer::NetworkState);
+    // the file mode
+    void requestFrom(long long offset);
+    void stopRequest();
+    void pumpFile();
+
+    ThreadSafeWeakPtr<MediaPlayer> m_player;
+    av_player* m_av { nullptr };
+    RunLoop::Timer m_pollTimer;
+
+    MediaPlayer::NetworkState m_networkState { MediaPlayer::NetworkState::Empty };
+    MediaPlayer::ReadyState m_readyState { MediaPlayer::ReadyState::HaveNothing };
+    bool m_playing { false };
+    bool m_ended { false };
+    bool m_waiting { false };
+    bool m_hasVideo { false };
+    bool m_hasAudio { false };
+    bool m_muted { false };
+    double m_volume { 1 };
+    double m_rate { 1 };
+    MediaTime m_time;
+    MediaTime m_duration;
+    IntSize m_size;
+    RefPtr<NativeImage> m_image;
+    unsigned m_decoded { 0 };
+    unsigned m_dropped { 0 };
+    MonotonicTime m_lastLog;
+    unsigned m_loggedDecoded { 0 };
+    std::optional<MediaTimePromise::AutoRejectProducer> m_seekPromise;
+    std::optional<MediaTime> m_seekTime;       // a seek asked for, not yet shown
+    bool m_seekSent { false };                 // the player was told (av_player_seek)
+
+    // the file mode
+    URL m_url;
+    RefPtr<PlatformMediaResource> m_resource;
+    int m_fileSource { -1 };                   // the store's source, once the container is known
+    long long m_fileSize { -1 };
+    long long m_offset { 0 };                  // where the next bytes received go
+    long long m_requestOffset { 0 };           // where the request under way started
+    bool m_requestIsRanged { false };
+    bool m_serverHasRanges { true };
+    bool m_fedEnd { false };
+    bool m_loadFailed { false };
+    mutable bool m_loadingProgressed { false };
+    Vector<uint8_t> m_head;                    // the first bytes, until the container is known
+    mutable PlatformTimeRanges m_buffered;
+
+#if ENABLE(MEDIA_SOURCE)
+    RefPtr<MediaSourcePrivateOnyx> m_mediaSourcePrivate;
+#endif
+};
+
+} // namespace WebCore
