+std::optional<VideoPlaybackQualityMetrics> MediaPlayerPrivateOnyx::videoPlaybackQualityMetrics()
+{
+    return VideoPlaybackQualityMetrics {
+        m_decoded,
+        m_dropped,
+        0,
+        0,
+        0,
+    };
+}
