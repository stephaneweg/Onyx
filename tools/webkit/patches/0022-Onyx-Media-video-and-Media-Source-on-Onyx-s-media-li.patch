+// A SourceBuffer: the bytes appended are parsed by one of the library's demuxers into coded frames
+// (MediaSampleOnyx), which WebCore keeps and orders (SourceBufferPrivate); those it enqueues for
+// decoding go into a queue of the player's store, one queue a buffer, a few seconds deep.
+class SourceBufferPrivateOnyx final : public SourceBufferPrivate {
+public:
+    static Ref<SourceBufferPrivateOnyx> create(MediaSourcePrivateOnyx&, const ContentType&);
+    virtual ~SourceBufferPrivateOnyx();
+
+    constexpr MediaPlatformType platformType() const final { return MediaPlatformType::Onyx; }
+
+    void provideMediaDataIfNeeded();
+
+private:
+    SourceBufferPrivateOnyx(MediaSourcePrivateOnyx&, const ContentType&);
+    RefPtr<MediaSourcePrivateOnyx> mediaSourcePrivate() const;
+    av_store* store() const;
+    bool ensureQueue();
+
+    // SourceBufferPrivate
+    Ref<MediaPromise> appendInternal(Ref<SharedBuffer>&&) final;
