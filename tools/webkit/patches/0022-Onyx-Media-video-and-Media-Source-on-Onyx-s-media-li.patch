+// The containers the library's demuxers read (av_format_of_mime).
+static const HashSet<String>& mimeTypes()
+{
+    static NeverDestroyed types = HashSet<String> {
+        "video/webm"_s, "audio/webm"_s, "video/x-matroska"_s, "audio/x-matroska"_s,
+        "video/mp4"_s, "audio/mp4"_s, "audio/x-m4a"_s,
+        "audio/wav"_s, "audio/x-wav"_s, "audio/wave"_s,
+        "audio/flac"_s, "audio/x-flac"_s,
+        "audio/mpeg"_s, "audio/mp3"_s,
+    };
+    return types;
+}
