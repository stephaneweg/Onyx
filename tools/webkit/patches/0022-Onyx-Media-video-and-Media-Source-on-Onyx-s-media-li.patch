+void MediaSourcePrivateOnyx::provideMediaDataIfNeeded()
+{
+    for (auto& sourceBuffer : sourceBuffers())
+        downcast<SourceBufferPrivateOnyx>(sourceBuffer.get()).provideMediaDataIfNeeded();
+}
