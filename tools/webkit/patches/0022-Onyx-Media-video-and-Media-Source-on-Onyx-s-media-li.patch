+static constexpr int usPerSecond = 1000000;
+static MediaTime fromUs(av_us t) { return MediaTime(t, usPerSecond); }
+static av_us toUs(const MediaTime& t) { return t.isValid() && t.isFinite() ? static_cast<av_us>(t.toDouble() * usPerSecond) : 0; }
+
+// What a queue holds before it says "no more for now": the media ahead of the playback position,
+// and the bytes.
+static constexpr av_us queueAhead = 3 * AV_US;
+static constexpr size_t queueBytes = 24u << 20;
+
+// A line of the kernel log ("web: media: ...": what plays, for whoever reads kmsg).
+static void mediaLog(const String& text)
+{
+    auto line = makeString("web: media: "_s, text, '\n').utf8();
+    auto bytes = line.span();
+    if (::write(2, bytes.data(), bytes.size()) < 0) { }
+}
