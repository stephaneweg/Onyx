+void MediaPlayerPrivateOnyx::paint(GraphicsContext& context, const FloatRect& rect)
+{
+    if (context.paintingDisabled() || !m_image)
+        return;
+    context.drawNativeImage(*m_image, rect, FloatRect { { }, m_image->size() });
+}
+
+RefPtr<NativeImage> MediaPlayerPrivateOnyx::nativeImageForCurrentTime()
+{
+    return m_image;
+}
