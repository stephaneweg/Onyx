             if (!handlers.numberOfHandlers[i])
@@ -595,6 +601,7 @@ void SignalHandlers::finalize()
             RELEASE_ASSERT(!result);
         }
     }
+#endif // !OS(ONYX)
 }
 
 } // namespace WTF
