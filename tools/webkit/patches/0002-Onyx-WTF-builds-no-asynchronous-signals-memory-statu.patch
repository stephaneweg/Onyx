+// Onyx delivers no fault or asynchronous signal to a handler (the kernel ends a faulting
+// process), and newlib's struct sigaction has no sa_sigaction: handlers can be added, none is
+// ever installed.
+#if !OS(ONYX)
 static void jscSignalHandler(int sig, siginfo_t* info, void* ucontext)
 {
     Signal signal = fromSystemSignal(sig);
@@ -543,6 +547,7 @@ static void jscSignalHandler(int sig, siginfo_t* info, void* ucontext)
         return;
     }
 }
+#endif // !OS(ONYX)
 
 void SignalHandlers::initialize()
