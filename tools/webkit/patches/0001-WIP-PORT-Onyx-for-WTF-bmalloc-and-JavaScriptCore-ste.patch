+
+#include "config.h"
+#include "CurrentProcessMemoryStatus.h"
+
+#include <sys/resource.h>
+
+namespace WTF {
+
+// Onyx has no /proc. libonyxposix's getrusage() reports in ru_maxrss the process's CURRENT
+// resident size (the kernel's vm_stats: owned frames and page tables, in KB). Onyx shares no
+// pages between processes but shared memory objects, and the program image is a private copy:
+// everything resident is counted as data.
+void currentProcessMemoryStatus(ProcessMemoryStatus& memoryStatus)
+{
+    memoryStatus = { };
+    struct rusage usage { };
+    if (getrusage(RUSAGE_SELF, &usage))
+        return;
+    size_t resident = static_cast<size_t>(usage.ru_maxrss) * 1024;
+    memoryStatus.size = resident;
+    memoryStatus.resident = resident;
+    memoryStatus.data = resident;
+}
+
+} // namespace WTF
