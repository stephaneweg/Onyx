+#include "config.h"
+#include <wtf/MemoryFootprint.h>
+
+#include <wtf/onyx/CurrentProcessMemoryStatus.h>
+
+namespace WTF {
+
+// The kernel's per-process count (kapi vm_stats, through getrusage): the frames the process
+// owns, page tables included -- what it costs the system.
+size_t memoryFootprint()
+{
+    ProcessMemoryStatus memoryStatus;
+    currentProcessMemoryStatus(memoryStatus);
+    return memoryStatus.resident;
+}
+
+} // namespace WTF
diff --git a/Source/bmalloc/PlatformOnyx.cmake b/Source/bmalloc/PlatformOnyx.cmake
new file mode 100644
index 00000000..5ba4408d
--- /dev/null
+++ b/Source/bmalloc/PlatformOnyx.cmake
@@ -0,0 +1,7 @@
+# The Onyx port uses the system allocator (USE_SYSTEM_MALLOC): libpas is never used, and its lock
+# has no Onyx implementation (pas_lock.h: Darwin, Linux / Windows / FreeBSD futexes). Only
+# bmalloc's thin system-malloc layer is built.
+if (USE_SYSTEM_MALLOC)
+    list(FILTER bmalloc_SOURCES EXCLUDE REGEX "^libpas/")
+    list(FILTER bmalloc_C_SOURCES EXCLUDE REGEX "^libpas/")
+endif ()
