+# INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
+# CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+# ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF
+# THE POSSIBILITY OF SUCH DAMAGE.
+
+# The Onyx port: Onyx is a small operating system for the Raspberry Pi 4 (AArch64), cross-built
+# with the aarch64-onyx-elf toolchain (GCC, newlib, Onyx's POSIX layer libonyxposix) and Onyx's
+# CMake toolchain file (CMAKE_SYSTEM_NAME Onyx). Everything is static (no shared libraries, no
+# dlopen), the page size is 64 KB, there is no executable memory for a JIT yet, no GLib: the
+# generic event loop, like the PlayStation and JSCOnly ports. Step 1 builds WTF and
+# JavaScriptCore (C_LOOP, or LLInt without JIT) and the jsc shell; WebCore and WebKit come next.
+
+set(PORT Onyx)
+
+add_definitions(-DBUILDING_ONYX__=1)
+add_definitions(-DWTF_PLATFORM_ONYX=1)
+
+set(PROJECT_VERSION_MAJOR 1)
+set(PROJECT_VERSION_MINOR 0)
+set(PROJECT_VERSION_MICRO 0)
+set(PROJECT_VERSION ${PROJECT_VERSION_MAJOR}.${PROJECT_VERSION_MINOR}.${PROJECT_VERSION_MICRO})
+
+# The kernel's pages are 64 KB (the 64 KB granule): WTF's CeilingOnPageSize, and the defaults
+# of the 64 KB page block (no JIT; LLInt rather than C_LOOP on ARM64) as the Linux distributions
+# with 64 KB pages build it.
+set(USE_64KB_PAGE_BLOCK ON)
+
+find_package(Threads REQUIRED)
+find_package(ICU 70.1 REQUIRED COMPONENTS data i18n uc)
+
+set(CMAKE_C_VISIBILITY_PRESET hidden)
+set(CMAKE_CXX_VISIBILITY_PRESET hidden)
+set(CMAKE_VISIBILITY_INLINES_HIDDEN ON)
+
+WEBKIT_OPTION_BEGIN()
+WEBKIT_OPTION_DEFINE(ENABLE_STATIC_JSC "Whether to build JavaScriptCore as a static library." PUBLIC ON)
+
+# No executable memory (the kernel refuses PROT_EXEC outside its own code arena): no JIT tier.
+# The interpreter: C_LOOP (portable C++) by default; ENABLE_C_LOOP=OFF builds the LLInt from
+# offlineasm's ARM64 back end (still no JIT, no runtime code generation).
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_JIT PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_DFG_JIT PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_FTL_JIT PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_C_LOOP PRIVATE ON)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_WEBASSEMBLY PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_SAMPLING_PROFILER PRIVATE OFF)
+
+# The system allocator (newlib's malloc over libonyxposix); no bmalloc / libpas / mimalloc, no
+# Gigacage (its multi-GB reservations), no IsoMalloc.
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(USE_SYSTEM_MALLOC PRIVATE ON)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(USE_MIMALLOC PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(USE_ISO_MALLOC PRIVATE OFF)
+
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_REMOTE_INSPECTOR PRIVATE OFF)
+WEBKIT_OPTION_DEFAULT_PORT_VALUE(ENABLE_RESOURCE_USAGE PRIVATE OFF)
+WEBKIT_OPTION_DEFINE(USE_SYSTEM_UNIFDEF "Whether to use a system-provided unifdef" PRIVATE ON)
+WEBKIT_OPTION_END()
+
+# Step 1: WTF, JavaScriptCore and its shell only.
+set(ENABLE_WEBCORE OFF)
+set(ENABLE_WEBKIT_LEGACY OFF)
+set(ENABLE_WEBKIT OFF)
+set(ENABLE_WEBINSPECTORUI OFF)
+set(ENABLE_WEBGL OFF)
+set(ENABLE_WEBGPU OFF)
+set(ENABLE_API_TESTS OFF)
+
+# Static libraries all through: the programs are static ELF images.
+set(bmalloc_LIBRARY_TYPE STATIC)
+set(WTF_LIBRARY_TYPE STATIC)
+set(JavaScriptCore_LIBRARY_TYPE STATIC)
+
+SET_AND_EXPOSE_TO_BUILD(USE_GENERIC_EVENT_LOOP 1)
+SET_AND_EXPOSE_TO_BUILD(WTF_DEFAULT_EVENT_LOOP 0)
+set(EVENT_LOOP_TYPE "Generic")
+set(LOWERCASE_EVENT_LOOP_TYPE "generic")
+
+SET_AND_EXPOSE_TO_BUILD(HAVE_PTHREAD_SETNAME_NP ON)
+SET_AND_EXPOSE_TO_BUILD(HAVE_MAP_ALIGNED OFF)
+SET_AND_EXPOSE_TO_BUILD(USE_UNIX_DOMAIN_SOCKETS ON)
