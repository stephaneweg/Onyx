+#include <mbedtls/pk.h>
+#include <memory>
+
+// The key container of WebCrypto's mbedTLS back end: an mbedtls_pk_context (an RSA or an
+// elliptic-curve key), freed with the pointer.
+
+namespace WebCore {
+
+struct MbedTLSPKDeleter {
+    void operator()(mbedtls_pk_context* key) const
+    {
+        if (!key)
+            return;
+        mbedtls_pk_free(key);
+        delete key;
+    }
+};
+
+using MbedTLSPKPtr = std::unique_ptr<mbedtls_pk_context, MbedTLSPKDeleter>;
+
+} // namespace WebCore
+
+#endif // USE(MBEDTLS)
