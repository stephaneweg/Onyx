+namespace WebCore {
+
+// The mbedTLS back end has the digests only so far (they run on PAL::CryptoDigest): every other
+// algorithm is absent from the registry, so crypto.subtle answers NotSupportedError for it
+// (CryptoNotImplementedMbedTLS.cpp only satisfies the linker).
+void CryptoAlgorithmRegistry::platformRegisterAlgorithms()
+{
+    registerAlgorithm<CryptoAlgorithmSHA1>();
+    registerAlgorithm<CryptoAlgorithmSHA256>();
+    registerAlgorithm<CryptoAlgorithmSHA384>();
+    registerAlgorithm<CryptoAlgorithmSHA512>();
+}
+
+} // namespace WebCore
