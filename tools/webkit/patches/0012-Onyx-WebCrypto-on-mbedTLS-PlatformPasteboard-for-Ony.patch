+
+#include "config.h"
+#include "CryptoAlgorithmAESKW.h"
+
+#include "CryptoKeyAES.h"
+#include "ExceptionOr.h"
+#include "MbedTLSUtilities.h"
+#include <mbedtls/nist_kw.h>
+
+namespace WebCore {
+
+static constexpr size_t semiblockSize = 8;
+
+// AES Key Wrap (RFC 3394, NIST SP 800-38F's KW: no padding): the result is 8 bytes longer.
+static std::optional<Vector<uint8_t>> cryptWrapKey(const Vector<uint8_t>& key, const Vector<uint8_t>& data)
+{
+    // (two semiblocks at least)
+    if (data.size() % semiblockSize || data.size() < 2 * semiblockSize)
+        return std::nullopt;
+
+    size_t keySize = key.size() * 8;
+    if (keySize != 128 && keySize != 192 && keySize != 256)
+        return std::nullopt;
+
+    mbedtls_nist_kw_context context;
+    mbedtls_nist_kw_init(&context);
+
+    Vector<uint8_t> cipherText(data.size() + semiblockSize);
+    size_t outputLength = 0;
+    bool succeeded = !mbedtls_nist_kw_setkey(&context, MBEDTLS_CIPHER_ID_AES, key.span().data(), keySize, 1)
+        && !mbedtls_nist_kw_wrap(&context, MBEDTLS_KW_MODE_KW, data.span().data(), data.size(), cipherText.mutableSpan().data(), &outputLength, cipherText.size());
+    mbedtls_nist_kw_free(&context);
+
+    if (!succeeded || outputLength != cipherText.size())
+        return std::nullopt;
+    return cipherText;
+}
+
+static std::optional<Vector<uint8_t>> cryptUnwrapKey(const Vector<uint8_t>& key, const Vector<uint8_t>& data)
+{
+    if (data.size() % semiblockSize || data.size() < 3 * semiblockSize)
+        return std::nullopt;
+
+    size_t keySize = key.size() * 8;
+    if (keySize != 128 && keySize != 192 && keySize != 256)
+        return std::nullopt;
+
+    mbedtls_nist_kw_context context;
+    mbedtls_nist_kw_init(&context);
+
+    // The integrity check value is compared in constant time by mbedTLS, which wipes the output
+    // when it is wrong.
+    Vector<uint8_t> plainText(data.size() - semiblockSize);
+    size_t outputLength = 0;
+    bool succeeded = !mbedtls_nist_kw_setkey(&context, MBEDTLS_CIPHER_ID_AES, key.span().data(), keySize, 0)
+        && !mbedtls_nist_kw_unwrap(&context, MBEDTLS_KW_MODE_KW, data.span().data(), data.size(), plainText.mutableSpan().data(), &outputLength, plainText.size());
+    mbedtls_nist_kw_free(&context);
+
+    if (!succeeded || outputLength != plainText.size()) {
+        MbedTLS::zeroize(plainText);
+        return std::nullopt;
+    }
+    return plainText;
+}
+
+ExceptionOr<Vector<uint8_t>> CryptoAlgorithmAESKW::platformWrapKey(const CryptoKeyAES& key, const Vector<uint8_t>& data)
+{
+    auto output = cryptWrapKey(key.key(), data);
+    if (!output)
+        return Exception { ExceptionCode::OperationError };
+    return WTF::move(*output);
+}
+
+ExceptionOr<Vector<uint8_t>> CryptoAlgorithmAESKW::platformUnwrapKey(const CryptoKeyAES& key, const Vector<uint8_t>& data)
+{
+    auto output = cryptUnwrapKey(key.key(), data);
+    if (!output)
+        return Exception { ExceptionCode::OperationError };
+    return WTF::move(*output);
+}
+
+} // namespace WebCore
