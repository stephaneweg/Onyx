+#include "config.h"
+#include "CryptoAlgorithmAESCTR.h"
+
+#include "CryptoAlgorithmAesCtrParams.h"
+#include "CryptoKeyAES.h"
+#include "ExceptionOr.h"
+#include "MbedTLSUtilities.h"
+#include <array>
+#include <mbedtls/aes.h>
+#include <mbedtls/platform_util.h>
+
+namespace WebCore {
+
+static constexpr size_t aesBlockSize = 16;
+
+static bool ctr(mbedtls_aes_context& context, const Vector<uint8_t>& counter, std::span<const uint8_t> input, std::span<uint8_t> output)
+{
+    if (counter.size() != aesBlockSize)
+        return false;
+    if (input.empty())
+        return true;
+
+    std::array<uint8_t, aesBlockSize> counterBlock;
+    std::array<uint8_t, aesBlockSize> streamBlock;
+    memcpy(counterBlock.data(), counter.span().data(), aesBlockSize);
+    size_t offset = 0;
+    int result = mbedtls_aes_crypt_ctr(&context, input.size(), &offset, counterBlock.data(), streamBlock.data(), input.data(), output.data());
+    mbedtls_platform_zeroize(streamBlock.data(), streamBlock.size());
+    return !result;
+}
+
+// mbedTLS's CTR mode counts with the whole block, WebCrypto with the block's last `counterLength`
+// bits only (the others are a nonce that must not change). As the OpenSSL back end does, the data
+// is cut where that counter would wrap: before it, counting with the whole block is the same
+// thing (nothing carries out of the counter's bits); after it, the counter starts again from
+// zero under the same nonce.
+static std::optional<Vector<uint8_t>> crypt(const Vector<uint8_t>& key, const Vector<uint8_t>& counter, size_t counterLength, const Vector<uint8_t>& inputText)
+{
+    if (counter.size() != aesBlockSize || !counterLength || counterLength > aesBlockSize * 8)
+        return std::nullopt;
+
+    size_t keySize = key.size() * 8;
+    if (keySize != 128 && keySize != 192 && keySize != 256)
+        return std::nullopt;
+
+    const size_t blocks = inputText.size() / aesBlockSize + (inputText.size() % aesBlockSize ? 1 : 0);
+
+    // Detect loop
+    if (counterLength < sizeof(size_t) * 8 && blocks > (static_cast<size_t>(1) << counterLength))
+        return std::nullopt;
+
+    // Calculate capacity before overflow
+    CryptoAlgorithmAESCTR::CounterBlockHelper counterBlockHelper(counter, counterLength);
+    size_t capacity = counterBlockHelper.countToOverflowSaturating();
+
+    // Divide data into two parts if necessary
+    size_t headSize = inputText.size();
+    if (capacity < blocks)
+        headSize = capacity * aesBlockSize;
+
+    mbedtls_aes_context context;
+    mbedtls_aes_init(&context);
+
+    Vector<uint8_t> outputText(inputText.size());
+    // (CTR uses the cipher's encryption in both directions)
+    bool succeeded = !mbedtls_aes_setkey_enc(&context, key.span().data(), keySize)
+        && ctr(context, counter, inputText.span().first(headSize), outputText.mutableSpan().first(headSize));
+    if (succeeded && capacity < blocks)
+        succeeded = ctr(context, counterBlockHelper.counterVectorAfterOverflow(), inputText.span().subspan(headSize), outputText.mutableSpan().subspan(headSize));
+    mbedtls_aes_free(&context);
+
+    if (!succeeded) {
+        MbedTLS::zeroize(outputText);
+        return std::nullopt;
+    }
+    return outputText;
+}
+
+ExceptionOr<Vector<uint8_t>> CryptoAlgorithmAESCTR::platformEncrypt(const CryptoAlgorithmAesCtrParams& parameters, const CryptoKeyAES& key, const Vector<uint8_t>& plainText)
+{
+    auto output = crypt(key.key(), parameters.counterVector(), parameters.length, plainText);
+    if (!output)
+        return Exception { ExceptionCode::OperationError };
+    return WTF::move(*output);
+}
+
+ExceptionOr<Vector<uint8_t>> CryptoAlgorithmAESCTR::platformDecrypt(const CryptoAlgorithmAesCtrParams& parameters, const CryptoKeyAES& key, const Vector<uint8_t>& cipherText)
+{
+    auto output = crypt(key.key(), parameters.counterVector(), parameters.length, cipherText);
+    if (!output)
+        return Exception { ExceptionCode::OperationError };
+    return WTF::move(*output);
+}
+
+} // namespace WebCore
