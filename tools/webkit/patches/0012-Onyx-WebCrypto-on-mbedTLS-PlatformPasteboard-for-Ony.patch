+
+#include "config.h"
+#include "PlatformPasteboard.h"
+
+#if PLATFORM(ONYX)
+
+#include "Pasteboard.h"
+#include <wtf/Lock.h>
+#include <wtf/NeverDestroyed.h>
+#include <wtf/Vector.h>
+#include <wtf/text/WTFString.h>
+
+// The clipboard of the Onyx port, for now a clipboard of its own: what a page copies is kept in this
+// process (the UI process: the web processes reach it through WebPasteboardProxy) and can be pasted into
+// any page of the same browser, as text or as HTML. It is not Onyx's system clipboard yet: nothing copied
+// here reaches another program, and nothing copied elsewhere can be pasted here.
+//
+// The system clipboard is the kernel's (kapi clipboard_set / clipboard_get, CLIP_TEXT: user/kapi.h of the
+// Onyx tree), and a program built on libonyxposix has no access to it: kapi.h is not in the POSIX
+// sysroot, and libonyxposix exports no clipboard function. What the binding needs: two functions in
+// libonyxposix, declared in a header of the sysroot, over those two kernel calls -- "set the clipboard's
+// plain text (UTF-8, a length)" and "get it (a buffer, its size, the clipboard's serial number)". With
+// them, write() below also gives the plain text to the system clipboard, and readString() / getTypes()
+// compare the system's serial with the one of our last write: when it differs another program has
+// copied something, which then replaces what is kept here (the HTML with it).
+
+namespace WebCore {
+
+namespace {
+
+struct OnyxClipboardEntry {
+    String type;
+    String string;
+};
+
+struct OnyxClipboardStore {
+    Lock lock;
+    Vector<OnyxClipboardEntry> items WTF_GUARDED_BY_LOCK(lock);
+    int64_t changeCount WTF_GUARDED_BY_LOCK(lock) { 0 };
+};
+
+OnyxClipboardStore& onyxClipboardStore()
+{
+    static NeverDestroyed<OnyxClipboardStore> store;
+    return store;
+}
+
+constexpr auto onyxPlainTextType = "text/plain;charset=utf-8"_s;
+constexpr auto onyxHTMLTextType = "text/html"_s;
+
+// "text/plain" and "text/plain;charset=utf-8" name the same thing.
+bool isSameClipboardType(const String& a, const String& b)
+{
+    if (a == b)
+        return true;
+    return a.startsWith("text/plain"_s) && b.startsWith("text/plain"_s);
+}
+
+} // namespace
+
+PlatformPasteboard::PlatformPasteboard(const String&)
+    : m_pasteboard(nullptr)
+{
+}
+
+PlatformPasteboard::PlatformPasteboard()
+    : m_pasteboard(nullptr)
+{
+}
+
+void PlatformPasteboard::performAsDataOwner(DataOwnerType, NOESCAPE const Function<void()>& actions)
+{
+    actions();
+}
+
+int64_t PlatformPasteboard::changeCount() const
+{
+    auto& clipboard = onyxClipboardStore();
+    Locker locker { clipboard.lock };
+    return clipboard.changeCount;
+}
+
+void PlatformPasteboard::getTypes(Vector<String>& types) const
+{
+    auto& clipboard = onyxClipboardStore();
+    Locker locker { clipboard.lock };
+    for (auto& item : clipboard.items)
+        types.append(item.type);
+}
+
+String PlatformPasteboard::readString(size_t, const String& type) const
+{
+    auto& clipboard = onyxClipboardStore();
+    Locker locker { clipboard.lock };
+    for (auto& item : clipboard.items) {
+        if (isSameClipboardType(item.type, type))
+            return item.string;
+    }
+    return String();
+}
+
+void PlatformPasteboard::write(const PasteboardWebContent& content)
+{
+    auto& clipboard = onyxClipboardStore();
+    Locker locker { clipboard.lock };
+    clipboard.items.clear();
+    if (!content.text.isNull())
+        clipboard.items.append(OnyxClipboardEntry { onyxPlainTextType, content.text });
+    if (!content.markup.isNull())
+        clipboard.items.append(OnyxClipboardEntry { onyxHTMLTextType, content.markup });
+    clipboard.changeCount++;
+}
+
+void PlatformPasteboard::write(const String& type, const String& string)
+{
+    auto& clipboard = onyxClipboardStore();
+    Locker locker { clipboard.lock };
+    clipboard.items.clear();
+    clipboard.items.append(OnyxClipboardEntry { type, string });
+    clipboard.changeCount++;
+}
+
+Vector<String> PlatformPasteboard::typesSafeForDOMToReadAndWrite(const String&) const
+{
+    return { };
+}
+
+int64_t PlatformPasteboard::write(const PasteboardCustomData& customData, PasteboardDataLifetime)
+{
+    PasteboardWebContent contents;
+    customData.forEachPlatformStringOrBuffer([&contents] (auto& type, auto& stringOrBuffer) {
+        if (std::holds_alternative<String>(stringOrBuffer)) {
+            if (type.startsWith("text/plain"_s))
+                contents.text = std::get<String>(stringOrBuffer);
+            else if (type == "text/html"_s)
+                contents.markup = std::get<String>(stringOrBuffer);
+        }
+    });
+    if (contents.text.isNull() && contents.markup.isNull())
+        return changeCount();
+
+    write(contents);
+    return changeCount();
+}
+
+int64_t PlatformPasteboard::write(const Vector<PasteboardCustomData>& data, PasteboardDataLifetime)
+{
+    if (data.isEmpty() || data.size() > 1)
+        return changeCount();
+
+    return write(data[0]);
+}
+
+} // namespace WebCore
+
+#endif // PLATFORM(ONYX)
