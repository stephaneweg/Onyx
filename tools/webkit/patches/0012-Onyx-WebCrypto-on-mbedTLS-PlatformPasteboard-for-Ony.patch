+#include "config.h"
+#include "CryptoAlgorithmRSA_PSS.h"
+
+#if HAVE(RSA_PSS)
+
+#include "CryptoAlgorithmRsaPssParams.h"
+#include "CryptoKeyRSA.h"
+#include "ExceptionOr.h"
+#include "MbedTLSUtilities.h"
+#include <limits>
+
+namespace WebCore {
+
+// RSASSA-PSS (RFC 8017), the key's hash for the message and for MGF1 both, the salt as long as
+// the parameters say (signing: exactly that many random bytes; verifying: exactly that length
+// expected), as the OpenSSL back end has it.
+
+ExceptionOr<Vector<uint8_t>> CryptoAlgorithmRSA_PSS::platformSign(const CryptoAlgorithmRsaPssParams& parameters, const CryptoKeyRSA& key, const Vector<uint8_t>& data)
+{
+    auto md = MbedTLS::digestAlgorithm(key.hashAlgorithmIdentifier());
+    if (md == MBEDTLS_MD_NONE)
+        return Exception { ExceptionCode::NotSupportedError };
+
+    auto digest = MbedTLS::calculateDigest(md, data.span());
+    if (!digest)
+        return Exception { ExceptionCode::OperationError };
+
+    if (key.type() != CryptoKeyType::Private)
+        return Exception { ExceptionCode::OperationError };
+
+    if (parameters.saltLength > static_cast<size_t>(std::numeric_limits<int>::max()))
+        return Exception { ExceptionCode::OperationError };
+
+    // A copy of the key: mbedTLS writes into the context it computes with (see MbedTLSUtilities.h).
+    MbedTLS::RSAContext rsa;
+    if (!rsa.copyFrom(key.platformKey()))
+        return Exception { ExceptionCode::OperationError };
+
+    // (the context's digest is MGF1's)
+    if (mbedtls_rsa_set_padding(rsa.get(), MBEDTLS_RSA_PKCS_V21, md))
+        return Exception { ExceptionCode::OperationError };
+
+    // (a salt too long for the modulus is refused there; the private operation is blinded)
+    Vector<uint8_t> signature(mbedtls_rsa_get_len(rsa.get()));
+    if (signature.isEmpty() || mbedtls_rsa_rsassa_pss_sign_ext(rsa.get(), MbedTLS::randomCallback, nullptr, md, digest->size(), digest->span().data(),
+        static_cast<int>(parameters.saltLength), signature.mutableSpan().data()))
+        return Exception { ExceptionCode::OperationError };
+
+    return signature;
+}
+
+ExceptionOr<bool> CryptoAlgorithmRSA_PSS::platformVerify(const CryptoAlgorithmRsaPssParams& parameters, const CryptoKeyRSA& key, const Vector<uint8_t>& signature, const Vector<uint8_t>& data)
+{
+    auto md = MbedTLS::digestAlgorithm(key.hashAlgorithmIdentifier());
+    if (md == MBEDTLS_MD_NONE)
+        return Exception { ExceptionCode::NotSupportedError };
+
+    auto digest = MbedTLS::calculateDigest(md, data.span());
+    if (!digest)
+        return Exception { ExceptionCode::OperationError };
+
+    MbedTLS::RSAContext rsa;
+    if (!rsa.copyFrom(key.platformKey()))
+        return Exception { ExceptionCode::OperationError };
+
+    // mbedTLS reads as many bytes as the modulus has: a signature of another length is wrong.
+    if (signature.size() != mbedtls_rsa_get_len(rsa.get()))
+        return false;
+
+    if (parameters.saltLength > static_cast<size_t>(std::numeric_limits<int>::max()))
+        return false;
+
+    return !mbedtls_rsa_rsassa_pss_verify_ext(rsa.get(), md, digest->size(), digest->span().data(), md, static_cast<int>(parameters.saltLength), signature.span().data());
+}
+
+} // namespace WebCore
+
+#endif // HAVE(RSA_PSS)
