+ * SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS
+ * INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
+ * CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+ * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF
+ * THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#include "config.h"
+#include "MbedTLSUtilities.h"
+
+#if USE(MBEDTLS)
+
+#include <mbedtls/asn1.h>
+#include <mbedtls/asn1write.h>
+#include <mbedtls/platform_util.h>
+#include <wtf/CryptographicallyRandomNumber.h>
+
+namespace WebCore {
+namespace MbedTLS {
+
+mbedtls_md_type_t digestAlgorithm(CryptoAlgorithmIdentifier hashFunction)
+{
+    switch (hashFunction) {
+    case CryptoAlgorithmIdentifier::SHA_1:
+        return MBEDTLS_MD_SHA1;
+    case CryptoAlgorithmIdentifier::SHA_256:
+        return MBEDTLS_MD_SHA256;
+    case CryptoAlgorithmIdentifier::SHA_384:
+        return MBEDTLS_MD_SHA384;
+    case CryptoAlgorithmIdentifier::SHA_512:
+        return MBEDTLS_MD_SHA512;
+    default:
+        return MBEDTLS_MD_NONE;
+    }
+}
+
+std::optional<Vector<uint8_t>> calculateDigest(mbedtls_md_type_t type, std::span<const uint8_t> message)
+{
+    const mbedtls_md_info_t* info = mbedtls_md_info_from_type(type);
+    if (!info)
+        return std::nullopt;
+
+    Vector<uint8_t> digest(mbedtls_md_get_size(info));
+    if (mbedtls_md(info, dataOrEmpty(message), message.size(), digest.mutableSpan().data()))
+        return std::nullopt;
+    return digest;
+}
+
+int randomCallback(void*, unsigned char* output, size_t length)
+{
+    cryptographicallyRandomValues(std::span<uint8_t> { output, length });
+    return 0;
+}
+
+const uint8_t* dataOrEmpty(std::span<const uint8_t> data)
+{
+    static const uint8_t empty = 0;
+    return data.data() ? data.data() : &empty;
+}
+
+void zeroize(Vector<uint8_t>& bytes)
+{
+    if (!bytes.isEmpty())
+        mbedtls_platform_zeroize(bytes.mutableSpan().data(), bytes.size());
+}
+
+Vector<uint8_t> convertToBytes(const mbedtls_mpi* number)
+{
+    size_t size = mbedtls_mpi_size(number);
+    Vector<uint8_t> bytes(size);
+    if (size && mbedtls_mpi_write_binary(number, bytes.mutableSpan().data(), size))
+        return { };
+    return bytes;
+}
+
+std::optional<Vector<uint8_t>> convertToBytesExpand(const mbedtls_mpi* number, size_t size)
+{
+    if (!size || mbedtls_mpi_size(number) > size)
+        return std::nullopt;
+
+    Vector<uint8_t> bytes(size);
+    if (mbedtls_mpi_write_binary(number, bytes.mutableSpan().data(), size))
+        return std::nullopt;
+    return bytes;
+}
+
+bool ECKeyParts::exportFrom(const mbedtls_pk_context* key)
+{
+    const mbedtls_ecp_keypair* keyPair = ecKeyPair(key);
+    if (!keyPair)
+        return false;
+    return !mbedtls_ecp_export(keyPair, group.get(), d.get(), q.get());
+}
+
+bool RSAContext::copyFrom(const mbedtls_pk_context* key)
+{
+    const mbedtls_rsa_context* rsa = rsaContext(key);
+    if (!rsa)
+        return false;
+    return !mbedtls_rsa_copy(&m_context, rsa);
+}
+
+MbedTLSPKPtr createPKContext(mbedtls_pk_type_t type)
+{
+    const mbedtls_pk_info_t* info = mbedtls_pk_info_from_type(type);
+    if (!info)
+        return nullptr;
+
+    MbedTLSPKPtr key(new mbedtls_pk_context);
+    mbedtls_pk_init(key.get());
+    if (mbedtls_pk_setup(key.get(), info))
+        return nullptr;
+    return key;
+}
+
+const mbedtls_rsa_context* rsaContext(const mbedtls_pk_context* key)
+{
+    if (!key || mbedtls_pk_get_type(key) != MBEDTLS_PK_RSA)
+        return nullptr;
+    return mbedtls_pk_rsa(*key);
+}
+
+const mbedtls_ecp_keypair* ecKeyPair(const mbedtls_pk_context* key)
+{
+    if (!key || mbedtls_pk_get_type(key) != MBEDTLS_PK_ECKEY)
+        return nullptr;
+    return mbedtls_pk_ec(*key);
+}
+
+// ---- DER (mbedTLS's ASN.1 readers take a non-const pointer and do not write through it)
+
+static bool parseAlgorithmIdentifier(unsigned char** p, const unsigned char* end, DERAlgorithmIdentifier& algorithm)
+{
+    size_t length = 0;
+    if (mbedtls_asn1_get_tag(p, end, &length, MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE))
+        return false;
+    const unsigned char* algorithmEnd = *p + length;
+
+    if (mbedtls_asn1_get_tag(p, algorithmEnd, &length, MBEDTLS_ASN1_OID) || !length)
+        return false;
+    algorithm.oid = std::span<const uint8_t> { *p, length };
+    *p += length;
+
+    if (*p == algorithmEnd)
+        return true;
+
+    // One parameter, whatever its type; it must end the AlgorithmIdentifier.
+    algorithm.hasParameters = true;
+    algorithm.parametersTag = **p;
+    ++*p;
+    if (mbedtls_asn1_get_len(p, algorithmEnd, &length))
+        return false;
+    algorithm.parameters = std::span<const uint8_t> { *p, length };
+    *p += length;
+    return *p == algorithmEnd;
+}
+
+std::optional<DERKeyInfo> parseSubjectPublicKeyInfo(std::span<const uint8_t> data)
+{
+    if (data.empty())
+        return std::nullopt;
+
+    unsigned char* p = const_cast<unsigned char*>(data.data());
+    const unsigned char* end = p + data.size();
+    size_t length = 0;
+    if (mbedtls_asn1_get_tag(&p, end, &length, MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE))
+        return std::nullopt;
+    if (p + length != end)
+        return std::nullopt;
+
+    DERKeyInfo info;
+    if (!parseAlgorithmIdentifier(&p, end, info.algorithm))
+        return std::nullopt;
+
+    // (a BIT STRING without unused bits)
+    if (mbedtls_asn1_get_bitstring_null(&p, end, &length))
+        return std::nullopt;
+    if (p + length != end)
+        return std::nullopt;
+    info.key = std::span<const uint8_t> { p, length };
+    return info;
+}
+
+std::optional<DERKeyInfo> parsePrivateKeyInfo(std::span<const uint8_t> data)
+{
+    if (data.empty())
+        return std::nullopt;
+
+    unsigned char* p = const_cast<unsigned char*>(data.data());
+    const unsigned char* end = p + data.size();
+    size_t length = 0;
+    if (mbedtls_asn1_get_tag(&p, end, &length, MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE))
+        return std::nullopt;
+    if (p + length != end)
+        return std::nullopt;
+
+    int version = -1;
+    if (mbedtls_asn1_get_int(&p, end, &version) || version)
+        return std::nullopt;
+
+    DERKeyInfo info;
+    if (!parseAlgorithmIdentifier(&p, end, info.algorithm))
+        return std::nullopt;
+
+    if (mbedtls_asn1_get_tag(&p, end, &length, MBEDTLS_ASN1_OCTET_STRING))
+        return std::nullopt;
+    info.key = std::span<const uint8_t> { p, length };
+    p += length;
+
+    if (p != end) {
+        // attributes [0] IMPLICIT SET OF Attribute: not looked at, but nothing else may follow.
+        if (*p != (MBEDTLS_ASN1_CONTEXT_SPECIFIC | MBEDTLS_ASN1_CONSTRUCTED))
+            return std::nullopt;
+        ++p;
+        if (mbedtls_asn1_get_len(&p, end, &length))
+            return std::nullopt;
+        if (p + length != end)
+            return std::nullopt;
+    }
+    return info;
+}
+
+bool oidEquals(std::span<const uint8_t> oid, const char* expected, size_t expectedLength)
+{
+    return oid.size() == expectedLength && !memcmp(oid.data(), expected, expectedLength);
+}
+
+bool readDERInteger(const uint8_t** p, const uint8_t* end, std::span<const uint8_t>& value)
+{
+    unsigned char* cursor = const_cast<unsigned char*>(*p);
+    size_t length = 0;
+    if (mbedtls_asn1_get_tag(&cursor, end, &length, MBEDTLS_ASN1_INTEGER))
+        return false;
+    if (!length || (cursor[0] & 0x80))
+        return false;
+    value = std::span<const uint8_t> { cursor, length };
+    *p = cursor + length;
+    return true;
+}
+
+Vector<uint8_t> writePrivateKeyInfo(const char* oid, size_t oidLength, std::span<const uint8_t> parameters, std::span<const uint8_t> privateKey)
+{
+    if (parameters.empty() || privateKey.empty())
+        return { };
+
+    // mbedTLS writes DER from the end of the buffer towards its start.
+    Vector<uint8_t> buffer(privateKey.size() + parameters.size() + oidLength + 48);
+    unsigned char* start = buffer.mutableSpan().data();
+    unsigned char* p = start + buffer.size();
+    size_t length = 0;
+    bool failed = false;
+    auto add = [&](int result) {
+        if (result < 0)
+            failed = true;
+        else
+            length += result;
+    };
+
+    add(mbedtls_asn1_write_octet_string(&p, start, privateKey.data(), privateKey.size()));
+    if (!failed) {
+        int parametersLength = mbedtls_asn1_write_raw_buffer(&p, start, parameters.data(), parameters.size());
+        if (parametersLength < 0)
+            failed = true;
+        else // (what it returns counts the parameters)
+            add(mbedtls_asn1_write_algorithm_identifier(&p, start, oid, oidLength, parametersLength));
+    }
+    if (!failed)
+        add(mbedtls_asn1_write_int(&p, start, 0));
+    if (!failed)
+        add(mbedtls_asn1_write_len(&p, start, length));
+    if (!failed)
+        add(mbedtls_asn1_write_tag(&p, start, MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE));
+
+    Vector<uint8_t> result;
+    if (!failed)
+        result = Vector<uint8_t>(std::span<const uint8_t> { p, length });
+    zeroize(buffer);
+    return result;
+}
+
+} // namespace MbedTLS
+} // namespace WebCore
+
+#endif // USE(MBEDTLS)
