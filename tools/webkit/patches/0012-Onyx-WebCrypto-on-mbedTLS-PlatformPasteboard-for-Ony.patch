+#include "config.h"
+#include "CryptoAlgorithmPBKDF2.h"
+
+#include "CryptoAlgorithmPbkdf2Params.h"
+#include "CryptoKeyRaw.h"
+#include "ExceptionOr.h"
+#include "MbedTLSUtilities.h"
+#include <limits>
+#include <mbedtls/pkcs5.h>
+
+namespace WebCore {
+
+ExceptionOr<Vector<uint8_t>> CryptoAlgorithmPBKDF2::platformDeriveBits(const CryptoAlgorithmPbkdf2Params& parameters, const CryptoKeyRaw& key, size_t length)
+{
+    auto algorithm = MbedTLS::digestAlgorithm(parameters.hashIdentifier);
+    if (algorithm == MBEDTLS_MD_NONE)
+        return Exception { ExceptionCode::NotSupportedError };
+
+    // iterations must not be zero.
+    if (!parameters.iterations || parameters.iterations > std::numeric_limits<unsigned>::max())
+        return Exception { ExceptionCode::OperationError };
+
+    if (length / 8 > std::numeric_limits<uint32_t>::max())
+        return Exception { ExceptionCode::OperationError };
+
+    Vector<uint8_t> output(length / 8);
+    if (output.isEmpty())
+        return output;
+
+    const auto& salt = parameters.saltVector();
+    if (mbedtls_pkcs5_pbkdf2_hmac_ext(algorithm, MbedTLS::dataOrEmpty(key.key().span()), key.key().size(), MbedTLS::dataOrEmpty(salt.span()), salt.size(),
+        static_cast<unsigned>(parameters.iterations), static_cast<uint32_t>(output.size()), output.mutableSpan().data())) {
+        MbedTLS::zeroize(output);
+        return Exception { ExceptionCode::OperationError };
+    }
+    return output;
+}
+
+} // namespace WebCore
