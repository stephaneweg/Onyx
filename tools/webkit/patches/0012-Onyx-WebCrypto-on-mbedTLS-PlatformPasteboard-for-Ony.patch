+#include "config.h"
+#include "CryptoAlgorithmAESCFB.h"
+
+#include "CryptoAlgorithmAesCbcCfbParams.h"
+#include "CryptoKeyAES.h"
+#include "ExceptionOr.h"
+#include "MbedTLSUtilities.h"
+#include <array>
+#include <mbedtls/aes.h>
+#include <mbedtls/platform_util.h>
+
+namespace WebCore {
+
+static constexpr size_t aesBlockSize = 16;
+
+// AES-CFB8 (WebKit's "AES-CFB-8"): eight bits of feedback, one block encryption per byte.
+static std::optional<Vector<uint8_t>> cfb8(int mode, const Vector<uint8_t>& key, const Vector<uint8_t>& iv, const Vector<uint8_t>& input)
+{
+    if (iv.size() != aesBlockSize)
+        return std::nullopt;
+
+    size_t keySize = key.size() * 8;
+    if (keySize != 128 && keySize != 192 && keySize != 256)
+        return std::nullopt;
+
+    mbedtls_aes_context context;
+    mbedtls_aes_init(&context);
+
+    // (mbedTLS advances the IV it is given; CFB uses the cipher's encryption in both directions)
+    std::array<uint8_t, aesBlockSize> shiftRegister;
+    memcpy(shiftRegister.data(), iv.span().data(), aesBlockSize);
+
+    Vector<uint8_t> output(input.size());
+    bool succeeded = !mbedtls_aes_setkey_enc(&context, key.span().data(), keySize)
+        && !mbedtls_aes_crypt_cfb8(&context, mode, input.size(), shiftRegister.data(), MbedTLS::dataOrEmpty(input.span()), output.mutableSpan().data());
+    mbedtls_aes_free(&context);
+    mbedtls_platform_zeroize(shiftRegister.data(), shiftRegister.size());
+
+    if (!succeeded) {
+        MbedTLS::zeroize(output);
+        return std::nullopt;
+    }
+    return output;
+}
+
+ExceptionOr<Vector<uint8_t>> CryptoAlgorithmAESCFB::platformEncrypt(const CryptoAlgorithmAesCbcCfbParams& parameters, const CryptoKeyAES& key, const Vector<uint8_t>& plainText)
+{
+    auto output = cfb8(MBEDTLS_AES_ENCRYPT, key.key(), parameters.ivVector(), plainText);
+    if (!output)
+        return Exception { ExceptionCode::OperationError };
+    return WTF::move(*output);
+}
+
+ExceptionOr<Vector<uint8_t>> CryptoAlgorithmAESCFB::platformDecrypt(const CryptoAlgorithmAesCbcCfbParams& parameters, const CryptoKeyAES& key, const Vector<uint8_t>& cipherText)
+{
+    auto output = cfb8(MBEDTLS_AES_DECRYPT, key.key(), parameters.ivVector(), cipherText);
+    if (!output)
+        return Exception { ExceptionCode::OperationError };
+    return WTF::move(*output);
+}
+
+} // namespace WebCore
