+ * INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
+ * CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+ * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF
+ * THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#pragma once
+
+#if USE(MBEDTLS)
+
+#include "CryptoAlgorithmIdentifier.h"
+#include "MbedTLSCryptoUniquePtr.h"
+#include <mbedtls/bignum.h>
+#include <mbedtls/ecp.h>
+#include <mbedtls/md.h>
+#include <mbedtls/rsa.h>
+#include <optional>
+#include <span>
+#include <stdint.h>
+#include <wtf/Noncopyable.h>
+#include <wtf/Vector.h>
+
+// What the files of WebCrypto's mbedTLS back end share: the digests, the random number callback
+// mbedTLS wants, big numbers <-> bytes, the owners of mbedTLS's contexts, and the little DER that
+// mbedTLS has no public function for (the SubjectPublicKeyInfo and PKCS #8 envelopes).
+//
+// Threads: WebCrypto runs its operations on work queues, and a CryptoKey may be used by two of
+// them at once. mbedTLS is built without MBEDTLS_THREADING_C, and its RSA and elliptic-curve
+// operations write into the context they are given (the blinding values, the cached Montgomery
+// constants, the padding mode). So a key's context is never written after the key is made: every
+// operation works on its own copy (RSAContext::copyFrom(), ECKeyParts::exportFrom()).
+
+namespace WebCore {
+namespace MbedTLS {
+
+// MBEDTLS_MD_NONE for what this back end does not do (SHA-224).
+mbedtls_md_type_t digestAlgorithm(CryptoAlgorithmIdentifier);
+std::optional<Vector<uint8_t>> calculateDigest(mbedtls_md_type_t, std::span<const uint8_t> message);
+
+// mbedTLS's f_rng: the system's cryptographic random numbers (WTF::cryptographicallyRandomValues).
+int randomCallback(void*, unsigned char* output, size_t length);
+
+// mbedTLS takes a pointer with a length of zero, but not everywhere a null one.
+const uint8_t* dataOrEmpty(std::span<const uint8_t>);
+
+void zeroize(Vector<uint8_t>&);
+
+class BigNumber {
+    WTF_MAKE_NONCOPYABLE(BigNumber);
+public:
+    BigNumber() { mbedtls_mpi_init(&m_value); }
+    ~BigNumber() { mbedtls_mpi_free(&m_value); } // (it wipes the limbs)
+    mbedtls_mpi* get() LIFETIME_BOUND { return &m_value; }
+    const mbedtls_mpi* get() const LIFETIME_BOUND { return &m_value; }
+private:
+    mbedtls_mpi m_value;
+};
+
+// Big-endian, without leading zeros (nothing for zero).
+Vector<uint8_t> convertToBytes(const mbedtls_mpi*);
+// Big-endian, exactly `size` bytes; nothing if the number does not fit.
+std::optional<Vector<uint8_t>> convertToBytesExpand(const mbedtls_mpi*, size_t size);
+
+class ECGroup {
+    WTF_MAKE_NONCOPYABLE(ECGroup);
+public:
+    ECGroup() { mbedtls_ecp_group_init(&m_group); }
+    ~ECGroup() { mbedtls_ecp_group_free(&m_group); }
+    mbedtls_ecp_group* get() LIFETIME_BOUND { return &m_group; }
+private:
+    mbedtls_ecp_group m_group;
+};
+
+class ECPoint {
+    WTF_MAKE_NONCOPYABLE(ECPoint);
+public:
+    ECPoint() { mbedtls_ecp_point_init(&m_point); }
+    ~ECPoint() { mbedtls_ecp_point_free(&m_point); }
+    mbedtls_ecp_point* get() LIFETIME_BOUND { return &m_point; }
+private:
+    mbedtls_ecp_point m_point;
+};
+
+// An elliptic-curve key taken apart, as copies: the curve, the private number (zero in a public
+// key), the public point.
+struct ECKeyParts {
+    bool exportFrom(const mbedtls_pk_context*);
+
+    ECGroup group;
+    BigNumber d;
+    ECPoint q;
+};
+
+// A private copy of an RSA key, to operate on (see "Threads" above).
+class RSAContext {
+    WTF_MAKE_NONCOPYABLE(RSAContext);
+public:
+    RSAContext() { mbedtls_rsa_init(&m_context); }
+    ~RSAContext() { mbedtls_rsa_free(&m_context); }
+    bool copyFrom(const mbedtls_pk_context*);
+    mbedtls_rsa_context* get() LIFETIME_BOUND { return &m_context; }
+private:
+    mbedtls_rsa_context m_context;
+};
+
+// A new, empty key container of the given type (MBEDTLS_PK_RSA, MBEDTLS_PK_ECKEY); null on failure.
+MbedTLSPKPtr createPKContext(mbedtls_pk_type_t);
+// The RSA / elliptic-curve key inside a container; null if it holds another kind of key.
+const mbedtls_rsa_context* rsaContext(const mbedtls_pk_context*);
+const mbedtls_ecp_keypair* ecKeyPair(const mbedtls_pk_context*);
+
+// ---- DER
+
+// AlgorithmIdentifier ::= SEQUENCE { algorithm OBJECT IDENTIFIER, parameters ANY OPTIONAL }
+struct DERAlgorithmIdentifier {
+    std::span<const uint8_t> oid; // the contents of the OBJECT IDENTIFIER
+    bool hasParameters { false };
+    uint8_t parametersTag { 0 };
+    std::span<const uint8_t> parameters; // the contents of the (one) parameter
+};
+
+struct DERKeyInfo {
+    DERAlgorithmIdentifier algorithm;
+    std::span<const uint8_t> key; // the subjectPublicKey's bytes / the privateKey's bytes
+};
+
+// SubjectPublicKeyInfo ::= SEQUENCE { algorithm AlgorithmIdentifier, subjectPublicKey BIT STRING }
+// Strict: the whole of `data` must be that one structure.
+std::optional<DERKeyInfo> parseSubjectPublicKeyInfo(std::span<const uint8_t> data);
+// PrivateKeyInfo ::= SEQUENCE { version INTEGER (0), privateKeyAlgorithm AlgorithmIdentifier,
+//     privateKey OCTET STRING, attributes [0] IMPLICIT Attributes OPTIONAL }
+std::optional<DERKeyInfo> parsePrivateKeyInfo(std::span<const uint8_t> data);
+
+bool oidEquals(std::span<const uint8_t> oid, const char* expected, size_t expectedLength);
+
+// Reads a non-negative INTEGER at *p (before end); its bytes (which may start with one zero).
+bool readDERInteger(const uint8_t** p, const uint8_t* end, std::span<const uint8_t>& value);
+
+// The PKCS #8 envelope around a private key. `parameters` is the algorithm's parameter, already
+// encoded (a NULL, a curve's OBJECT IDENTIFIER). Nothing on failure.
+Vector<uint8_t> writePrivateKeyInfo(const char* oid, size_t oidLength, std::span<const uint8_t> parameters, std::span<const uint8_t> privateKey);
+
+} // namespace MbedTLS
+} // namespace WebCore
+
+#endif // USE(MBEDTLS)
