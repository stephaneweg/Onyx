+
+#include "config.h"
+#include "CryptoAlgorithmRSASSA_PKCS1_v1_5.h"
+
+#include "CryptoKeyRSA.h"
+#include "ExceptionOr.h"
+#include "MbedTLSUtilities.h"
+
+namespace WebCore {
+
+ExceptionOr<Vector<uint8_t>> CryptoAlgorithmRSASSA_PKCS1_v1_5::platformSign(const CryptoKeyRSA& key, const Vector<uint8_t>& data)
+{
+    auto md = MbedTLS::digestAlgorithm(key.hashAlgorithmIdentifier());
+    if (md == MBEDTLS_MD_NONE)
+        return Exception { ExceptionCode::NotSupportedError };
+
+    auto digest = MbedTLS::calculateDigest(md, data.span());
+    if (!digest)
+        return Exception { ExceptionCode::OperationError };
+
+    if (key.type() != CryptoKeyType::Private)
+        return Exception { ExceptionCode::OperationError };
+
+    // A copy of the key: mbedTLS writes into the context it computes with (see MbedTLSUtilities.h).
+    MbedTLS::RSAContext rsa;
+    if (!rsa.copyFrom(key.platformKey()))
+        return Exception { ExceptionCode::OperationError };
+
+    if (mbedtls_rsa_set_padding(rsa.get(), MBEDTLS_RSA_PKCS_V15, MBEDTLS_MD_NONE))
+        return Exception { ExceptionCode::OperationError };
+
+    // The private operation is blinded with the random numbers given, and its result checked
+    // against the public key before it is given out.
+    Vector<uint8_t> signature(mbedtls_rsa_get_len(rsa.get()));
+    if (signature.isEmpty() || mbedtls_rsa_rsassa_pkcs1_v15_sign(rsa.get(), MbedTLS::randomCallback, nullptr, md, digest->size(), digest->span().data(), signature.mutableSpan().data()))
+        return Exception { ExceptionCode::OperationError };
+
+    return signature;
+}
+
+ExceptionOr<bool> CryptoAlgorithmRSASSA_PKCS1_v1_5::platformVerify(const CryptoKeyRSA& key, const Vector<uint8_t>& signature, const Vector<uint8_t>& data)
+{
+    auto md = MbedTLS::digestAlgorithm(key.hashAlgorithmIdentifier());
+    if (md == MBEDTLS_MD_NONE)
+        return Exception { ExceptionCode::NotSupportedError };
+
+    auto digest = MbedTLS::calculateDigest(md, data.span());
+    if (!digest)
+        return Exception { ExceptionCode::OperationError };
+
+    MbedTLS::RSAContext rsa;
+    if (!rsa.copyFrom(key.platformKey()))
+        return Exception { ExceptionCode::OperationError };
+
+    // mbedTLS reads as many bytes as the modulus has: a signature of another length is wrong.
+    if (signature.size() != mbedtls_rsa_get_len(rsa.get()))
+        return false;
+
+    if (mbedtls_rsa_set_padding(rsa.get(), MBEDTLS_RSA_PKCS_V15, MBEDTLS_MD_NONE))
+        return Exception { ExceptionCode::OperationError };
+
+    // (the expected encoding is built and compared whole, in constant time: no parsing of what
+    // the signature decrypts to)
+    return !mbedtls_rsa_rsassa_pkcs1_v15_verify(rsa.get(), md, digest->size(), digest->span().data(), signature.span().data());
+}
+
+} // namespace WebCore
