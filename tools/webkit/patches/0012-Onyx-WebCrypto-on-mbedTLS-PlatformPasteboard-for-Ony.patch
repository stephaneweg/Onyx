+
+#include "config.h"
+#include "CryptoAlgorithmECDH.h"
+
+#include "CryptoKeyEC.h"
+#include "MbedTLSUtilities.h"
+#include <mbedtls/ecdh.h>
+
+namespace WebCore {
+
+std::optional<Vector<uint8_t>> CryptoAlgorithmECDH::platformDeriveBits(const CryptoKeyEC& baseKey, const CryptoKeyEC& publicKey)
+{
+    if (baseKey.type() != CryptoKeyType::Private || baseKey.namedCurve() != publicKey.namedCurve())
+        return std::nullopt;
+
+    // Copies of both keys: mbedTLS writes into the group it computes with.
+    MbedTLS::ECKeyParts base;
+    MbedTLS::ECKeyParts peer;
+    if (!base.exportFrom(baseKey.platformKey().get()) || !peer.exportFrom(publicKey.platformKey().get()))
+        return std::nullopt;
+
+    // The shared secret is the x coordinate of d * Q. mbedTLS checks that Q is on the curve (it
+    // was checked when the key was imported, too) and blinds the multiplication with the random
+    // numbers it is given.
+    MbedTLS::BigNumber z;
+    if (mbedtls_ecdh_compute_shared(base.group.get(), z.get(), peer.q.get(), base.d.get(), MbedTLS::randomCallback, nullptr))
+        return std::nullopt;
+
+    // As a field element: as long as the curve's prime, zeros in front.
+    return MbedTLS::convertToBytesExpand(z.get(), (baseKey.keySizeInBits() + 7) / 8);
+}
+
+} // namespace WebCore
