+ * THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#include "config.h"
+#include "CryptoAlgorithmRSA_OAEP.h"
+
+#include "CryptoAlgorithmRsaOaepParams.h"
+#include "CryptoKeyRSA.h"
+#include "ExceptionOr.h"
+#include "MbedTLSUtilities.h"
+
+namespace WebCore {
+
+// RSAES-OAEP (RFC 8017), the key's hash for the label's digest and for MGF1 both, as the other
+// back ends have it.
+
+ExceptionOr<Vector<uint8_t>> CryptoAlgorithmRSA_OAEP::platformEncrypt(const CryptoAlgorithmRsaOaepParams& parameters, const CryptoKeyRSA& key, const Vector<uint8_t>& plainText)
+{
+    auto md = MbedTLS::digestAlgorithm(key.hashAlgorithmIdentifier());
+    if (md == MBEDTLS_MD_NONE)
+        return Exception { ExceptionCode::NotSupportedError };
+
+    // A copy of the key: mbedTLS writes into the context it computes with (see MbedTLSUtilities.h).
+    MbedTLS::RSAContext rsa;
+    if (!rsa.copyFrom(key.platformKey()))
+        return Exception { ExceptionCode::OperationError };
+
+    if (mbedtls_rsa_set_padding(rsa.get(), MBEDTLS_RSA_PKCS_V21, md))
+        return Exception { ExceptionCode::OperationError };
+
+    // (a message longer than the modulus less twice the digest less two bytes is refused there)
+    const auto& label = parameters.labelVector();
+    Vector<uint8_t> cipherText(mbedtls_rsa_get_len(rsa.get()));
+    if (cipherText.isEmpty() || mbedtls_rsa_rsaes_oaep_encrypt(rsa.get(), MbedTLS::randomCallback, nullptr, MbedTLS::dataOrEmpty(label.span()), label.size(),
+        plainText.size(), MbedTLS::dataOrEmpty(plainText.span()), cipherText.mutableSpan().data()))
+        return Exception { ExceptionCode::OperationError };
+
+    return cipherText;
+}
+
+ExceptionOr<Vector<uint8_t>> CryptoAlgorithmRSA_OAEP::platformDecrypt(const CryptoAlgorithmRsaOaepParams& parameters, const CryptoKeyRSA& key, const Vector<uint8_t>& cipherText)
+{
+    auto md = MbedTLS::digestAlgorithm(key.hashAlgorithmIdentifier());
+    if (md == MBEDTLS_MD_NONE)
+        return Exception { ExceptionCode::NotSupportedError };
+
+    if (key.type() != CryptoKeyType::Private)
+        return Exception { ExceptionCode::OperationError };
+
+    MbedTLS::RSAContext rsa;
+    if (!rsa.copyFrom(key.platformKey()))
+        return Exception { ExceptionCode::OperationError };
+
+    // mbedTLS reads as many bytes as the modulus has.
+    size_t modulusLength = mbedtls_rsa_get_len(rsa.get());
+    if (!modulusLength || cipherText.size() != modulusLength)
+        return Exception { ExceptionCode::OperationError };
+
+    if (mbedtls_rsa_set_padding(rsa.get(), MBEDTLS_RSA_PKCS_V21, md))
+        return Exception { ExceptionCode::OperationError };
+
+    // The private operation is blinded, and the padding checked in constant time; whatever is
+    // wrong, the answer is the one same error.
+    const auto& label = parameters.labelVector();
+    Vector<uint8_t> plainText(modulusLength);
+    size_t plainTextLength = 0;
+    if (mbedtls_rsa_rsaes_oaep_decrypt(rsa.get(), MbedTLS::randomCallback, nullptr, MbedTLS::dataOrEmpty(label.span()), label.size(),
+        &plainTextLength, cipherText.span().data(), plainText.mutableSpan().data(), plainText.size()) || plainTextLength > plainText.size()) {
+        MbedTLS::zeroize(plainText);
+        return Exception { ExceptionCode::OperationError };
+    }
+
+    // (mbedTLS wrote the message's bytes only: what is cut off never held plain text)
+    plainText.shrink(plainTextLength);
+    return plainText;
+}
+
+} // namespace WebCore
