+#include "config.h"
+#include "CryptoAlgorithmHKDF.h"
+
+#include "CryptoAlgorithmHkdfParams.h"
+#include "CryptoKeyRaw.h"
+#include "ExceptionOr.h"
+#include "MbedTLSUtilities.h"
+#include <mbedtls/hkdf.h>
+
+namespace WebCore {
+
+ExceptionOr<Vector<uint8_t>> CryptoAlgorithmHKDF::platformDeriveBits(const CryptoAlgorithmHkdfParams& parameters, const CryptoKeyRaw& key, size_t length)
+{
+    const mbedtls_md_info_t* info = mbedtls_md_info_from_type(MbedTLS::digestAlgorithm(parameters.hashIdentifier));
+    if (!info)
+        return Exception { ExceptionCode::NotSupportedError };
+
+    Vector<uint8_t> output(length / 8);
+    if (output.isEmpty())
+        return output;
+
+    // (RFC 5869: extract with the salt, then expand with the info; mbedTLS refuses more than 255
+    // times the digest's size, and takes an absent salt as a digest's size of zeros, as the RFC says)
+    const auto& salt = parameters.saltVector();
+    const auto& infoVector = parameters.infoVector();
+    if (mbedtls_hkdf(info, salt.isEmpty() ? nullptr : salt.span().data(), salt.size(), MbedTLS::dataOrEmpty(key.key().span()), key.key().size(),
+        MbedTLS::dataOrEmpty(infoVector.span()), infoVector.size(), output.mutableSpan().data(), output.size())) {
+        MbedTLS::zeroize(output);
+        return Exception { ExceptionCode::OperationError };
+    }
+    return output;
+}
+
+} // namespace WebCore
