+#include "config.h"
+#include "CryptoAlgorithmAESCBC.h"
+
+#include "CryptoAlgorithmAesCbcCfbParams.h"
+#include "CryptoKeyAES.h"
+#include "ExceptionOr.h"
+#include "MbedTLSUtilities.h"
+#include <array>
+#include <mbedtls/cipher.h>
+
+namespace WebCore {
+
+static constexpr size_t aesBlockSize = 16;
+
+// AES-CBC through mbedTLS's cipher layer, which does the PKCS #7 padding (and checks it, when
+// decrypting, without branching on the padding bytes).
+static std::optional<Vector<uint8_t>> crypt(mbedtls_operation_t operation, const Vector<uint8_t>& key, const Vector<uint8_t>& iv, const Vector<uint8_t>& input, CryptoAlgorithmAESCBC::Padding padding)
+{
+    // WebCrypto always gives 16 bytes (the generic code checks); WebCore's own callers (the
+    // authenticator's PIN protocol) give none and mean a block of zeros.
+    static const std::array<uint8_t, aesBlockSize> zeroIV { };
+    if (!iv.isEmpty() && iv.size() != aesBlockSize)
+        return std::nullopt;
+    const uint8_t* ivData = iv.isEmpty() ? zeroIV.data() : iv.span().data();
+
+    const mbedtls_cipher_info_t* info = mbedtls_cipher_info_from_values(MBEDTLS_CIPHER_ID_AES, key.size() * 8, MBEDTLS_MODE_CBC);
+    if (!info)
+        return std::nullopt;
+
+    mbedtls_cipher_context_t context;
+    mbedtls_cipher_init(&context);
+
+    // (room for the padding block when encrypting; mbedTLS wants a block more when decrypting too)
+    Vector<uint8_t> output(input.size() + aesBlockSize);
+    size_t outputLength = 0;
+    bool succeeded = !mbedtls_cipher_setup(&context, info)
+        && !mbedtls_cipher_setkey(&context, key.span().data(), key.size() * 8, operation)
+        && !mbedtls_cipher_set_padding_mode(&context, padding == CryptoAlgorithmAESCBC::Padding::Yes ? MBEDTLS_PADDING_PKCS7 : MBEDTLS_PADDING_NONE)
+        && !mbedtls_cipher_crypt(&context, ivData, aesBlockSize,MbedTLS::dataOrEmpty(input.span()), input.size(), output.mutableSpan().data(), &outputLength);
+    mbedtls_cipher_free(&context);
+
+    if (!succeeded || outputLength > output.size()) {
+        MbedTLS::zeroize(output);
+        return std::nullopt;
+    }
+    output.shrink(outputLength);
+    return output;
+}
+
+ExceptionOr<Vector<uint8_t>> CryptoAlgorithmAESCBC::platformEncrypt(const CryptoAlgorithmAesCbcCfbParams& parameters, const CryptoKeyAES& key, const Vector<uint8_t>& plainText, Padding padding)
+{
+    auto output = crypt(MBEDTLS_ENCRYPT, key.key(), parameters.ivVector(), plainText, padding);
+    if (!output)
+        return Exception { ExceptionCode::OperationError };
+    return WTF::move(*output);
+}
+
+ExceptionOr<Vector<uint8_t>> CryptoAlgorithmAESCBC::platformDecrypt(const CryptoAlgorithmAesCbcCfbParams& parameters, const CryptoKeyAES& key, const Vector<uint8_t>& cipherText, Padding padding)
+{
+    auto output = crypt(MBEDTLS_DECRYPT, key.key(), parameters.ivVector(), cipherText, padding);
+    if (!output)
+        return Exception { ExceptionCode::OperationError };
+    return WTF::move(*output);
+}
+
+} // namespace WebCore
