+#include "config.h"
+#include "CryptoAlgorithmAESGCM.h"
+
+#include "CryptoAlgorithmAesGcmParams.h"
+#include "CryptoKeyAES.h"
+#include "ExceptionOr.h"
+#include "MbedTLSUtilities.h"
+#include <mbedtls/gcm.h>
+
+namespace WebCore {
+
+class GCMContext {
+    WTF_MAKE_NONCOPYABLE(GCMContext);
+public:
+    GCMContext() { mbedtls_gcm_init(&m_context); }
+    ~GCMContext() { mbedtls_gcm_free(&m_context); }
+
+    bool setKey(const Vector<uint8_t>& key)
+    {
+        size_t keySize = key.size() * 8;
+        if (keySize != 128 && keySize != 192 && keySize != 256)
+            return false;
+        return !mbedtls_gcm_setkey(&m_context, MBEDTLS_CIPHER_ID_AES, key.span().data(), keySize);
+    }
+
+    mbedtls_gcm_context* get() LIFETIME_BOUND { return &m_context; }
+
+private:
+    mbedtls_gcm_context m_context;
+};
+
+// The result is the cipher text followed by the tag (tagLength bytes: 4 and 8, then 12 to 16).
+static std::optional<Vector<uint8_t>> cryptEncrypt(const Vector<uint8_t>& key, const Vector<uint8_t>& iv, const Vector<uint8_t>& plainText, const Vector<uint8_t>& additionalData, uint8_t tagLength)
+{
+    GCMContext context;
+    if (!context.setKey(key))
+        return std::nullopt;
+
+    Vector<uint8_t> cipherText(plainText.size() + tagLength);
+    size_t tagOffset = plainText.size();
+
+    // (mbedTLS refuses an empty IV and a tag outside 4 to 16 bytes)
+    if (mbedtls_gcm_crypt_and_tag(context.get(), MBEDTLS_GCM_ENCRYPT, plainText.size(), MbedTLS::dataOrEmpty(iv.span()), iv.size(),
+        MbedTLS::dataOrEmpty(additionalData.span()), additionalData.size(), MbedTLS::dataOrEmpty(plainText.span()), cipherText.mutableSpan().data(),
+        tagLength, cipherText.mutableSpan().subspan(tagOffset).data()))
+        return std::nullopt;
+
+    return cipherText;
+}
+
+static std::optional<Vector<uint8_t>> cryptDecrypt(const Vector<uint8_t>& key, const Vector<uint8_t>& iv, const Vector<uint8_t>& cipherText, const Vector<uint8_t>& additionalData, uint8_t tagLength)
+{
+    if (cipherText.size() < tagLength)
+        return std::nullopt;
+
+    GCMContext context;
+    if (!context.setKey(key))
+        return std::nullopt;
+
+    size_t cipherTextLength = cipherText.size() - tagLength;
+    auto tag = cipherText.span().subspan(cipherTextLength);
+    // (never empty, so that mbedTLS has somewhere to write when there is no text, only a tag)
+    Vector<uint8_t> plainText(cipherTextLength + 1);
+
+    // Decrypts, then compares the tags in constant time; the text is wiped if they differ.
+    if (mbedtls_gcm_auth_decrypt(context.get(), cipherTextLength, MbedTLS::dataOrEmpty(iv.span()), iv.size(),
+        MbedTLS::dataOrEmpty(additionalData.span()), additionalData.size(), tag.data(), tagLength,
+        cipherText.span().data(), plainText.mutableSpan().data())) {
+        MbedTLS::zeroize(plainText);
+        return std::nullopt;
+    }
+
+    plainText.shrink(cipherTextLength);
+    return plainText;
+}
+
+ExceptionOr<Vector<uint8_t>> CryptoAlgorithmAESGCM::platformEncrypt(const CryptoAlgorithmAesGcmParams& parameters, const CryptoKeyAES& key, const Vector<uint8_t>& plainText)
+{
+    auto output = cryptEncrypt(key.key(), parameters.ivVector(), plainText, parameters.additionalDataVector(), parameters.tagLength.value_or(0) / 8);
+    if (!output)
+        return Exception { ExceptionCode::OperationError };
+    return WTF::move(*output);
+}
+
+ExceptionOr<Vector<uint8_t>> CryptoAlgorithmAESGCM::platformDecrypt(const CryptoAlgorithmAesGcmParams& parameters, const CryptoKeyAES& key, const Vector<uint8_t>& cipherText)
+{
+    auto output = cryptDecrypt(key.key(), parameters.ivVector(), cipherText, parameters.additionalDataVector(), parameters.tagLength.value_or(0) / 8);
+    if (!output)
+        return Exception { ExceptionCode::OperationError };
+    return WTF::move(*output);
+}
+
+} // namespace WebCore
