+ * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF
+ * THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#include "config.h"
+#include "CryptoAlgorithmECDSA.h"
+
+#include "CryptoAlgorithmEcdsaParams.h"
+#include "CryptoKeyEC.h"
+#include "ExceptionOr.h"
+#include "MbedTLSUtilities.h"
+#include <mbedtls/ecdsa.h>
+
+namespace WebCore {
+
+// WebCrypto's ECDSA signature is r and s one after the other, each as long as the curve's order
+// (IEEE P1363), not the DER SEQUENCE of X9.62: hence mbedTLS's ecdsa functions that give and take
+// the two numbers, not its pk layer.
+
+ExceptionOr<Vector<uint8_t>> CryptoAlgorithmECDSA::platformSign(const CryptoAlgorithmEcdsaParams& parameters, const CryptoKeyEC& key, const Vector<uint8_t>& data)
+{
+    size_t keySizeInBytes = (key.keySizeInBits() + 7) / 8;
+
+    auto md = MbedTLS::digestAlgorithm(parameters.hashIdentifier);
+    if (md == MBEDTLS_MD_NONE)
+        return Exception { ExceptionCode::NotSupportedError };
+
+    auto digest = MbedTLS::calculateDigest(md, data.span());
+    if (!digest)
+        return Exception { ExceptionCode::OperationError };
+
+    if (key.type() != CryptoKeyType::Private)
+        return Exception { ExceptionCode::OperationError };
+
+    // A copy of the key: mbedTLS writes into the group it computes with.
+    MbedTLS::ECKeyParts parts;
+    if (!parts.exportFrom(key.platformKey().get()))
+        return Exception { ExceptionCode::OperationError };
+
+    // A random nonce (and blinding) from the system's random numbers; mbedTLS takes the digest's
+    // leftmost bits when it is longer than the curve's order.
+    MbedTLS::BigNumber r;
+    MbedTLS::BigNumber s;
+    if (mbedtls_ecdsa_sign(parts.group.get(), r.get(), s.get(), parts.d.get(), digest->span().data(), digest->size(), MbedTLS::randomCallback, nullptr))
+        return Exception { ExceptionCode::OperationError };
+
+    // Concatenate r and s, expanding r and s to keySizeInBytes.
+    auto signature = MbedTLS::convertToBytesExpand(r.get(), keySizeInBytes);
+    auto sBytes = MbedTLS::convertToBytesExpand(s.get(), keySizeInBytes);
+    if (!signature || !sBytes)
+        return Exception { ExceptionCode::OperationError };
+    signature->appendVector(*sBytes);
+    return WTF::move(*signature);
+}
+
+ExceptionOr<bool> CryptoAlgorithmECDSA::platformVerify(const CryptoAlgorithmEcdsaParams& parameters, const CryptoKeyEC& key, const Vector<uint8_t>& signature, const Vector<uint8_t>& data)
+{
+    size_t keySizeInBytes = (key.keySizeInBits() + 7) / 8;
+
+    // Bail if the signature size isn't double the key size (i.e. concatenated r and s components).
+    if (signature.size() != keySizeInBytes * 2)
+        return false;
+
+    MbedTLS::BigNumber r;
+    MbedTLS::BigNumber s;
+    if (mbedtls_mpi_read_binary(r.get(), signature.span().data(), keySizeInBytes)
+        || mbedtls_mpi_read_binary(s.get(), signature.span().subspan(keySizeInBytes).data(), keySizeInBytes))
+        return Exception { ExceptionCode::OperationError };
+
+    auto md = MbedTLS::digestAlgorithm(parameters.hashIdentifier);
+    if (md == MBEDTLS_MD_NONE)
+        return Exception { ExceptionCode::NotSupportedError };
+
+    auto digest = MbedTLS::calculateDigest(md, data.span());
+    if (!digest)
+        return Exception { ExceptionCode::OperationError };
+
+    MbedTLS::ECKeyParts parts;
+    if (!parts.exportFrom(key.platformKey().get()))
+        return Exception { ExceptionCode::OperationError };
+
+    // (r and s outside [1, n - 1] are refused there)
+    return !mbedtls_ecdsa_verify(parts.group.get(), digest->span().data(), digest->size(), parts.q.get(), r.get(), s.get());
+}
+
+} // namespace WebCore
