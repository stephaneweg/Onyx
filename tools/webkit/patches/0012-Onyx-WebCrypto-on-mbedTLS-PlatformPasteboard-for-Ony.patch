+ * THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#include "config.h"
+#include "CryptoKeyEC.h"
+
+#include "JsonWebKey.h"
+#include "MbedTLSUtilities.h"
+#include <array>
+#include <mbedtls/asn1.h>
+#include <mbedtls/asn1write.h>
+#include <mbedtls/oid.h>
+#include <mbedtls/platform_util.h>
+#include <wtf/text/Base64.h>
+
+// The elliptic-curve keys of WebCrypto's mbedTLS back end (P-256, P-384, P-521): an
+// mbedtls_pk_context of type MBEDTLS_PK_ECKEY, holding the curve, the public point and, in a
+// private key, the private number. A key is made here, checked, and never written again (see
+// "Threads" in MbedTLSUtilities.h).
+//
+// The key formats are read and written here rather than by mbedTLS's pk_parse / pk_write: those
+// accept more than WebCrypto does (PEM, PKCS #1 and SEC 1 keys without their envelope, encrypted
+// PKCS #8, curves given by their parameters, bytes after the key) and cannot write PKCS #8.
+
+namespace WebCore {
+
+static mbedtls_ecp_group_id curveIdentifier(CryptoKeyEC::NamedCurve curve)
+{
+    switch (curve) {
+    case CryptoKeyEC::NamedCurve::P256:
+        return MBEDTLS_ECP_DP_SECP256R1;
+    case CryptoKeyEC::NamedCurve::P384:
+        return MBEDTLS_ECP_DP_SECP384R1;
+    case CryptoKeyEC::NamedCurve::P521:
+        return MBEDTLS_ECP_DP_SECP521R1;
+    }
+
+    ASSERT_NOT_REACHED();
+    return MBEDTLS_ECP_DP_NONE;
+}
+
+static size_t curveSize(CryptoKeyEC::NamedCurve curve)
+{
+    switch (curve) {
+    case CryptoKeyEC::NamedCurve::P256:
+        return 256;
+    case CryptoKeyEC::NamedCurve::P384:
+        return 384;
+    case CryptoKeyEC::NamedCurve::P521:
+        return 521;
+    }
+
+    ASSERT_NOT_REACHED();
+    return 0;
+}
+
+// A point from its SEC 1 encoding (04 x y, or compressed: 02 / 03 x), then checked: not the point
+// at infinity, coordinates below the prime, on the curve (all there is to check: these curves'
+// cofactor is one).
+static bool readPoint(mbedtls_ecp_group_id curve, std::span<const uint8_t> bytes, MbedTLS::ECPoint& point)
+{
+    if (bytes.empty())
+        return false;
+
+    MbedTLS::ECGroup group;
+    if (mbedtls_ecp_group_load(group.get(), curve))
+        return false;
+    if (mbedtls_ecp_point_read_binary(group.get(), point.get(), bytes.data(), bytes.size()))
+        return false;
+    return !mbedtls_ecp_check_pubkey(group.get(), point.get());
+}
+
+// The point of a JWK's x and y: field elements, as long as the prime in a well-formed key;
+// shorter ones and zeros in front are taken, as the other back ends do.
+static bool readPoint(CryptoKeyEC::NamedCurve curve, const Vector<uint8_t>& x, const Vector<uint8_t>& y, MbedTLS::ECPoint& point)
+{
+    size_t fieldSize = (curveSize(curve) + 7) / 8;
+    Vector<uint8_t> encoded;
+    encoded.reserveInitialCapacity(1 + 2 * fieldSize);
+    encoded.append(0x04);
+    for (auto* coordinate : { &x, &y }) {
+        auto bytes = coordinate->span();
+        while (!bytes.empty() && !bytes.front())
+            bytes = bytes.subspan(1);
+        if (bytes.size() > fieldSize)
+            return false;
+        for (size_t i = bytes.size(); i < fieldSize; ++i)
+            encoded.append(0);
+        encoded.append(bytes);
+    }
+    return readPoint(curveIdentifier(curve), encoded.span(), point);
+}
+
+// A public key of a point already checked.
+static MbedTLSPKPtr createPublicKey(mbedtls_ecp_group_id curve, MbedTLS::ECPoint& point)
+{
+    auto key = MbedTLS::createPKContext(MBEDTLS_PK_ECKEY);
+    if (!key)
+        return nullptr;
+    if (mbedtls_ecp_set_public_key(curve, mbedtls_pk_ec(*key), point.get()))
+        return nullptr;
+    return key;
+}
+
+// A private key of its number d (big-endian), which must be in [1, n - 1]. Its public point is
+// computed (d * G); the one the key came with, if any, must be that point.
+static MbedTLSPKPtr createPrivateKey(mbedtls_ecp_group_id curve, std::span<const uint8_t> d, MbedTLS::ECPoint* expectedPublicPoint)
+{
+    if (d.empty())
+        return nullptr;
+
+    auto key = MbedTLS::createPKContext(MBEDTLS_PK_ECKEY);
+    if (!key)
+        return nullptr;
+
+    mbedtls_ecp_keypair* keyPair = mbedtls_pk_ec(*key);
+    if (mbedtls_ecp_read_key(curve, keyPair, d.data(), d.size()))
+        return nullptr;
+    if (mbedtls_ecp_keypair_calc_public(keyPair, MbedTLS::randomCallback, nullptr))
+        return nullptr;
+
+    if (expectedPublicPoint) {
+        MbedTLS::ECKeyParts parts;
+        if (!parts.exportFrom(key.get()))
+            return nullptr;
+        if (mbedtls_ecp_point_cmp(parts.q.get(), expectedPublicPoint->get()))
+            return nullptr;
+    }
+    return key;
+}
+
+size_t CryptoKeyEC::keySizeInBits() const
+{
+    return curveSize(m_curve);
+}
+
+bool CryptoKeyEC::platformSupportedCurve(NamedCurve curve)
+{
+    return curve == NamedCurve::P256 || curve == NamedCurve::P384 || curve == NamedCurve::P521;
+}
+
+std::optional<CryptoKeyPair> CryptoKeyEC::platformGeneratePair(CryptoAlgorithmIdentifier identifier, NamedCurve curve, bool extractable, CryptoKeyUsageBitmap usages)
+{
+    // To generate a key pair, we generate a private key and extract the public key from the private key.
+    auto privateKeyContext = MbedTLS::createPKContext(MBEDTLS_PK_ECKEY);
+    if (!privateKeyContext)
+        return std::nullopt;
+
+    if (mbedtls_ecp_gen_key(curveIdentifier(curve), mbedtls_pk_ec(*privateKeyContext), MbedTLS::randomCallback, nullptr))
+        return std::nullopt;
+
+    MbedTLS::ECKeyParts parts;
+    if (!parts.exportFrom(privateKeyContext.get()))
+        return std::nullopt;
+
+    auto publicKeyContext = createPublicKey(curveIdentifier(curve), parts.q);
+    if (!publicKeyContext)
+        return std::nullopt;
+
+    auto publicKey = CryptoKeyEC::create(identifier, curve, CryptoKeyType::Public, WTF::move(publicKeyContext), true, usages);
+    auto privateKey = CryptoKeyEC::create(identifier, curve, CryptoKeyType::Private, WTF::move(privateKeyContext), extractable, usages);
+    return CryptoKeyPair { WTF::move(publicKey), WTF::move(privateKey) };
+}
+
+RefPtr<CryptoKeyEC> CryptoKeyEC::platformImportRaw(CryptoAlgorithmIdentifier identifier, NamedCurve curve, Vector<uint8_t>&& keyData, bool extractable, CryptoKeyUsageBitmap usages)
+{
+    MbedTLS::ECPoint point;
+    if (!readPoint(curveIdentifier(curve), keyData.span(), point))
+        return nullptr;
+
+    auto key = createPublicKey(curveIdentifier(curve), point);
+    if (!key)
+        return nullptr;
+
+    return create(identifier, curve, CryptoKeyType::Public, WTF::move(key), extractable, usages);
+}
+
+RefPtr<CryptoKeyEC> CryptoKeyEC::platformImportJWKPublic(CryptoAlgorithmIdentifier identifier, NamedCurve curve, Vector<uint8_t>&& x, Vector<uint8_t>&& y, bool extractable, CryptoKeyUsageBitmap usages)
+{
+    MbedTLS::ECPoint point;
+    if (!readPoint(curve, x, y, point))
+        return nullptr;
+
+    auto key = createPublicKey(curveIdentifier(curve), point);
+    if (!key)
+        return nullptr;
+
+    return create(identifier, curve, CryptoKeyType::Public, WTF::move(key), extractable, usages);
+}
+
+RefPtr<CryptoKeyEC> CryptoKeyEC::platformImportJWKPrivate(CryptoAlgorithmIdentifier identifier, NamedCurve curve, Vector<uint8_t>&& x, Vector<uint8_t>&& y, Vector<uint8_t>&& d, bool extractable, CryptoKeyUsageBitmap usages)
+{
+    MbedTLS::ECPoint point;
+    if (!readPoint(curve, x, y, point))
+        return nullptr;
+
+    // (x, y) must be d * G.
+    auto key = createPrivateKey(curveIdentifier(curve), d.span(), &point);
+    MbedTLS::zeroize(d);
+    if (!key)
+        return nullptr;
+
+    return create(identifier, curve, CryptoKeyType::Private, WTF::move(key), extractable, usages);
+}
+
+static bool supportedAlgorithmIdentifier(CryptoAlgorithmIdentifier identifier, std::span<const uint8_t> oid)
+{
+    switch (identifier) {
+    case CryptoAlgorithmIdentifier::ECDSA:
+        // ECDSA only supports id-ecPublicKey algorithms for imported keys.
+        return MbedTLS::oidEquals(oid, MBEDTLS_OID_EC_ALG_UNRESTRICTED, MBEDTLS_OID_SIZE(MBEDTLS_OID_EC_ALG_UNRESTRICTED));
+    case CryptoAlgorithmIdentifier::ECDH:
+        // ECDH supports both id-ecPublicKey and id-ecDH algorithms for imported keys.
+        return MbedTLS::oidEquals(oid, MBEDTLS_OID_EC_ALG_UNRESTRICTED, MBEDTLS_OID_SIZE(MBEDTLS_OID_EC_ALG_UNRESTRICTED))
+            || MbedTLS::oidEquals(oid, MBEDTLS_OID_EC_ALG_ECDH, MBEDTLS_OID_SIZE(MBEDTLS_OID_EC_ALG_ECDH));
+    default:
+        ASSERT_NOT_REACHED();
+        return false;
+    }
+}
+
+// Whether an OBJECT IDENTIFIER's contents name this curve.
+static bool isCurve(std::span<const uint8_t> oid, mbedtls_ecp_group_id curve)
+{
+    mbedtls_asn1_buf buffer;
+    buffer.tag = MBEDTLS_ASN1_OID;
+    buffer.len = oid.size();
+    buffer.p = const_cast<unsigned char*>(oid.data());
+    mbedtls_ecp_group_id found = MBEDTLS_ECP_DP_NONE;
+    return !mbedtls_oid_get_ec_grp(&buffer, &found) && found == curve;
+}
+
+// ECParameters ::= CHOICE { namedCurve OBJECT IDENTIFIER, -- implicitCurve NULL, specifiedCurve SpecifiedECDomain }
+// Only "namedCurve" is supported.
+static bool hasNamedCurve(const MbedTLS::DERAlgorithmIdentifier& algorithm, mbedtls_ecp_group_id curve)
+{
+    return algorithm.hasParameters && algorithm.parametersTag == MBEDTLS_ASN1_OID && isCurve(algorithm.parameters, curve);
+}
+
+RefPtr<CryptoKeyEC> CryptoKeyEC::platformImportSpki(CryptoAlgorithmIdentifier identifier, NamedCurve curve, Vector<uint8_t>&& keyData, bool extractable, CryptoKeyUsageBitmap usages)
+{
+    // The subjectPublicKey is taken after verifying that the algorithm in the SPKI data matches
+    // the given identifier and curve; then a key of the named curve is made of it.
+    auto info = MbedTLS::parseSubjectPublicKeyInfo(keyData.span());
+    if (!info)
+        return nullptr;
+
+    if (!supportedAlgorithmIdentifier(identifier, info->algorithm.oid))
+        return nullptr;
+    if (!hasNamedCurve(info->algorithm, curveIdentifier(curve)))
+        return nullptr;
+
+    MbedTLS::ECPoint point;
+    if (!readPoint(curveIdentifier(curve), info->key, point))
+        return nullptr;
+
+    // (a key of the type MBEDTLS_PK_ECKEY whatever the algorithm was: it is exported as id-ecPublicKey)
+    auto key = createPublicKey(curveIdentifier(curve), point);
+    if (!key)
+        return nullptr;
+
+    return adoptRef(new CryptoKeyEC(identifier, curve, CryptoKeyType::Public, WTF::move(key), extractable, usages));
+}
+
+// ECPrivateKey ::= SEQUENCE {            (RFC 5915, SEC 1)
+//   version        INTEGER { ecPrivkeyVer1(1) },
+//   privateKey     OCTET STRING,
+//   parameters [0] ECParameters {{ NamedCurve }} OPTIONAL,
+//   publicKey  [1] BIT STRING OPTIONAL
+// }
+static MbedTLSPKPtr parseECPrivateKey(std::span<const uint8_t> data, mbedtls_ecp_group_id curve)
+{
+    if (data.empty())
+        return nullptr;
+
+    // (mbedTLS's ASN.1 readers take a non-const pointer and do not write through it)
+    unsigned char* p = const_cast<unsigned char*>(data.data());
+    const unsigned char* end = p + data.size();
+    size_t length = 0;
+    if (mbedtls_asn1_get_tag(&p, end, &length, MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE))
+        return nullptr;
+    if (p + length != end)
+        return nullptr;
+
+    int version = 0;
+    if (mbedtls_asn1_get_int(&p, end, &version) || version != 1)
+        return nullptr;
+
+    if (mbedtls_asn1_get_tag(&p, end, &length, MBEDTLS_ASN1_OCTET_STRING))
+        return nullptr;
+    std::span<const uint8_t> d { p, length };
+    p += length;
+
+    // The curve again: the same one, if it is there.
+    if (p != end && *p == (MBEDTLS_ASN1_CONTEXT_SPECIFIC | MBEDTLS_ASN1_CONSTRUCTED | 0)) {
+        if (mbedtls_asn1_get_tag(&p, end, &length, MBEDTLS_ASN1_CONTEXT_SPECIFIC | MBEDTLS_ASN1_CONSTRUCTED | 0))
+            return nullptr;
+        const unsigned char* parametersEnd = p + length;
+        if (mbedtls_asn1_get_tag(&p, parametersEnd, &length, MBEDTLS_ASN1_OID))
+            return nullptr;
+        if (p + length != parametersEnd || !isCurve(std::span<const uint8_t> { p, length }, curve))
+            return nullptr;
+        p += length;
+    }
+
+    MbedTLS::ECPoint publicPoint;
+    bool hasPublicPoint = false;
+    if (p != end) {
+        if (mbedtls_asn1_get_tag(&p, end, &length, MBEDTLS_ASN1_CONTEXT_SPECIFIC | MBEDTLS_ASN1_CONSTRUCTED | 1))
+            return nullptr;
+        const unsigned char* publicKeyEnd = p + length;
+        if (mbedtls_asn1_get_bitstring_null(&p, publicKeyEnd, &length))
+            return nullptr;
+        if (p + length != publicKeyEnd)
+            return nullptr;
+        if (!readPoint(curve, std::span<const uint8_t> { p, length }, publicPoint))
+            return nullptr;
+        hasPublicPoint = true;
+        p += length;
+    }
+
+    if (p != end)
+        return nullptr;
+
+    return createPrivateKey(curve, d, hasPublicPoint ? &publicPoint : nullptr);
+}
+
+RefPtr<CryptoKeyEC> CryptoKeyEC::platformImportPkcs8(CryptoAlgorithmIdentifier identifier, NamedCurve curve, Vector<uint8_t>&& keyData, bool extractable, CryptoKeyUsageBitmap usages)
+{
+    auto info = MbedTLS::parsePrivateKeyInfo(keyData.span());
+    if (!info)
+        return nullptr;
+
+    if (!supportedAlgorithmIdentifier(identifier, info->algorithm.oid))
+        return nullptr;
+    if (!hasNamedCurve(info->algorithm, curveIdentifier(curve)))
+        return nullptr;
+
+    auto key = parseECPrivateKey(info->key, curveIdentifier(curve));
+    MbedTLS::zeroize(keyData);
+    if (!key)
+        return nullptr;
+
+    return adoptRef(new CryptoKeyEC(identifier, curve, CryptoKeyType::Private, WTF::move(key), extractable, usages));
+}
+
+Vector<uint8_t> CryptoKeyEC::platformExportRaw() const
+{
+    const mbedtls_ecp_keypair* keyPair = MbedTLS::ecKeyPair(platformKey().get());
+    if (!keyPair)
+        return { };
+
+    // 04 x y, x and y as long as the prime.
+    std::array<uint8_t, MBEDTLS_ECP_MAX_PT_LEN> buffer;
+    size_t length = 0;
+    if (mbedtls_ecp_write_public_key(keyPair, MBEDTLS_ECP_PF_UNCOMPRESSED, &length, buffer.data(), buffer.size()))
+        return { };
+    if (length != 1 + 2 * ((keySizeInBits() + 7) / 8))
+        return { };
+
+    return Vector<uint8_t>(std::span<const uint8_t> { buffer.data(), length });
+}
+
+bool CryptoKeyEC::platformAddFieldElements(JsonWebKey& jwk) const
+{
+    size_t keySizeInBytes = (keySizeInBits() + 7) / 8;
+
+    const mbedtls_ecp_keypair* keyPair = MbedTLS::ecKeyPair(platformKey().get());
+    if (!keyPair)
+        return false;
+
+    auto point = platformExportRaw();
+    if (point.size() != 1 + 2 * keySizeInBytes)
+        return false;
+    jwk.x = base64URLEncodeToString(point.span().subspan(1, keySizeInBytes));
+    jwk.y = base64URLEncodeToString(point.span().subspan(1 + keySizeInBytes, keySizeInBytes));
+
+    if (type() == Type::Private) {
+        // (as long as the curve's order, zeros in front: RFC 7518, 6.2.2.1)
+        std::array<uint8_t, MBEDTLS_ECP_MAX_BYTES> d;
+        size_t length = 0;
+        if (mbedtls_ecp_write_key_ext(keyPair, &length, d.data(), d.size()) || length != keySizeInBytes) {
+            mbedtls_platform_zeroize(d.data(), d.size());
+            return false;
+        }
+        jwk.d = base64URLEncodeToString(std::span<const uint8_t> { d.data(), length });
+        mbedtls_platform_zeroize(d.data(), d.size());
+    }
+    return true;
+}
+
+Vector<uint8_t> CryptoKeyEC::platformExportSpki() const
+{
+    if (type() != CryptoKeyType::Public)
+        return { };
+
+    // SubjectPublicKeyInfo: id-ecPublicKey, the curve's name, the point uncompressed. mbedTLS
+    // writes it at the end of the buffer.
+    std::array<uint8_t, MBEDTLS_ECP_MAX_PT_LEN + 64> buffer;
+    int length = mbedtls_pk_write_pubkey_der(platformKey().get(), buffer.data(), buffer.size());
+    if (length <= 0 || static_cast<size_t>(length) > buffer.size())
+        return { };
+
+    return Vector<uint8_t>(std::span<const uint8_t> { buffer }.last(length));
+}
+
+Vector<uint8_t> CryptoKeyEC::platformExportPkcs8() const
+{
+    if (type() != CryptoKeyType::Private)
+        return { };
+
+    const mbedtls_ecp_keypair* keyPair = MbedTLS::ecKeyPair(platformKey().get());
+    if (!keyPair)
+        return { };
+
+    std::array<uint8_t, MBEDTLS_ECP_MAX_PT_LEN> point;
+    size_t pointLength = 0;
+    if (mbedtls_ecp_write_public_key(keyPair, MBEDTLS_ECP_PF_UNCOMPRESSED, &pointLength, point.data(), point.size()))
+        return { };
+
+    const char* curveOID = nullptr;
+    size_t curveOIDLength = 0;
+    if (mbedtls_oid_get_oid_by_ec_grp(curveIdentifier(m_curve), &curveOID, &curveOIDLength))
+        return { };
+
+    // The private number, as long as the curve's order (RFC 5915).
+    std::array<uint8_t, MBEDTLS_ECP_MAX_BYTES> d;
+    size_t dLength = 0;
+
+    // The ECPrivateKey (see parseECPrivateKey), written from the end of the buffer: without its
+    // parameters -- the curve is named by the PKCS #8 envelope --, with the public key, as the
+    // other browsers write it.
+    std::array<uint8_t, MBEDTLS_ECP_MAX_PT_LEN + MBEDTLS_ECP_MAX_BYTES + 32> buffer;
+    unsigned char* start = buffer.data();
+    unsigned char* p = start + buffer.size();
+    size_t length = 0;
+    bool failed = !!mbedtls_ecp_write_key_ext(keyPair, &dLength, d.data(), d.size());
+    auto add = [&](int result) {
+        if (result < 0)
+            failed = true;
+        else
+            length += result;
+    };
+
+    if (!failed)
+        add(mbedtls_asn1_write_bitstring(&p, start, point.data(), pointLength * 8));
+    if (!failed)
+        add(mbedtls_asn1_write_len(&p, start, length));
+    if (!failed)
+        add(mbedtls_asn1_write_tag(&p, start, MBEDTLS_ASN1_CONTEXT_SPECIFIC | MBEDTLS_ASN1_CONSTRUCTED | 1));
+    if (!failed)
+        add(mbedtls_asn1_write_octet_string(&p, start, d.data(), dLength));
+    if (!failed)
+        add(mbedtls_asn1_write_int(&p, start, 1));
+    if (!failed)
+        add(mbedtls_asn1_write_len(&p, start, length));
+    if (!failed)
+        add(mbedtls_asn1_write_tag(&p, start, MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE));
+
+    // The envelope's algorithm: id-ecPublicKey, its parameter the curve's name.
+    std::array<uint8_t, 32> parameters;
+    unsigned char* parametersStart = parameters.data();
+    unsigned char* q = parametersStart + parameters.size();
+    int parametersLength = failed ? -1 : mbedtls_asn1_write_oid(&q, parametersStart, curveOID, curveOIDLength);
+
+    Vector<uint8_t> result;
+    if (!failed && parametersLength > 0) {
+        result = MbedTLS::writePrivateKeyInfo(MBEDTLS_OID_EC_ALG_UNRESTRICTED, MBEDTLS_OID_SIZE(MBEDTLS_OID_EC_ALG_UNRESTRICTED),
+            std::span<const uint8_t> { q, static_cast<size_t>(parametersLength) }, std::span<const uint8_t> { p, length });
+    }
+
+    mbedtls_platform_zeroize(d.data(), d.size());
+    mbedtls_platform_zeroize(buffer.data(), buffer.size());
+    return result;
+}
+
+} // namespace WebCore
