+// The RSA keys of WebCrypto's mbedTLS back end: an mbedtls_pk_context of type MBEDTLS_PK_RSA. A
+// key is made here, completed (mbedTLS computes the CRT numbers itself), checked, and never
+// written again: the operations work on copies (see "Threads" in MbedTLSUtilities.h).
+//
+// The limits are mbedTLS's: a modulus of at most MBEDTLS_MPI_MAX_SIZE bytes (8192 bits); two
+// primes; to generate, a modulus of 1024 bits at least, an even number of them, and a public
+// exponent that fits in an int.
+//
+// The key formats are read here rather than by mbedTLS's pk_parse, which accepts more than
+// WebCrypto does (PEM, PKCS #1 keys without their envelope, encrypted PKCS #8, bytes after the key).
+
+namespace WebCore {
+
+static constexpr std::array<uint8_t, 2> derNull { 0x05, 0x00 };
+
+// A key container of the public numbers n and e (big-endian).
+static MbedTLSPKPtr createPublicKey(std::span<const uint8_t> n, std::span<const uint8_t> e)
+{
+    if (n.empty() || e.empty())
+        return nullptr;
+
+    auto key = MbedTLS::createPKContext(MBEDTLS_PK_RSA);
+    if (!key)
+        return nullptr;
+
+    mbedtls_rsa_context* rsa = mbedtls_pk_rsa(*key);
+    if (mbedtls_rsa_import_raw(rsa, n.data(), n.size(), nullptr, 0, nullptr, 0, nullptr, 0, e.data(), e.size()))
+        return nullptr;
+    if (mbedtls_rsa_complete(rsa))
+        return nullptr;
+    // (a modulus of 128 bits at least, odd; an odd exponent, above one and below the modulus)
+    if (mbedtls_rsa_check_pubkey(rsa))
+        return nullptr;
+    if (mbedtls_rsa_get_len(rsa) > MBEDTLS_MPI_MAX_SIZE)
+        return nullptr;
+    return key;
+}
+
+// A key container of n, e, the private exponent d and the primes p and q (big-endian). The CRT
+// numbers (d mod (p - 1), d mod (q - 1), 1 / q mod p) are computed, not taken from the key.
+static MbedTLSPKPtr createPrivateKey(std::span<const uint8_t> n, std::span<const uint8_t> e, std::span<const uint8_t> d, std::span<const uint8_t> p, std::span<const uint8_t> q)
+{
+    if (n.empty() || e.empty() || d.empty() || p.empty() || q.empty())
+        return nullptr;
+
+    auto key = MbedTLS::createPKContext(MBEDTLS_PK_RSA);
+    if (!key)
+        return nullptr;
+
+    mbedtls_rsa_context* rsa = mbedtls_pk_rsa(*key);
+    if (mbedtls_rsa_import_raw(rsa, n.data(), n.size(), p.data(), p.size(), q.data(), q.size(), d.data(), d.size(), e.data(), e.size()))
+        return nullptr;
+    if (mbedtls_rsa_complete(rsa))
+        return nullptr;
+    // (the public key's checks, and: n = p * q, d * e = 1 modulo p - 1 and modulo q - 1, the CRT
+    // numbers; p and q are not tested for primality)
+    if (mbedtls_rsa_check_privkey(rsa))
+        return nullptr;
+    if (mbedtls_rsa_get_len(rsa) > MBEDTLS_MPI_MAX_SIZE)
+        return nullptr;
+    return key;
+}
+
+RefPtr<CryptoKeyRSA> CryptoKeyRSA::create(CryptoAlgorithmIdentifier identifier, CryptoAlgorithmIdentifier hash, bool hasHash, const CryptoKeyRSAComponents& keyData, bool extractable, CryptoKeyUsageBitmap usages)
+{
+    CryptoKeyType keyType;
+    switch (keyData.type()) {
+    case CryptoKeyRSAComponents::Type::Public:
+        keyType = CryptoKeyType::Public;
+        break;
+    case CryptoKeyRSAComponents::Type::Private:
+        keyType = CryptoKeyType::Private;
+        break;
+    default:
+        return nullptr;
+    }
+
+    // When creating a private key, we require the p and q prime information.
+    if (keyType == CryptoKeyType::Private && !keyData.hasAdditionalPrivateKeyParameters())
+        return nullptr;
+
+    // But we don't currently support creating keys with any additional prime information.
+    if (!keyData.otherPrimeInfos().isEmpty())
+        return nullptr;
+
+    // For both public and private keys, we need the public modulus and exponent.
+    if (keyData.modulus().isEmpty() || keyData.exponent().isEmpty())
+        return nullptr;
+
+    MbedTLSPKPtr key;
+    if (keyType == CryptoKeyType::Private) {
+        // For private keys, we require the private exponent, as well as p and q prime information.
+        if (keyData.privateExponent().isEmpty() || keyData.firstPrimeInfo().primeFactor.isEmpty() || keyData.secondPrimeInfo().primeFactor.isEmpty())
+            return nullptr;
+        key = createPrivateKey(keyData.modulus().span(), keyData.exponent().span(), keyData.privateExponent().span(),
+            keyData.firstPrimeInfo().primeFactor.span(), keyData.secondPrimeInfo().primeFactor.span());
+    } else
+        key = createPublicKey(keyData.modulus().span(), keyData.exponent().span());
+
+    if (!key)
+        return nullptr;
+
+    return adoptRef(new CryptoKeyRSA(identifier, hash, hasHash, keyType, WTF::move(key), extractable, usages));
+}
+
+CryptoKeyRSA::CryptoKeyRSA(CryptoAlgorithmIdentifier identifier, CryptoAlgorithmIdentifier hash, bool hasHash, CryptoKeyType type, PlatformRSAKeyContainer&& platformKey, bool extractable, CryptoKeyUsageBitmap usages)
+    : CryptoKey(identifier, type, extractable, usages)
+    , m_platformKey(WTF::move(platformKey))
+    , m_restrictedToSpecificHash(hasHash)
+    , m_hash(hash)
+{
+}
+
+bool CryptoKeyRSA::isRestrictedToHash(CryptoAlgorithmIdentifier& identifier) const
+{
+    if (!m_restrictedToSpecificHash)
+        return false;
+
+    identifier = m_hash;
+    return true;
+}
+
+size_t CryptoKeyRSA::keySizeInBits() const
+{
+    const mbedtls_rsa_context* rsa = MbedTLS::rsaContext(m_platformKey.get());
+    if (!rsa)
+        return 0;
+
+    return mbedtls_rsa_get_len(rsa) * 8;
+}
+
+// Convert the exponent vector to a 32-bit value, if possible.
+static std::optional<uint32_t> exponentVectorToUInt32(const Vector<uint8_t>& exponent)
+{
+    if (exponent.size() > 4) {
+        if (std::any_of(exponent.begin(), exponent.end() - 4, [](uint8_t element) { return !!element; }))
+            return std::nullopt;
+    }
+
+    uint32_t result = 0;
+    for (size_t size = exponent.size(), i = std::min<size_t>(4, size); i > 0; --i) {
+        result <<= 8;
+        result += exponent[size - i];
+    }
+
+    return result;
+}
+
+static WorkQueue& keyGenerationQueue()
+{
+    static std::once_flag onceFlag;
+    static LazyNeverDestroyed<Ref<WorkQueue>> queue;
+    std::call_once(onceFlag, [] {
+        queue.construct(WorkQueue::create("org.webkit.WebCrypto.RSAKeyGeneration"_s));
+    });
+    return queue.get().get();
+}
+
+// The key pair: the private key generated (two random primes: seconds of computing), the public
+// key made of its n and e.
+static bool generateKeyPair(unsigned modulusLength, int exponent, MbedTLSPKPtr& publicKey, MbedTLSPKPtr& privateKey)
+{
+    privateKey = MbedTLS::createPKContext(MBEDTLS_PK_RSA);
+    if (!privateKey)
+        return false;
+
+    mbedtls_rsa_context* rsa = mbedtls_pk_rsa(*privateKey);
+    if (mbedtls_rsa_gen_key(rsa, MbedTLS::randomCallback, nullptr, modulusLength, exponent))
+        return false;
+    if (mbedtls_rsa_check_privkey(rsa))
+        return false;
+
+    MbedTLS::BigNumber n;
+    MbedTLS::BigNumber e;
+    if (mbedtls_rsa_export(rsa, n.get(), nullptr, nullptr, nullptr, e.get()))
+        return false;
+
+    auto modulus = MbedTLS::convertToBytes(n.get());
+    auto publicExponent = MbedTLS::convertToBytes(e.get());
+    publicKey = createPublicKey(modulus.span(), publicExponent.span());
+    return !!publicKey;
+}
+
+void CryptoKeyRSA::generatePair(CryptoAlgorithmIdentifier algorithm, CryptoAlgorithmIdentifier hash, bool hasHash, unsigned modulusLength, const Vector<uint8_t>& publicExponent, bool extractable, CryptoKeyUsageBitmap usages, KeyPairCallback&& callback, VoidCallback&& failureCallback, ScriptExecutionContext* context)
+{
+    // mbedTLS takes the exponent as an int, and refuses one smaller than three; an even one
+    // would never give a key.
+    auto e = exponentVectorToUInt32(publicExponent);
+    if (!e || *e < 3 || !(*e & 0x1) || *e > static_cast<uint32_t>(std::numeric_limits<int>::max())) {
+        failureCallback();
+        return;
+    }
+
+    // (mbedTLS would refuse these too)
+    if (modulusLength < MBEDTLS_RSA_GEN_KEY_MIN_BITS || (modulusLength % 2) || modulusLength > MBEDTLS_MPI_MAX_SIZE * 8 || !context) {
+        failureCallback();
+        return;
+    }
+
+    // Generating the key takes seconds: on a work queue, as the Cocoa port does it; the key and
+    // the callbacks then go back to the context's thread.
+    keyGenerationQueue().dispatch([algorithm, hash, hasHash, modulusLength, exponent = static_cast<int>(*e), extractable, usages, callback = WTF::move(callback), failureCallback = WTF::move(failureCallback), contextIdentifier = context->identifier()]() mutable {
+        MbedTLSPKPtr publicKeyContext;
+        MbedTLSPKPtr privateKeyContext;
+        if (!generateKeyPair(modulusLength, exponent, publicKeyContext, privateKeyContext)) {
+            ScriptExecutionContext::postTaskTo(contextIdentifier, [callback = WTF::move(callback), failureCallback = WTF::move(failureCallback)](auto&) {
+                failureCallback();
+            });
+            return;
+        }
+
+        ScriptExecutionContext::postTaskTo(contextIdentifier, [algorithm, hash, hasHash, extractable, usages, callback = WTF::move(callback), failureCallback = WTF::move(failureCallback), publicKeyContext = WTF::move(publicKeyContext), privateKeyContext = WTF::move(privateKeyContext)](auto&) mutable {
+            auto publicKey = CryptoKeyRSA::create(algorithm, hash, hasHash, CryptoKeyType::Public, WTF::move(publicKeyContext), true, usages);
+            auto privateKey = CryptoKeyRSA::create(algorithm, hash, hasHash, CryptoKeyType::Private, WTF::move(privateKeyContext), extractable, usages);
+
+            callback(CryptoKeyPair { WTF::move(publicKey), WTF::move(privateKey) });
+        });
+    });
+}
+
+// Only rsaEncryption (as the OpenSSL back end: its d2i functions give a key of the type
+// EVP_PKEY_RSA for that identifier alone), its parameters NULL or, leniently, absent.
+static bool supportedAlgorithmIdentifier(const MbedTLS::DERAlgorithmIdentifier& algorithm)
+{
+    if (!MbedTLS::oidEquals(algorithm.oid, MBEDTLS_OID_PKCS1_RSA, MBEDTLS_OID_SIZE(MBEDTLS_OID_PKCS1_RSA)))
+        return false;
+    if (!algorithm.hasParameters)
+        return true;
+    return algorithm.parametersTag == MBEDTLS_ASN1_NULL && algorithm.parameters.empty();
+}
+
+RefPtr<CryptoKeyRSA> CryptoKeyRSA::importSpki(CryptoAlgorithmIdentifier identifier, std::optional<CryptoAlgorithmIdentifier> hash, Vector<uint8_t>&& keyData, bool extractable, CryptoKeyUsageBitmap usages)
+{
+    auto info = MbedTLS::parseSubjectPublicKeyInfo(keyData.span());
+    if (!info || !supportedAlgorithmIdentifier(info->algorithm) || info->key.empty())
+        return nullptr;
+
+    // RSAPublicKey ::= SEQUENCE { modulus INTEGER, publicExponent INTEGER }
+    // (mbedTLS's ASN.1 readers take a non-const pointer and do not write through it)
+    unsigned char* cursor = const_cast<unsigned char*>(info->key.data());
+    const uint8_t* end = cursor + info->key.size();
+    size_t length = 0;
+    if (mbedtls_asn1_get_tag(&cursor, end, &length, MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE))
+        return nullptr;
+    if (cursor + length != end)
+        return nullptr;
+
+    const uint8_t* p = cursor;
+    std::span<const uint8_t> n;
+    std::span<const uint8_t> e;
+    if (!MbedTLS::readDERInteger(&p, end, n) || !MbedTLS::readDERInteger(&p, end, e) || p != end)
+        return nullptr;
+
+    auto key = createPublicKey(n, e);
+    if (!key)
+        return nullptr;
+
+    return adoptRef(new CryptoKeyRSA(identifier, hash.value_or(CryptoAlgorithmIdentifier::SHA_1), !!hash, CryptoKeyType::Public, WTF::move(key), extractable, usages));
+}
+
+// RSAPrivateKey ::= SEQUENCE {           (RFC 8017, A.1.2)
+//   version INTEGER (0: two primes), modulus INTEGER, publicExponent INTEGER, privateExponent INTEGER,
+//   prime1 INTEGER, prime2 INTEGER, exponent1 INTEGER, exponent2 INTEGER, coefficient INTEGER
+// }
+static MbedTLSPKPtr parseRSAPrivateKey(std::span<const uint8_t> data)
+{
+    if (data.empty())
+        return nullptr;
+
+    unsigned char* cursor = const_cast<unsigned char*>(data.data());
+    const uint8_t* end = cursor + data.size();
+    size_t length = 0;
+    if (mbedtls_asn1_get_tag(&cursor, end, &length, MBEDTLS_ASN1_CONSTRUCTED | MBEDTLS_ASN1_SEQUENCE))
+        return nullptr;
+    if (cursor + length != end)
+        return nullptr;
+
+    int version = -1;
+    if (mbedtls_asn1_get_int(&cursor, end, &version) || version)
+        return nullptr;
+
+    const uint8_t* p = cursor;
+    std::array<std::span<const uint8_t>, 8> numbers; // n, e, d, p, q, d mod (p - 1), d mod (q - 1), 1 / q mod p
+    for (auto& number : numbers) {
+        if (!MbedTLS::readDERInteger(&p, end, number))
+            return nullptr;
+    }
+    if (p != end)
+        return nullptr;
+
+    return createPrivateKey(numbers[0], numbers[1], numbers[2], numbers[3], numbers[4]);
+}
+
+RefPtr<CryptoKeyRSA> CryptoKeyRSA::importPkcs8(CryptoAlgorithmIdentifier identifier, std::optional<CryptoAlgorithmIdentifier> hash, Vector<uint8_t>&& keyData, bool extractable, CryptoKeyUsageBitmap usages)
+{
+    auto info = MbedTLS::parsePrivateKeyInfo(keyData.span());
+    if (!info || !supportedAlgorithmIdentifier(info->algorithm))
+        return nullptr;
+
+    auto key = parseRSAPrivateKey(info->key);
+    MbedTLS::zeroize(keyData);
+    if (!key)
+        return nullptr;
+
+    return adoptRef(new CryptoKeyRSA(identifier, hash.value_or(CryptoAlgorithmIdentifier::SHA_1), !!hash, CryptoKeyType::Private, WTF::move(key), extractable, usages));
+}
+
+ExceptionOr<Vector<uint8_t>> CryptoKeyRSA::exportSpki() const
+{
+    if (type() != CryptoKeyType::Public)
+        return Exception { ExceptionCode::InvalidAccessError };
+
+    const mbedtls_rsa_context* rsa = MbedTLS::rsaContext(platformKey());
+    if (!rsa)
+        return Exception { ExceptionCode::OperationError };
+
+    // SubjectPublicKeyInfo: rsaEncryption with a NULL parameter, the RSAPublicKey. mbedTLS writes
+    // it at the end of the buffer.
+    Vector<uint8_t> buffer(2 * mbedtls_rsa_get_len(rsa) + 64);
+    int length = mbedtls_pk_write_pubkey_der(platformKey(), buffer.mutableSpan().data(), buffer.size());
+    if (length <= 0 || static_cast<size_t>(length) > buffer.size())
+        return Exception { ExceptionCode::OperationError };
+
+    return Vector<uint8_t>(buffer.span().last(length));
+}
+
+ExceptionOr<Vector<uint8_t>> CryptoKeyRSA::exportPkcs8() const
+{
+    if (type() != CryptoKeyType::Private)
+        return Exception { ExceptionCode::InvalidAccessError };
+
+    const mbedtls_rsa_context* rsa = MbedTLS::rsaContext(platformKey());
+    if (!rsa)
+        return Exception { ExceptionCode::OperationError };
+
+    // mbedTLS writes the RSAPrivateKey (PKCS #1), at the end of the buffer; the PKCS #8 envelope
+    // goes around it here.
+    Vector<uint8_t> buffer(5 * mbedtls_rsa_get_len(rsa) + 128);
+    int length = mbedtls_pk_write_key_der(platformKey(), buffer.mutableSpan().data(), buffer.size());
+    if (length <= 0 || static_cast<size_t>(length) > buffer.size()) {
+        MbedTLS::zeroize(buffer);
+        return Exception { ExceptionCode::OperationError };
+    }
+
+    auto keyData = MbedTLS::writePrivateKeyInfo(MBEDTLS_OID_PKCS1_RSA, MBEDTLS_OID_SIZE(MBEDTLS_OID_PKCS1_RSA), std::span<const uint8_t> { derNull }, buffer.span().last(length));
+    MbedTLS::zeroize(buffer);
+    if (keyData.isEmpty())
+        return Exception { ExceptionCode::OperationError };
+
+    return keyData;
+}
+
+auto CryptoKeyRSA::algorithm() const -> KeyAlgorithm
+{
+    const mbedtls_rsa_context* rsa = MbedTLS::rsaContext(platformKey());
+
+    // FIXME: `CryptoRsaKeyAlgorithm` stores `modulusLength` as an `unsigned` requiring us to cast below. We should find a way to remove the need for a cast / ensure the cast is safe and doesn't overflow.
+
+    size_t modulusLength = rsa ? mbedtls_rsa_get_len(rsa) * 8 : 0;
+    Vector<uint8_t> publicExponent;
+
+    if (rsa) {
+        MbedTLS::BigNumber e;
+        if (!mbedtls_rsa_export(rsa, nullptr, nullptr, nullptr, nullptr, e.get()))
+            publicExponent = MbedTLS::convertToBytes(e.get());
+    }
+
+    if (m_restrictedToSpecificHash) {
+        return CryptoRsaHashedKeyAlgorithm {
+            CryptoRsaKeyAlgorithm {
+                CryptoKeyAlgorithm { CryptoAlgorithmRegistry::singleton().name(algorithmIdentifier()) },
+                static_cast<unsigned>(modulusLength),
+                Uint8Array::create(publicExponent.span())
+            },
+            CryptoKeyAlgorithm { CryptoAlgorithmRegistry::singleton().name(m_hash) }
+        };
+    }
+
+    return CryptoRsaKeyAlgorithm {
+        CryptoKeyAlgorithm { CryptoAlgorithmRegistry::singleton().name(algorithmIdentifier()) },
+        static_cast<unsigned>(modulusLength),
+        Uint8Array::create(publicExponent.span())
+    };
+}
+
+std::unique_ptr<CryptoKeyRSAComponents> CryptoKeyRSA::exportData() const
+{
+    const mbedtls_rsa_context* rsa = MbedTLS::rsaContext(platformKey());
+    if (!rsa)
+        return nullptr;
+
+    // (the numbers big-endian, without zeros in front)
+    switch (type()) {
+    case CryptoKeyType::Public: {
+        // We need the public modulus and exponent for the public key.
+        MbedTLS::BigNumber n;
+        MbedTLS::BigNumber e;
+        if (mbedtls_rsa_export(rsa, n.get(), nullptr, nullptr, nullptr, e.get()))
+            return nullptr;
+        return CryptoKeyRSAComponents::createPublic(MbedTLS::convertToBytes(n.get()), MbedTLS::convertToBytes(e.get()));
+    }
+    case CryptoKeyType::Private: {
+        // We need the public modulus, exponent, and private exponent, as well as p and q prime information.
+        MbedTLS::BigNumber n;
+        MbedTLS::BigNumber e;
+        MbedTLS::BigNumber d;
+        MbedTLS::BigNumber p;
+        MbedTLS::BigNumber q;
+        if (mbedtls_rsa_export(rsa, n.get(), p.get(), q.get(), d.get(), e.get()))
+            return nullptr;
+
+        MbedTLS::BigNumber dmp1; // d mod (p - 1)
+        MbedTLS::BigNumber dmq1; // d mod (q - 1)
+        MbedTLS::BigNumber iqmp; // q^(-1) mod p
+        if (mbedtls_rsa_export_crt(rsa, dmp1.get(), dmq1.get(), iqmp.get()))
+            return nullptr;
+
+        CryptoKeyRSAComponents::PrimeInfo firstPrimeInfo;
+        firstPrimeInfo.primeFactor = MbedTLS::convertToBytes(p.get());
+        firstPrimeInfo.factorCRTExponent = MbedTLS::convertToBytes(dmp1.get());
+
+        CryptoKeyRSAComponents::PrimeInfo secondPrimeInfo;
+        secondPrimeInfo.primeFactor = MbedTLS::convertToBytes(q.get());
+        secondPrimeInfo.factorCRTExponent = MbedTLS::convertToBytes(dmq1.get());
+        secondPrimeInfo.factorCRTCoefficient = MbedTLS::convertToBytes(iqmp.get());
+
+        return CryptoKeyRSAComponents::createPrivateWithAdditionalData(
+            MbedTLS::convertToBytes(n.get()), MbedTLS::convertToBytes(e.get()), MbedTLS::convertToBytes(d.get()),
+            WTF::move(firstPrimeInfo), WTF::move(secondPrimeInfo), Vector<CryptoKeyRSAComponents::PrimeInfo> { });
+    }
+    default:
+        ASSERT_NOT_REACHED();
+        return nullptr;
+    }
+}
+
+} // namespace WebCore
