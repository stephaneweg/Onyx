+
+# The TLS library behind curl: OpenSSL, or mbedTLS (USE_MBEDTLS: the certificate helpers in
+# MbedTLSHelper.cpp). The public suffix list: libpsl, unless the port has its own store.
+if (USE_MBEDTLS)
+    list(APPEND WebCore_SOURCES
+        platform/network/curl/MbedTLSHelper.cpp
+    )
+    list(APPEND WebCore_PRIVATE_FRAMEWORK_HEADERS
+        platform/network/curl/MbedTLSHelper.h
+    )
+    list(APPEND WebCore_LIBRARIES
+        MbedTLS::mbedtls
+    )
+else ()
+    list(APPEND WebCore_SOURCES
+        platform/network/curl/OpenSSLHelper.cpp
+    )
+    list(APPEND WebCore_PRIVATE_FRAMEWORK_HEADERS
+        platform/network/curl/OpenSSLHelper.h
+    )
+    list(APPEND WebCore_LIBRARIES
+        OpenSSL::SSL
+    )
+endif ()
+
+if (TARGET LibPSL::LibPSL)
+    list(APPEND WebCore_SOURCES
+        platform/network/curl/PublicSuffixStoreCurl.cpp
+    )
+    list(APPEND WebCore_LIBRARIES
+        LibPSL::LibPSL
+    )
+endif ()
