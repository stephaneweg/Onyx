+ * SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS
+ * INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
+ * CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+ * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF
+ * THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#include "config.h"
+#include "MbedTLSHelper.h"
+
+#if USE(MBEDTLS)
+
+#include <mbedtls/oid.h>
+#include <mbedtls/x509_crt.h>
+#include <wtf/DateMath.h>
+#include <wtf/HexNumber.h>
+#include <wtf/Seconds.h>
+#include <wtf/text/Base64.h>
+#include <wtf/text/MakeString.h>
+#include <wtf/text/StringBuilder.h>
+
+WTF_ALLOW_UNSAFE_BUFFER_USAGE_BEGIN
+
+namespace MbedTLS {
+
+static constexpr auto pemHeader = "-----BEGIN CERTIFICATE-----"_s;
+static constexpr auto pemFooter = "-----END CERTIFICATE-----"_s;
+
+// A certificate (DER) as PEM text: 64 base64 characters a line.
+static WebCore::CertificateInfo::Certificate pemFromDER(std::span<const uint8_t> der)
+{
+    auto encoded = base64EncodeToString(der);
+
+    StringBuilder builder;
+    builder.append(pemHeader, '\n');
+    for (unsigned i = 0; i < encoded.length(); i += 64)
+        builder.append(StringView(encoded).substring(i, 64), '\n');
+    builder.append(pemFooter, '\n');
+
+    auto text = builder.toString().utf8();
+    WebCore::CertificateInfo::Certificate certificate;
+    certificate.append(text.span());
+    return certificate;
+}
+
+// The DER of the first certificate of a PEM text.
+static std::optional<Vector<uint8_t>> derFromPEM(const Vector<uint8_t>& pem)
+{
+    auto text = String::fromUTF8(pem.span());
+    auto begin = text.find(pemHeader);
+    if (begin == notFound)
+        return std::nullopt;
+    begin += pemHeader.length();
+    auto end = text.find(pemFooter, begin);
+    if (end == notFound)
+        return std::nullopt;
+
+    return base64Decode(StringView(text).substring(begin, end - begin), { Base64DecodeOption::IgnoreWhitespace });
+}
+
+WebCore::CertificateInfo::CertificateChain createCertificateChain(const mbedtls_x509_crt* chain)
+{
+    WebCore::CertificateInfo::CertificateChain result;
+    for (auto* certificate = chain; certificate; certificate = certificate->next) {
+        if (!certificate->raw.p || !certificate->raw.len)
+            return { };
+        result.append(pemFromDER({ certificate->raw.p, certificate->raw.len }));
+    }
+    return result;
+}
+
+std::unique_ptr<WebCore::CertificateInfo> createCertificateInfo(std::optional<long>&& verifyResult, const mbedtls_ssl_context* ssl)
+{
+    if (!ssl)
+        return nullptr;
+
+    // curl does not report mbedTLS's verification flags (CURLINFO_SSL_VERIFYRESULT): take them
+    // from the connection.
+    long flags = mbedtls_ssl_get_verify_result(ssl);
+    if (!flags && verifyResult)
+        flags = *verifyResult;
+
+    auto* chain = mbedtls_ssl_get_peer_cert(ssl);
+    if (!chain)
+        return nullptr;
+
+    return makeUnique<WebCore::CertificateInfo>(static_cast<int>(flags), createCertificateChain(chain));
+}
+
+String verificationErrorDescription(int flags)
+{
+    if (!flags)
+        return "ok"_s;
+
+    char buffer[512];
+    int length = mbedtls_x509_crt_verify_info(buffer, sizeof(buffer), "", static_cast<uint32_t>(flags));
+    if (length <= 0)
+        return makeString("certificate verification failed (0x"_s, hex(static_cast<unsigned>(flags)), ')');
+
+    // One reason a line: the first one, without its end of line.
+    auto text = String::fromUTF8(std::span { reinterpret_cast<const char8_t*>(buffer), static_cast<size_t>(length) });
+    auto lineEnd = text.find('\n');
+    return lineEnd == notFound ? text : text.left(lineEnd);
+}
+
+static String toString(const mbedtls_asn1_buf& value)
+{
+    if (!value.p || !value.len)
+        return String();
+    return String::fromUTF8(std::span { reinterpret_cast<const char8_t*>(value.p), value.len });
+}
+
+static String subjectEntry(const mbedtls_x509_crt& certificate, const char* oid, size_t oidLength)
+{
+    for (auto* name = &certificate.subject; name; name = name->next) {
+        if (name->oid.len == oidLength && !memcmp(name->oid.p, oid, oidLength))
+            return toString(name->val);
+    }
+    return String();
+}
+
+static String subjectName(const mbedtls_x509_crt& certificate)
+{
+    char buffer[1024];
+    int length = mbedtls_x509_dn_gets(buffer, sizeof(buffer), &certificate.subject);
+    if (length <= 0)
+        return String();
+    return String::fromUTF8(std::span { reinterpret_cast<const char8_t*>(buffer), static_cast<size_t>(length) });
+}
+
+static Seconds toSeconds(const mbedtls_x509_time& time)
+{
+    // (UTC: the dates of a certificate are GMT)
+    double days = dateToDaysFrom1970(time.year, time.mon - 1, time.day);
+    return Seconds(days * 86400.0 + time.hour * 3600.0 + time.min * 60.0 + time.sec);
+}
+
+static void subjectAltNames(const mbedtls_x509_crt& certificate, Vector<String>& dnsNames, Vector<String>& ipAddresses)
+{
+    for (auto* entry = &certificate.subject_alt_names; entry; entry = entry->next) {
+        if (!entry->buf.p)
+            continue;
+
+        mbedtls_x509_subject_alternative_name name;
+        if (mbedtls_x509_parse_subject_alt_name(&entry->buf, &name))
+            continue;
+
+        if (name.type == MBEDTLS_X509_SAN_DNS_NAME) {
+            auto dnsName = toString(name.san.unstructured_name);
+            if (!dnsName.isNull())
+                dnsNames.append(WTF::move(dnsName));
+        } else if (name.type == MBEDTLS_X509_SAN_IP_ADDRESS) {
+            auto& address = name.san.unstructured_name;
+            if (address.len == 4)
+                ipAddresses.append(makeString(address.p[0], '.', address.p[1], '.', address.p[2], '.', address.p[3]));
+            else if (address.len == 16)
+                ipAddresses.append(canonicalizeIPv6Address(std::span<uint8_t, 16> { address.p, 16 }));
+        }
+        mbedtls_x509_free_subject_alt_name(&name);
+    }
+}
+
+// RFC 5952: the longest run of zero groups (two or more) as "::", no leading zeros.
+String canonicalizeIPv6Address(std::span<uint8_t, 16> data)
+{
+    int bestStart = -1;
+    int bestLength = 0;
+    for (int i = 0; i < 8;) {
+        if (data[2 * i] || data[2 * i + 1]) {
+            i++;
+            continue;
+        }
+        int start = i;
+        while (i < 8 && !data[2 * i] && !data[2 * i + 1])
+            i++;
+        if (i - start > bestLength) {
+            bestStart = start;
+            bestLength = i - start;
+        }
+    }
+    if (bestLength < 2)
+        bestStart = -1;
+
+    StringBuilder address;
+    for (int i = 0; i < 8; i++) {
+        if (i == bestStart) {
+            address.append(i ? ":"_s : "::"_s);
+            i += bestLength - 1;
+            continue;
+        }
+        address.append(hex(static_cast<unsigned>(data[2 * i] << 8 | data[2 * i + 1]), Lowercase));
+        if (i != 7)
+            address.append(':');
+    }
+    return address.toString();
+}
+
+std::optional<WebCore::CertificateSummary> createSummaryInfo(const Vector<uint8_t>& pem)
+{
+    auto der = derFromPEM(pem);
+    if (!der)
+        return std::nullopt;
+
+    mbedtls_x509_crt certificate;
+    mbedtls_x509_crt_init(&certificate);
+    if (mbedtls_x509_crt_parse_der(&certificate, der->span().data(), der->size())) {
+        mbedtls_x509_crt_free(&certificate);
+        return std::nullopt;
+    }
+
+    WebCore::CertificateSummary summaryInfo;
+
+    // Prefer the CN attribute, then O (as the OpenSSL helper does, to match macOS).
+    summaryInfo.subject = subjectEntry(certificate, MBEDTLS_OID_AT_CN, MBEDTLS_OID_SIZE(MBEDTLS_OID_AT_CN));
+    if (summaryInfo.subject.isNull())
+        summaryInfo.subject = subjectEntry(certificate, MBEDTLS_OID_AT_ORGANIZATION, MBEDTLS_OID_SIZE(MBEDTLS_OID_AT_ORGANIZATION));
+    if (summaryInfo.subject.isNull())
+        summaryInfo.subject = subjectName(certificate);
+
+    summaryInfo.validFrom = toSeconds(certificate.valid_from);
+    summaryInfo.validUntil = toSeconds(certificate.valid_to);
+
+    subjectAltNames(certificate, summaryInfo.dnsNames, summaryInfo.ipAddresses);
+
+    mbedtls_x509_crt_free(&certificate);
+    return summaryInfo;
+}
+
+String tlsVersion(const mbedtls_ssl_context* ssl)
+{
+    return String::fromLatin1(mbedtls_ssl_get_version(ssl));
+}
+
+String tlsCipherName(const mbedtls_ssl_context* ssl)
+{
+    return String::fromLatin1(mbedtls_ssl_get_ciphersuite(ssl));
+}
+
+} // namespace MbedTLS
+
