+ * BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR
+ * CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF
+ * SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS
+ * INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
+ * CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+ * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF
+ * THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#include "config.h"
+#include "CryptoDigest.h"
+
+#include <mbedtls/md.h>
+
+// The SHA digests on mbedTLS's message digest layer (the TLS library of the ports without
+// OpenSSL: USE(MBEDTLS)).
+
+namespace PAL::Crypto {
+
+struct CryptoDigestContext {
+    WTF_DEPRECATED_MAKE_STRUCT_FAST_ALLOCATED(CryptoDigestContext);
+
+    explicit CryptoDigestContext(mbedtls_md_type_t type)
+    {
+        mbedtls_md_init(&context);
+        info = mbedtls_md_info_from_type(type);
+        RELEASE_ASSERT(info);
+        int result = mbedtls_md_setup(&context, info, 0);
+        RELEASE_ASSERT(!result);
+        result = mbedtls_md_starts(&context);
+        RELEASE_ASSERT(!result);
+    }
+
+    ~CryptoDigestContext()
+    {
+        mbedtls_md_free(&context);
+    }
+
+    mbedtls_md_context_t context;
+    const mbedtls_md_info_t* info { nullptr };
+};
+
+CryptoDigest::CryptoDigest() = default;
+
+CryptoDigest::~CryptoDigest() = default;
+
+std::unique_ptr<CryptoDigest> CryptoDigest::create(CryptoDigest::Algorithm algorithm)
+{
+    mbedtls_md_type_t type = MBEDTLS_MD_NONE;
+    switch (algorithm) {
+    case CryptoDigest::Algorithm::SHA_1:
+        type = MBEDTLS_MD_SHA1;
+        break;
+    case CryptoDigest::Algorithm::DEPRECATED_SHA_224:
+        RELEASE_ASSERT_NOT_REACHED_WITH_MESSAGE("SHA224 is not supported.");
+        break;
+    case CryptoDigest::Algorithm::SHA_256:
+        type = MBEDTLS_MD_SHA256;
+        break;
+    case CryptoDigest::Algorithm::SHA_384:
+        type = MBEDTLS_MD_SHA384;
+        break;
+    case CryptoDigest::Algorithm::SHA_512:
+        type = MBEDTLS_MD_SHA512;
+        break;
+    }
+
+    std::unique_ptr<CryptoDigest> digest = WTF::makeUnique<CryptoDigest>();
+    digest->m_context = WTF::makeUnique<CryptoDigestContext>(type);
+    return digest;
+}
+
+void CryptoDigest::addBytes(std::span<const uint8_t> input)
+{
+    ASSERT(m_context);
+    int result = mbedtls_md_update(&m_context->context, input.data(), input.size());
+    RELEASE_ASSERT(!result);
+}
+
+Vector<uint8_t> CryptoDigest::computeHash()
+{
+    ASSERT(m_context);
+    Vector<uint8_t> result(mbedtls_md_get_size(m_context->info));
+    int status = mbedtls_md_finish(&m_context->context, result.mutableSpan().data());
+    RELEASE_ASSERT(!status);
+    return result;
+}
+
+} // namespace PAL::Crypto
