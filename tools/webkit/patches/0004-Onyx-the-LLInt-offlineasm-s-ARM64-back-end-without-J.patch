From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Onyx contributors <onyx@localhost>
Date: Fri, 2 Oct 2026 18:01:32 +0200
Subject: [PATCH 04/11] Onyx: the LLInt (offlineasm's ARM64 back end) without
 JIT

What:
- offlineasm/arm64.rb: "globaladdr" for OS(ONYX): adrp + add :lo12: on the symbol itself (as
  the Windows branch), no GOT.
- wtf/InlineASM.h: OS(ONYX) is an ELF platform (HIDE_SYMBOL is ".hidden", LOCAL_LABEL_STRING
  is ".L<name>").
- assembler/ARM64Assembler.h: cacheFlush() for OS(ONYX) through __builtin___clear_cache
  (libgcc's DC CVAU / IC IVAU loop). Not reached while the port has no JIT; the header is
  compiled as soon as ENABLE_C_LOOP is off.

Why: with ENABLE_C_LOOP=OFF and ENABLE_JIT=OFF, JavaScriptCore runs the low-level interpreter
assembled at build time: no executable memory is needed at run time, and it is several times
faster than the C++ loop. Onyx programs are static, non-PIC ELF images, so a global's address
is a link-time constant.
---
 Source/JavaScriptCore/assembler/ARM64Assembler.h | 3 +++
 Source/JavaScriptCore/offlineasm/arm64.rb        | 5 +++--
 Source/WTF/wtf/InlineASM.h                       | 2 ++
 3 files changed, 8 insertions(+), 2 deletions(-)

diff --git a/Source/JavaScriptCore/assembler/ARM64Assembler.h b/Source/JavaScriptCore/assembler/ARM64Assembler.h
index 0fc3038d..2cee1344 100644
--- a/Source/JavaScriptCore/assembler/ARM64Assembler.h
+++ b/Source/JavaScriptCore/assembler/ARM64Assembler.h
@@ -4063,6 +4063,9 @@ public:
         linuxPageFlush(current, end);
 #elif OS(WINDOWS)
         FlushInstructionCache(GetCurrentProcess(), code, size);
+#elif OS(ONYX)
+        // libgcc's __clear_cache (DC CVAU / IC IVAU). Not reached while there is no JIT.
+        __builtin___clear_cache(reinterpret_cast<char*>(code), reinterpret_cast<char*>(code) + size);
 #else
 #error "The cacheFlush support is missing on this platform."
 #endif
diff --git a/Source/JavaScriptCore/offlineasm/arm64.rb b/Source/JavaScriptCore/offlineasm/arm64.rb
index 53334dff..1eff7ba3 100644
--- a/Source/JavaScriptCore/offlineasm/arm64.rb
+++ b/Source/JavaScriptCore/offlineasm/arm64.rb
@@ -1540,8 +1540,9 @@ class Instruction
             $asm.puts "ldr #{operands[1].arm64Operand(:quad)}, [#{operands[1].arm64Operand(:quad)}, :got_lo12:#{operands[0].asmLabel}]"
             $asm.putStr("#endif")
 
-            # On Windows, use COFF-style addressing.
-            $asm.putStr("#elif OS(WINDOWS)")
+            # On Windows, use COFF-style addressing. Onyx programs are static, non-PIC ELF
+            # images: the same direct page + offset addressing, no GOT.
+            $asm.putStr("#elif OS(WINDOWS) || OS(ONYX)")
 
             $asm.puts "adrp #{operands[1].arm64Operand(:quad)}, #{operands[0].asmLabel}"
             $asm.puts "add #{operands[1].arm64Operand(:quad)}, #{operands[1].arm64Operand(:quad)}, :lo12:#{operands[0].asmLabel}"
diff --git a/Source/WTF/wtf/InlineASM.h b/Source/WTF/wtf/InlineASM.h
index 2937c456..2a0cf609 100644
--- a/Source/WTF/wtf/InlineASM.h
+++ b/Source/WTF/wtf/InlineASM.h
@@ -69,6 +69,7 @@
     || OS(HAIKU)               \
     || OS(HPUX)                \
     || OS(NETBSD)              \
+    || OS(ONYX)                \
     || OS(OPENBSD)             \
     || OS(QNX)
     // ELF platform
@@ -89,6 +90,7 @@
     || OS(HAIKU)               \
     || OS(HURD)                \
     || OS(NETBSD)              \
+    || OS(ONYX)                \
     || OS(QNX)                 \
     || OS(WINDOWS)
     // GNU as-compatible syntax.
