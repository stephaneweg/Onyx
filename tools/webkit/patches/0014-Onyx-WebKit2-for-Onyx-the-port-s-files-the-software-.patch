+// surfaceSize: the surface's size in pixels (normally the view's size). stride: the bytes from one row to
+// the next (0: surfaceSize.width * 4). paintRect: the part to paint, in the view's coordinates; pixels
+// outside it are not touched. What the page has not drawn yet is filled with its background colour (white
+// when it has none).
+WK_EXPORT void WKPagePaint(WKPageRef, unsigned char* pixels, WKSize surfaceSize, uint32_t stride, WKRect paintRect);
