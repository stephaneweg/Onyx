+
+#pragma once
+
+#include <WebKit/WKBase.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef void(*WKRunLoopCallback)(void *userData);
+
+// To call first, on the thread that will use WebKit (its "main thread"): initializes WebKit and that
+// thread's run loop.
+WK_EXPORT void WKRunLoopInitializeMain();
+
+// Everything WebKit does in the UI process happens on the main thread's run loop: the replies of the
+// other processes, the timers, the calls given to WKRunLoopCallOnMainThread. Two ways to run it.
+//
+// 1. WebKit owns the thread: WKRunLoopRunMain() runs the loop until WKRunLoopStopMain(). The embedder's
+//    own events (its window's) then come from another thread through WKRunLoopCallOnMainThread, or from a
+//    function that posts itself again.
+//
+// 2. The embedder owns the thread, with its own event loop: it calls WKRunLoopCycleMain() from that
+//    loop. One call runs what is due now (the timers that expired, the work queued) and returns without
+//    waiting. The loop must come back to it when there is new work: WKRunLoopSetWakeUpCallback gives a
+//    function that WebKit calls, from any thread and with a lock held (it must only wake the embedder's
+//    loop up, never call WebKit), each time work is queued; a timer that comes due queues nothing, so the
+//    embedder's loop must also come back by itself every few milliseconds while a page is alive.
+WK_EXPORT void WKRunLoopRunMain();
+WK_EXPORT void WKRunLoopStopMain();
+WK_EXPORT void WKRunLoopCycleMain();
+WK_EXPORT void WKRunLoopSetWakeUpCallback(WKRunLoopCallback, void* userData);
+
+// Thread safe: the function is called later on the main thread, from its run loop.
+WK_EXPORT void WKRunLoopCallOnMainThread(WKRunLoopCallback, void* userData);
+
+#ifdef __cplusplus
+}
+#endif
