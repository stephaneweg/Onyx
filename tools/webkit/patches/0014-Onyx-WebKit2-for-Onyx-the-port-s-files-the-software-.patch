+static OptionSet<WebEventModifier> modifiersForEventModifiers(uint32_t eventModifiers)
+{
+    OptionSet<WebEventModifier> modifiers;
+    // As the Windows port: a key typed with AltGr is not a Control / Alt combination.
+    bool altGraph = eventModifiers & kWKEventModifiersAltGraphKey;
+    if (altGraph)
+        modifiers.add(WebEventModifier::AltGraphKey);
+    if ((eventModifiers & kWKEventModifiersControlKey) && !altGraph)
+        modifiers.add(WebEventModifier::ControlKey);
+    if (eventModifiers & kWKEventModifiersShiftKey)
+        modifiers.add(WebEventModifier::ShiftKey);
+    if ((eventModifiers & kWKEventModifiersAltKey) && !altGraph)
+        modifiers.add(WebEventModifier::AltKey);
+    if (eventModifiers & kWKEventModifiersMetaKey)
+        modifiers.add(WebEventModifier::MetaKey);
+    if (eventModifiers & kWKEventModifiersCapsLockKey)
+        modifiers.add(WebEventModifier::CapsLockKey);
+    return modifiers;
+}
+
+static OptionSet<WebEventModifier> modifiersForKeyboardEvent(const WKKeyboardEvent& event)
+{
+    auto modifiers = modifiersForEventModifiers(event.modifiers);
+
+    if (event.type != kWKEventKeyDown)
+        return modifiers;
+
+    // As the libwpe factory: a modifier key going down counts as held in its own event, whether or not
+    // the embedder's modifier mask already says so.
+    switch (event.virtualKeyCode) {
+    case VK_CONTROL:
+    case VK_LCONTROL:
+    case VK_RCONTROL:
+        if (!modifiers.contains(WebEventModifier::AltGraphKey))
+            modifiers.add(WebEventModifier::ControlKey);
+        break;
+    case VK_SHIFT:
+    case VK_LSHIFT:
+    case VK_RSHIFT:
+        modifiers.add(WebEventModifier::ShiftKey);
+        break;
+    case VK_MENU:
+    case VK_LMENU:
+    case VK_RMENU:
+        if (!modifiers.contains(WebEventModifier::AltGraphKey))
+            modifiers.add(WebEventModifier::AltKey);
+        break;
+    case VK_LWIN:
+    case VK_RWIN:
+        modifiers.add(WebEventModifier::MetaKey);
+        break;
+    case VK_CAPITAL:
+        modifiers.add(WebEventModifier::CapsLockKey);
+        break;
+    }
+
+    return modifiers;
+}
+
+static String stringFromCharacter(char16_t character)
+{
+    return String { std::span<const char16_t> { &character, 1 } };
+}
+
+static bool isKeypadKeyCode(int keyCode)
+{
+    // VK_NUMPAD0 ... VK_NUMPAD9, VK_MULTIPLY, VK_ADD, VK_SEPARATOR, VK_SUBTRACT, VK_DECIMAL, VK_DIVIDE.
+    return (keyCode >= VK_NUMPAD0 && keyCode <= VK_DIVIDE) || keyCode == VK_NUMLOCK;
+}
+
+// The text of the key press. WebCore splits a KeyDown event into a "keydown" (which runs the editing
+// commands: WebPageOnyx.cpp) and, when there is text, a "keypress" (which types it). Return and Tab
+// must come with their character for the keypress to exist, as they do on the other ports.
+static String textForKeyboardEvent(const WKKeyboardEvent& event)
+{
+    String text = event.text ? String::fromUTF8(event.text) : String();
+    if (text == "\n"_s)
+        return "\r"_s;
+    if (!text.isEmpty())
+        return text;
+
+    switch (event.virtualKeyCode) {
+    case VK_RETURN:
+        return "\r"_s;
+    case VK_TAB:
+        return "\t"_s;
+    case VK_BACK:
+        return "\x8"_s;
+    default:
+        return { };
+    }
+}
+
+// https://www.w3.org/TR/uievents-key/: the named keys.
+static ASCIILiteral namedKeyForKeyCode(int keyCode)
+{
+    switch (keyCode) {
+    case VK_BACK:
+        return "Backspace"_s;
+    case VK_TAB:
+        return "Tab"_s;
+    case VK_CLEAR:
+        return "Clear"_s;
+    case VK_RETURN:
+        return "Enter"_s;
+    case VK_SHIFT:
+    case VK_LSHIFT:
+    case VK_RSHIFT:
+        return "Shift"_s;
+    case VK_CONTROL:
+    case VK_LCONTROL:
+    case VK_RCONTROL:
+        return "Control"_s;
+    case VK_MENU:
+    case VK_LMENU:
+    case VK_RMENU:
+        return "Alt"_s;
+    case VK_PAUSE:
+        return "Pause"_s;
+    case VK_CAPITAL:
+        return "CapsLock"_s;
+    case VK_ESCAPE:
+        return "Escape"_s;
+    case VK_PRIOR:
+        return "PageUp"_s;
+    case VK_NEXT:
+        return "PageDown"_s;
+    case VK_END:
+        return "End"_s;
+    case VK_HOME:
+        return "Home"_s;
+    case VK_LEFT:
+        return "ArrowLeft"_s;
+    case VK_UP:
+        return "ArrowUp"_s;
+    case VK_RIGHT:
+        return "ArrowRight"_s;
+    case VK_DOWN:
+        return "ArrowDown"_s;
+    case VK_SELECT:
+        return "Select"_s;
+    case VK_EXECUTE:
+        return "Execute"_s;
+    case VK_SNAPSHOT:
+        return "PrintScreen"_s;
+    case VK_INSERT:
+        return "Insert"_s;
+    case VK_DELETE:
+        return "Delete"_s;
+    case VK_HELP:
+        return "Help"_s;
+    case VK_LWIN:
+    case VK_RWIN:
+        return "Meta"_s;
+    case VK_APPS:
+        return "ContextMenu"_s;
+    case VK_NUMLOCK:
+        return "NumLock"_s;
+    case VK_SCROLL:
+        return "ScrollLock"_s;
+    default:
+        return { };
+    }
+}
+
+// KeyboardEvent.key: the named key, else what the key types, else (no text: a key up, a shortcut)
+// what a letter or a digit key would type.
+static String keyForKeyboardEvent(int keyCode, const String& text, OptionSet<WebEventModifier> modifiers)
+{
+    if (auto name = namedKeyForKeyCode(keyCode); !name.isNull())
+        return name;
+
+    if (keyCode >= VK_F1 && keyCode <= VK_F24)
+        return makeString('F', keyCode - VK_F1 + 1);
+
+    if (!text.isEmpty() && text[0] >= 0x20 && text[0] != 0x7F)
+        return text;
+
+    if (keyCode >= VK_A && keyCode <= VK_Z) {
+        bool upperCase = modifiers.contains(WebEventModifier::ShiftKey) != modifiers.contains(WebEventModifier::CapsLockKey);
+        return stringFromCharacter(upperCase ? keyCode : toASCIILower(static_cast<char16_t>(keyCode)));
+    }
+    if (keyCode >= VK_0 && keyCode <= VK_9)
+        return stringFromCharacter(keyCode);
+    if (keyCode >= VK_NUMPAD0 && keyCode <= VK_NUMPAD9)
+        return stringFromCharacter('0' + keyCode - VK_NUMPAD0);
+    if (keyCode == VK_SPACE)
+        return " "_s;
+
+    return "Unidentified"_s;
+}
+
+// KeyboardEvent.code names the physical key. Onyx's key events carry no scan code WebKit knows, so
+// this takes the virtual key for the position it has on a US keyboard: right for the letters, the
+// digits and the named keys of every layout whose embedder maps its keys to virtual-key codes by
+// position, approximate for the punctuation keys otherwise.
+static String codeForKeyboardEvent(int keyCode, bool isKeypad)
+{
+    if (keyCode >= VK_A && keyCode <= VK_Z)
+        return makeString("Key"_s, static_cast<char>(keyCode));
+    if (keyCode >= VK_0 && keyCode <= VK_9)
+        return makeString("Digit"_s, static_cast<char>(keyCode));
+    if (keyCode >= VK_NUMPAD0 && keyCode <= VK_NUMPAD9)
+        return makeString("Numpad"_s, keyCode - VK_NUMPAD0);
+    if (keyCode >= VK_F1 && keyCode <= VK_F24)
+        return makeString('F', keyCode - VK_F1 + 1);
+
+    switch (keyCode) {
+    case VK_BACK:
+        return "Backspace"_s;
+    case VK_TAB:
+        return "Tab"_s;
+    case VK_CLEAR:
+        return "NumpadClear"_s;
+    case VK_RETURN:
+        return isKeypad ? "NumpadEnter"_s : "Enter"_s;
+    case VK_SHIFT:
+    case VK_LSHIFT:
+        return "ShiftLeft"_s;
+    case VK_RSHIFT:
+        return "ShiftRight"_s;
+    case VK_CONTROL:
+    case VK_LCONTROL:
+        return "ControlLeft"_s;
+    case VK_RCONTROL:
+        return "ControlRight"_s;
+    case VK_MENU:
+    case VK_LMENU:
+        return "AltLeft"_s;
+    case VK_RMENU:
+        return "AltRight"_s;
+    case VK_PAUSE:
+        return "Pause"_s;
+    case VK_CAPITAL:
+        return "CapsLock"_s;
+    case VK_ESCAPE:
+        return "Escape"_s;
+    case VK_SPACE:
+        return "Space"_s;
+    case VK_PRIOR:
+        return "PageUp"_s;
+    case VK_NEXT:
+        return "PageDown"_s;
+    case VK_END:
+        return "End"_s;
+    case VK_HOME:
+        return "Home"_s;
+    case VK_LEFT:
+        return "ArrowLeft"_s;
+    case VK_UP:
+        return "ArrowUp"_s;
+    case VK_RIGHT:
+        return "ArrowRight"_s;
+    case VK_DOWN:
+        return "ArrowDown"_s;
+    case VK_SELECT:
+        return "Select"_s;
+    case VK_SNAPSHOT:
+        return "PrintScreen"_s;
+    case VK_INSERT:
+        return "Insert"_s;
+    case VK_DELETE:
+        return "Delete"_s;
+    case VK_HELP:
+        return "Help"_s;
+    case VK_LWIN:
+        return "MetaLeft"_s;
+    case VK_RWIN:
+        return "MetaRight"_s;
+    case VK_APPS:
+        return "ContextMenu"_s;
+    case VK_MULTIPLY:
+        return "NumpadMultiply"_s;
+    case VK_ADD:
+        return "NumpadAdd"_s;
+    case VK_SEPARATOR:
+        return "NumpadComma"_s;
+    case VK_SUBTRACT:
+        return "NumpadSubtract"_s;
+    case VK_DECIMAL:
+        return "NumpadDecimal"_s;
+    case VK_DIVIDE:
+        return "NumpadDivide"_s;
+    case VK_NUMLOCK:
+        return "NumLock"_s;
+    case VK_SCROLL:
+        return "ScrollLock"_s;
+    case VK_OEM_1:
+        return "Semicolon"_s;
+    case VK_OEM_PLUS:
+        return "Equal"_s;
+    case VK_OEM_COMMA:
+        return "Comma"_s;
+    case VK_OEM_MINUS:
+        return "Minus"_s;
+    case VK_OEM_PERIOD:
+        return "Period"_s;
+    case VK_OEM_2:
+        return "Slash"_s;
+    case VK_OEM_3:
+        return "Backquote"_s;
+    case VK_OEM_4:
+        return "BracketLeft"_s;
+    case VK_OEM_5:
+        return "Backslash"_s;
+    case VK_OEM_6:
+        return "BracketRight"_s;
+    case VK_OEM_7:
+        return "Quote"_s;
+    case VK_OEM_102:
+        return "IntlBackslash"_s;
+    default:
+        return "Unidentified"_s;
+    }
+}
+
+// KeyboardEvent.keyIdentifier (the old DOM 3 draft), as the Windows factory derives it from the same
+// virtual-key codes.
+static String keyIdentifierForKeyCode(int keyCode)
+{
+    if (keyCode >= VK_F1 && keyCode <= VK_F24)
+        return makeString('F', keyCode - VK_F1 + 1);
+
+    switch (keyCode) {
+    case VK_MENU:
+    case VK_LMENU:
+    case VK_RMENU:
+        return "Alt"_s;
+    case VK_CONTROL:
+    case VK_LCONTROL:
+    case VK_RCONTROL:
+        return "Control"_s;
+    case VK_SHIFT:
+    case VK_LSHIFT:
+    case VK_RSHIFT:
+        return "Shift"_s;
+    case VK_CAPITAL:
+        return "CapsLock"_s;
+    case VK_LWIN:
+    case VK_RWIN:
+        return "Win"_s;
+    case VK_CLEAR:
+        return "Clear"_s;
+    case VK_DOWN:
+        return "Down"_s;
+    case VK_END:
+        return "End"_s;
+    case VK_RETURN:
+        return "Enter"_s;
+    case VK_EXECUTE:
+        return "Execute"_s;
+    case VK_HELP:
+        return "Help"_s;
+    case VK_HOME:
+        return "Home"_s;
+    case VK_INSERT:
+        return "Insert"_s;
+    case VK_LEFT:
+        return "Left"_s;
+    case VK_NEXT:
+        return "PageDown"_s;
+    case VK_PRIOR:
+        return "PageUp"_s;
+    case VK_PAUSE:
+        return "Pause"_s;
+    case VK_SNAPSHOT:
+        return "PrintScreen"_s;
+    case VK_RIGHT:
+        return "Right"_s;
+    case VK_SCROLL:
+        return "Scroll"_s;
+    case VK_SELECT:
+        return "Select"_s;
+    case VK_UP:
+        return "Up"_s;
+    case VK_DELETE:
+        return "U+007F"_s; // Standard says that DEL becomes U+007F.
+    default:
+        return makeString("U+"_s, hex(static_cast<unsigned>(keyCode), 4));
+    }
+}
+
+WebKeyboardEventInit WebEventFactory::createWebKeyboardEvent(const WKKeyboardEvent& event)
+{
+    // KeyDown, not RawKeyDown + Char as the Windows port sends: one event with the key and its text,
+    // which WebCore disambiguates (PlatformKeyboardEvent::disambiguateKeyDownEvent), as the libwpe ports do.
+    auto type = event.type == kWKEventKeyUp ? WebEventType::KeyUp : WebEventType::KeyDown;
+    auto modifiers = modifiersForKeyboardEvent(event);
+    int keyCode = event.virtualKeyCode;
+    String text = textForKeyboardEvent(event);
+    String unmodifiedText = event.unmodifiedText ? String::fromUTF8(event.unmodifiedText) : text;
+    bool isKeypad = (event.flags & kWKKeyboardEventFlagsKeypad) || isKeypadKeyCode(keyCode);
+
+    return {
+        { type, modifiers, MonotonicTime::now() },
+        {
+            .text = text,
+            .unmodifiedText = unmodifiedText,
+            .key = keyForKeyboardEvent(keyCode, text, modifiers),
+            .code = codeForKeyboardEvent(keyCode, isKeypad),
+            .keyIdentifier = keyIdentifierForKeyCode(keyCode),
+            .windowsVirtualKeyCode = keyCode,
+            .nativeVirtualKeyCode = event.nativeKeyCode ? event.nativeKeyCode : keyCode,
+            .macCharCode = 0,
+            .isAutoRepeat = !!(event.flags & kWKKeyboardEventFlagsAutoRepeat),
+            .isKeypad = isKeypad,
+            .isSystemKey = false,
+        }
+    };
+}
+
+static WebMouseEventButton buttonForMouseEvent(const WKMouseEvent& event)
+{
+    switch (event.button) {
+    case kWKEventMouseButtonLeftButton:
+        return WebMouseEventButton::Left;
+    case kWKEventMouseButtonMiddleButton:
+        return WebMouseEventButton::Middle;
+    case kWKEventMouseButtonRightButton:
+        return WebMouseEventButton::Right;
+    case kWKEventMouseButtonBackButton:
+        return WebMouseEventButton::Back;
+    case kWKEventMouseButtonForwardButton:
+        return WebMouseEventButton::Forward;
+    default:
+        break;
+    }
+
+    if (event.type != kWKEventMouseMove)
+        return WebMouseEventButton::None;
+
+    // A move with a button held (a drag): the button is the one held, as the other factories say.
+    if (event.buttons & kWKEventMouseButtonsLeft)
+        return WebMouseEventButton::Left;
+    if (event.buttons & kWKEventMouseButtonsMiddle)
+        return WebMouseEventButton::Middle;
+    if (event.buttons & kWKEventMouseButtonsRight)
+        return WebMouseEventButton::Right;
+    return WebMouseEventButton::None;
+}
+
+// The click count when the embedder gives none (WKMouseEvent.clickCount 0): the same button pressed
+// again within 500 ms and 5 pixels, as the libwpe and Windows factories count it.
+static int clickCountForMouseEvent(WebEventType type, WebMouseEventButton button, const IntPoint& position, MonotonicTime timestamp)
+{
+    static constexpr Seconds doubleClickTime { 500_ms };
+    static constexpr int pixelThreshold = 5;
+    static int lastClickCount;
+    static MonotonicTime lastClickTime;
+    static IntPoint lastClickPosition;
+    static WebMouseEventButton lastClickButton = WebMouseEventButton::Left;
+
+    bool cancelPreviousClick = std::abs(lastClickPosition.x() - position.x()) > pixelThreshold
+        || std::abs(lastClickPosition.y() - position.y()) > pixelThreshold
+        || (timestamp - lastClickTime) > doubleClickTime;
+
+    if (type == WebEventType::MouseDown) {
+        if (!cancelPreviousClick && button == lastClickButton)
+            ++lastClickCount;
+        else {
+            lastClickCount = 1;
+            lastClickPosition = position;
+        }
+        lastClickTime = timestamp;
+        lastClickButton = button;
+    } else if (type == WebEventType::MouseMove) {
+        if (cancelPreviousClick) {
+            lastClickCount = 0;
+            lastClickPosition = { };
+            lastClickTime = { };
+        }
+    }
+
+    return lastClickCount;
+}
+
+WebMouseEventInit WebEventFactory::createWebMouseEvent(const WKMouseEvent& event)
+{
+    auto type = WebEventType::MouseMove;
+    switch (event.type) {
+    case kWKEventMouseDown:
+        type = WebEventType::MouseDown;
+        break;
+    case kWKEventMouseUp:
+        type = WebEventType::MouseUp;
+        break;
+    case kWKEventMouseMove:
+        type = WebEventType::MouseMove;
+        break;
+    default:
+        ASSERT_NOT_REACHED();
+    }
+
+    auto button = buttonForMouseEvent(event);
+    IntPoint position { static_cast<int>(std::floor(event.position.x)), static_cast<int>(std::floor(event.position.y)) };
+    IntPoint globalPosition { static_cast<int>(std::floor(event.screenPosition.x)), static_cast<int>(std::floor(event.screenPosition.y)) };
+    auto timestamp = MonotonicTime::now();
+
+    // The counter runs on every event, so that it stays right if the embedder gives a count for some
+    // events only.
+    int clickCount = clickCountForMouseEvent(type, button, position, timestamp);
+    if (event.clickCount > 0)
+        clickCount = event.clickCount;
+
+    return {
+        { type, modifiersForEventModifiers(event.modifiers), timestamp },
+        {
+            .button = button,
+            .buttons = static_cast<unsigned short>(event.buttons),
+            .position = position,
+            .globalPosition = globalPosition,
+            .deltaX = 0,
+            .deltaY = 0,
+            .deltaZ = 0,
+            .clickCount = clickCount,
+            .force = 0,
+            .inputSource = WebEventInputSource::UserDriven,
+            .canInitiateDrag = WebCore::PlatformMouseEvent::CanInitiateDrag::Yes,
+            .syntheticClickType = WebMouseEventSyntheticClickType::NoTap,
+            .pointerId = WebCore::mousePointerID,
+            .pointerType = WebCore::mousePointerEventType(),
+            .gestureWasCancelled = GestureWasCancelled::No,
+            .unadjustedMovementDelta = { },
+            .coalescedEvents = { },
+        }
+    };
+}
+
+WebWheelEventInit WebEventFactory::createWebWheelEvent(const WKWheelEvent& event)
+{
+    IntPoint position { static_cast<int>(std::floor(event.position.x)), static_cast<int>(std::floor(event.position.y)) };
+    IntPoint globalPosition { static_cast<int>(std::floor(event.screenPosition.x)), static_cast<int>(std::floor(event.screenPosition.y)) };
+
+    FloatSize delta { static_cast<float>(event.delta.width), static_cast<float>(event.delta.height) };
+    FloatSize wheelTicks { static_cast<float>(event.wheelTicks.width), static_cast<float>(event.wheelTicks.height) };
+
+    // The embedder gives pixels, wheel notches, or both: the missing one comes from the line step.
+    const float pixelsPerTick = Scrollbar::pixelsPerLineStep();
+    if (delta.isZero() && !wheelTicks.isZero()) {
+        delta = wheelTicks;
+        delta.scale(pixelsPerTick);
+    } else if (wheelTicks.isZero() && !delta.isZero()) {
+        wheelTicks = delta;
+        wheelTicks.scale(1 / pixelsPerTick);
+    }
+
+    // As the Windows factory: shift turns the vertical wheel into a horizontal one.
+    auto modifiers = modifiersForEventModifiers(event.modifiers);
+    if (modifiers.contains(WebEventModifier::ShiftKey) && !delta.width()) {
+        delta = delta.transposedSize();
+        wheelTicks = wheelTicks.transposedSize();
+    }
+
+    return {
+        { WebEventType::Wheel, modifiers, MonotonicTime::now() },
+        {
+            .position = position,
+            .globalPosition = globalPosition,
+            .delta = delta,
+            .wheelTicks = wheelTicks,
+            .granularity = WebWheelEvent::Granularity::ScrollByPixelWheelEvent,
+        }
+    };
+}
+
+} // namespace WebKit
