+#include <WebCore/NotImplemented.h>
+#include <wtf/FileSystem.h>
+
+namespace WebKit {
+
+// Where a data store keeps its files when the embedder gave no directory. The embedder normally sets
+// each one through the data store's configuration (WKWebsiteDataStoreConfiguration...), or the two
+// bases; these are the last resort. They are rooted paths without a volume name ("SD:"): Onyx's kernel
+// resolves them on the volume of the working directory, and WebKit's path code (std::filesystem) takes
+// them for absolute, which it does not do of a path that starts with a volume name.
+static constexpr auto defaultDataBaseDirectory = "/var/webkit"_s;
+static constexpr auto defaultCacheBaseDirectory = "/var/webkit/cache"_s;
+
+void WebsiteDataStore::platformInitialize()
+{
+    notImplemented();
+}
+
+void WebsiteDataStore::platformDestroy()
+{
+    notImplemented();
+}
+
+String WebsiteDataStore::cacheDirectoryFileSystemRepresentation(const String& directoryName, const String& baseCacheDirectory, ShouldCreateDirectory)
+{
+    if (!baseCacheDirectory.isNull())
+        return FileSystem::pathByAppendingComponent(baseCacheDirectory, directoryName);
+    return FileSystem::pathByAppendingComponent(defaultCacheBaseDirectory, directoryName);
+}
+
+String WebsiteDataStore::websiteDataDirectoryFileSystemRepresentation(const String& directoryName, const String& baseDataDirectory, ShouldCreateDirectory)
+{
+    if (!baseDataDirectory.isNull())
+        return FileSystem::pathByAppendingComponent(baseDataDirectory, directoryName);
+    return FileSystem::pathByAppendingComponent(defaultDataBaseDirectory, directoryName);
+}
+
+UnifiedOriginStorageLevel WebsiteDataStore::defaultUnifiedOriginStorageLevel()
+{
+    return UnifiedOriginStorageLevel::None;
+}
+
+} // namespace WebKit
