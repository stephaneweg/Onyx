+ * THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR
+ * PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL APPLE INC. OR ITS CONTRIBUTORS
+ * BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR
+ * CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF
+ * SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS
+ * INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
+ * CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+ * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF
+ * THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+// How Onyx starts WebKit's auxiliary processes.
+//
+// One executable plays the three roles (the UI, the web and the network process). The launcher starts
+// that same program file again with posix_spawn (Onyx has no fork) and this command line:
+//
+//     argv[0]  the program's path
+//     argv[1]  --onyx-webkit-process=web   or   --onyx-webkit-process=network
+//     argv[2]  the process identifier WebKit gave the new process (a decimal number)
+//     argv[3]  the descriptor number of the child's end of the IPC socket (a decimal number)
+//
+// The socket is an AF_UNIX SOCK_SEQPACKET pair. The parent's end is close-on-exec; the child's end is
+// not, and Onyx's posix_spawn gives the child every descriptor without FD_CLOEXEC at its own number, so
+// the number in argv[3] is valid in the child.
+//
+// What the embedder's main() must do, before anything else:
+//
+//     if (argc >= 2 && !strncmp(argv[1], "--onyx-webkit-process=", 22)) {
+//         const char* role = argv[1] + 22;
+//         if (!strcmp(role, "web"))
+//             return WebKit::WebProcessMain(argc - 1, argv + 1);
+//         if (!strcmp(role, "network"))
+//             return WebKit::NetworkProcessMain(argc - 1, argv + 1);
+//         return 1;
+//     }
+//
+// With the first argument dropped, argv[1] and argv[2] are the process identifier and the socket
+// descriptor that AuxiliaryProcessMainCommon::parseCommandLine (Shared/unix/AuxiliaryProcessMain.cpp)
+// reads. WKAuxiliaryProcessMainOnyx (UIProcess/API/C/onyx/WKAuxiliaryProcessOnyx.h) is that test and
+// those calls behind one C function.
+//
+// The program started is m_launchOptions.processPath when the embedder set one
+// (WKContextConfigurationSetWebProcessPath / SetNetworkProcessPath), else the running program's own
+// path: argv[0], which Onyx's kernel sets to the path the program was loaded from and libonyxposix
+// keeps in program_invocation_name.
+
+#include "config.h"
+#include "ProcessLauncher.h"
+
+#include "IPCUtilities.h"
+#include <errno.h>
+#include <signal.h>
+#include <spawn.h>
+#include <string.h>
+#include <sys/socket.h>
+#include <sys/types.h>
+#include <sys/wait.h>
+#include <wtf/Lock.h>
+#include <wtf/NeverDestroyed.h>
+#include <wtf/RunLoop.h>
+#include <wtf/Seconds.h>
+#include <wtf/StdLibExtras.h>
+#include <wtf/Vector.h>
+#include <wtf/text/CString.h>
+#include <wtf/text/WTFString.h>
+
+extern "C" {
+extern char** environ;
+// newlib declares it in <errno.h> under _GNU_SOURCE; said again here so that this file does not depend on it.
+extern char* program_invocation_name;
+}
+
+namespace WebKit {
+
+static const char* roleArgument(ProcessLauncher::ProcessType processType)
+{
+    switch (processType) {
+    case ProcessLauncher::ProcessType::Network:
+        return "--onyx-webkit-process=network";
+#if ENABLE(GPU_PROCESS)
+    case ProcessLauncher::ProcessType::GPU:
+        return "--onyx-webkit-process=gpu";
+#endif
+    case ProcessLauncher::ProcessType::Web:
+    default:
+        return "--onyx-webkit-process=web";
+    }
+}
+
+// libonyxposix keeps a record (and the kernel a process handle) for every child until waitpid has
+// collected it, and Onyx has no SIGCHLD to tell when a child ends. So the launcher remembers every
+// process it started and collects, without waiting, the ones that have ended each time it is used:
+// before a launch, after a kill (at once, then one second later, the time for the kill to take
+// effect), and when a launcher is invalidated. A child that ends by itself (a crash, or its
+// connection closed) is collected at the next of these. Each child is asked for by its pid, never
+// waitpid(-1), so the embedder's own children are left alone.
+static Lock childrenLock;
+
+static Vector<pid_t>& children() WTF_REQUIRES_LOCK(childrenLock)
+{
+    static NeverDestroyed<Vector<pid_t>> children;
+    return children;
+}
+
+static void rememberChild(pid_t pid)
+{
+    Locker locker { childrenLock };
+    children().append(pid);
+}
+
+static void reapChildren()
+{
+    Locker locker { childrenLock };
+    children().removeAllMatching([](pid_t pid) {
+        int result = waitpid(pid, nullptr, WNOHANG);
+        // The child was collected, or it is not ours any more (ECHILD): forget it. 0: still running.
+        return result == pid || (result < 0 && errno == ECHILD);
+    });
+}
+
+void ProcessLauncher::launchProcess()
+{
+    reapChildren();
+
+    // The client end keeps no FD_CLOEXEC: it is the descriptor the child inherits.
+    IPC::SocketPair socketPair = IPC::createPlatformConnection(SOCK_SEQPACKET, IPC::PlatformConnectionOptions::SetCloexecOnServer);
+
+    auto processPath = !m_launchOptions.processPath.isEmpty() ? m_launchOptions.processPath.utf8() : String::fromUTF8(program_invocation_name).utf8();
+    auto processIdentifier = String::number(static_cast<unsigned long long>(m_launchOptions.processIdentifier.toUInt64())).utf8();
+    auto clientSocket = String::number(static_cast<long>(socketPair.client.value())).utf8();
+
+    char* argv[] = {
+        const_cast<char*>(processPath.legacyCStringPointer()),
+        const_cast<char*>(roleArgument(m_launchOptions.processType)),
+        const_cast<char*>(processIdentifier.legacyCStringPointer()),
+        const_cast<char*>(clientSocket.legacyCStringPointer()),
+        nullptr
+    };
+
+    pid_t pid = 0;
+    int error = posix_spawn(&pid, processPath.legacyCStringPointer(), nullptr, nullptr, argv, environ);
+
+    // The child has its own reference to the client end (or there is no child): the parent closes its
+    // copy, so that the server end sees the connection close when the child ends.
+    socketPair.client = UnixFileDescriptor { };
+
+    if (error) {
+        WTFLogAlways("ProcessLauncher: posix_spawn of %s (%s) failed: %s", processPath.legacyCStringPointer(), roleArgument(m_launchOptions.processType), strerror(error));
+
+        // An invalid connection identifier is how a launcher reports a failed launch: the process
+        // proxies take it for a process that ended (WebProcessProxy::didFinishLaunching,
+        // NetworkProcessProxy::didFinishLaunching).
+        RunLoop::mainSingleton().dispatch([protectedThis = Ref { *this }] {
+            protectedThis->didFinishLaunchingProcess(0, IPC::Connection::Identifier { });
+        });
+        return;
+    }
+
+    rememberChild(pid);
+    m_processID = pid;
+
+    // We've finished launching the process, message back to the main run loop.
+    RunLoop::mainSingleton().dispatch([protectedThis = Ref { *this }, pid, serverIdentifier = WTF::move(socketPair.server)] mutable {
+        protectedThis->didFinishLaunchingProcess(pid, IPC::Connection::Identifier { WTF::move(serverIdentifier) });
+    });
+}
+
+void ProcessLauncher::terminateProcess(const String&)
+{
+    // The pid is known as soon as posix_spawn returns, before the launch is reported.
+    auto processID = m_processID;
+
+    if (m_isLaunching)
+        invalidate();
+
+    if (!processID)
+        return;
+
+    // SIGKILL ends the process at once (kapi kill_pid); Onyx delivers no other signal to another process.
+    kill(processID, SIGKILL);
+    m_processID = 0;
+
+    reapChildren();
+    RunLoop::mainSingleton().dispatchAfter(1_s, [] {
+        reapChildren();
+    });
+}
+
+void ProcessLauncher::platformInvalidate()
+{
+    reapChildren();
+}
+
+} // namespace WebKit
