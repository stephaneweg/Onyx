+#include "config.h"
+#include "WKPagePrivateOnyx.h"
+
+#include "DrawingAreaProxy.h"
+#include "DrawingAreaProxyCoordinatedGraphics.h"
+#include "NativeWebKeyboardEvent.h"
+#include "NativeWebMouseEvent.h"
+#include "NativeWebWheelEvent.h"
+#include "WKAPICast.h"
+#include "WebEventFactoryOnyx.h"
+#include "WebPageProxy.h"
+#include <WebCore/Color.h>
+#include <WebCore/Region.h>
+#include <skia/core/SkCanvas.h>
+#include <skia/core/SkColorSpace.h>
+#include <skia/core/SkImageInfo.h>
+#include <skia/core/SkPaint.h>
+#include <skia/core/SkSurface.h>
+
+static void drawPageBackground(SkCanvas* canvas, const std::optional<WebCore::Color>& backgroundColor, const WebCore::IntRect& rect)
+{
+    // (The PlayStation port only does this for an invisible background colour, and then clears the
+    // whole canvas. Here: the rectangle, with the page's colour, white when it has none.)
+    SkPaint paint;
+    paint.setBlendMode(SkBlendMode::kSrc);
+    paint.setColor(backgroundColor ? SkColor(backgroundColor.value()) : SK_ColorWHITE);
+    canvas->drawRect(SkRect::MakeXYWH(rect.x(), rect.y(), rect.width(), rect.height()), paint);
+}
+
+void WKPageHandleKeyboardEvent(WKPageRef pageRef, WKKeyboardEvent event)
+{
+    switch (event.type) {
+    case kWKEventKeyDown:
+    case kWKEventKeyUp:
+        break;
+    default:
+        ASSERT_NOT_REACHED();
+        return;
+    }
+
+    WebKit::toImpl(pageRef)->handleKeyboardEvent(WebKit::NativeWebKeyboardEvent::create(WebKit::WebEventFactory::createWebKeyboardEvent(event)));
+}
+
+void WKPageHandleMouseEvent(WKPageRef pageRef, WKMouseEvent event)
+{
+    switch (event.type) {
+    case kWKEventMouseDown:
+    case kWKEventMouseUp:
+    case kWKEventMouseMove:
+        break;
+    default:
+        ASSERT_NOT_REACHED();
+        return;
+    }
+
+    WebKit::toImpl(pageRef)->handleMouseEvent(WebKit::NativeWebMouseEvent::create(WebKit::WebEventFactory::createWebMouseEvent(event)));
+}
+
+void WKPageHandleWheelEvent(WKPageRef pageRef, WKWheelEvent event)
+{
+    WebKit::toImpl(pageRef)->handleNativeWheelEvent(WebKit::NativeWebWheelEvent::create(WebKit::WebEventFactory::createWebWheelEvent(event)));
+}
+
+void WKPagePaint(WKPageRef pageRef, unsigned char* surfaceData, WKSize wkSurfaceSize, uint32_t stride, WKRect wkPaintRect)
+{
+    auto surfaceSize = WebKit::toIntSize(wkSurfaceSize);
+    auto paintRect = WebKit::toIntRect(wkPaintRect);
+    if (!surfaceData || surfaceSize.isEmpty())
+        return;
+
+    paintRect.intersect(WebCore::IntRect { { }, surfaceSize });
+    if (paintRect.isEmpty())
+        return;
+
+    // 0xAARRGGBB words, premultiplied: the layout of an Onyx window's canvas (and Skia's N32 in Onyx's build).
+    auto info = SkImageInfo::Make(surfaceSize.width(), surfaceSize.height(), kBGRA_8888_SkColorType, kPremul_SkAlphaType, SkColorSpace::MakeSRGB());
+    size_t rowBytes = stride ? stride : info.minRowBytes();
+    if (rowBytes < info.minRowBytes())
+        return;
+    auto surface = SkSurfaces::WrapPixels(info, surfaceData, rowBytes, nullptr);
+    if (!surface)
+        return;
+    auto* canvas = surface->getCanvas();
+
+    // Nothing is painted outside the rectangle asked for.
+    canvas->save();
+    canvas->clipRect(SkRect::MakeXYWH(paintRect.x(), paintRect.y(), paintRect.width(), paintRect.height()));
+
+    auto page = WebKit::toImpl(pageRef);
+    auto& backgroundColor = page->backgroundColor();
+    page->endPrinting();
+
+    if (auto* drawingArea = page->drawingArea()) {
+        // FIXME: We should port WebKit1's rect coalescing logic here.
+        WebCore::Region unpaintedRegion;
+        downcast<WebKit::DrawingAreaProxyCoordinatedGraphics>(drawingArea)->paint(canvas, paintRect, unpaintedRegion);
+
+        for (const auto& rect : unpaintedRegion.rects())
+            drawPageBackground(canvas, backgroundColor, rect);
+    } else
+        drawPageBackground(canvas, backgroundColor, paintRect);
+
+    canvas->restore();
+}
