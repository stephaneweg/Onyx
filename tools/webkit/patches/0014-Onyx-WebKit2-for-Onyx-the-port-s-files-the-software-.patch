+void WKViewSetViewClient(WKViewRef view, const WKViewClientBase* client)
+{
+    class ViewClient final : public API::Client<WKViewClientBase>, public API::ViewClient {
+    public:
+        explicit ViewClient(const WKViewClientBase* client)
+        {
+            initialize(client);
+        }
+
+    private:
+        void setViewNeedsDisplay(WebKit::OnyxWebView& view, const WebCore::Region& region) final
+        {
+            if (!m_client.setViewNeedsDisplay)
+                return;
+            m_client.setViewNeedsDisplay(WebKit::toAPI(&view), WebKit::toAPI(region.bounds()), m_client.base.clientInfo);
+        }
+
+        void setCursor(WebKit::OnyxWebView& view, const WebCore::Cursor& cursor) final
+        {
+            if (!m_client.setCursor)
+                return;
+            m_client.setCursor(WebKit::toAPI(&view), toWKCursorType(cursor), m_client.base.clientInfo);
+        }
+
+        void toolTipChanged(WebKit::OnyxWebView& view, const WTF::String& toolTip) final
+        {
+            if (!m_client.toolTipChanged)
+                return;
+            m_client.toolTipChanged(WebKit::toAPI(&view), WebKit::toAPI(toolTip), m_client.base.clientInfo);
+        }
+
+        void didNotHandleKeyEvent(WebKit::OnyxWebView& view, const WebKit::NativeWebKeyboardEvent& event) final
+        {
+            if (!m_client.didNotHandleKeyEvent)
+                return;
+
+            // The embedder's event is not kept: this is the same event made again from WebKit's.
+            auto text = event.text().utf8();
+            auto unmodifiedText = event.unmodifiedText().utf8();
+
+            WKKeyboardEvent keyboardEvent;
+            keyboardEvent.type = event.type() == WebKit::WebEventType::KeyUp ? kWKEventKeyUp : kWKEventKeyDown;
+            keyboardEvent.virtualKeyCode = event.windowsVirtualKeyCode();
+            keyboardEvent.nativeKeyCode = event.nativeVirtualKeyCode();
+            keyboardEvent.text = text.legacyCStringPointer();
+            keyboardEvent.unmodifiedText = unmodifiedText.legacyCStringPointer();
+            keyboardEvent.modifiers = toWKEventModifiers(event.modifiers());
+            keyboardEvent.flags = (event.isAutoRepeat() ? kWKKeyboardEventFlagsAutoRepeat : 0) | (event.isKeypad() ? kWKKeyboardEventFlagsKeypad : 0);
+            m_client.didNotHandleKeyEvent(WebKit::toAPI(&view), keyboardEvent, m_client.base.clientInfo);
+        }
+
+        void webProcessCrashed(WebKit::OnyxWebView& view) final
+        {
+            if (!m_client.webProcessCrashed)
+                return;
+            m_client.webProcessCrashed(WebKit::toAPI(&view), m_client.base.clientInfo);
+        }
+
+        void webProcessDidRelaunch(WebKit::OnyxWebView& view) final
+        {
+            if (!m_client.webProcessDidRelaunch)
+                return;
+            m_client.webProcessDidRelaunch(WebKit::toAPI(&view), m_client.base.clientInfo);
+        }
+
+        void enterFullScreen(WebKit::OnyxWebView& view, CompletionHandler<void(bool)>&& completionHandler) final
+        {
+            if (!m_client.enterFullScreen)
+                return completionHandler(false);
+            m_client.enterFullScreen(WebKit::toAPI(&view), m_client.base.clientInfo);
+            completionHandler(true);
+        }
+
+        void exitFullScreen(WebKit::OnyxWebView& view) final
+        {
+            if (!m_client.exitFullScreen)
+                return;
+            m_client.exitFullScreen(WebKit::toAPI(&view), m_client.base.clientInfo);
+        }
+
+        void closeFullScreen(WebKit::OnyxWebView& view) final
+        {
+            if (!m_client.closeFullScreen)
+                return;
+            m_client.closeFullScreen(WebKit::toAPI(&view), m_client.base.clientInfo);
+        }
+
+        void beganEnterFullScreen(WebKit::OnyxWebView& view, const WebCore::IntRect& initialFrame, const WebCore::IntRect& finalFrame, CompletionHandler<void(bool)>&& completionHandler) final
+        {
+            if (!m_client.beganEnterFullScreen)
+                return completionHandler(false);
+            m_client.beganEnterFullScreen(WebKit::toAPI(&view), WebKit::toAPI(initialFrame), WebKit::toAPI(finalFrame), m_client.base.clientInfo);
+            completionHandler(true);
+        }
+
+        void beganExitFullScreen(WebKit::OnyxWebView& view, const WebCore::IntRect& initialFrame, const WebCore::IntRect& finalFrame, CompletionHandler<void()>&& completionHandler) final
+        {
+            if (!m_client.beganExitFullScreen)
+                return completionHandler();
+            m_client.beganExitFullScreen(WebKit::toAPI(&view), WebKit::toAPI(initialFrame), WebKit::toAPI(finalFrame), m_client.base.clientInfo);
+            completionHandler();
+        }
+    };
+
+    WebKit::toImpl(view)->setClient(makeUnique<ViewClient>(client));
+}
