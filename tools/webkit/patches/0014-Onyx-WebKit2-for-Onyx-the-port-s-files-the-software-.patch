+static WKCursorType toWKCursorType(const WebCore::Cursor& cursor)
+{
+    switch (cursor.type()) {
+    case WebCore::Cursor::Type::Cross:
+        return kWKCursorTypeCross;
+    case WebCore::Cursor::Type::Hand:
+        return kWKCursorTypeHand;
+    case WebCore::Cursor::Type::IBeam:
+    case WebCore::Cursor::Type::VerticalText:
+        return kWKCursorTypeIBeam;
+    case WebCore::Cursor::Type::Wait:
+        return kWKCursorTypeWait;
+    case WebCore::Cursor::Type::Help:
+        return kWKCursorTypeHelp;
+    case WebCore::Cursor::Type::Move:
+        return kWKCursorTypeMove;
+    case WebCore::Cursor::Type::EastResize:
+    case WebCore::Cursor::Type::WestResize:
+    case WebCore::Cursor::Type::EastWestResize:
+        return kWKCursorTypeEastWestResize;
+    case WebCore::Cursor::Type::NorthResize:
+    case WebCore::Cursor::Type::SouthResize:
+    case WebCore::Cursor::Type::NorthSouthResize:
+        return kWKCursorTypeNorthSouthResize;
+    case WebCore::Cursor::Type::NorthEastResize:
+    case WebCore::Cursor::Type::SouthWestResize:
+    case WebCore::Cursor::Type::NorthEastSouthWestResize:
+        return kWKCursorTypeNorthEastSouthWestResize;
+    case WebCore::Cursor::Type::NorthWestResize:
+    case WebCore::Cursor::Type::SouthEastResize:
+    case WebCore::Cursor::Type::NorthWestSouthEastResize:
+        return kWKCursorTypeNorthWestSouthEastResize;
+    case WebCore::Cursor::Type::ColumnResize:
+        return kWKCursorTypeColumnResize;
+    case WebCore::Cursor::Type::RowResize:
+        return kWKCursorTypeRowResize;
+    case WebCore::Cursor::Type::Progress:
+        return kWKCursorTypeProgress;
+    case WebCore::Cursor::Type::NoDrop:
+    case WebCore::Cursor::Type::NotAllowed:
+        return kWKCursorTypeNotAllowed;
+    case WebCore::Cursor::Type::Grab:
+        return kWKCursorTypeGrab;
+    case WebCore::Cursor::Type::Grabbing:
+        return kWKCursorTypeGrabbing;
+    case WebCore::Cursor::Type::ZoomIn:
+        return kWKCursorTypeZoomIn;
+    case WebCore::Cursor::Type::ZoomOut:
+        return kWKCursorTypeZoomOut;
+    case WebCore::Cursor::Type::None:
+        return kWKCursorTypeNone;
+    case WebCore::Cursor::Type::Pointer:
+    default:
+        return kWKCursorTypePointer;
+    }
+}
+
+static uint32_t toWKEventModifiers(OptionSet<WebKit::WebEventModifier> modifiers)
+{
+    uint32_t result = 0;
+    if (modifiers.contains(WebKit::WebEventModifier::ShiftKey))
+        result |= kWKEventModifiersShiftKey;
+    if (modifiers.contains(WebKit::WebEventModifier::ControlKey))
+        result |= kWKEventModifiersControlKey;
+    if (modifiers.contains(WebKit::WebEventModifier::AltKey))
+        result |= kWKEventModifiersAltKey;
+    if (modifiers.contains(WebKit::WebEventModifier::MetaKey))
+        result |= kWKEventModifiersMetaKey;
+    if (modifiers.contains(WebKit::WebEventModifier::CapsLockKey))
+        result |= kWKEventModifiersCapsLockKey;
+    if (modifiers.contains(WebKit::WebEventModifier::AltGraphKey))
+        result |= kWKEventModifiersAltGraphKey;
+    return result;
+}
+
+WKViewRef WKViewCreate(WKPageConfigurationRef configuration)
+{
+    return WebKit::toAPI(WebKit::OnyxWebView::create(*WebKit::toImpl(configuration)).leakRef());
+}
