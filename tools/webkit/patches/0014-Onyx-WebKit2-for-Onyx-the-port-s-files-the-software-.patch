+extern "C" {
+#endif
+
+// On Onyx one executable plays the three roles of WebKit: the UI process (the embedder's program), the
+// web process and the network process. WebKit starts the two others by running the same program file
+// again with "--onyx-webkit-process=web" or "--onyx-webkit-process=network" as its first argument
+// (UIProcess/Launcher/onyx/ProcessLauncherOnyx.cpp). The embedder's main() must therefore begin with:
+//
+//     int main(int argc, char** argv)
+//     {
+//         if (WKIsAuxiliaryProcessOnyx(argc, argv))
+//             return WKAuxiliaryProcessMainOnyx(argc, argv);
+//         ... the program itself ...
+//     }
+//
+// before it opens a window or touches anything else.
+
+// Whether this run of the program is one of WebKit's auxiliary processes.
+WK_EXPORT bool WKIsAuxiliaryProcessOnyx(int argc, char** argv);
+
+// Runs the web process or the network process the arguments ask for, and returns its exit code when it
+// ends (1 at once if the arguments ask for neither).
+WK_EXPORT int WKAuxiliaryProcessMainOnyx(int argc, char** argv);
+
+#ifdef __cplusplus
+}
