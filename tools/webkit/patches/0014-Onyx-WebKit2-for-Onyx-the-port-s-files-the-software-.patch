+
+/* The pointer shape the page asks for. Every other shape WebCore knows is reported as kWKCursorTypePointer. */
+enum {
+    kWKCursorTypePointer = 0,
+    kWKCursorTypeCross,
+    kWKCursorTypeHand,
+    kWKCursorTypeIBeam,
+    kWKCursorTypeWait,
+    kWKCursorTypeHelp,
+    kWKCursorTypeMove,
+    kWKCursorTypeEastWestResize,
+    kWKCursorTypeNorthSouthResize,
+    kWKCursorTypeNorthEastSouthWestResize,
+    kWKCursorTypeNorthWestSouthEastResize,
+    kWKCursorTypeColumnResize,
+    kWKCursorTypeRowResize,
+    kWKCursorTypeProgress,
+    kWKCursorTypeNotAllowed,
+    kWKCursorTypeGrab,
+    kWKCursorTypeGrabbing,
+    kWKCursorTypeZoomIn,
+    kWKCursorTypeZoomOut,
+    kWKCursorTypeNone
+};
+typedef uint32_t WKCursorType;
+
+// The rectangle (in the view's coordinates) has new pixels: the embedder paints it with WKPagePaint.
+typedef void(*WKViewSetViewNeedsDisplayCallback)(WKViewRef view, WKRect rect, const void* clientInfo);
+typedef void(*WKViewSetCursorCallback)(WKViewRef view, WKCursorType cursorType, const void* clientInfo);
+// The tool tip to show at the pointer; an empty string: none.
+typedef void(*WKViewToolTipChangedCallback)(WKViewRef view, WKStringRef toolTip, const void* clientInfo);
+// A key event given to WKPageHandleKeyboardEvent that the page did not use: the embedder's shortcuts.
+// The event's strings are only valid during the call.
+typedef void(*WKViewDidNotHandleKeyEventCallback)(WKViewRef view, WKKeyboardEvent event, const void* clientInfo);
+// The web process ended (it crashed, or was killed): the view shows nothing until the page is loaded
+// again (WKPageReload...), which starts a new process and calls webProcessDidRelaunch.
+typedef void(*WKViewWebProcessCrashedCallback)(WKViewRef view, const void* clientInfo);
+typedef void(*WKViewWebProcessDidRelaunchCallback)(WKViewRef view, const void* clientInfo);
+typedef void(*WKViewEnterFullScreen)(WKViewRef view, const void* clientInfo);
+typedef void(*WKViewExitFullScreen)(WKViewRef view, const void* clientInfo);
