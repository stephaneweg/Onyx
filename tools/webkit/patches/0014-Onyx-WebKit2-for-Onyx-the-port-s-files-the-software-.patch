+
+class NativeWebKeyboardEvent;
+
+// The web view of the Onyx port: it owns the page (WebPageProxy), keeps the size and the activity state
+// the embedder gives it, and passes what the page asks of its view (repaint, cursor, tool tip, unused
+// keys, full screen) to the embedder's client. It has no window: the embedder paints the page into its
+// own with WKPagePaint and sends it the input events (WKPagePrivateOnyx.h).
+class OnyxWebView : public API::ObjectImpl<API::Object::Type::View> {
+    WTF_MAKE_TZONE_ALLOCATED(OnyxWebView);
+public:
+    static RefPtr<OnyxWebView> create(const API::PageConfiguration&);
+    virtual ~OnyxWebView();
+
+    void setClient(std::unique_ptr<API::ViewClient>&&);
+
+    WebPageProxy* page() { return m_page.get(); }
+
+    void setViewSize(WebCore::IntSize);
+    WebCore::IntSize viewSize() const { return m_viewSize; }
+
+    void setViewState(OptionSet<WebCore::ActivityState>);
+    OptionSet<WebCore::ActivityState> viewState() const { return m_viewStateFlags; }
+
+#if ENABLE(FULLSCREEN_API)
+    void willEnterFullScreen(CompletionHandler<void(bool)>&&);
+    void requestExitFullScreen();
+#endif
+
+    // Functions called by PageClientImpl
+    void setViewNeedsDisplay(const WebCore::Region&);
+    void setCursor(const WebCore::Cursor&);
+    void toolTipChanged(const String&);
+    void didNotHandleKeyEvent(const NativeWebKeyboardEvent&);
+    void webProcessCrashed();
+    void webProcessDidRelaunch();
+#if ENABLE(FULLSCREEN_API)
+    bool isFullScreen();
+    void closeFullScreenManager();
+    void enterFullScreen(CompletionHandler<void(bool)>&&);
+    void exitFullScreen(CompletionHandler<void()>&&);
+    void beganEnterFullScreen(const WebCore::IntRect&, const WebCore::IntRect&, CompletionHandler<void(bool)>&&);
+    void beganExitFullScreen(const WebCore::IntRect&, const WebCore::IntRect&, CompletionHandler<void()>&&);
+#endif
+
+private:
+    OnyxWebView(const API::PageConfiguration&);
+
+    std::unique_ptr<API::ViewClient> m_client;
+    const std::unique_ptr<WebKit::PageClientImpl> m_pageClient;
+    const RefPtr<WebPageProxy> m_page;
+    OptionSet<WebCore::ActivityState> m_viewStateFlags;
+
+    WebCore::IntSize m_viewSize;
+#if ENABLE(FULLSCREEN_API)
+    bool m_isFullScreen { false };
+#endif
+};
+
+} // namespace WebKit
