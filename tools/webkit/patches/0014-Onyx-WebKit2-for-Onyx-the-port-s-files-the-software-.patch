+ * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF
+ * THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#include "config.h"
+#include "WKAuxiliaryProcessOnyx.h"
+
+#include "NetworkProcessMain.h"
+#include "WebProcessMain.h"
+#include <string.h>
+
+// The first argument ProcessLauncherOnyx.cpp gives an auxiliary process: this prefix, then its role.
+static const char roleArgumentPrefix[] = "--onyx-webkit-process=";
+
+static const char* auxiliaryProcessRole(int argc, char** argv)
+{
+    if (argc < 2 || !argv || !argv[1])
+        return nullptr;
+    const size_t prefixLength = sizeof(roleArgumentPrefix) - 1;
+    if (strncmp(argv[1], roleArgumentPrefix, prefixLength))
+        return nullptr;
+    return argv[1] + prefixLength;
+}
+
+bool WKIsAuxiliaryProcessOnyx(int argc, char** argv)
+{
+    return !!auxiliaryProcessRole(argc, argv);
+}
+
+int WKAuxiliaryProcessMainOnyx(int argc, char** argv)
+{
+    const char* role = auxiliaryProcessRole(argc, argv);
+    if (!role)
+        return 1;
+
+    // Without the role argument, the command line is the one every Unix port gives its auxiliary
+    // processes (Shared/unix/AuxiliaryProcessMain.cpp): the name, the process identifier, the socket.
+    if (!strcmp(role, "web"))
+        return WebKit::WebProcessMain(argc - 1, argv + 1);
+    if (!strcmp(role, "network"))
+        return WebKit::NetworkProcessMain(argc - 1, argv + 1);
+
+    return 1;
+}
