@@ -0,0 +1,111 @@
+# The Onyx port of WebKit (the multi-process layer): the Unix IPC files, the curl network
+# process, Skia on the CPU and the software drawing path -- no compositor, no GL / EGL, no libwpe,
+# no GLib, no GPU process, no WebDriver. The view (UIProcess/onyx) is exposed to embedders through
+# a small C API (UIProcess/API/C/onyx, Shared/API/c/onyx) beside WebKit's generic WK* API.
+
+include(Headers.cmake)
+include(Platform/Curl.cmake)
+include(Platform/Skia.cmake)
+
+# The program that is shipped is one multi-call executable linked outside this build: its main
+# picks the role (UI, web, network) and calls WebKit::WebProcessMain or NetworkProcessMain. The
+# two upstream targets are kept, on the stock Unix entry points, as a link check of libWebKit.a.
+list(APPEND WebProcess_SOURCES
+    WebProcess/EntryPoint/unix/WebProcessMain.cpp
+)
+
+list(APPEND NetworkProcess_SOURCES
+    NetworkProcess/EntryPoint/unix/NetworkProcessMain.cpp
+)
+
+list(APPEND WebKit_SOURCES
+    NetworkProcess/NetworkDataTaskDataURL.cpp
+
+    NetworkProcess/Classifier/WebResourceLoadStatisticsStore.cpp
+
+    Platform/IPC/unix/ArgumentCodersUnix.cpp
+    Platform/IPC/unix/ConnectionUnix.cpp
+    Platform/IPC/unix/IPCSemaphoreUnix.cpp
+    Platform/IPC/unix/IPCUtilitiesUnix.cpp
+
+    Platform/classifier/ResourceLoadStatisticsClassifier.cpp
+
+    Platform/unix/LoggingUnix.cpp
+    Platform/unix/ModuleUnix.cpp
+
+    Shared/API/c/onyx/WKEventOnyx.cpp
+
+    Shared/onyx/NativeWebKeyboardEventOnyx.cpp
+    Shared/onyx/NativeWebMouseEventOnyx.cpp
+    Shared/onyx/NativeWebWheelEventOnyx.cpp
+    Shared/onyx/WebEventFactoryOnyx.cpp
+
+    Shared/unix/AuxiliaryProcessMain.cpp
+
+    UIProcess/DefaultUndoController.cpp
+    UIProcess/LegacySessionStateCodingNone.cpp
+    UIProcess/WebGrammarDetail.cpp
+    UIProcess/WebMemoryPressureHandler.cpp
+    UIProcess/WebViewportAttributes.cpp
+
+    UIProcess/API/C/WKViewportAttributes.cpp
+
+    UIProcess/API/C/onyx/WKAuxiliaryProcessOnyx.cpp
+    UIProcess/API/C/onyx/WKContextConfigurationOnyx.cpp
+    UIProcess/API/C/onyx/WKPagePrivateOnyx.cpp
+    UIProcess/API/C/onyx/WKRunLoop.cpp
+    UIProcess/API/C/onyx/WKView.cpp
+
+    # The software drawing path (USE_NON_COMPOSITED_DRAWING_AREA): no layer tree host.
+    UIProcess/CoordinatedGraphics/DrawingAreaProxyCoordinatedGraphics.cpp
+
+    UIProcess/Launcher/onyx/ProcessLauncherOnyx.cpp
+
+    UIProcess/WebsiteData/onyx/WebsiteDataStoreOnyx.cpp
+
+    # Only WebCore::PlatformPasteboard calls, nothing of libwpe (platform/onyx/PlatformPasteboardOnyx.cpp).
+    UIProcess/libwpe/WebPasteboardProxyLibWPE.cpp
+
+    UIProcess/onyx/OnyxWebView.cpp
