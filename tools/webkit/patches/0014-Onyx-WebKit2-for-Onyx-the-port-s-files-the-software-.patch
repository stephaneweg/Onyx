+#include "config.h"
+#include "WKRunLoop.h"
+
+#include "WebKit2Initialize.h"
+#include <wtf/MainThread.h>
+#include <wtf/RunLoop.h>
+
+void WKRunLoopRunMain()
+{
+    RunLoop::mainSingleton().run();
+}
+
+void WKRunLoopStopMain()
+{
+    RunLoop::mainSingleton().stop();
+}
+
+void WKRunLoopCycleMain()
+{
+    // The generic run loop's (wtf/generic/RunLoopGeneric.cpp) single pass: the expired timers, the queued
+    // work, no wait. It runs the current thread's loop, which is the main one when called as documented.
+    ASSERT(isMainRunLoop());
+    RunLoop::cycle();
+}
+
+void WKRunLoopSetWakeUpCallback(WKRunLoopCallback callback, void* userData)
+{
+    ASSERT(isMainRunLoop());
+    if (!callback) {
+        RunLoop::setWakeUpCallback({ });
+        return;
+    }
+
+    RunLoop::setWakeUpCallback([callback, userData] {
+        callback(userData);
+    });
+}
+
+void WKRunLoopCallOnMainThread(WKRunLoopCallback callback, void* userData)
+{
+    if (!callback)
+        return;
+
+    callOnMainThread([callback, userData]() {
+        callback(userData);
+    });
+}
+
+void WKRunLoopInitializeMain()
+{
+    // FIXME:
+    // Initializing RunLoop by InitializeWebKit2().
+    // WKRunLoopInitializeMain() should be renamed to more straightforward API name to wrap InitializeWebKit2().
+    WebKit::InitializeWebKit2();
+}
