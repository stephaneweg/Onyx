--- a/Source/WebKit/Platform/IPC/unix/ConnectionUnix.cpp
+++ b/Source/WebKit/Platform/IPC/unix/ConnectionUnix.cpp
@@ -108,13 +108,25 @@ void Connection::platformInitialize(Identifier&& identifier)
 
 void Connection::platformInvalidate()
 {
+#if PLATFORM(ONYX)
+    // Onyx's poll() and select() hold a reference on the socket for as long as they wait, so
+    // closing the descriptor from another thread neither wakes the socket monitor nor tells the
+    // peer. shutdown() does both: every waiter wakes and receives return 0 from then on. The
+    // descriptor is taken out of m_socketDescriptor first, so that the woken monitor sees -1 and
+    // leaves its loop instead of reading.
+    if (int fd = m_socketDescriptor.release(); fd != -1) {
+        shutdown(fd, SHUT_RDWR);
+        closeWithRetry(fd);
+    }
+#else
     if (m_socketDescriptor.value() != -1)
         closeWithRetry(m_socketDescriptor.release());
+#endif
 
     if (!m_isConnected)
         return;
 
-#if PLATFORM(PLAYSTATION)
+#if PLATFORM(PLAYSTATION) || PLATFORM(ONYX)
     if (m_socketMonitor) {
         m_socketMonitor->detach();
         m_socketMonitor = nullptr;
@@ -335,7 +347,7 @@ void Connection::platformOpen()
     RefPtr<Connection> protectedThis(this);
     m_isConnected = true;
 
-#if PLATFORM(PLAYSTATION)
+#if PLATFORM(PLAYSTATION) || PLATFORM(ONYX)
     m_socketMonitor = Thread::create("SocketMonitor"_s, [protectedThis] {
         {
             int fd;
@@ -346,6 +358,12 @@ void Connection::platformOpen()
                 FD_SET(fd, &fdSet);
 
                 if (-1 != select(maxFd + 1, &fdSet, 0, 0, 0)) {
+#if PLATFORM(ONYX)
+                    // Woken by platformInvalidate()'s shutdown(): the descriptor is no longer the
+                    // connection's, there is nothing to read and the loop ends.
+                    if (protectedThis->socketDescriptor() != fd)
+                        continue;
+#endif
                     if (FD_ISSET(fd, &fdSet))
