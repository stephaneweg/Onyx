+#include "config.h"
+#include "WKEventOnyx.h"
+
+WKKeyboardEvent WKKeyboardEventMake(WKEventType type, int32_t virtualKeyCode, const char* text, uint32_t modifiers, uint32_t flags)
+{
+    WKKeyboardEvent keyboardEvent;
+    keyboardEvent.type = type;
+    keyboardEvent.virtualKeyCode = virtualKeyCode;
+    keyboardEvent.nativeKeyCode = 0;
+    keyboardEvent.text = text;
+    keyboardEvent.unmodifiedText = nullptr;
+    keyboardEvent.modifiers = modifiers;
+    keyboardEvent.flags = flags;
+    return keyboardEvent;
+}
+
+WKMouseEvent WKMouseEventMake(WKEventType type, WKEventMouseButton button, uint32_t buttons, WKPoint position, WKPoint screenPosition, int32_t clickCount, uint32_t modifiers)
+{
+    WKMouseEvent mouseEvent;
+    mouseEvent.type = type;
+    mouseEvent.button = button;
+    mouseEvent.buttons = buttons;
+    mouseEvent.position = position;
+    mouseEvent.screenPosition = screenPosition;
+    mouseEvent.clickCount = clickCount;
+    mouseEvent.modifiers = modifiers;
+    return mouseEvent;
+}
+
+WKWheelEvent WKWheelEventMake(WKPoint position, WKPoint screenPosition, WKSize delta, WKSize wheelTicks, uint32_t modifiers)
+{
+    WKWheelEvent wheelEvent;
+    wheelEvent.type = kWKEventWheel;
+    wheelEvent.position = position;
+    wheelEvent.screenPosition = screenPosition;
+    wheelEvent.delta = delta;
+    wheelEvent.wheelTicks = wheelTicks;
+    wheelEvent.modifiers = modifiers;
+    return wheelEvent;
+}
diff --git a/Source/WebKit/Shared/API/c/onyx/WKEventOnyx.h b/Source/WebKit/Shared/API/c/onyx/WKEventOnyx.h
new file mode 100644
index 00000000..74a9c970
--- /dev/null
+++ b/Source/WebKit/Shared/API/c/onyx/WKEventOnyx.h
@@ -0,0 +1,217 @@
+/*
+ * Copyright (C) 2026 Onyx contributors. All rights reserved.
+ *
+ * Redistribution and use in source and binary forms, with or without
+ * modification, are permitted provided that the following conditions
+ * are met:
+ * 1. Redistributions of source code must retain the above copyright
+ *    notice, this list of conditions and the following disclaimer.
+ * 2. Redistributions in binary form must reproduce the above copyright
+ *    notice, this list of conditions and the following disclaimer in the
+ *    documentation and/or other materials provided with the distribution.
+ *
+ * THIS SOFTWARE IS PROVIDED BY APPLE INC. AND ITS CONTRIBUTORS ``AS IS''
+ * AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO,
+ * THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR
+ * PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL APPLE INC. OR ITS CONTRIBUTORS
+ * BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR
+ * CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF
+ * SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS
+ * INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
+ * CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+ * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF
+ * THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#pragma once
+
+#include <WebKit/WKBase.h>
+#include <WebKit/WKEvent.h>
+#include <WebKit/WKGeometry.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/*
+ * The input events an Onyx embedder gives to a page (WKPageHandleKeyboardEvent, WKPageHandleMouseEvent,
+ * WKPageHandleWheelEvent in WKPagePrivateOnyx.h). They are plain values: nothing in them is kept after
+ * the call returns (the text of a keyboard event is copied).
+ *
+ * Modifiers are the WKEventModifiers of WKEvent.h (shift, control, alt, meta, caps lock), plus
+ * kWKEventModifiersAltGraphKey below.
+ */
+
+enum {
+    kWKEventNoType = -1,
+
+    // WebMouseEvent
+    kWKEventMouseDown,
+    kWKEventMouseUp,
+    kWKEventMouseMove,
+    kWKEventMouseForceChanged, // (not used on Onyx; kept so the values match the other ports')
+    kWKEventMouseForceDown,
+    kWKEventMouseForceUp,
+
+    // WebWheelEvent
+    kWKEventWheel,
+
+    // WebKeyboardEvent
+    kWKEventKeyDown,
+    kWKEventKeyUp
+};
+typedef int32_t WKEventType;
+
+enum {
+    // AltGr (the right Alt key of a layout that has a third level). A key event that carries it is not
+    // taken for a Control / Alt shortcut: its text is typed. An embedder whose keyboard driver reports
+    // AltGr as Control + Alt sets this bit instead of those two.
+    kWKEventModifiersAltGraphKey = 1 << 5
+};
+
+/* The bits of WKMouseEvent.buttons: the buttons held down, as MouseEvent.buttons in the DOM. */
+enum {
+    kWKEventMouseButtonsNone = 0,
+    kWKEventMouseButtonsLeft = 1 << 0,
+    kWKEventMouseButtonsRight = 1 << 1,
+    kWKEventMouseButtonsMiddle = 1 << 2,
+    kWKEventMouseButtonsBack = 1 << 3,
+    kWKEventMouseButtonsForward = 1 << 4
+};
+typedef uint32_t WKEventMouseButtons;
+
+/* The bits of WKKeyboardEvent.flags. */
+enum {
+    kWKKeyboardEventFlagsNone = 0,
+    kWKKeyboardEventFlagsAutoRepeat = 1 << 0, // the key is held down: this is a repeated key down
+    kWKKeyboardEventFlagsKeypad = 1 << 1 // the key is on the numeric keypad
+};
+typedef uint32_t WKKeyboardEventFlags;
+
+/*
+ * WKKeyboardEvent.virtualKeyCode is a Windows virtual-key code: WebKit's editing commands, KeyboardEvent.keyCode
+ * and the "key" / "code" strings of the DOM event are all derived from it (and from the text). The usual ones;
+ * letters are 'A' to 'Z' (0x41 to 0x5A) and digits '0' to '9' (0x30 to 0x39) whatever the modifiers.
+ */
+enum {
+    kWKKeyCodeUnknown = 0,
+    kWKKeyCodeBackspace = 0x08,
+    kWKKeyCodeTab = 0x09,
+    kWKKeyCodeClear = 0x0C,
+    kWKKeyCodeReturn = 0x0D,
+    kWKKeyCodeShift = 0x10,
+    kWKKeyCodeControl = 0x11,
+    kWKKeyCodeAlt = 0x12,
+    kWKKeyCodePause = 0x13,
+    kWKKeyCodeCapsLock = 0x14,
+    kWKKeyCodeEscape = 0x1B,
+    kWKKeyCodeSpace = 0x20,
+    kWKKeyCodePageUp = 0x21,
+    kWKKeyCodePageDown = 0x22,
+    kWKKeyCodeEnd = 0x23,
+    kWKKeyCodeHome = 0x24,
+    kWKKeyCodeLeft = 0x25,
+    kWKKeyCodeUp = 0x26,
+    kWKKeyCodeRight = 0x27,
+    kWKKeyCodeDown = 0x28,
+    kWKKeyCodePrintScreen = 0x2C,
+    kWKKeyCodeInsert = 0x2D,
+    kWKKeyCodeDelete = 0x2E,
+    kWKKeyCodeMetaLeft = 0x5B,
+    kWKKeyCodeMetaRight = 0x5C,
+    kWKKeyCodeContextMenu = 0x5D,
+    kWKKeyCodeNumpad0 = 0x60, // ... kWKKeyCodeNumpad0 + 9
+    kWKKeyCodeNumpadMultiply = 0x6A,
+    kWKKeyCodeNumpadAdd = 0x6B,
+    kWKKeyCodeNumpadSubtract = 0x6D,
+    kWKKeyCodeNumpadDecimal = 0x6E,
+    kWKKeyCodeNumpadDivide = 0x6F,
+    kWKKeyCodeF1 = 0x70, // ... kWKKeyCodeF1 + 23 (F24)
+    kWKKeyCodeNumLock = 0x90,
+    kWKKeyCodeScrollLock = 0x91,
+    kWKKeyCodeShiftLeft = 0xA0,
+    kWKKeyCodeShiftRight = 0xA1,
+    kWKKeyCodeControlLeft = 0xA2,
+    kWKKeyCodeControlRight = 0xA3,
+    kWKKeyCodeAltLeft = 0xA4,
+    kWKKeyCodeAltRight = 0xA5,
+    kWKKeyCodeSemicolon = 0xBA, // the US layout's ;: key (VK_OEM_1)
+    kWKKeyCodeEqual = 0xBB, // =+ (VK_OEM_PLUS)
+    kWKKeyCodeComma = 0xBC, // ,< (VK_OEM_COMMA)
+    kWKKeyCodeMinus = 0xBD, // -_ (VK_OEM_MINUS)
+    kWKKeyCodePeriod = 0xBE, // .> (VK_OEM_PERIOD)
+    kWKKeyCodeSlash = 0xBF, // /? (VK_OEM_2)
+    kWKKeyCodeBackquote = 0xC0, // `~ (VK_OEM_3)
+    kWKKeyCodeBracketLeft = 0xDB, // [{ (VK_OEM_4)
+    kWKKeyCodeBackslash = 0xDC, // \| (VK_OEM_5)
+    kWKKeyCodeBracketRight = 0xDD, // ]} (VK_OEM_6)
+    kWKKeyCodeQuote = 0xDE, // '" (VK_OEM_7)
+    kWKKeyCodeIntlBackslash = 0xE2 // the key between the left shift and Z of an ISO keyboard (VK_OEM_102)
+};
+
+struct WKKeyboardEvent {
+    // kWKEventKeyDown or kWKEventKeyUp.
+    WKEventType type;
+    // The key, as a Windows virtual-key code (above); 0 when the embedder cannot tell.
+    int32_t virtualKeyCode;
+    // The embedder's own code for the key (a scan code, a HID usage...): passed through, never interpreted.
+    int32_t nativeKeyCode;
+    // The text the key types with the current modifiers and layout: UTF-8, NUL-terminated. NULL or "" for
+    // a key that types nothing (arrows, function keys, a modifier). Return, Tab and Backspace need none.
+    const char* text;
+    // The text the key would type with no modifier but shift. NULL: the same as text.
+    const char* unmodifiedText;
+    // WKEventModifiers (and kWKEventModifiersAltGraphKey): the modifiers held when the key went down or up.
+    uint32_t modifiers;
+    // WKKeyboardEventFlags.
+    uint32_t flags;
+};
+typedef struct WKKeyboardEvent WKKeyboardEvent;
+
+struct WKMouseEvent {
+    // kWKEventMouseDown, kWKEventMouseUp or kWKEventMouseMove.
+    WKEventType type;
+    // The button that went down or up. For a move: kWKEventMouseButtonNoButton (the button of a drag is then
+    // taken from buttons).
+    WKEventMouseButton button;
+    // WKEventMouseButtons: the buttons held down once this event has happened.
+    uint32_t buttons;
+    // In the view's coordinates (pixels from its top left corner).
+    WKPoint position;
+    // In the screen's coordinates.
+    WKPoint screenPosition;
+    // 1 for a click, 2 for a double click...; 0 lets WebKit count the clicks itself (same button, within
+    // 500 ms and 5 pixels of the last one), which is what an embedder without its own notion should pass.
+    int32_t clickCount;
+    // WKEventModifiers.
+    uint32_t modifiers;
+};
+typedef struct WKMouseEvent WKMouseEvent;
+
+struct WKWheelEvent {
+    // kWKEventWheel.
+    WKEventType type;
+    // In the view's coordinates.
+    WKPoint position;
+    // In the screen's coordinates.
+    WKPoint screenPosition;
+    // The distance to scroll, in pixels. A positive height scrolls towards the top of the page (the wheel
+    // turned away from the user), a positive width towards its left. (0, 0) with wheelTicks set: the
+    // distance is the ticks times WebKit's line step.
+    WKSize delta;
+    // The wheel's notches, with the same signs. (0, 0) with delta set: derived from delta.
+    WKSize wheelTicks;
+    // WKEventModifiers. With shift alone, a vertical wheel event scrolls horizontally.
+    uint32_t modifiers;
+};
+typedef struct WKWheelEvent WKWheelEvent;
+
+WK_EXPORT WKKeyboardEvent WKKeyboardEventMake(WKEventType type, int32_t virtualKeyCode, const char* text, uint32_t modifiers, uint32_t flags);
+
+WK_EXPORT WKMouseEvent WKMouseEventMake(WKEventType type, WKEventMouseButton button, uint32_t buttons, WKPoint position, WKPoint screenPosition, int32_t clickCount, uint32_t modifiers);
+
+WK_EXPORT WKWheelEvent WKWheelEventMake(WKPoint position, WKPoint screenPosition, WKSize delta, WKSize wheelTicks, uint32_t modifiers);
+
+#ifdef __cplusplus
+}
+#endif
