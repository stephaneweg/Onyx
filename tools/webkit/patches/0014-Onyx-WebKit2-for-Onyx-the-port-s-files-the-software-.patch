+// The layer tree host of a port with no compositor (no Coordinated Graphics, no TextureMapper):
+// DrawingAreaCoordinatedGraphics is compiled for its software path only (the dirty region painted
+// into a ShareableBitmap and sent as an UpdateInfo). The class gives the drawing area's
+// m_layerTreeHost a complete type; it cannot be constructed, enterAcceleratedCompositingMode()
+// leaves the pointer null, so none of these bodies is ever reached.
+class LayerTreeHost {
+    WTF_MAKE_NONCOPYABLE(LayerTreeHost);
+public:
+    LayerTreeHost() = delete;
+
+    const LayerTreeContext& layerTreeContext() const LIFETIME_BOUND { return m_layerTreeContext; }
