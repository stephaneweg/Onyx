+    ONYX_IMPORT_LIBRARY(HarfBuzz::HarfBuzz LIBRARIES harfbuzz INCLUDES "${_onyx_inc}/harfbuzz" DEPENDS Freetype::Freetype)
+    ONYX_IMPORT_LIBRARY(HarfBuzz::ICU LIBRARIES harfbuzz-icu DEPENDS HarfBuzz::HarfBuzz ICU::uc)
+    ONYX_IMPORT_LIBRARY(LibXml2::LibXml2 LIBRARIES xml2 INCLUDES "${_onyx_inc}/libxml2" DEPENDS ZLIB::ZLIB
+        DEFINITIONS LIBXML_STATIC)
+    ONYX_IMPORT_LIBRARY(SQLite3::SQLite3 LIBRARIES sqlite3)
+
+    # Skia: the sysroot's libskia.a is WebKit's own copy (Source/ThirdParty/skia at the pinned
+    # revision), CPU raster only (no Ganesh), with Onyx's font manager (SkFontMgr_onyx.h). Its
+    # headers are installed as <sysroot>/include/skia/include/...; WebKit includes <skia/core/...>.
+    file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/onyx-skia")
