+ * AND ANY EXPRESS OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO,
+ * THE IMPLIED WARRANTIES OF MERCHANTABILITY AND FITNESS FOR A PARTICULAR
+ * PURPOSE ARE DISCLAIMED. IN NO EVENT SHALL APPLE INC. OR ITS CONTRIBUTORS
+ * BE LIABLE FOR ANY DIRECT, INDIRECT, INCIDENTAL, SPECIAL, EXEMPLARY, OR
+ * CONSEQUENTIAL DAMAGES (INCLUDING, BUT NOT LIMITED TO, PROCUREMENT OF
+ * SUBSTITUTE GOODS OR SERVICES; LOSS OF USE, DATA, OR PROFITS; OR BUSINESS
+ * INTERRUPTION) HOWEVER CAUSED AND ON ANY THEORY OF LIABILITY, WHETHER IN
+ * CONTRACT, STRICT LIABILITY, OR TORT (INCLUDING NEGLIGENCE OR OTHERWISE)
+ * ARISING IN ANY WAY OUT OF THE USE OF THIS SOFTWARE, EVEN IF ADVISED OF
+ * THE POSSIBILITY OF SUCH DAMAGE.
+ */
+
+#include "config.h"
+#include "PublicSuffixStore.h"
+
+#include <wtf/text/StringView.h>
+
+// The public suffixes (the domains under which anyone can register: "com", "co.uk"...), which
+// decide what a site is for cookies and for process isolation. INTERIM: Onyx has no public suffix
+// list yet (libpsl and its data are to be ported): a top-level domain is a public suffix, and so
+// are the second-level registries below. A site under a suffix this misses (a rarer country
+// registry, a hosting domain such as "github.io") is seen as sharing its parent's site.
+
+namespace WebCore {
+
+static bool isSecondLevelRegistry(StringView label, StringView topLevel)
+{
+    // <label>.<cc> where the country registers under generic second-level labels
+    static constexpr ASCIILiteral genericLabels[] = { "co"_s, "com"_s, "net"_s, "org"_s, "gov"_s, "edu"_s, "ac"_s, "or"_s, "ne"_s, "go"_s, "mil"_s, "gouv"_s, "gob"_s, "nom"_s };
+    static constexpr ASCIILiteral countries[] = { "uk"_s, "jp"_s, "au"_s, "nz"_s, "br"_s, "cn"_s, "in"_s, "kr"_s, "za"_s, "mx"_s, "ar"_s, "tr"_s, "tw"_s, "hk"_s, "sg"_s, "il"_s, "id"_s, "th"_s, "my"_s, "ph"_s, "vn"_s, "ua"_s, "pl"_s, "ru"_s, "eg"_s, "sa"_s, "co"_s, "pe"_s, "ve"_s, "fr"_s, "es"_s, "pt"_s, "it"_s, "at"_s };
+
+    bool known = false;
+    for (auto country : countries) {
+        if (equalIgnoringASCIICase(topLevel, country)) {
+            known = true;
+            break;
+        }
+    }
+    if (!known)
+        return false;
+    for (auto generic : genericLabels) {
+        if (equalIgnoringASCIICase(label, generic))
+            return true;
+    }
+    return false;
+}
+
+// The number of labels of the public suffix that ends the domain: 1 ("com") or 2 ("co.uk").
+static unsigned publicSuffixLabelCount(StringView domain)
+{
+    auto lastDot = domain.reverseFind('.');
+    if (lastDot == notFound)
+        return 1;
+    auto topLevel = domain.substring(lastDot + 1);
+    auto rest = domain.left(lastDot);
+    auto previousDot = rest.reverseFind('.');
+    auto label = previousDot == notFound ? rest : rest.substring(previousDot + 1);
+    return isSecondLevelRegistry(label, topLevel) ? 2 : 1;
+}
+
+static unsigned labelCount(StringView domain)
+{
+    unsigned count = 1;
+    for (unsigned i = 0; i < domain.length(); ++i) {
+        if (domain[i] == '.')
+            count++;
+    }
+    return count;
+}
+
+bool PublicSuffixStore::platformIsPublicSuffix(StringView domain) const
+{
+    if (domain.isEmpty())
+        return false;
+    return labelCount(domain) <= publicSuffixLabelCount(domain);
+}
+
+String PublicSuffixStore::platformTopPrivatelyControlledDomain(StringView domain) const
+{
+    // This function is expected to work with the format used by cookies, so skip any leading dots.
+    unsigned position = 0;
+    while (position < domain.length() && domain[position] == '.')
+        position++;
+    domain = domain.substring(position);
+    if (domain.isEmpty() || platformIsPublicSuffix(domain))
+        return String();
+
+    // The public suffix and one label more.
+    unsigned wanted = publicSuffixLabelCount(domain) + 1;
+    unsigned start = domain.length();
+    while (wanted && start) {
+        auto dot = domain.left(start).reverseFind('.');
+        if (dot == notFound) {
+            start = 0;
+            break;
+        }
+        if (!--wanted) {
+            start = dot + 1;
+            break;
+        }
+        start = dot;
+    }
+    return domain.substring(start).convertToASCIILowercase();
+}
+
+} // namespace WebCore
