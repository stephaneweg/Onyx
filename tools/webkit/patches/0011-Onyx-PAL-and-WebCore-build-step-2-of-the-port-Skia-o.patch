+// changing it). Sites look for "Safari" and "Version/" to recognise WebKit, and take a WebKit
+// that is not on a desktop system for a phone: the system token is the one WebKit's Linux
+// ports send, which sites know (Onyx is not Linux; the browser can send another per site).
+
+namespace WebCore {
+
+static constexpr ASCIILiteral versionForUAString()
+{
+    // https://bugs.webkit.org/show_bug.cgi?id=180365
+    return "605.1.15"_s;
+}
+
+static String standardUserAgentStatic()
+{
+    // Version/X is mandatory *before* Safari/X to be a valid Safari UA. See
+    // https://bugs.webkit.org/show_bug.cgi?id=133403 for details.
+    static NeverDestroyed<String> uaStatic(makeString("Mozilla/5.0 (X11; Linux aarch64) AppleWebKit/"_s, versionForUAString(), " (KHTML, like Gecko) Version/17.0 Safari/"_s, versionForUAString()));
+    return uaStatic;
+}
+
+String standardUserAgent(const String& applicationName, const String& applicationVersion)
+{
+    if (applicationName.isEmpty())
+        return standardUserAgentStatic();
+    return makeString(standardUserAgentStatic(), ' ', applicationName, '/', applicationVersion.isEmpty() ? versionForUAString() : applicationVersion);
+}
+
+String standardUserAgentForURL(const URL&)
+{
+    return standardUserAgentStatic();
+}
+
+} // namespace WebCore
