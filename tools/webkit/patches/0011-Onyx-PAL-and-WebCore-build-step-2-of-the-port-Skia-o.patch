+    ONYX_IMPORT_LIBRARY(WebP::demux LIBRARIES webpdemux DEPENDS WebP::libwebp)
+    ONYX_IMPORT_LIBRARY(WebP::mux LIBRARIES webpmux DEPENDS WebP::libwebp)
+    ONYX_IMPORT_LIBRARY(Freetype::Freetype LIBRARIES freetype INCLUDES "${_onyx_inc}/freetype2"
