+    function(ONYX_IMPORT_LIBRARY _target)
+        cmake_parse_arguments(opt "" "" "LIBRARIES;INCLUDES;DEPENDS;DEFINITIONS" ${ARGN})
+        add_library(${_target} INTERFACE IMPORTED GLOBAL)
+        set(_libs)
+        foreach (_lib IN LISTS opt_LIBRARIES)
+            if (NOT EXISTS "${_onyx_lib}/lib${_lib}.a")
+                message(FATAL_ERROR "No ${_onyx_lib}/lib${_lib}.a: sh tools/ports/build-all.sh")
+            endif ()
+            list(APPEND _libs "${_onyx_lib}/lib${_lib}.a")
+        endforeach ()
+        set_target_properties(${_target} PROPERTIES
+            INTERFACE_LINK_LIBRARIES "${_libs};${opt_DEPENDS}"
+            INTERFACE_INCLUDE_DIRECTORIES "${opt_INCLUDES}"
+            INTERFACE_COMPILE_DEFINITIONS "${opt_DEFINITIONS}"
+        )
+    endfunction()
