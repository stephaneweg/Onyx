+    execute_process(COMMAND ${PKG_CONFIG_EXECUTABLE} --cflags-only-other skia
+        OUTPUT_VARIABLE _onyx_skia_cflags OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE _onyx_skia_result)
+    if (_onyx_skia_result)
+        message(FATAL_ERROR "pkg-config does not know skia (the sysroot's lib/pkgconfig/skia.pc)")
