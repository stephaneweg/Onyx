+    ONYX_IMPORT_LIBRARY(Skia::Skia LIBRARIES skia
+        INCLUDES "${_onyx_inc}/skia" "${CMAKE_BINARY_DIR}/onyx-skia"
+        DEPENDS HarfBuzz::HarfBuzz Freetype::Freetype PNG::PNG JPEG::JPEG WebP::mux WebP::demux WebP::libwebp ZLIB::ZLIB
+        DEFINITIONS ${_onyx_skia_defs})
+endif ()
