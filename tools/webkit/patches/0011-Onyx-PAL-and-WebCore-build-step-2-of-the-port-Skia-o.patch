+
+#include "config.h"
+#include "GraphicsLayer.h"
+
+#include "GraphicsLayerFactory.h"
+
+// Onyx has no compositor yet (no GL: Skia paints on the CPU): accelerated compositing stays off
+// (Settings::acceleratedCompositingEnabled), pages are painted by their frame view into one
+// bitmap. WebCore still creates a few layers of its own (the page overlays' root...): a layer
+// that keeps the tree and its properties, and draws nothing.
+
+namespace WebCore {
+
+class GraphicsLayerOnyx final : public GraphicsLayer {
+public:
+    GraphicsLayerOnyx(Type type, GraphicsLayerClient& client)
+        : GraphicsLayer(type, client)
+    {
+    }
+
+    ~GraphicsLayerOnyx() final
+    {
+        willBeDestroyed();
+    }
+
+    void setNeedsDisplay() final { }
+    void setNeedsDisplayInRect(const FloatRect&, ShouldClipToLayer) final { }
+};
+
+Ref<GraphicsLayer> GraphicsLayer::create(GraphicsLayerFactory* factory, GraphicsLayerClient& client, Type layerType)
+{
+    if (!factory)
+        return adoptRef(*new GraphicsLayerOnyx(layerType, client));
+
+    return factory->createGraphicsLayer(layerType, client);
+}
+
+} // namespace WebCore
