+// The planned paints painted here and now, one after the other (the main thread; as before there
+// were raster workers).
+void GraphicsLayerOnyx::paintPendingPaints(TileUpdate& update)
+{
+    if (!m_host) {
+        m_pendingPaints.clear();
+        return;
+    }
+    for (auto& paint : std::exchange(m_pendingPaints, { }))
+        uploadPendingPaint(*paint, paintRect(paint->rect, update), paint->rect.width(), update);
+
+    // (One texture of 2048 x 2048 is 16 MB of scratch: not kept.)
+    if (scratchPixels().capacity() > 2048 * 1024)
+        scratchPixels().clear();
+}
+
+// The planned paints recorded (the main thread: WebCore paints each rectangle once, into a Skia
+// picture) and cut into raster jobs for the host to run on its workers (runRasterJob), each a
+// part of the paint's own pixel buffer.
+void GraphicsLayerOnyx::recordPendingPaints(Vector<void*>& jobs, TileUpdate& update)
+{
+    // (Parts of 512 x 256 pixels at most: a row of two new tiles is four jobs.)
+    static constexpr int partWidth = 512;
+    static constexpr int partHeight = 256;
+
+    SkSurfaceProps properties = FontRenderOptions::singleton().createSurfaceProps();
+    bool opaque = contentsOpaque();
+    for (auto& paint : m_pendingPaints) {
+        auto& rect = paint->rect;
+        size_t pixelCount = static_cast<size_t>(rect.width()) * rect.height();
+        if (!paint->pixels.tryGrow(pixelCount))
+            continue;
+        // Transparent, and touched here: the memory's pages are there before another core writes them
+        // (a page fault on an Onyx app core waits for core 0).
+        zeroSpan(paint->pixels.mutableSpan());
+        int partCount = ((rect.width() + partWidth - 1) / partWidth) * ((rect.height() + partHeight - 1) / partHeight);
+
+        auto startTime = MonotonicTime::now();
+        {
+            SkPictureRecorder recorder;
+            // (A bounding box hierarchy when the picture is replayed more than once: each part plays
+            // only what touches it.)
+            SkRTreeFactory hierarchyFactory;
+            auto* canvas = recorder.beginRecording(SkRect::MakeXYWH(rect.x(), rect.y(), rect.width(), rect.height()), partCount > 1 ? &hierarchyFactory : nullptr);
+            if (!canvas)
+                continue;
+            {
+                GraphicsContextSkia context(*canvas, RenderingMode::Unaccelerated, RenderingPurpose::LayerBacking);
+                context.clip(rect);
+                paintGraphicsLayerContents(context, rect);
+            }
+            paint->picture = recorder.finishRecordingAsPicture();
+        }
+        update.recordTime += MonotonicTime::now() - startTime;
+        update.paints++;
+        update.pixelsPainted += pixelCount;
+        if (!paint->picture)
+            continue;
+
+        paint->jobs.reserveInitialCapacity(partCount);
+        for (int y = 0; y < rect.height(); y += partHeight) {
+            for (int x = 0; x < rect.width(); x += partWidth) {
+                paint->jobs.append(GraphicsLayerOnyxRasterJob {
+                    paint->picture.get(),
+                    paint->pixels.mutableSpan().data() + static_cast<size_t>(y) * rect.width() + x,
+                    static_cast<size_t>(rect.width()) * sizeof(uint32_t),
+                    rect.x() + x,
+                    rect.y() + y,
+                    std::min(partWidth, rect.width() - x),
+                    std::min(partHeight, rect.height() - y),
+                    opaque,
+                    properties,
+                    0
+                });
+            }
+        }
+        for (auto& job : paint->jobs)
+            jobs.append(&job);
     }
 }
 
