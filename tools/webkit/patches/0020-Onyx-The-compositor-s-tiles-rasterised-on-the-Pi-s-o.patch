+// The app cores are a resource of the whole machine (two of them: an emulator wants one, another
+// window's web process too): taken when there is a frame to rasterise, given back once nothing was
+// rasterised for a while.
+void LayerTreeHost::startCoresIfNeeded()
+{
+    if (!m_usesCores || m_startedCores || m_coresFaulted)
+        return;
+    // (None was free: not asked again at every frame.)
+    auto now = MonotonicTime::now();
+    if (m_lastCoresAttemptTime && now - m_lastCoresAttemptTime < coresRetryInterval)
+        return;
+    m_lastCoresAttemptTime = now;
+
+    m_workerCount = onyx_cores_start(2);
+    m_startedCores = true;
+    if (!m_workerCount) {
+        releaseCores();
+        return;
+    }
+    m_coresIdleTimer.startOneShot(coresIdleInterval);
+    if (m_coresWereReleased)
+        logLine("painting on %u cores again (%u app cores taken)", m_workerCount + (m_mainThreadRasterises ? 1 : 0), m_workerCount);
+}
+
+// SD:/etc/web-gpu-coretest: each stage of WebCore's OnyxCoreTest.cpp as a job of its own on an app
+// core, said before it starts ("starts": the last line of the log if the core takes the kernel
+// down) and after it returns -- "ok in N us", the fault (with the stage's breadcrumb: how far it
+// got) or a result that is not the main thread's. It stops at the first failure. Its last stage
+// is the page's own first raster jobs (paintPreparedLayers).
+void LayerTreeHost::runCoreTest()
+{
+    unsigned count = onyxCoreTestStageCount();
+    if (!m_workerCount) {
+        logLine("core test: no app core is free: nothing is tested");
+        return;
+    }
+    logLine("core test: %u stages on an app core, then the page's first raster jobs one at a time", count);
+    for (unsigned stage = 0; stage < count; ++stage) {
+        auto* name = onyxCoreTestStageName(stage);
+        logLine("core test %u %s: starts", stage + 1, name);
+        void* argument = onyxCoreTestPrepare(stage);
+        auto startTime = onyx_cores_now_ns();
+        int result = onyx_cores_run(onyxCoreTestRun, onyxCoreTestStopped, &argument, 1, 0);
+        auto microseconds = (onyx_cores_now_ns() - startTime) / 1000;
+        if (result < 0) {
+            auto* failure = onyx_cores_failure();
+            logLine("core test %u %s: FAULT at breadcrumb %u (%s); the test stops, painting on 1 core from now on", stage + 1, name, onyxCoreTestBreadcrumb(), failure ? failure : "see the kernel's log");
+            m_coresFaulted = true;
+            releaseCores();
+            return;
+        }
+        char text[160];
+        if (!onyxCoreTestCheck(stage, text, sizeof(text))) {
+            logLine("core test %u %s: WRONG in %llu us: %s; the test stops", stage + 1, name, static_cast<unsigned long long>(microseconds), text);
+            return;
+        }
+        logLine("core test %u %s: ok in %llu us (%s)", stage + 1, name, static_cast<unsigned long long>(microseconds), text);
+    }
+    m_coreTestJobsLeft = coreTestJobCount;
+}
+
+// The core test's last stage: a batch's jobs run on an app core one at a time, each said before
+// and after, with what it is and, for a fault, where in its picture it stopped -> false: a core
+// faulted (the job was done again by the main thread).
+bool LayerTreeHost::runCoreTestJobs(Vector<void*>& jobs)
+{
+    unsigned stage = onyxCoreTestStageCount() + 1;
+    for (size_t i = 0; i < jobs.size(); ++i) {
+        char text[200];
+        GraphicsLayerOnyx::setRasterJobTraced(jobs[i]);
+        GraphicsLayerOnyx::describeRasterJob(jobs[i], text, sizeof(text));
+        logLine("core test %u the page's raster job %zu of %zu: starts (%s)", stage, i + 1, jobs.size(), text);
+        auto startTime = onyx_cores_now_ns();
+        int result = onyx_cores_run(GraphicsLayerOnyx::runRasterJob, GraphicsLayerOnyx::resetRasterJob, &jobs[i], 1, 0);
+        auto microseconds = (onyx_cores_now_ns() - startTime) / 1000;
+        GraphicsLayerOnyx::describeRasterJob(jobs[i], text, sizeof(text));
+        if (result < 0) {
+            auto* failure = onyx_cores_failure();
+            logLine("core test %u the page's raster job %zu of %zu: FAULT (%s) -- %s", stage, i + 1, jobs.size(), failure ? failure : "see the kernel's log", text);
+            m_coreTestJobsLeft = 0;
+            // (The job was done again by the main thread; the others: by it too, the cores are gone.)
+            if (i + 1 < jobs.size())
+                onyx_cores_run(GraphicsLayerOnyx::runRasterJob, GraphicsLayerOnyx::resetRasterJob, jobs.mutableSpan().data() + i + 1, jobs.size() - i - 1, 1);
+            return false;
+        }
+        logLine("core test %u the page's raster job %zu of %zu: ok in %llu us", stage, i + 1, jobs.size(), static_cast<unsigned long long>(microseconds));
+        if (!--m_coreTestJobsLeft) {
+            logLine("core test: %u raster jobs of the page done on an app core: the test is over, the jobs go to the cores together from now on", coreTestJobCount);
+            if (i + 1 < jobs.size())
+                return onyx_cores_run(GraphicsLayerOnyx::runRasterJob, GraphicsLayerOnyx::resetRasterJob, jobs.mutableSpan().data() + i + 1, jobs.size() - i - 1, m_mainThreadRasterises) >= 0;
+            break;
+        }
+    }
+    return true;
+}
+
+void LayerTreeHost::releaseCores()
+{
+    if (!m_startedCores)
+        return;
+    onyx_cores_stop();
+    m_startedCores = false;
+    m_workerCount = 0;
+}
+
+void LayerTreeHost::coresIdleTimerFired()
+{
+    if (!m_workerCount)
+        return;
+    logLine("the app cores are given back (nothing to rasterise for %.0f s)", coresIdleInterval.seconds());
+    releaseCores();
+    m_coresWereReleased = true;
+    m_lastCoresAttemptTime = { };
+}
+
+// What the Prepare walk planned is painted, for every layer of the frame at once: by the main
+// thread directly (no raster worker, or little to paint), or recorded by the main thread into
+// pictures and rasterised in parts by the workers -- Onyx's app cores -- and the main thread;
+// then the pixels are given to the textures (the main thread: a kernel call).
+void LayerTreeHost::paintPreparedLayers()
+{
+    if (m_preparedLayers.isEmpty())
+        return;
+
+    if (m_pixelsPlanned >= minimumPixelsForWorkers)
+        startCoresIfNeeded();
+    bool usesWorkers = m_workerCount && m_pixelsPlanned >= minimumPixelsForWorkers && onyx_cores_count() > 0;
+    if (usesWorkers)
+        m_coresIdleTimer.startOneShot(coresIdleInterval);
+    Vector<GraphicsLayerOnyx::TileUpdate> updates(m_preparedLayers.size());
+
+    if (usesWorkers) {
+        Vector<void*> jobs;
