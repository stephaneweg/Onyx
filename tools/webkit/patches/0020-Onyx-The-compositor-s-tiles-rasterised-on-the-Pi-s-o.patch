+#include <arm_neon.h>
+#endif
+
+namespace WebCore {
+
+WTF_ALLOW_UNSAFE_BUFFER_USAGE_BEGIN // (Plain C buffers, on purpose: nothing of WTF runs on an app core.)
+
+namespace {
+
+struct Context {
+    unsigned stage { 0 };
+    volatile unsigned breadcrumb { 0 };
+    uint64_t result { 0 };
+    const void* threadLocalAddress { nullptr };
+    bool stopped { false };
+    unsigned breadcrumbWhenStopped { 0 };
+};
+
+Context s_coreContext;
+Context s_mainContext;
+// What the main thread prepares for the stages (prepare).
+SkTypeface* s_typeface;
+SkPicture* s_picture;
+
+inline void crumb(Context& context, unsigned value) { context.breadcrumb = value; }
+
+inline uint64_t mix(uint64_t hash, uint64_t value)
+{
+    hash ^= value;
+    hash *= 0x100000001b3ull;
+    return hash ^ (hash >> 29);
+}
+
+uint64_t hashBytes(const void* data, size_t size)
+{
+    auto* bytes = static_cast<const uint8_t*>(data);
+    uint64_t hash = 0xcbf29ce484222325ull;
+    for (size_t i = 0; i < size; ++i) {
+        hash ^= bytes[i];
+        hash *= 0x100000001b3ull;
+    }
+    return hash;
+}
+
+constexpr int canvasSize = 256;
+
+bool makeCanvasBitmap(SkBitmap& bitmap)
+{
+    return bitmap.tryAllocPixels(SkImageInfo::Make(canvasSize, canvasSize, kBGRA_8888_SkColorType, kPremul_SkAlphaType, SkColorSpace::MakeSRGB()));
+}
+
+uint64_t hashBitmap(const SkBitmap& bitmap)
+{
+    return hashBytes(bitmap.getPixels(), bitmap.computeByteSize());
+}
+
+sk_sp<SkShader> makeGradient(bool radial)
+{
+    static const SkColor4f colors[] = { { 1, 0, 0, 1 }, { 0, 0.5f, 1, 0.75f }, { 1, 1, 0, 1 } };
+    SkGradient gradient(SkGradient::Colors(SkSpan<const SkColor4f>(colors, 3), SkTileMode::kClamp), SkGradient::Interpolation());
+    if (radial)
+        return SkShaders::RadialGradient({ 128, 128 }, 96, gradient);
+    const SkPoint points[2] = { { 10, 10 }, { 240, 200 } };
+    return SkShaders::LinearGradient(points, gradient);
+}
+
+// ---- the stages ----
+
+uint64_t stageReturn(Context&)
+{
+    return 1;
+}
+
+uint64_t stageArithmetic(Context& context)
+{
+    constexpr int count = 4096;
+    static float values[2][count]; // (One a caller: s_coreContext / s_mainContext.)
+    auto* data = values[&context == &s_mainContext];
+    uint64_t hash = 0xcbf29ce484222325ull;
+    for (int i = 0; i < count; ++i)
+        data[i] = i * 0.37f + 1;
+    crumb(context, 1);
+    for (int round = 0; round < 50; ++round) {
+        for (int i = 0; i < count; ++i)
+            data[i] = sqrtf(data[i] * 1.0001f + 3) / (1 + data[(i + 1) & (count - 1)] * 0.01f);
+    }
+    crumb(context, 2);
+    double sum = 0;
+    for (int i = 0; i < count; ++i)
+        sum += static_cast<double>(data[i]) * (i & 7);
+    hash = mix(hash, static_cast<uint64_t>(sum * 1024));
+    crumb(context, 3);
+#if CPU(ARM64)
+    float32x4_t accumulator = vdupq_n_f32(0);
+    uint32x4_t integers = vdupq_n_u32(0x9e3779b9u);
+    for (int i = 0; i < count; i += 4) {
+        float32x4_t v = vld1q_f32(data + i);
+        accumulator = vmlaq_f32(accumulator, v, vdupq_n_f32(1.5f));
+        integers = veorq_u32(vmulq_u32(integers, vdupq_n_u32(2654435761u)), vreinterpretq_u32_f32(v));
+    }
+    float lanes[4];
+    uint32_t words[4];
+    vst1q_f32(lanes, accumulator);
+    vst1q_u32(words, integers);
+    for (int i = 0; i < 4; ++i) {
+        hash = mix(hash, static_cast<uint64_t>(lanes[i] * 16));
+        hash = mix(hash, words[i]);
+    }
+#endif
+    crumb(context, 4);
+    for (uint64_t i = 1; i < 200000; ++i)
+        hash = mix(hash, (hash / (i | 1)) + (hash % (i + 7)));
+    return hash;
+}
+
+uint64_t stageMalloc(Context& context)
+{
+    // Small blocks and blocks of 1 MB, 1000 times; eight large ones are held at a time, and 2000
+    // small ones: the heap grows and is trimmed (sbrk: through the app-core RPC there).
+    constexpr size_t large = 1024 * 1024;
+    void* held[8] = { };
+    void* smalls[2000] = { };
+    uint64_t hash = 0;
+    for (int i = 0; i < 1000; ++i) {
+        crumb(context, 1000 + i);
+        size_t size = 16 + (i * 37) % 900;
+        auto* block = static_cast<uint8_t*>(malloc(size));
+        if (!block)
+            return 0;
+        memset(block, i, size);
+        hash = mix(hash, block[size - 1] + size);
+        free(smalls[(i * 2) % 2000]);
+        smalls[(i * 2) % 2000] = block;
+        smalls[(i * 2 + 1) % 2000] = calloc(1, 64);
+        auto* big = static_cast<uint8_t*>(malloc(large));
+        if (!big)
+            return 0;
+        for (size_t offset = 0; offset < large; offset += 4096)
+            big[offset] = static_cast<uint8_t>(offset >> 12);
+        hash = mix(hash, big[large - 4096]);
+        free(held[i & 7]);
+        held[i & 7] = big;
+    }
+    crumb(context, 3000);
+    for (auto* block : held)
+        free(block);
+    for (auto* block : smalls)
+        free(block);
+    crumb(context, 3001);
+    auto* grown = static_cast<uint8_t*>(malloc(64));
+    for (size_t size = 128; grown && size <= 4 * large; size *= 2)
+        grown = static_cast<uint8_t*>(realloc(grown, size));
+    free(grown);
+    return grown ? hash : 0;
+}
+
+struct TestNode {
+    virtual ~TestNode() = default;
+    virtual uint64_t value() const { return m_value; }
+    uint64_t m_value { 0 };
+    TestNode* next { nullptr };
+};
+struct TestNodeTwice final : TestNode {
+    uint64_t value() const final { return m_value * 2; }
+};
+
+uint64_t stageNew(Context& context)
+{
+    uint64_t hash = 0;
+    TestNode* list = nullptr;
+    for (int i = 0; i < 20000; ++i) {
+        TestNode* node = (i & 1) ? new TestNodeTwice : new TestNode;
+        node->m_value = i;
+        node->next = list;
+        list = node;
+    }
+    crumb(context, 1);
+    while (list) {
+        auto* next = list->next;
+        hash = mix(hash, list->value()); // (A virtual call.)
+        delete list;
+        list = next;
+    }
+    crumb(context, 2);
+    std::vector<uint32_t> numbers;
+    for (uint32_t i = 0; i < 300000; ++i)
+        numbers.push_back(i * 2654435761u);
+    crumb(context, 3);
+    std::string text;
+    for (int i = 0; i < 5000; ++i)
+        text += static_cast<char>('a' + i % 26);
+    hash = mix(hash, hashBytes(numbers.data(), numbers.size() * sizeof(uint32_t)));
+    hash = mix(hash, hashBytes(text.data(), text.size()));
+    crumb(context, 4);
+    auto* array = new uint64_t[50000];
+    for (int i = 0; i < 50000; ++i)
+        array[i] = hash + i;
+    hash = mix(hash, array[49999]);
+    delete[] array;
+    return hash;
+}
+
+thread_local int t_value = 42;
+thread_local uint64_t t_words[32];
+
+uint64_t stageThreadLocal(Context& context)
+{
+    context.threadLocalAddress = &t_value;
+    uint64_t result = t_value == 42 || t_value == 43 ? 1 : 0; // (Its first value, or what this thread left.)
+    crumb(context, 1);
+    t_value = 43;
+    for (int i = 0; i < 32; ++i)
+        t_words[i] += i + 1;
+    crumb(context, 2);
+    errno = 0;
+    crumb(context, 3);
+    errno = EDOM;
+    result = result * 10 + (errno == EDOM);
+    errno = 0;
+    crumb(context, 4);
+    result = result * 10 + (t_value == 43);
+    result = result * 10 + (t_words[31] >= 32 && !(t_words[31] % 32));
+    return result;
+}
+
+struct TestTable {
+    TestTable()
+    {
+        for (int i = 0; i < 4096; ++i)
+            entries.push_back(i * 40503u + 7);
+    }
+    std::vector<uint32_t> entries;
+};
+
+const TestTable& testTable()
+{
+    static const TestTable table; // (__cxa_guard_acquire / release: on the core the first time.)
+    return table;
+}
+
+uint64_t stageStatic(Context& context)
+{
+    crumb(context, 1);
+    auto& table = testTable();
+    crumb(context, 2);
+    return hashBytes(table.entries.data(), table.entries.size() * sizeof(uint32_t));
+}
+
+uint64_t stageCanvas(Context& context)
+{
+    SkBitmap bitmap;
+    if (!makeCanvasBitmap(bitmap))
+        return 0;
+    crumb(context, 1);
+    SkCanvas canvas(bitmap);
+    crumb(context, 2);
+    canvas.drawColor(SK_ColorWHITE);
+    crumb(context, 3);
+    SkPaint paint;
+    paint.setColor(SkColorSetARGB(255, 20, 60, 200));
+    canvas.drawRect(SkRect::MakeXYWH(16, 16, 120, 90), paint);
+    crumb(context, 4);
+    paint.setAntiAlias(true);
+    paint.setColor(SkColorSetARGB(128, 200, 30, 30));
+    canvas.drawRect(SkRect::MakeXYWH(60.5f, 50.25f, 150.5f, 120.75f), paint);
+    crumb(context, 5);
+    canvas.drawRRect(SkRRect::MakeRectXY(SkRect::MakeXYWH(30, 150, 180, 80), 14, 14), paint);
+    crumb(context, 6);
+    return hashBitmap(bitmap);
+}
+
+uint64_t stageShaders(Context& context)
+{
+    SkBitmap bitmap;
+    if (!makeCanvasBitmap(bitmap))
+        return 0;
+    SkCanvas canvas(bitmap);
+    canvas.drawColor(SK_ColorWHITE);
+    crumb(context, 1);
+    SkPaint paint;
+    paint.setAntiAlias(true);
+    paint.setShader(makeGradient(false));
+    crumb(context, 2);
+    canvas.drawRect(SkRect::MakeXYWH(8, 8, 240, 110), paint);
+    crumb(context, 3);
+    paint.setShader(makeGradient(true));
+    canvas.drawRRect(SkRRect::MakeRectXY(SkRect::MakeXYWH(40, 100, 180, 130), 20, 20), paint);
+    crumb(context, 4);
+    SkPaint shadow;
+    shadow.setAntiAlias(true);
+    shadow.setColor(SkColorSetARGB(160, 0, 0, 0));
+    shadow.setMaskFilter(SkMaskFilter::MakeBlur(kNormal_SkBlurStyle, 6));
+    crumb(context, 5);
+    canvas.drawRRect(SkRRect::MakeRectXY(SkRect::MakeXYWH(60, 40, 120, 70), 10, 10), shadow);
+    crumb(context, 6);
+    return hashBitmap(bitmap);
+}
+
+uint64_t stageText(Context& context)
+{
+    if (!s_typeface)
+        return 1; // (No typeface on this card: nothing to draw; said by the host.)
+    SkBitmap bitmap;
+    if (!makeCanvasBitmap(bitmap))
+        return 0;
+    SkCanvas canvas(bitmap);
+    canvas.drawColor(SK_ColorWHITE);
+    SkPaint paint;
+    paint.setAntiAlias(true);
+    paint.setColor(SK_ColorBLACK);
+    static const float sizes[] = { 11, 16, 23, 37 };
+    float y = 20;
+    unsigned step = 1;
+    for (float size : sizes) {
+        crumb(context, step++);
+        SkFont font(sk_ref_sp(s_typeface), size);
+        font.setSubpixel(true);
+        font.setEdging(SkFont::Edging::kAntiAlias);
+        // (Letters no page has drawn yet at these sizes: their glyphs are made here.)
+        canvas.drawString("Onyx core test: Hamburgefonstiv 0123456789", 4, y, font, paint);
+        y += size * 1.6f;
+        canvas.drawString("\303\251\303\250\303\240 qjpgy @#&%", 4, y, font, paint);
+        y += size * 1.6f;
+    }
+    crumb(context, 9);
+    return hashBitmap(bitmap);
+}
+
+uint64_t stageImage(Context& context)
+{
+    SkBitmap source;
+    if (!source.tryAllocPixels(SkImageInfo::Make(64, 48, kBGRA_8888_SkColorType, kPremul_SkAlphaType, SkColorSpace::MakeSRGB())))
+        return 0;
+    for (int y = 0; y < 48; ++y) {
+        auto* row = source.getAddr32(0, y);
+        for (int x = 0; x < 64; ++x)
+            row[x] = 0xff000000u | ((x * 4) << 16) | ((y * 5) << 8) | ((x ^ y) * 3 & 0xff);
+    }
+    crumb(context, 1);
+    source.setImmutable();
+    auto image = SkImages::RasterFromBitmap(source);
+    if (!image)
+        return 0;
+    crumb(context, 2);
+    SkBitmap bitmap;
+    if (!makeCanvasBitmap(bitmap))
+        return 0;
+    SkCanvas canvas(bitmap);
+    canvas.drawColor(SK_ColorWHITE);
+    crumb(context, 3);
+    canvas.drawImageRect(image, SkRect::MakeXYWH(4, 4, 200, 120), SkSamplingOptions(SkFilterMode::kLinear), nullptr);
+    crumb(context, 4);
+    canvas.drawImageRect(image, SkRect::MakeXYWH(100.5f, 130.5f, 31, 23), SkSamplingOptions(SkFilterMode::kLinear, SkMipmapMode::kLinear), nullptr);
+    crumb(context, 5);
+    canvas.drawImageRect(image, SkRect::MakeXYWH(10, 140, 80, 100), SkSamplingOptions(SkCubicResampler::Mitchell()), nullptr);
+    crumb(context, 6);
+    canvas.drawImage(image, 180, 180);
+    return hashBitmap(bitmap);
+}
+
+uint64_t stagePicture(Context& context)
+{
+    if (!s_picture)
+        return 0;
+    SkBitmap bitmap;
+    if (!makeCanvasBitmap(bitmap))
+        return 0;
+    SkCanvas canvas(bitmap);
+    crumb(context, 1);
+    canvas.translate(-8, -8); // (As a raster job: a part of the picture.)
+    crumb(context, 2);
+    s_picture->playback(&canvas);
+    crumb(context, 3);
+    return hashBitmap(bitmap);
+}
+
+sk_sp<SkPicture> recordTestPicture()
+{
+    SkPictureRecorder recorder;
+    auto* canvas = recorder.beginRecording(SkRect::MakeWH(canvasSize + 16, canvasSize + 16));
+    canvas->drawColor(SK_ColorWHITE);
+    SkPaint paint;
+    paint.setAntiAlias(true);
+    paint.setShader(makeGradient(false));
+    canvas->drawRect(SkRect::MakeXYWH(12, 12, 200, 60), paint);
+    paint.setShader(nullptr);
+    canvas->save();
+    canvas->clipRRect(SkRRect::MakeRectXY(SkRect::MakeXYWH(30, 80, 200, 150), 16, 16), true);
+    canvas->rotate(4);
+    paint.setColor(SkColorSetARGB(255, 30, 140, 60));
+    canvas->drawRect(SkRect::MakeXYWH(20, 70, 230, 180), paint);
+    if (s_typeface) {
+        SkFont font(sk_ref_sp(s_typeface), 19);
+        paint.setColor(SK_ColorWHITE);
+        canvas->drawString("a recorded picture", 40, 120, font, paint);
+    }
+    canvas->restore();
+    paint.setColor(SkColorSetARGB(120, 0, 0, 0));
+    paint.setMaskFilter(SkMaskFilter::MakeBlur(kNormal_SkBlurStyle, 4));
+    canvas->drawRect(SkRect::MakeXYWH(150, 190, 80, 50), paint);
+    return recorder.finishRecordingAsPicture();
+}
+
+struct Stage {
+    ASCIILiteral name;
+    uint64_t (*run)(Context&);
+};
+
+const Stage stages[] = {
+    { "return at once"_s, stageReturn },
+    { "integer, float and NEON arithmetic"_s, stageArithmetic },
+    { "malloc / free, small blocks and 1 MB, 1000 times"_s, stageMalloc },
+    { "operator new / delete, std::vector, std::string"_s, stageNew },
+    { "thread_local and errno"_s, stageThreadLocal },
+    { "a function's static initialised (__cxa_guard)"_s, stageStatic },
+    { "Skia: a bitmap, a canvas, drawColor, drawRect"_s, stageCanvas },
+    { "Skia: gradient shaders, a blurred shadow"_s, stageShaders },
+    { "Skia: text (the glyph cache, FreeType)"_s, stageText },
+    { "Skia: an image drawn scaled"_s, stageImage },
+    { "Skia: a recorded picture replayed"_s, stagePicture },
+};
+
+} // namespace
+
+unsigned onyxCoreTestStageCount()
+{
+    return std::size(stages);
+}
+
+const char* onyxCoreTestStageName(unsigned stage)
+{
+    return stage < std::size(stages) ? stages[stage].name.characters() : "";
+}
+
+void* onyxCoreTestPrepare(unsigned stage)
+{
+    // (The main thread: what the stages take from WebCore -- the typeface -- and the picture.)
+    if (!s_typeface) {
+        auto& manager = FontCache::forCurrentThread().fontManager();
+        auto typeface = manager.legacyMakeTypeface(nullptr, SkFontStyle());
+        if (!typeface)
+            typeface = manager.matchFamilyStyle("sans-serif", SkFontStyle());
+        s_typeface = typeface.release();
+    }
+    if (!s_picture && stages[stage].run == stagePicture)
+        s_picture = recordTestPicture().release();
+    s_coreContext = { };
+    s_coreContext.stage = stage;
+    return &s_coreContext;
+}
+
+void onyxCoreTestRun(void* argument)
+{
+    auto& context = *static_cast<Context*>(argument);
+    context.breadcrumb = 0;
+    context.result = stages[context.stage].run(context);
+    context.breadcrumb = 0xffff;
+}
+
+void onyxCoreTestStopped(void* argument)
+{
+    auto& context = *static_cast<Context*>(argument);
+    context.breadcrumbWhenStopped = context.breadcrumb;
+    context.stopped = true;
+}
+
+unsigned onyxCoreTestBreadcrumb()
+{
+    return s_coreContext.stopped ? s_coreContext.breadcrumbWhenStopped : s_coreContext.breadcrumb;
+}
+
+bool onyxCoreTestCheck(unsigned stage, char* text, size_t size)
+{
+    s_mainContext = { };
+    s_mainContext.stage = stage;
+    onyxCoreTestRun(&s_mainContext);
+    bool same = s_coreContext.result == s_mainContext.result && s_coreContext.result;
+    const char* note = "";
+    if (stages[stage].run == stageThreadLocal) {
+        same = s_coreContext.result == 1111 && s_mainContext.result == 1111;
+        note = s_coreContext.threadLocalAddress != s_mainContext.threadLocalAddress ? "; the core has its own thread_local data" : "; the core SHARES the main thread's thread_local data";
+    } else if (stages[stage].run == stageText && !s_typeface)
+        note = "; no typeface: nothing drawn";
+    if (same)
+        snprintf(text, size, "result %llx%s", static_cast<unsigned long long>(s_coreContext.result), note);
+    else
+        snprintf(text, size, "result %llx, the main thread's is %llx%s", static_cast<unsigned long long>(s_coreContext.result), static_cast<unsigned long long>(s_mainContext.result), note);
+    return same;
+}
