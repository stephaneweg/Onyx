+static inline uint64_t rasterClockNanoseconds()
+{
+    // (clock_gettime: libonyxposix reads the counter, no kernel call -- it may run on an app core.)
+    struct timespec time;
+    clock_gettime(CLOCK_MONOTONIC, &time);
+    return static_cast<uint64_t>(time.tv_sec) * 1000000000ull + static_cast<uint64_t>(time.tv_nsec);
+}
+
+// On any core, an app core included (the host's raster workers): Skia and plain memory only -- no
+// WTF, no WebCore (their thread-local state is the main thread's).
+void GraphicsLayerOnyx::runRasterJob(void* argument)
+{
+    auto& job = *static_cast<GraphicsLayerOnyxRasterJob*>(argument);
+    auto startTime = rasterClockNanoseconds();
+    leaveBreadcrumb(job, 1);
+    auto info = SkImageInfo::Make(job.width, job.height, kBGRA_8888_SkColorType, kPremul_SkAlphaType, SkColorSpace::MakeSRGB());
+    if (auto surface = SkSurfaces::WrapPixels(info, job.pixels, job.rowBytes, &job.properties)) {
+        // (The pixels are transparent already: recordPendingPaints.)
+        leaveBreadcrumb(job, 2);
+        auto* canvas = surface->getCanvas();
+        canvas->translate(-job.x, -job.y);
+        leaveBreadcrumb(job, 3);
+        if (job.traced) {
+            OperationCounter counter(job);
+            job.picture->playback(canvas, &counter);
+        } else
+            job.picture->playback(canvas);
+    }
+    leaveBreadcrumb(job, 0xffff);
+    job.nanoseconds = rasterClockNanoseconds() - startTime;
+}
+
+void GraphicsLayerOnyx::setRasterJobTraced(void* argument)
+{
+    static_cast<GraphicsLayerOnyxRasterJob*>(argument)->traced = true;
+}
+
+void GraphicsLayerOnyx::describeRasterJob(void* argument, char* text, size_t size)
+{
+    auto& job = *static_cast<GraphicsLayerOnyxRasterJob*>(argument);
+    unsigned breadcrumb = *static_cast<volatile unsigned*>(&job.breadcrumb);
+    char where[48];
+    if (breadcrumb == 0xffff)
+        snprintf(where, sizeof(where), "done");
+    else if (breadcrumb >= 100)
+        snprintf(where, sizeof(where), "in the picture's operation %u", breadcrumb - 100);
+    else
+        snprintf(where, sizeof(where), "breadcrumb %u", breadcrumb);
+    snprintf(text, size, "%d x %d at %d,%d, %s, a picture of %d operations, %zu bytes: %s", job.width, job.height, job.x, job.y, job.opaque ? "opaque" : "with alpha",
+        job.picture->approximateOpCount(), job.picture->approximateBytesUsed(), where);
+}
+
+void GraphicsLayerOnyx::resetRasterJob(void* argument)
+{
+    auto& job = *static_cast<GraphicsLayerOnyxRasterJob*>(argument);
+    job.traced = false; // (The core test: the breadcrumb stays where the core left it.)
+    for (int y = 0; y < job.height; ++y)
+        memset(reinterpret_cast<uint8_t*>(job.pixels) + y * job.rowBytes, 0, static_cast<size_t>(job.width) * sizeof(uint32_t));
+}
