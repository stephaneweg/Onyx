+// The app cores' self test (SD:/etc/web-gpu-coretest, ONYX_WEB_GPU_CORETEST): what a raster job
+// needs of an Onyx app core, one thing a stage, from nothing to a recorded picture replayed. The
+// host (LayerTreeHostOnyx) runs each stage on an app core FIRST -- whatever the stage uses for the
+// first time in the process, it uses it there -- then on the main thread, and compares the two
+// results. A stage leaves a breadcrumb between its steps: what the host prints when the core
+// faults. Declared in GraphicsLayerOnyx.h. A stage is Skia, the C and C++ libraries and plain
+// memory: no WTF, no WebCore (as a raster job).
+
+#include "config.h"
+#include "GraphicsLayerOnyx.h"
+
+#if USE(GRAPHICS_LAYER_ONYX)
+
+#include "FontCache.h"
+#include <errno.h>
