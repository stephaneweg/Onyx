+// Onyx's app cores (kapi core_acquire / core_run, Onyx's docs/03): whole cores a program takes for
+// code of its own -- the only parallelism Onyx has (its threads all run on core 0, in turns). The
+// compositor rasterises its tiles there. An app core is not a thread (no kernel call, the caller's
+// TLS, locks that spin): what makes Skia's raster run on one is in tools/webkit/onyxcores.c of the
+// Onyx sources, which the program WebKit is linked into brings, as it brings gpucomp. The jobs
+// given here must be Skia and plain memory only: no WTF, no WebCore.
+extern "C" {
+
+// Up to `wanted` app cores taken and their workers started -> how many (0: none is free: an
+// emulator, the network core). Each start has its stop.
+int onyx_cores_start(int wanted);
+void onyx_cores_stop(void);
+// The workers that run now (0 once one has faulted, for the rest of the process's life: the next
+// starts take none).
+int onyx_cores_count(void);
+// function(arguments[i]) for every i < count, on the workers and (mainToo) on the calling thread,
+// which must be the main thread; back when all are done. -1: a worker stopped -- its job faulted
+// (a kernel call made on the core is one), or no job was finished for 2 s: the job it had was run
+// again by the caller, after reset(arguments[i]) had put its output back as it was given; the
+// cores are given back. (A worker that died holding a lock the main thread then needs ends the
+// process: see onyxcores.c.)
+int onyx_cores_run(void (*function)(void*), void (*reset)(void*), void** arguments, int count, int mainToo);
+// What happened to the worker that stopped (null: none did).
+const char* onyx_cores_failure(void);
+// A clock that may be read on an app core (nanoseconds).
+unsigned long long onyx_cores_now_ns(void);
+unsigned onyx_cores_jobs_done(int worker);
+
+}
+
+#endif // USE(GRAPHICS_LAYER_ONYX)
