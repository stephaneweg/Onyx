+// A part of a pending paint to rasterise: what GraphicsLayerOnyx::runRasterJob gets, on any core.
+// Plain data and Skia only.
+struct GraphicsLayerOnyxRasterJob {
+    SkPicture* picture;
+    uint32_t* pixels; // The part's first pixel in the paint's buffer.
+    size_t rowBytes;
+    int x; // The part, in the layer's coordinates (the picture's).
+    int y;
+    int width;
+    int height;
+    bool opaque;
+    SkSurfaceProps properties;
+    uint64_t nanoseconds; // Out: how long the job took.
+    bool traced { false }; // The core test: breadcrumbs are left.
+    unsigned breadcrumb { 0 };
+};
+
+// The core test's breadcrumbs: written at once (the core may stop at the next instruction).
+static inline void leaveBreadcrumb(GraphicsLayerOnyxRasterJob& job, unsigned value)
+{
+    if (job.traced)
+        *static_cast<volatile unsigned*>(&job.breadcrumb) = value;
+}
+
+namespace {
+class OperationCounter final : public SkPicture::AbortCallback {
+public:
+    explicit OperationCounter(GraphicsLayerOnyxRasterJob& job)
+        : m_job(job)
+    {
+    }
+    bool abort() final
+    {
+        leaveBreadcrumb(m_job, 100 + m_count++);
+        return false;
+    }
+private:
+    GraphicsLayerOnyxRasterJob& m_job;
+    unsigned m_count { 0 };
+};
+}
