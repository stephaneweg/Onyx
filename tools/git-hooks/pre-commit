#!/bin/sh
#
# Onyx pre-commit hook -- never let the user's Wi-Fi network and key reach git history.
#
# sdcard/etc/wpa_supplicant.conf (and sdcard_lite's) is not tracked (.gitignore): it lives on
# the SD card only, written by the Wi-Fi settings. If it is ever staged (git add -f), the
# commit is refused.
#
# Install (once per clone):  git config core.hooksPath tools/git-hooks
#
if git diff --cached --name-only --diff-filter=ACMR | grep -q "etc/wpa_supplicant.conf$"; then
	echo "pre-commit: etc/wpa_supplicant.conf holds your Wi-Fi key: it must not be committed" >&2
	echo "            (git restore --staged <file>)" >&2
	exit 1
fi

exit 0
