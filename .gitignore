# Circle (the HAL) is a git SUBMODULE -> our fork github.com/stephaneweg/circle,
# branch `onyx` (= upstream Step51 + our patches). It is therefore tracked, not
# ignored. After cloning Onyx:  git submodule update --init  (then build Circle).

# Build artifacts (transient outputs of the kernel/ and user/ builds).
*.o
*.a
*.d
*.img
*.elf
*.lst
*.map
*.bin
# Pi / WLAN firmware blobs elsewhere in the tree
*.dat
*.dtb

# Scratch / reference material (e.g. MenuetOS .asm sources kept for reference)
/temp/

# Editor / tooling
.claude/settings.local.json
.claude/settings.local.json.bak
# MS Office lock/temp files (e.g. ~$04-USER-GUIDE.docx while a doc is open)
~$*

# The shared libraries' build folder (user/Makefile: lib/<name>.so, staged to sdcard/lib)
/user/lib/

# Generated by the kernel build (kapi_* symbol export)
user/kernel_syms.ld

# libonyxposix's build folder and the POSIX sysroot + the ports' builds (docs/03 §5.4, tools/ports)
user/Runtime/libc/posix/build/
user/Runtime/libc/posix/build-sim/
user/Runtime/libc/posix/build-onyx/
user/Runtime/libc/posix/build-onyx-sim/
/out/

# Python bytecode cache
__pycache__/
*.pyc

# ============================================================================
# Committed WHOLESALE -- these override the artifact globs above.
# ============================================================================

# The complete SD card image is committed (binaries included): the kernel .img, every
# app .elf, the resources, skins, keymaps AND the Pi/WLAN firmware blobs, so
# the repo is a ready-to-flash card. EXCEPT sdcard/etc/wpa_supplicant.conf (the user's Wi-Fi
# network and key): never tracked (ignored below), never packaged (tools/pkg/mkrepo.py) -- the
# Wi-Fi settings (wpaconf) or the menu bar's Wi-Fi menu write it on the card.
!/sdcard/
!/sdcard/**
# ... and the smallest card, sdcard_lite (the required packages only, made by tools/pkg/mkrepo.py --lite)
!/sdcard_lite/
!/sdcard_lite/**

# Vendored third-party dependencies (sources + prebuilt .a) so the build is self-contained:
# FreeType, mbedTLS, libwebp, libpng, the codecs, FFmpeg, MuPDF, Skia, ICU...,
# libjpeg, zlib. The builds point here by default.
!/third_party/
!/third_party/**
# ...but NEVER the intermediate object files under third_party -- keep only the sources +
# the re-linkable .a libraries (see build-artifacts hygiene). Re-excluded after the negation.
# (Only *.o: patterns like *.d/*.map would wrongly catch source such as mbedtls/ChangeLog.d/
# or zlib's version-script zlib.map.)
third_party/**/*.o
# (their header lists, -MMD: named <obj>.o.d -- no source is)
third_party/**/*.o.d
# Remembered FTP logins (ftpfs "Remember password"): never commit them
sdcard/etc/ftpfs.ini
# Mail: the user's accounts, their encrypted passwords and tokens, the card's key, the mail itself
sdcard/etc/mail/accounts.ini
sdcard/etc/mail/secrets
sdcard/etc/mail/key
sdcard/mail/
sdcard_lite/etc/mail/accounts.ini
sdcard_lite/etc/mail/secrets
sdcard_lite/etc/mail/key
sdcard_lite/mail/

# Lisa's Groq API key: never commit it
sdcard/apps/lisa.app/config.ini

# Jet, the browser on WebKit: its 100 MB program is built by tools/webkit/build-web.sh and carried by
# its package only (too big for git); and WebKit's data on the card (cookies, storage, caches)
sdcard/apps/jet.app/main
sdcard/var/webkit/

# The PC tools' build folders (pc/build.sh; the result, pc/dist/, is kept)
pc/OnyxBasic/bin/
pc/OnyxBasic/obj/
pc/OnyxRemote/bin/
pc/OnyxRemote/obj/
pc/NintendoEMU/bin/
pc/NintendoEMU/obj/
tools/basc/basc

# Game Boy ROMs, saves and the Game Library's thumbnails: the user's own, never committed
sdcard/roms/**/*.gb
sdcard/roms/**/*.gbc
sdcard/roms/**/*.gba
sdcard/roms/**/*.sav
sdcard/apps/gamelib.app/thumbs/
sdcard/apps/gamelib.app/config.ini

# Doom: the player's own IWADs / PWADs, settings and saved games (Freedoom ships)
sdcard/doom/*.wad
!sdcard/doom/freedoom1.wad
sdcard/doom/*.WAD
sdcard/doom/savegame/
sdcard/doom/*.cfg
user/Ports/doom/build/
sdcard/etc/clock

# Koton for Windows: what the app writes into its folder when tried from the repository
pc/dist/Koton/koton/settings.json

# The user's Wi-Fi network and key: on the card only, never in git (see the note above)
/sdcard/etc/wpa_supplicant.conf
/sdcard_lite/etc/wpa_supplicant.conf
sdcard/res/wallpaper.*
sdcard_lite/res/wallpaper.*

# tools/pkg/publish.sh: the Jet package its program was taken back from
.jet-from-package
