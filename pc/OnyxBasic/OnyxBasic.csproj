<Project Sdk="Microsoft.NET.Sdk">
  <!-- Onyx BASIC for Windows: the editor and the runtime (obcore.dll does the language).
       .NET Framework 4.8: already on every Windows 10 / 11. Build: sh pc/build.sh -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>OnyxBasic</AssemblyName>
    <RootNamespace>OnyxBasic</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>onyxbasic.ico</ApplicationIcon>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>Onyx BASIC</AssemblyTitle>
    <Product>Onyx BASIC</Product>
    <Version>1.0.0</Version>
    <Nullable>disable</Nullable>
    <DebugType>none</DebugType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
