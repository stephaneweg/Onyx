<Project Sdk="Microsoft.NET.Sdk">
  <!-- Onyx Remote: the client of rdpd (the window-level remote desktop of Onyx). Each Onyx
       window is a window of its own on the PC. .NET Framework 4.8 (on every Windows 10 / 11).
       Build: sh pc/build.sh -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>OnyxRemote</AssemblyName>
    <RootNamespace>OnyxRemote</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>onyxremote.ico</ApplicationIcon>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>Onyx Remote</AssemblyTitle>
    <Product>Onyx Remote</Product>
    <Version>1.0.0</Version>
    <Nullable>disable</Nullable>
    <DebugType>none</DebugType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
